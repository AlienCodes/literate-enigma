  "approved_summary": [
    [
      "旧说",
      "医学界曾把溃疡归于压力、辛辣食物和胃酸过多，认为胃里的强酸会让细菌无法存活。"
    ],
    [
      "发现",
      "沃伦在胃炎患者胃中看见细菌，与马歇尔合作培养；过去培养皿放两天就扔，一次留置约五天后终于长出细菌，后来命名为幽门螺杆菌。"
    ],
    [
      "自试",
      "1984年，马歇尔喝下菌液后呕吐、疲惫，检查发现胃黏膜发炎，也从胃部样本中培养出同种细菌；他得的是胃炎，并非溃疡。"
    ],
    [
      "治疗",
      "马歇尔服用抗生素后感染消退，后来溃疡治疗也逐步采用这类药物。"
    ],
    [
      "认可",
      "2005年，两人因发现这种细菌及其在胃炎、消化性溃疡中的作用共获诺奖；获奖理由也明确写到了胃炎。"
    ]
  ],
