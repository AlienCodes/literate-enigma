  "precision_fixes": [
    {
      "id": "25",
      "paragraphs": [
        4
      ],
      "detail": "完整保留地面65伏与28伏温控开关不匹配、很可能失灵、长时间加热损伤绝缘层、飞行中起火链条；未把失灵推测写成定论。"
    },
    {
      "id": "26",
      "paragraphs": [
        2,
        4,
        5,
        6
      ],
      "detail": "不把聋人一概写成聋哑人；入学年龄与后来几批新生分别交代，运动方式/路径的合并与拆分保留。"
    },
    {
      "id": "27",
      "paragraphs": [
        2,
        4,
        5
      ],
      "detail": "狼的七倍多按原文保留数量对比，不擅换为密度；数量与个体健康分开，鸟数/鸟种、养分循环及持续低剂量辐射争议均保留。"
    },
    {
      "id": "28",
      "paragraphs": [
        3,
        4,
        5
      ],
      "detail": "不煮沸是关键；小鼠完全抑制不等于人体安全，1972自试与21名患者时间线及多药联合疗法保留。"
    },
    {
      "id": "29",
      "paragraphs": [
        2,
        3,
        5,
        6
      ],
      "detail": "二氧化硫—硫酸盐气溶胶—反射阳光降温链条与死后次生灾情、作者实际到场和匿名出版均完整。"
    },
    {
      "id": "30",
      "paragraphs": [
        1,
        4,
        5,
        6
      ],
      "detail": "chloride of lime译为含氯漂白粉，避免“氯化石灰”误指；截流下游、直径加倍、错理论因保护饮水奏效及1866未接网地区死亡均保留。"
    },
    {
      "id": "31",
      "paragraphs": [
        3,
        5
      ],
      "detail": "十二次拒绝保留据报道限定；500限定首批精装本，300馆藏及英美出版、系列含衍生书销量均保留。"
    },
    {
      "id": "32",
      "paragraphs": [
        3,
        5
      ],
      "detail": "轨道清理译出引力主导而非完全清空；心形区域与整个汤博区不全是平原，在唯一必要的阅读提示中明确；EN原文不改。"
    },
    {
      "id": "33",
      "paragraphs": [
        3,
        4,
        5
      ],
      "detail": "救援者不与少年球队混指，获救与两名救援者先后遇难分清2018前期布气瓶和2019感染。"
    },
    {
      "id": "34",
      "paragraphs": [
        2,
        3,
        4,
        5
      ],
      "detail": "原文copies未直接称盗版，去除原译擅加；领取工资与游戏收益分开，未授权转卖、掌机/全球主机范围、出货量及1995协议到期均准确。"
    },
    {
      "id": "35",
      "paragraphs": [
        1,
        3,
        4,
        5
      ],
      "detail": "被移位运输后放飞、磁感实验室证据和活鸟验证、低于世卫限值的定向干扰及罗盘/定位地图差别均保留。"
    },
    {
      "id": "36",
      "paragraphs": [
        2,
        3,
        4,
        5
      ],
      "detail": "据萨松回忆限定保留；未投产限1975原型，裁员为累计削减，破产保护与重组不是消失，停产仅Kodachrome产品；printer译印刷企业。"
    }
