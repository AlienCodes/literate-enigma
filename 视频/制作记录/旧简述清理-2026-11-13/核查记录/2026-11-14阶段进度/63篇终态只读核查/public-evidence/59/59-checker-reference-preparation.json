  "reference_calls": [
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "In June 1974 Mario Molina and Sherwood Rowland,",
      "exact_native_cache_key": "1615cfbd830c50793969baf44febb0b5af15ff27.pkl",
      "cache_input_text_sha256": "8a14db288c5b20acca859b8066d1ba582d9a84b5fb1ee5995ed245386d42efed",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "chemists in California,",
      "exact_native_cache_key": "d1493dacd8580746fa76bd3e990c2b2dafaf19d7.pkl",
      "cache_input_text_sha256": "5a6ffb85518b3583a67e35b22692f4cbd8cb223b71ffca84f834dbf0fa45752d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "warned in Nature of a menace in fridges and spray cans.",
      "exact_native_cache_key": "98ca4b2f7ea8a7ecf998bbb966b0334196e78185.pkl",
      "cache_input_text_sha256": "547b04c7d9f5b9749787a38129c871eba54d0cd60c9c0e6ee25b8ba6b0dcd3c1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Chlorofluorocarbons (CFCs) are so inert that they drift intact into the stratosphere,",
      "exact_native_cache_key": "2ca518ad703b504fb3aa2797003582e799a72cb2.pkl",
      "cache_input_text_sha256": "f18131c43566a7e705ee28a3cab0a2dc9203c5635347e5c9912311fffba5c9e3",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "high in the atmosphere,",
      "exact_native_cache_key": "7decc4d856b91a4684084a49bb39a552d7e613fe.pkl",
      "cache_input_text_sha256": "81f6af6ac26e23b1f15358b3283b681e3cad3fb3846e57330a05711efbdc5609",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "where they can liberate chlorine,",
      "exact_native_cache_key": "07aa14f16ac6a49553fd220c4467e8eafb05a3fe.pkl",
      "cache_input_text_sha256": "0332e7b5433b704d5d4c80fd1ee4e5fd3f301eeccffe2c23b972b29ea77c53e5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 4,
      "source_slice": "a catalyst that destroys ozone molecule after molecule.",
      "exact_native_cache_key": "0fc340458fc74ef32bb6e033b941d4e13fdfb745.pkl",
      "cache_input_text_sha256": "02c32365873d5b43305700cf94225363aafbe04c4c7c7b01ce45f8ed71e5a20b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "The alarm,",
      "exact_native_cache_key": "ce3fb7f2f873ebcd695b21e997c0a23eb7be67a9.pkl",
      "cache_input_text_sha256": "34efa261bb993e061d4ce6ee8084e8e8cdcf7833fca6cc4ea59019e7ef48f0a9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "when it sounded,",
      "exact_native_cache_key": "4f7029fecdc66cd575be5e7d7da5fc1cf491218e.pkl",
      "cache_input_text_sha256": "29d797c755872fae02257bc5119432a418f60c5e59466ef070a25ab6325a1a72",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "was abrupt.",
      "exact_native_cache_key": "a147e0e47331df7e2eee34bdadf28e110d47b8cf.pkl",
      "cache_input_text_sha256": "509b04c26dd2da7b74b52ce6f9c938d857649140aefcf2428908fd182e75e7a9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "In May 1985 Joseph Farman and colleagues at the British Antarctic Survey reported that ozone over Halley Bay,",
      "exact_native_cache_key": "3e1ca5208bf3f5a41a5130c7f8bdf924f62f7eb9.pkl",
      "cache_input_text_sha256": "4b1773a777af22ce8a1447ce268132b24a366109367a1900e6133109f0f29735",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "their Antarctic station,",
      "exact_native_cache_key": "4d5c1f166230cb5fc011689803ea85249f9be891.pkl",
      "cache_input_text_sha256": "2dd08b91ebe8b813ce495cd1a168fd824727ce8064fa8cdbd2c0fa85c60122fd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "had plummeted each southern spring since the mid-1970s.",
      "exact_native_cache_key": "efd7347bd692864d36f143b2013e635cc5dafcef.pkl",
      "cache_input_text_sha256": "d1b182abd43c13eccc480a23ae2aeadb042e2e2d0ddee7e06731aa03bb761e19",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The staff were persistent,",
      "exact_native_cache_key": "a0b40cb11151fd41c2a3f44ca2785289676d850b.pkl",
      "cache_input_text_sha256": "5e5dffa578a61c4063ca7ff995212750d55fad088047b7eff8d0c0da40a22f2f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "reading it in a painstaking routine of manual observation.",
      "exact_native_cache_key": "fd4cd238852aeb4567ab395c9618c5b764123a08.pkl",
      "cache_input_text_sha256": "a8befaf9fc05e58170ac209b10e801ecf2c44b35b6946a772478c5ed09adb835",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Yet NASA's Nimbus-7 satellite,",
      "exact_native_cache_key": "2df2ac2c5f1653168c7a505c4f05b6e5216456d2.pkl",
      "cache_input_text_sha256": "68433d9aed4117721b5f916db7cd7657d91d6f1cbcb2231963ed1d7f62eba7ff",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "a sophisticated eye in orbit,",
      "exact_native_cache_key": "8e83da20ad41bdfa6d10b82eb614ffd3efa56a1f.pkl",
      "cache_input_text_sha256": "4286e4710cb2c80bb661aa36a7f9e7243ea72f67c3df14a8eed38537e3eb8aef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "had recorded the same lows.",
      "exact_native_cache_key": "8a707621ab7a065a0a1d89b98175c0b8239c0138.pkl",
      "cache_input_text_sha256": "1847249cc76767d15a28a997a729444fd7f8ebb77816ef514d5962cc25ebbe77",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Its software flagged them as dubious,",
      "exact_native_cache_key": "419be703564edc901fadc261b80f00dd3c553cb8.pkl",
      "cache_input_text_sha256": "976f2f273e90c69b1e77d5df00ba221cb0547538bb0859b3b8bafdc8cb6a1ff9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "since ozone that low had never been reliably measured.",
      "exact_native_cache_key": "21d634ea9fdba648492476e18d241ce7c523a991.pkl",
      "cache_input_text_sha256": "dc9ee67f2047ffe3f8d3017a796898eb7574974bbf0e77e05ec315459657c855",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "The sensor had worked;",
      "exact_native_cache_key": "28da5914ae40aafcf6cfcb4ce86aa98013ce2238.pkl",
      "cache_input_text_sha256": "e4180fefe818676b11d94b52b1b16d23927b5ca6279ef04a500ebcf69a1611f0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "expectation had not.",
      "exact_native_cache_key": "e18724d3b28f2580f9a22757aed27f64d58c75b6.pkl",
      "cache_input_text_sha256": "21f2d61bd403bf4774c49572623b51b70aa956582b527fadb12e02af44a07764",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Remarkably,",
      "exact_native_cache_key": "348af92d951f94f5da2ff4ada054d71d0ca21432.pkl",
      "cache_input_text_sha256": "4452bf6066d66e4ed7107392ccd181fd353dc5e364ede1b5612441ac6d4fc084",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "the response was swift.",
      "exact_native_cache_key": "a2b2804d75695d267f4c0e1dece0542eba6e9371.pkl",
      "cache_input_text_sha256": "641c0f2baf1726fb15102e3363d5153f0d5fa2af8a40992f6628747785b14d6f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "In September 1987 diplomats signed the Montreal Protocol,",
      "exact_native_cache_key": "8b65b356ba540d6ec7e9b8ae417c4bc5806136ed.pkl",
      "cache_input_text_sha256": "7895943f67ddec93d9fc98378b8e9cf8cd9211012ac4c1d358bf9ae9c811ca3c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "a binding accord to curb CFCs.",
      "exact_native_cache_key": "1501963b5ad7db4fc9baa4d74841de943646bfb2.pkl",
      "cache_input_text_sha256": "d85674f61d7e1ff43c0beda79178c33e685a2200bffa4df5470bc18d82efa20f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Amendments tightened it:",
      "exact_native_cache_key": "1068db836bbeb75c766282555dae0f442a401679.pkl",
      "cache_input_text_sha256": "c23541a05a34b2e1689ec2c88335a5215b36e9ede56e3a9b9e4d552df01ce2c9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "in June 1990 affluent countries pledged to phase out CFCs by 2000.",
      "exact_native_cache_key": "9620e44f855a85dd282cdb1eca8623afa0773f89.pkl",
      "cache_input_text_sha256": "8d944d3c44692e0a00bf2e0f92558bde64fc7c66b6b9f9bae878452307a27f31",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "In January 2023 a UN-backed assessment forecast recovery to 1980 levels around 2066 over Antarctica,",
      "exact_native_cache_key": "ff750993d9eeb8ddbb61d52a5f787d47c00fdcf6.pkl",
      "cache_input_text_sha256": "eb5167dd6dfd57d78b993055faf2bdc4a28606059325e1ba3af9b21f6c45a32f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "2045 over the Arctic,",
      "exact_native_cache_key": "44f49f120564c17a26ae0e035c4810b9e7f3f7db.pkl",
      "cache_input_text_sha256": "6b8c152dcedfa93b8a9204a8d831ed09c2f5f02258c693462e400e37d6ab0f23",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "and 2040 elsewhere.",
      "exact_native_cache_key": "e343fa1a10205da4270245a1f0ea102314079d13.pkl",
      "cache_input_text_sha256": "62fd421a2f023df617dcb4ac797811192bd3cde2854e91e84927c16a384b0fde",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 1,
      "source_slice": "The sky's rescue began with diligent observers who trusted that a baffling number was no glitch,",
      "exact_native_cache_key": "5cd618111f166a1c2923a65d291003907fb5b0ea.pkl",
      "cache_input_text_sha256": "8a501274dd4e4add6d6bb6692cbce534ed95846dc83dbecb7f4e78945a5ce4ce",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
