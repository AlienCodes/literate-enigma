  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "Each winter,",
      "exact_native_cache_key": "738e5606b56c5fdc9177d4dc6381d8600103600c.pkl",
      "cache_input_text_sha256": "5ba05b8f47ab0a97efc0beaf5e072c1c156a54c2d39f958415f35462226c3201",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "male humpback whales,",
      "exact_native_cache_key": "3ee7d4efec7b6788ee748ed5b0e1452dcbfc7638.pkl",
      "cache_input_text_sha256": "344371024f1acb2cd8523d0fbe1dc425b04c27e39a8da935d131c327c0ab9851",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "and only males,",
      "exact_native_cache_key": "593dce0991adbbde8be1159ce48bbe8c0aed5785.pkl",
      "cache_input_text_sha256": "5893d94aaf8fb150450cce51ba177d77f164323f9b69374cfe7cf1036eb59740",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 4,
      "source_slice": "fill their breeding grounds with a haunting melody.",
      "exact_native_cache_key": "787e327794e5ddcf9ac999675dc563dc20195a46.pkl",
      "cache_input_text_sha256": "ce7e926482cd08733c653b7abf1912aa8243b586ddefa38f727da99669e606ee",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Sound units constitute phrases,",
      "exact_native_cache_key": "35f8c28c415f541ba6a1f55186245aec02e9fed4.pkl",
      "cache_input_text_sha256": "ffabfce5394cae954edcc89b0381b23bb3cef7c8e56adf36a45826482019e64d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "and phrases build themes in an elaborate hierarchy.",
      "exact_native_cache_key": "89f45824c78ce09bfc123589e6a28c309a99b2ab.pkl",
      "cache_input_text_sha256": "7ef02c52282f5095c77c4869b8ba4ce8714e07dd688a42dac06d8bbc4e48fc06",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Each rendition lasts minutes,",
      "exact_native_cache_key": "1186718af6b83d29627fbd84752bf281d6c71084.pkl",
      "cache_input_text_sha256": "ad6ab75dbb7a8438a59150b49862724c1b16e798a0409186dbaa3fcb394d1b20",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "and the song can recur for hours,",
      "exact_native_cache_key": "82c89a7f6f21e77cb691574745b6fff9318fac96.pkl",
      "cache_input_text_sha256": "0c6191836c50226ccc1704921a0e19d6d45c4cf260a0f8233136c846fec33edf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "probably for courtship.",
      "exact_native_cache_key": "dcf5ada45ea64212cb739d669c902b424782d61e.pkl",
      "cache_input_text_sha256": "b94978ba3b89b5630aa414a62b70a3bf17076d6d1b78c29650ac0412ab22feab",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "All the males in a population sing an identical version,",
      "exact_native_cache_key": "fe6ce83d04425d6a8599274bb250d6c3553b2ba9.pkl",
      "cache_input_text_sha256": "215740b03c9116687c9487ad8d94208d88ff51bab2b74724fac09bb3762fa4a1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "which evolves subtly each year.",
      "exact_native_cache_key": "c6ca8c0f60a42ac19c5e19f4077c3a44bee6a951.pkl",
      "cache_input_text_sha256": "b7f8d05cf22addf6d5f327098df79c7b38511e9463c9e366e1d6bf906ebab9a7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Off eastern Australia,",
      "exact_native_cache_key": "12efc0398dfaa5f7d77f21b0f1043b1259989e0d.pkl",
      "cache_input_text_sha256": "596fb9212ddab784835aa26242c5472770ae5a255f424d77acb61643b5ffcf26",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "it was broken.",
      "exact_native_cache_key": "541e177af14185d6e84764b0db5d432591b18f89.pkl",
      "cache_input_text_sha256": "b693b555012b8c332edd2b1996bd4de02cdbcbfc00bb1e5a275ffa37a005a492",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "From 1995 to 1998,",
      "exact_native_cache_key": "a88bcb88a6ba4dd0e849e897998273ed1e346320.pkl",
      "cache_input_text_sha256": "167d8e3df9ca7c5495368f429aa5ac2b67ba395e9a3b67fb584576d9bcbc2f88",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "researchers used hydrophones,",
      "exact_native_cache_key": "485e63aa129c7e9a5319feeab1d4796580cc78ea.pkl",
      "cache_input_text_sha256": "8a2a806009c2d53f7aa1a6360ff3c69d72eb0094523307f82bcb255d51ffcec5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "or underwater microphones,",
      "exact_native_cache_key": "5f1950c715c61eaf648e8f164c9c30ab7e518612.pkl",
      "cache_input_text_sha256": "15917df6589605b507d46ad67f50566794610670e1a921b37417b64e20a1d29d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 4,
      "source_slice": "to record humpbacks on their seasonal migration along the coastline.",
      "exact_native_cache_key": "7b3850d1fc2814ae0ca42505a5bac4e5b910d01b.pkl",
      "cache_input_text_sha256": "0e5ee4d5786297063f51430228b85705ec3e690b71686c94e1abb97dcdcc17b6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "In the mid-1990s,",
      "exact_native_cache_key": "d537f59f158e88ee955f8da1eb8b782411e5fad6.pkl",
      "cache_input_text_sha256": "997d67b8d4f0d17c64ad253a2312b5f37955fa9c48f84048fa522c00bd44ef54",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "merely two of 82 singers emitted a distinctive new song,",
      "exact_native_cache_key": "cb103596d3e7ddd9a3eb97952c3b68a5990a7fe5.pkl",
      "cache_input_text_sha256": "28b0ca5885705af5ab0b54c37968716ec98bdda59ea34817e986b6dcbc8c27e8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "utterly unlike the reigning chorus.",
      "exact_native_cache_key": "2e5cde7669dfe4749200d2a3b34ba7d1010048de.pkl",
      "cache_input_text_sha256": "5442bea6dc421c17fdfdaf4db1922382080032e42b15ab18b15a94def069fab9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Within about two years,",
      "exact_native_cache_key": "f95829db00faf1aec0e55f2b3be6a3dfb9e1804b.pkl",
      "cache_input_text_sha256": "0f486fa1e0b95c25aa142df82d5652c4e1cff92223d52cd9c7acacf84edab325",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "virtually every singer had converted,",
      "exact_native_cache_key": "be501bb9faa08fc4927d71473debb729ff13fb13.pkl",
      "cache_input_text_sha256": "ad65fa3be52bae347e5023afad655b93f037729cb41099993aa2f94b42a6e06c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "and by 1998 the old song had been displaced wholesale.",
      "exact_native_cache_key": "e8c095008cdde03ee95823f72037c49b90714dee.pkl",
      "cache_input_text_sha256": "a20e336b2584672770cc81af6eecd4e77c5190bc87f96e943c1c5d2c2300276f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "A study published in Nature in November 2000 found that the new song resembled that of the Indian Ocean population off western Australia,",
      "exact_native_cache_key": "72925732637995d7733ee1e65c8b57e76b46b29b.pkl",
      "cache_input_text_sha256": "8b2d7626fd820325e3c94c370e454341d41d7948e1fe85f611fbfcec32e251cf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "apparently ferried east by a handful of visiting performers.",
      "exact_native_cache_key": "8f881f4b8400922eb94cb3208908ceb02f7d075b.pkl",
      "cache_input_text_sha256": "3c72fad3caf740504a474d091b31a3cee70b39deb3d316dd29c9d95b5889446e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "In April 2011,",
      "exact_native_cache_key": "719d4fac363527137913a92fa17e289e90910b35.pkl",
      "cache_input_text_sha256": "5ed68aeb80ef4efde4906c28d6fa247544e0e57170f742ac028c0c50b7b846ab",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "a study in Current Biology analysed over a decade of recordings from six South Pacific populations.",
      "exact_native_cache_key": "5040205ae3d0d3a70624468f4daf70e9c110e157.pkl",
      "cache_input_text_sha256": "be217c3eb8e33793bc4a0bd5dddc74973d06d1a27632243e6d0a1b2ec1491771",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Song types primarily arose off eastern Australia,",
      "exact_native_cache_key": "e31738f3bead3b246c775748fc17dfdb37370766.pkl",
      "cache_input_text_sha256": "bc2f039e1168945d1d4c01266fffd5ccc1b5ee72985aef11480f3ca36b9c5b97",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "then rippled eastward through successive populations to French Polynesia,",
      "exact_native_cache_key": "6e357db9932d6d7327ee16084690f0becc14e597.pkl",
      "cache_input_text_sha256": "2eb5063008f5b413b131fdb81fc56734155d39713af2038f5601a7806154c48e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "generally crossing the region within about two years.",
      "exact_native_cache_key": "b9d70002ae9c4a224131e187a4214001a0a2e3f7.pkl",
      "cache_input_text_sha256": "89599d264eae8e8b25dcaae0c88d49f23a7f063257247c62f46d7e8a92a61270",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Such rapid change,",
      "exact_native_cache_key": "73292f943ac03ab6d526cb0fa4e6e4f12653ea7d.pkl",
      "cache_input_text_sha256": "fb8a9505c64cea140f18ef5f3bdab3054317eeb1c543e29a7e47532c8d6373d3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "too fast for genetic evolution,",
      "exact_native_cache_key": "456dfa45afe5e39a02752ba19aebd641bf0db14b.pkl",
      "cache_input_text_sha256": "49869aa484e12abd3a0845ba7f476a95a0cb9682252b4e11b4e9680f22ff7ab5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "points to imitation rather than inheritance,",
      "exact_native_cache_key": "a500c0ca040c81ee30982ee6d2ccf285655a99b4.pkl",
      "cache_input_text_sha256": "76ca5c00f5eee93a1081fb2f242112caaf5b6eb5c7f2708a2c588fb6dddc2b82",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "a persuasive case of cultural transmission.",
      "exact_native_cache_key": "e662f764da63898c83b5069901d81f1bedf79df5.pkl",
      "cache_input_text_sha256": "4e5cec8ad177f8deb96cb2d55242e0e5068bd62dfef4a92a7f73d6dd7cb57e96",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Why males sing,",
      "exact_native_cache_key": "4ef6e54a93f2d115c0c1ee2fa5d4c6f29159bbeb.pkl",
      "cache_input_text_sha256": "69c41591558cc663efe5c60a1adf39bf8e13b75578797b7e162262684680d125",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "and why they overhaul their songs,",
      "exact_native_cache_key": "c29f7ec4d208944825899f39e28d806b7e4f79c0.pkl",
      "cache_input_text_sha256": "32b04d1591f302a22dafe42d2182d54a56b7d16f62faa6ee485938835a6cb94d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "remain controversial.",
      "exact_native_cache_key": "0121b0532abf0342328c86b38fcf74f13138ba0e.pkl",
      "cache_input_text_sha256": "65646ca2d83a7272ef655f334811757e916d09788b5f6a26e5c46389fce85575",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "Whatever the label,",
      "exact_native_cache_key": "4b61d3b00342a9a97751566c6701e6374d535d08.pkl",
      "cache_input_text_sha256": "2b37095f636a6fe6269835f2617befada53d2f533fdc685877299608e891abf9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "a few outsiders off eastern Australia reshaped an entire population's music.",
      "exact_native_cache_key": "63bfa4606d86870d28fb24c4de61a8950a299960.pkl",
      "cache_input_text_sha256": "cb4b335de344fc7f6068c19672eea915d21c5ab3838e0df2ba981bd564ec04dd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
