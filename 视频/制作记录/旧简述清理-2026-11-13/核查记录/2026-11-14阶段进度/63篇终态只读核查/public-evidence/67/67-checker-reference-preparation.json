      "cache_input_text_sha256": "4375f8e27ffda85e19802583434d95c572ac022b8a849f5349c674cfb3f70e9b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "The animal only nosed about the hole,",
      "exact_native_cache_key": "60930b747dae1a4f40ecea84f08a3c63a263bcd3.pkl",
      "cache_input_text_sha256": "65e7bdf3b924b69d8626be6882b56e08e24e4b1512ae286ec8d96bd144bce116",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "and the pivotal initiative was the boys' own.",
