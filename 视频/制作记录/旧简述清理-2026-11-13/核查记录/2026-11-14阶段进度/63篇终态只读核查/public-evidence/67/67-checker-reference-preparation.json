      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "A white fungus invaded the walls in a 2001 outbreak,",
      "exact_native_cache_key": "e37f1e78845615636f4e86da6212a093aedaa612.pkl",
