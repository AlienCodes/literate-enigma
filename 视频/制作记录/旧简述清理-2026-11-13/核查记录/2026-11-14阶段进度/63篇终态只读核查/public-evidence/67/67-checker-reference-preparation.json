      "cache_input_text_sha256": "55f6cd228af503627610e260b95ced3f2de8a0e71e590d28cd8ad9a233396421",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "On 12 September 1940 he came back with three other boys for an adventurous excursion,",
      "exact_native_cache_key": "30cd122c7d99b09225fd038c424e10c3e21134ac.pkl",
      "cache_input_text_sha256": "c8437ff0af8d04fa9dcdf4ba7ad0dc2ee8283cb2c3818ded47be6f646ede5812",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "and the four explorers climbed down into the darkness.",
      "exact_native_cache_key": "142634f05ccb5c93fd77ee5935d9d089beb2a1dd.pkl",
      "cache_input_text_sha256": "73eca3ee3b7b0fe3ef5a1f92a795b93e59c24fa6df8ee729946f26bf31fa553f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "In later retellings,",
      "exact_native_cache_key": "c24af5911bc3cd002a9f0391ef4ecb297acea11b.pkl",
      "cache_input_text_sha256": "07f25968694cc3ad90a2132710c60a12ca89bb23f406e2acc457d9b48445bae2",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "Ravidat embroidered his anecdote with a dramatic twist.",
      "exact_native_cache_key": "54357048949a2476707b5ea78dff6a2ac4c9a768.pkl",
      "cache_input_text_sha256": "4b61215d54388cba493eed27896a4dd162d970a3e87cb1be779d0a0f53900ac5",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Robot,",
      "exact_native_cache_key": "3d3387956eb659569037c7a7d7a4cde73a31b328.pkl",
