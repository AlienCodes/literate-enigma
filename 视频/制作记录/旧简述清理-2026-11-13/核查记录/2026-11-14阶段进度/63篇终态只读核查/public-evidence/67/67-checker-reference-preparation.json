      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "bulls,",
      "exact_native_cache_key": "15cb419ea680aff29f71c1cf1c736aa571a63794.pkl",
      "cache_input_text_sha256": "37afa8393e67f899c1ba6059cfd4e64b6a7928a7c8ff9ed85efcb412d52c36aa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "and stags are among the animals depicted in pigments on the murals.",
      "exact_native_cache_key": "4a7b5e58772556d7c4876007823cf94e1320dada.pkl",
      "cache_input_text_sha256": "fb2ba162551901893e8ee463ef5a857c09eced96ad550f66cafb1273f8352506",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "Lascaux opened to the public on 14 July 1948,",
      "exact_native_cache_key": "e83de217e3ee9cde836000c46c5ca287d0c11cbb.pkl",
      "cache_input_text_sha256": "e69cb2151bf98b198176a899ddf91f5a423131e283ea2dd9e6d06b3ea4713e15",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "and tourism brought an influx of about 1,200 visitors a day.",
      "exact_native_cache_key": "b1b33b6fe78f900fbc314b1800ea913f323c7437.pkl",
      "cache_input_text_sha256": "6555dd63922413103a48273680aacb7fae1e6cd3cfec0b8bc875743df16ad2fb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "The throng exhaled carbon dioxide and added heat,",
      "exact_native_cache_key": "d109b962cc4daaa72f0fafda0856fab8b933bf40.pkl",
      "cache_input_text_sha256": "cd55c493d940d8ed4a04bb8b4699ecfd340532f022794fd309a771de6b1232be",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "humidity,",
      "exact_native_cache_key": "f3e89ea56027e9b69fbccbc48a5c8253002752f6.pkl",
      "cache_input_text_sha256": "5a52ce3ba893c569c02380c9ca1dbc67900906e1e7f6a769f562adb79d71ae1b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "and contaminants,",
      "exact_native_cache_key": "3d680fe27c993205afac10653192cc4b4584e74a.pkl",
      "cache_input_text_sha256": "5feb250b6d4250fd4f302e2745a845aee2a0982712c43be33abe24529c298f47",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 4,
      "source_slice": "and the deterioration of the paintings became plain to see.",
      "exact_native_cache_key": "8dfd1f4f95383c433849c604a01104669a4755fb.pkl",
      "cache_input_text_sha256": "9474b8d5c9ce8d9f4e286a030c5dbe70160c1c1c5a08c7bb22ca516caa1b72a1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "In 1963 the site closed to the public,",
      "exact_native_cache_key": "c85ac7cf6400b275406974f515c2296cdc0c211a.pkl",
