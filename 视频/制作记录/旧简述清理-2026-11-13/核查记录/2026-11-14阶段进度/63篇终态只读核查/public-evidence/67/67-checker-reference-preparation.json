      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "followed by restoration and daily inspection.",
      "exact_native_cache_key": "3621c389cf2c9588d71b4f255b286c93a0688cb9.pkl",
      "cache_input_text_sha256": "0ea253e3a0367be1c6affd6617e231a008e4c59f8fa136377d4a65322d7bd1c1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Lascaux joined UNESCO's World Heritage List in 1979,",
      "exact_native_cache_key": "f640c1c3426dc8403bc2c245664db47eb9e30a18.pkl",
      "cache_input_text_sha256": "cf5be49b658d170639e6d4bfd3b290a34f30366495f96924a05a3aa9d6d88e97",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "and Lascaux II,",
      "exact_native_cache_key": "c56c0aa81552a4962ea23d811d3ce82495e9f060.pkl",
      "cache_input_text_sha256": "eedcfd3bb5fc0c631226eaf2eaec95e89b59d829168a6b106a254001361c9294",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "a meticulously made partial facsimile,",
      "exact_native_cache_key": "410578b63fcb7a7f62311554617c06542ea4fabc.pkl",
      "cache_input_text_sha256": "55cc24c4bb601f67913636cbbb440a6f802795da726adeaa61a5805a4afecee5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 4,
