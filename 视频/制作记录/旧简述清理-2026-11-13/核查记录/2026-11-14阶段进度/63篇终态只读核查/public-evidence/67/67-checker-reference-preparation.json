      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "The artwork is usually dated to between 17,000 and 22,000 years ago;",
      "exact_native_cache_key": "84abf41559c8029227244a8b43d22622a22734f8.pkl",
      "cache_input_text_sha256": "ddf65ed398f009519391d494d754b074cc5983952c5c10153871093df22a6e94",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "its creators,",
      "exact_native_cache_key": "25cc34781c03ee39d3a9326cc450f0c8246e0296.pkl",
