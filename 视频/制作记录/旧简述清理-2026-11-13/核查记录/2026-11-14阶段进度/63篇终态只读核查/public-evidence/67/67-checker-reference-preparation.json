      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "the invented fall made the dog the hero of the story.",
      "exact_native_cache_key": "e9c2dc07e72e3d98a2ab244e5b7e98049b417e3e.pkl",
