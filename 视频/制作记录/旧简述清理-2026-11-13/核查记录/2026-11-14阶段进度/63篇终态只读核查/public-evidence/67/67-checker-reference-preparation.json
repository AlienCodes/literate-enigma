      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "he said,",
      "exact_native_cache_key": "be760765f59c1b4d326b7befce7622ead74e0443.pkl",
      "cache_input_text_sha256": "7144daaa71361caf40cc57cc7f6fd85171d694e4953ea610370d65deb1bc80fc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "had fallen into the cave.",
