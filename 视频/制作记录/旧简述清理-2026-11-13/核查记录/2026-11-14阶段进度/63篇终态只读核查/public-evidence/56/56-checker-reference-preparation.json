  "reference_calls": [
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "In September 1838 he began formulating the principle of natural selection:",
      "exact_native_cache_key": "cc91e746be52c729175e486bede9e33a1dca9a86.pkl",
      "cache_input_text_sha256": "347f2c77dfbd24b25f5773ac744d6f4f11bdaab83b751dfe4f31d53fdadce56d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "individuals better adapted to their surroundings survive and pass on their hereditary traits.",
      "exact_native_cache_key": "37b9aed7c28020c130c27683278f482a5313d696.pkl",
      "cache_input_text_sha256": "3d0e31b00ea6f522f4f7b5409ea24840fa97c01fd8b8f624c90eaba6f4864f4f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "By 1844 he had composed a 230-page manuscript,",
      "exact_native_cache_key": "c282d2defe703078e971bdd1e82d2f5374df39f0.pkl",
      "cache_input_text_sha256": "ff0d580c348b653ee9fdec1c1820091e67261810f456cc52a0297eb67e4ef098",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "yet kept it unpublished,",
      "exact_native_cache_key": "6083b0674cf64ede3e40f74c800ede430d6f8321.pkl",
      "cache_input_text_sha256": "b8c9bcc144a0fb942106252f50509871c45f0f65b7ebab123a52bb010bc0b877",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "cautiously amassing evidence.",
      "exact_native_cache_key": "055508d2ad364d81de37198739bc39e0a512510e.pkl",
      "cache_input_text_sha256": "f9f050fbc86921535097fe84f6b297058f79239cb629bb3ff97d10dcb2217ef4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "In February 1858,",
      "exact_native_cache_key": "d33c108489102869a24c5cd5372dfd3b32aa6e86.pkl",
      "cache_input_text_sha256": "9f067e111580304e91f4f755330fd3e663db2a2570c98ccf8d7e45d7a46fcff3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "two decades after Darwin's first insight,",
      "exact_native_cache_key": "785a8cfad4802cf985e99086ef5f331cb178a6c1.pkl",
      "cache_input_text_sha256": "fdc25047407a21ee5f20d25d21b5b3a699f0e192df767e40b41e85b36cdb5882",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "Alfred Russel Wallace,",
      "exact_native_cache_key": "038dc9d831ac64fbef781e37d74946ca74d7d845.pkl",
      "cache_input_text_sha256": "be8d1bd43144cc9f776c14d99f0204483facc59fcba7bcbcfe63d4b32627986e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 4,
      "source_slice": "a naturalist afflicted by fever in the Malay Archipelago,",
      "exact_native_cache_key": "459e83beaf10f680b8d64b410b6b18150b195cda.pkl",
      "cache_input_text_sha256": "d719a16472373cc07edfdb59779c535381488876e9607053ac60ccc011ecb85d",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 5,
      "source_slice": "independently conceived the same idea.",
      "exact_native_cache_key": "23401f936d30af13810caf0c98520cc5d09f3fca.pkl",
      "cache_input_text_sha256": "ee97f672a230006bf651fe99ffa79ee54e60966e177b13c01877f32f50f58da0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Its argument paralleled Darwin's own almost precisely;",
      "exact_native_cache_key": "ed575bba87fa0f9e6fea31a145b0389aa99f6f56.pkl",
      "cache_input_text_sha256": "0045bcb8416f859914c00bbef27be45dec58f6884d7d75a116b0647e5e17b5aa",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "he told Charles Lyell he had never seen a more remarkable coincidence.",
      "exact_native_cache_key": "f25862968f6776af876eb5bdd7c36cce54be0166.pkl",
      "cache_input_text_sha256": "a33707b4820f3176b67f0496f27de4f2abc4bd05adc30b3faf1c61318c58282c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Lyell and the botanist Joseph Hooker arranged for both papers to be read simultaneously at the Linnean Society,",
      "exact_native_cache_key": "3c251e391d3cd88b1159f0a2850e7f2e540d3e36.pkl",
      "cache_input_text_sha256": "a5455f4d6c007d4c79e4594d7390f5eaacc0a18203077a8997a99307ea46f1f1",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "a scientific institution in London,",
      "exact_native_cache_key": "6769854e25c7003bc7878ca1beb0e14b680b0b5e.pkl",
      "cache_input_text_sha256": "2c10622de2cade9f825ccf0682bb6d6d2dfda3e460d2f6ea1cc885854bcef8b7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "on 1 July 1858.",
      "exact_native_cache_key": "30f7f08d211a4fef768f08cb1be89ca236fa9aa1.pkl",
      "cache_input_text_sha256": "07c60ae90cfcc5c89bea7075a05c37d78c9798875dde797d422e5b00e6ac05cd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Wallace was abroad,",
      "exact_native_cache_key": "6e4580990ee6932185b6e001deb8739c0756b97e.pkl",
      "cache_input_text_sha256": "59269225e53f512b02582460c9dd7ae3779f332c80e4e15a109cfea81db4c17d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "and Darwin was grieving:",
      "exact_native_cache_key": "6d37e86e2bec95a210c785efec149825a8e758a3.pkl",
      "cache_input_text_sha256": "cc4e80c07535f4bf8ae2e89888c973e953ad0294a027fe9e7f348f51f6c8b041",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "scarlet fever had killed his infant son on 28 June.",
      "exact_native_cache_key": "3d9141c90991c72da903eaf10350406be3bfaa30.pkl",
      "cache_input_text_sha256": "a3569b5162a1a43ab055da8785d106407e93d424783b2c510e9634d52ad55b3f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "The compromise,",
      "exact_native_cache_key": "5c3483749d6d4889dcf64a567b9756e2c56e8d51.pkl",
      "cache_input_text_sha256": "4a0cf7014816e121db4f1d6b47ca7ed291b4fa3c7e823cc06269fadea2e88d6d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "struck without Wallace,",
      "exact_native_cache_key": "95e110c8fa041a5f6b5ad2fffab74562f6ac7c0f.pkl",
      "cache_input_text_sha256": "2621ed6fed6271f7a2bf5cf511f6ba312bcd490d964fc80163ddadf3019f8a84",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "may have kept rivalry over precedence at bay.",
      "exact_native_cache_key": "4000c58be94d086b49a4be62b14002b1b1d726e5.pkl",
      "cache_input_text_sha256": "417ce2ca979380998267f0225a654d4bcae84d4df7eba27e0bed5c655373ed9f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "The sensation came on 24 November 1859 with Darwin's treatise,",
      "exact_native_cache_key": "133c809bf14c270689f7b4b8651485e63351f503.pkl",
      "cache_input_text_sha256": "490369ae092677181895bdf2c20fc6941bed3f3185a40d33f94853320973b250",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "On the Origin of Species:",
      "exact_native_cache_key": "edad3a03faf8448ec146c3394128127437f89b54.pkl",
      "cache_input_text_sha256": "029a7798827334646b28ba1b41cd64106e956e09ff1704a435c97f322df2b9b2",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "booksellers had subscribed for every copy of its first impression,",
      "exact_native_cache_key": "af1e3eec59360c1e2843e3898003af39febbbc21.pkl",
      "cache_input_text_sha256": "3a173a4348bdd97687c9e75616f55f28515175f283bfebf9dd660334135dc093",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "1,250 in all.",
      "exact_native_cache_key": "d614330695b21d60a43117d3e93fb74fc04832f2.pkl",
      "cache_input_text_sha256": "b0a1b7626d9cd11a2c44ebce902f82cda9bd22a9c719652ec80e424ba691172a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Wallace had readily signified his acceptance in October 1858,",
      "exact_native_cache_key": "5bb9d0352c0ae95d5a4dc0b89220480378b2740c.pkl",
      "cache_input_text_sha256": "1243cd6116ca20fc31bb7b63ef9c878158a013b2a86e3945fe1134a210918fad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "assuring Hooker in a cordial letter of his satisfaction with the arrangement.",
      "exact_native_cache_key": "1ad0bcebd2a036a6b833e0de7c2efa61591dada2.pkl",
      "cache_input_text_sha256": "22f5f54c6ae43a305b7bdc3a1c61f10f51b0fbaf37348c51d9a484d0b14ccfcd",
      "cache_input_is_phonemes": false,
