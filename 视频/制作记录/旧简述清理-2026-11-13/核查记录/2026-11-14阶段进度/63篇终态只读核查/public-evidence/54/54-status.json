        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 2,
        "source_slice": "blaming the sunsets on moisture at high altitude or cosmic dust.",
        "exact_native_cache_key": "0cdd7fe89413b04779e49976a87829757b8d0d98.pkl",
        "cache_input_text_sha256": "df4f8bd909c9636cb823594ac1c77ec7a8be6b63b89f0e99d0c37e8a10355157",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "In February 1884,",
        "exact_native_cache_key": "0e964651299231ce36fba3aa2ea49a0965413a4a.pkl",
        "cache_input_text_sha256": "abcb5962498219ec7438795cf00a9b4449c980252886b0f8069cd87b40a83835",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "Britain's Royal Society appealed in The Times for dated observations,",
        "exact_native_cache_key": "0a9e2a0b6b48f2e6c8e3e7962efa50527bf44046.pkl",
        "cache_input_text_sha256": "26f55140859e525c48d99c6785cba99b26b69d9bc0380679e9bc964c5d75da1e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 3,
        "source_slice": "eliciting worldwide replies;",
        "exact_native_cache_key": "a6249c6baf12d6ea382c18834989fc467ab54dfa.pkl",
        "cache_input_text_sha256": "f6203ce51ff048ce7c4b411157608d9bff557208d47d81810822a3ad1dbf42b4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 4,
        "source_slice": "the Society's 1888 report tied the glow to Krakatoa.",
        "exact_native_cache_key": "8ecf9544caecd89938c4adbe1891af22091b88d3.pkl",
        "cache_input_text_sha256": "fe4cf086db3f7ae23b7f0c5b1d21890797d03b2b7a2ce03395593decabfae871",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S16",
        "piece": 1,
        "source_slice": "Through barometers,",
        "exact_native_cache_key": "36f1d5747c25547a931eba2fafef84304816cab0.pkl",
        "cache_input_text_sha256": "1cb0cb2ea34b0146b3e569f5a89911a4b4a98d7dde696a89e43c4e8217068649",
