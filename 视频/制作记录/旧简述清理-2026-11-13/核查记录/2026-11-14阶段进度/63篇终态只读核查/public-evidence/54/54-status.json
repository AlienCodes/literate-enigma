        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 1,
        "source_slice": "Some experts discounted the volcanic explanation,",
        "exact_native_cache_key": "b35aed821498e73e336df4dad274b1f8173cd02f.pkl",
