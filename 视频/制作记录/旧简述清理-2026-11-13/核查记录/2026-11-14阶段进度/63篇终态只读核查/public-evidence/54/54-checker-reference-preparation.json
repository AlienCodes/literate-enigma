    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "Shortly after ten in the morning on 27 August 1883,",
      "exact_native_cache_key": "eb6f333c2b994001115f367bfd2cb3a4920fc857.pkl",
      "cache_input_text_sha256": "8b27a2544d288807fd3907d838ce9d356ba7964dad5d2b3851ab1c808c2f2c8e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "Krakatoa,",
      "exact_native_cache_key": "75ead62102f09f8bc97e29263813c9dc2fc6fcaa.pkl",
      "cache_input_text_sha256": "99dafcf8f5bce4fef8549a9a800028e789288721b608ca0b67ebe683659af23a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "a volcanic island in the Sunda Strait,",
      "exact_native_cache_key": "8dc7f031561cf9a27fb70acbe964eaafab9273d5.pkl",
      "cache_input_text_sha256": "7bf1335f3fbc6f6386119e648da0f183c9979b84b008ee357e3c75cc6e13bf8e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 4,
      "source_slice": "unleashed its most thunderous explosion.",
      "exact_native_cache_key": "4a612d30ea8a6264247c63b51474ec3f57c4b934.pkl",
      "cache_input_text_sha256": "3d46e1e01d63a759121bc849e93e948350a1edf6cca6c831c8226feee6a22eda",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "About four hours later,",
      "exact_native_cache_key": "12a2583383d96e2d3d84959653d6e3a23fa770ed.pkl",
      "cache_input_text_sha256": "db4d22320ca4de6819646486e2e93bd84927607de0f7343bc02d1815b079bbaa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "islanders on Rodrigues,",
      "exact_native_cache_key": "7c02c0cb77e094ce36ce2cea969c13457dcbffa1.pkl",
      "cache_input_text_sha256": "945f3ee0eccd79bf919653a4c933e721d4559b098437bcefa4543c53e4657785",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "nearly 4,800 kilometres across the Indian Ocean,",
      "exact_native_cache_key": "7ef3c218204fd4074e40a0884e7a63fd47fb8d51.pkl",
      "cache_input_text_sha256": "5c590f850b233899c33b713a098827f0fd293ff97d0dd4e3b12d8a6851492a95",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "took the roar for distant gunfire.",
      "exact_native_cache_key": "0a3851f855a1654f8b45592559f47896b630c3e3.pkl",
      "cache_input_text_sha256": "ec5ac0df84b90557537a63dfd446094de6776440633966a0328dca49fd7b2ad5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Barometers worldwide recorded the atmospheric pressure wave,",
      "exact_native_cache_key": "80d4742ad91e1974580854180dd757b9d00a3565.pkl",
      "cache_input_text_sha256": "fac41735f331346aeb4531d3991ffdb4af65f32e560171acacfae41959668d22",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "some of them seven times in about five days.",
      "exact_native_cache_key": "a5d546fd15f1e24bb0b0d02b2f1ed71f8ec29a02.pkl",
      "cache_input_text_sha256": "0a520fdea607b8ead58a080adb4f7f8d9d00563a947c634a6ea35b80a3853806",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Restless since 20 May,",
      "exact_native_cache_key": "0c483510198d97847a40a2f62e52dc48f416d251.pkl",
      "cache_input_text_sha256": "21b669da3b2489b01086c6f61680b32f8d724f85b995f270a68d87419fa1f534",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "the volcano reached a catastrophic climax on 26–27 August.",
      "exact_native_cache_key": "4cf5a4d62ee800b61155d7c311a52b28445c068f.pkl",
      "cache_input_text_sha256": "d6fc451f80eb72ea0057d6c804be51e87670a1da60253a1b996eee2bb61ca2c6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "About two-thirds of the island collapsed into its emptied magma chamber,",
      "exact_native_cache_key": "5090ad9555c1d18c799a57a34b7520c1c22261b8.pkl",
      "cache_input_text_sha256": "30a876550b92884fedb8226122415952db45b39c11233b9c22cc94b69b9df4a7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "vanishing beneath the sea.",
      "exact_native_cache_key": "705ddc30511ef51caaaf08ae935b58a492647040.pkl",
      "cache_input_text_sha256": "a1d597076bd102fb6c31dd3c0b0e222dc5cdf2d70c73c5d560fcaafe17ac9955",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Tsunamis,",
      "exact_native_cache_key": "ed2905f554144e2fde21142bcc1b100655e1079d.pkl",
      "cache_input_text_sha256": "a0ee339a0271c7256eb6ddce995931adabc89741f7fdf415b336685455a55ab6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "reportedly over 30 metres high in places,",
      "exact_native_cache_key": "e2bc33f6321718ac0f5ce1c37ecaccccc9e01307.pkl",
      "cache_input_text_sha256": "fa1936952003487e7913de23fcf5c6a564b1af6f8b85b5b99fbd7f800bfa6ad3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "swamped coastal settlements on Java and Sumatra.",
      "exact_native_cache_key": "c296869c08e7971bad6a93a111d702b7e72c51b7.pkl",
      "cache_input_text_sha256": "9491722958416ae790bbd61b03d597c88c3ec54c6d48afac75ee95c90821458f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "Dutch colonial administrators counted 36,417 dead,",
      "exact_native_cache_key": "627fc669d525e8acfde75182aa959f5e3b25e88e.pkl",
      "cache_input_text_sha256": "9f4efe779772b749f9e47b05f026f7df2cd3f5cb1212886e171eabc58aba7016",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "mostly drowned,",
      "exact_native_cache_key": "7cecb168d76b22b709d8d1a5b09034a3cd950c5d.pkl",
      "cache_input_text_sha256": "4ebe16c0c530aefa5c1a08fe4acad2fe5489616ed21ccda5861fdc4e81be519e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "perhaps underestimating the toll.",
      "exact_native_cache_key": "7da007b111942821c3eda703ade02332fcff7fb3.pkl",
      "cache_input_text_sha256": "3bb3296391e5126e285316a473e8647ea10e89a2291313a270aee30988ff04ed",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Telegrams from Batavia (now Jakarta),",
      "exact_native_cache_key": "7d114855cb65ca883b8fd2da70adeccf743d8762.pkl",
      "cache_input_text_sha256": "82a8e3c4fc6ccc14396430ef8556f9c9f8444010d64f357a97d62c2ded653440",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "relayed by submarine cable,",
      "exact_native_cache_key": "2e6008fb64b78e3b77e378ba07b405a510fd860e.pkl",
      "cache_input_text_sha256": "9c764ca0e8509fe173437e76d6b0f70e4e656a5648adb3140dc240d75f9fae8c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "reached London within hours.",
      "exact_native_cache_key": "cc834d0478d7e4985203194d06f595426a9c422c.pkl",
      "cache_input_text_sha256": "11bba11e2339f464062963c7e13ca2e9801e596d1cf1cc12698eb33b83b26da0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Yet early dispatches were terse;",
      "exact_native_cache_key": "1e1d0c9c221507df92741e0a6d2c378805c5f656.pkl",
      "cache_input_text_sha256": "639ba0701e4e0db2e8e2bd18c02d10c002fca5e2f1fe0367763d9e807aea4734",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "the magnitude of the devastation emerged piecemeal over days.",
      "exact_native_cache_key": "4c170e9240c93f3b47d1739e99589bcdca168267.pkl",
      "cache_input_text_sha256": "2f264c07b24edbbeed0bbc41407123eaccdc352da901edf4f3e6ddd3c5a22ed1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Ash and sulphur dioxide,",
      "exact_native_cache_key": "9f101767081dd130fb950446ddef8afe5d9445b4.pkl",
      "cache_input_text_sha256": "430ba9e47725d835d5600e02252fb277529e3898f5e6f1b9bf119dd13ad8e5f1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "hurled tens of kilometres high,",
      "exact_native_cache_key": "c45719cb52cb5bcef3bf2b33261c9b3182b661b7.pkl",
      "cache_input_text_sha256": "fb18009049856c5b35ef4193799a63e6350c1205b57321df3d3a04c9044949de",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "formed a haze that circled the equator in about two weeks.",
      "exact_native_cache_key": "eb5db85fd87d011ffa8d6cdcb340f899d4eb2c5a.pkl",
      "cache_input_text_sha256": "0679d5a0b6961e868a620fc5a298686d1a01214a1fcf2d9844b1a607ac185550",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "In November 1883,",
      "exact_native_cache_key": "6dba617ad682c91581912a7aa930ba52e83b29a9.pkl",
      "cache_input_text_sha256": "eff0ff5ef1dd0277990c4c52d9bc44e2c3b037bd5fbd78a5dd92c0f0a6124a46",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "crimson sunsets glowed over Europe and North America,",
      "exact_native_cache_key": "7fb35643928beb6411017b5478e3b763d3153511.pkl",
      "cache_input_text_sha256": "8c45d1bc7d7d91ba9a0c3b4e410e4c39b9b6060a9cab1ae88bda0845d0405a51",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "summoning firefighters in New York and Connecticut to phantom blazes.",
      "exact_native_cache_key": "395341d4da9d6e7b341bf1d1526aac2f4637e9ba.pkl",
      "cache_input_text_sha256": "2236f7f96bdd5c95d0bf0579060137fab04b6cfbf452b1ea1bc8d96b0bb55d60",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Some experts discounted the volcanic explanation,",
      "exact_native_cache_key": "b35aed821498e73e336df4dad274b1f8173cd02f.pkl",
      "cache_input_text_sha256": "a2c40d6c49fd43a1df7b9ab5a855b3586e5cfdb87868f1bddd711756e79433ab",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "blaming the sunsets on moisture at high altitude or cosmic dust.",
      "exact_native_cache_key": "0cdd7fe89413b04779e49976a87829757b8d0d98.pkl",
      "cache_input_text_sha256": "df4f8bd909c9636cb823594ac1c77ec7a8be6b63b89f0e99d0c37e8a10355157",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "In February 1884,",
      "exact_native_cache_key": "0e964651299231ce36fba3aa2ea49a0965413a4a.pkl",
      "cache_input_text_sha256": "abcb5962498219ec7438795cf00a9b4449c980252886b0f8069cd87b40a83835",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "Britain's Royal Society appealed in The Times for dated observations,",
      "exact_native_cache_key": "0a9e2a0b6b48f2e6c8e3e7962efa50527bf44046.pkl",
      "cache_input_text_sha256": "26f55140859e525c48d99c6785cba99b26b69d9bc0380679e9bc964c5d75da1e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "eliciting worldwide replies;",
      "exact_native_cache_key": "a6249c6baf12d6ea382c18834989fc467ab54dfa.pkl",
      "cache_input_text_sha256": "f6203ce51ff048ce7c4b411157608d9bff557208d47d81810822a3ad1dbf42b4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 4,
      "source_slice": "the Society's 1888 report tied the glow to Krakatoa.",
      "exact_native_cache_key": "8ecf9544caecd89938c4adbe1891af22091b88d3.pkl",
      "cache_input_text_sha256": "fe4cf086db3f7ae23b7f0c5b1d21890797d03b2b7a2ce03395593decabfae871",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "Through barometers,",
      "exact_native_cache_key": "36f1d5747c25547a931eba2fafef84304816cab0.pkl",
      "cache_input_text_sha256": "1cb0cb2ea34b0146b3e569f5a89911a4b4a98d7dde696a89e43c4e8217068649",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "cables,",
      "exact_native_cache_key": "bb48e5db657480ab961a01edab5400e18bd34e0d.pkl",
      "cache_input_text_sha256": "f8cb627812af78458b6953be12c5d8f9eb092c3e62af6b51195fdc2d5b50cbda",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 3,
      "source_slice": "and crimson skies,",
      "exact_native_cache_key": "701be60850b0de58b495c350be9a8c12f54e6710.pkl",
      "cache_input_text_sha256": "1958b88447f579e4f567973884182a4ef54900a5da7f1f361b1889fb3acf1b81",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 4,
      "source_slice": "far-flung observers began to glimpse how interconnected the planet already was.",
      "exact_native_cache_key": "dd3e745c593a96df9154a6ce21790f6b96e824fc.pkl",
      "cache_input_text_sha256": "4b73618fd779b255e8af12b001daaa94e3932e4c1fe6cc1bcecbbadce7ef8c71",
