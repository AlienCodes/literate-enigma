  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In June 1984 Alexey Pajitnov,",
      "exact_native_cache_key": "9b2563e34563ef54a218c2c0e1f8a32623392539.pkl",
      "cache_input_text_sha256": "84ab2e71046fed22f77ec57faa0025cd06491af6d0e829b71a3fe0953dedae98",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "a 29-year-old Moscow coder,",
      "exact_native_cache_key": "729d1e426b1b1cf6ab7a2cc3c080fc572fe1bb6a.pkl",
      "cache_input_text_sha256": "b844a603413f0aee90ae8cbbf168200cde72adb62a078438417e025b45a1c3d9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "grew engrossed in a diversion he had built.",
      "exact_native_cache_key": "2a600a3532fd9d075d4ff909e6e0cafa44d2ddc7.pkl",
      "cache_input_text_sha256": "e717addc6c48a969f760d168d6cdd70ed2a88e19a210f78b37a836fd655c96f4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "His primitive Elektronika 60 had a purely textual display,",
      "exact_native_cache_key": "cbf17cfb6ef06d96298a7ba211b0c2e4d0e9a9da.pkl",
      "cache_input_text_sha256": "a29756b22861278702893fce50a3ff25868568b6ada104b4275e58dc60d364d0",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "so every geometric piece of four tiles was assembled from characters.",
      "exact_native_cache_key": "68c72292aff45006c2723f3212c259d761d8a76e.pkl",
      "cache_input_text_sha256": "16c5f98e2e80a03aff1551a3b6b3a459c2bd0436cd646dd3a332d4e8f92caea2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "He called it Tetris,",
      "exact_native_cache_key": "4e34f45d4b46bf55c046f47ac1ca6b6b96113631.pkl",
      "cache_input_text_sha256": "ce47e7e6bc37a331808ccc7a93cd8cea29e30ef367c6c75de93759106a1e9ec3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "a fusion of the Greek tetra- and tennis,",
      "exact_native_cache_key": "fd37ab31b357f09d9221ca03b0eedac16c761c8f.pkl",
      "cache_input_text_sha256": "e7e5b47ebe2c258f4a2c0f819e9a4b51bd2ccfe95d647edf143c0c5b50996594",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "his favourite pastime.",
      "exact_native_cache_key": "9e638919db8ac0de5e443e1bef50bc5ae3433370.pkl",
      "cache_input_text_sha256": "75541b3fe386340a3d541be2b6d5bfef166a52de1cb2ef52e4e00f03f2a5b5e2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "In the Soviet Union,",
      "exact_native_cache_key": "501743a72c3c6e55514e5e2c93769cad637c2f2a.pkl",
      "cache_input_text_sha256": "02d9fc0f77f9c3cf75db503a9ab3f4ebb50572c71e5fb3780ad7df7a6bb4dd0e",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "the state,",
      "exact_native_cache_key": "ef0e5c33118a09e84cbb637b7b54ef9808b465c7.pkl",
      "cache_input_text_sha256": "3ca784835c6f487a7be5d592d8b7aad59573954be2c467fdff838214ca15ea49",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "not its salaried designer,",
      "exact_native_cache_key": "00d9eac52222ee7ff4a1d59eceba71738df165e1.pkl",
      "cache_input_text_sha256": "726c3a4298ee4f3d9a6cc9dc6e939b1f58b1a109523ac2dfdc77b5e346c92117",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 4,
      "source_slice": "was the proprietor of this intellectual property,",
      "exact_native_cache_key": "ca565ad0ea1eb16337c0cd95fdccb421125223a6.pkl",
      "cache_input_text_sha256": "678aa5e11c1585680bfed751c95abf01768ca003c959ea51a8d629ad01e731e0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 5,
      "source_slice": "and Pajitnov held no entitlement to it.",
      "exact_native_cache_key": "a961c830b4b57315a95ffa4495f65666c9be9838.pkl",
      "cache_input_text_sha256": "1fcc7482ec31c48b5313555e005f727f01457248342a61477d60cd5f9b7f100a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "In 1986 Robert Stein,",
      "exact_native_cache_key": "509ff1f1faaf507755c09094703fce05ccf51833.pkl",
      "cache_input_text_sha256": "e8c9be0e26231948068c9a97b5dbd87abb20d7fbdeecb86c405b087dd104bc02",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "an enterprising British software vendor,",
      "exact_native_cache_key": "c18857ae335bbca054444747577711091421151d.pkl",
      "cache_input_text_sha256": "913f0b0aa88a33cf7e3ee390e6f19976034e62c1d0cfd0d341c198764a4b36a8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "stumbled upon Tetris in Hungary.",
      "exact_native_cache_key": "b8cb77245fe565ef00f19fb5f2bcf693884b3e2e.pkl",
      "cache_input_text_sha256": "563f93aee1123fe960bc72df9fdf7673abf98595fb7d0cc1ca655307d4c8f5cd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "In his ignorance of Elorg,",
      "exact_native_cache_key": "7f740de9bd55ea45437926029ab9c05413f66a4a.pkl",
      "cache_input_text_sha256": "8c7d0f71f397caba74ddabb7ebdcfda8351ea7fddc2ae4832b9975d4908a0eb0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "the state bureau regulating Soviet software exports,",
      "exact_native_cache_key": "126ba7c0cd3c21858205663ed6928bba877da3a2.pkl",
      "cache_input_text_sha256": "2b911ab018ebf2f651ddc93f7375effc547805f60531de94b486dfbe5140ff53",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "he hastily hawked rights he did not yet legitimately hold.",
      "exact_native_cache_key": "807fcc73ec9316f0da0109b7eefa28e70c1948d1.pkl",
      "cache_input_text_sha256": "92b81f33612a52b9acfaa54c4bded049b46466c7cf706517589e18451ae34203",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "The rights were shuffled onward through a chaotic muddle of overlapping deals among Western firms,",
      "exact_native_cache_key": "ea4aafd6eb65dd30567a265477931dc0a4b22000.pkl",
      "cache_input_text_sha256": "fc32d73550493a3d1a14ed1f2d9016f49076b42c8ef6d5b1ebcbddd98f6d0dfc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "one owned by the magnate Robert Maxwell.",
      "exact_native_cache_key": "2dfcf701ba1a293524d4d39b99ff60941ee1b0b4.pkl",
      "cache_input_text_sha256": "a45477a25c2e50499dc438d3f9076bf7e447ad069df9be6a75504b1c748ff0aa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "In February 1989 Henk Rogers,",
      "exact_native_cache_key": "90f761a5108bc6ea8e092753e5ccdbe9e8f0ed29.pkl",
      "cache_input_text_sha256": "56a9d6c5877e63a64c1b9fbef154f80a26e8ff62425485fe33118416431143d9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "a resourceful Dutch-born publisher,",
      "exact_native_cache_key": "cc98b67aaaa200d4b960950df34d95cc877c2cf3.pkl",
      "cache_input_text_sha256": "0134e313f89c14d789a67d24fb8631ee80d00406f4fa630bdefa4052d0b13fcc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "reached Moscow on a tourist visa and found his way to Elorg.",
      "exact_native_cache_key": "2eb4f27dd178523d24f32b9586ecb93dce0a74a1.pkl",
      "cache_input_text_sha256": "df3dafd1e9692864d522e6b122e6765b3d0bfdc3693250c7d1115828f9dc2b2f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Stein and Kevin Maxwell,",
      "exact_native_cache_key": "833129868c53a39095b2443533a4ffaa27ea3cd0.pkl",
      "cache_input_text_sha256": "ecb46dea8c4ad122e9c9be0f4929ce0e3eaf62054fcbc02425f765d3186ab584",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "the magnate's son,",
      "exact_native_cache_key": "eade0494d5b5a68b06fcc35ac107311eab03ad21.pkl",
      "cache_input_text_sha256": "4b62c9e99afc5b87e83aca15ee469b63e0da818fa5e3ee5c6fe830b7740cb6e4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "were in Moscow that same hectic week of negotiations,",
      "exact_native_cache_key": "da071c53875855644e5d62d79230caec44a658ce.pkl",
      "cache_input_text_sha256": "04695997f08c833b5d1b50ba1cf50cbb63d138c29137a6a3d8ca79c2d26f88de",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 4,
      "source_slice": "each a bidder.",
      "exact_native_cache_key": "39d678d5131718bff357a56cba3ce363c9d1339c.pkl",
      "cache_input_text_sha256": "aeeee0770aeb2eaf4b1d9188f092a4b10583840d9d50922894dc2f95d260ac0e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "Pajitnov felt a fondness for Rogers,",
      "exact_native_cache_key": "ff3280971d6e590d1dd26bbe17d0ec799c9b047a.pkl",
      "cache_input_text_sha256": "42f06d1f586b89a1bd4a501d83d8ed5aefbadb9ac52833117204e86d2bc344b9",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "and Nintendo scooped the handheld rights,",
      "exact_native_cache_key": "32abffc49ed3db76333dc45b03940ac8966d4b8b.pkl",
      "cache_input_text_sha256": "4b96489491628a62bda2d5cf7ff4d86f86ece1cec7869f1764ab65538ad321f0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "then worldwide console rights.",
      "exact_native_cache_key": "0f2178d7524cd9e51753acf8a3d357c633293511.pkl",
      "cache_input_text_sha256": "2fb7ae3b847d2eaff5630fa906ca81e2a29c8511f91e65744bc573cbbcf19521",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Nintendo bundled Tetris with its pocket-sized Game Boy,",
      "exact_native_cache_key": "a9235b02bd65f7ff86f0a053124e406d6e938d74.pkl",
      "cache_input_text_sha256": "8f2a80cc8d4f27e7ebc1cc5496a30d1a563980dda273cc4c7e5dbc0d8d7c315f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "and that version shipped over 35 million copies.",
      "exact_native_cache_key": "3b182684f7b94e4466e884380bbd31aa94098b61.pkl",
      "cache_input_text_sha256": "b50cce3d8d3243309133b691e8ba7fafb475c21b5b41edc5c0a384340d1672e2",
      "cache_input_is_phonemes": false,
