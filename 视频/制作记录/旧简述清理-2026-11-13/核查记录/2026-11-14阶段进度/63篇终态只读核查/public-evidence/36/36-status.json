        "source_slice": "streamlined,",
        "exact_native_cache_key": "379d95498bb88eefe8ccae3c756c6b93d8ce86c0.pkl",
        "cache_input_text_sha256": "06ac6ee4089c22083455955ac62f07f6b227434661089af81ea8270fbb4db9be",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
