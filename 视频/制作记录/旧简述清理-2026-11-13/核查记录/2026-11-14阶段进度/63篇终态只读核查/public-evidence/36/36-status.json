        "cache_input_text_sha256": "9198bc461952970f9ce5e8423f0007d2ba72787dd4f6c1e12b6294b181b95640",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "Technical staffers were appreciative of the camera,",
        "exact_native_cache_key": "922d0cbd6d44b028d5aa3f3cc7bfe923bb131a0b.pkl",
        "cache_input_text_sha256": "b9f55690a35614665d89c5f9b90a41f9a187016b0ec3e4002b733620befc6036",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "but it needed no film.",
        "exact_native_cache_key": "37f234b9f02407df41c697f734d915d08f1bc361.pkl",
        "cache_input_text_sha256": "723355c4db6549efa256e26e68909850b3ce7929009d41e19987d10d00ea3352",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "By Sasson's recollection,",
        "exact_native_cache_key": "d9dea0468a6d1c7dc840577c4ddfa29fd776cac6.pkl",
        "cache_input_text_sha256": "b4c3e584065a9e3d99b2cdf0b957e38b28c0aaac49cfaca68c271787e24bd185",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "his superiors at headquarters called it cute and urged him to keep it hushed.",
        "exact_native_cache_key": "cf0acb19ce3225d7d4253197163029997daedf63.pkl",
        "cache_input_text_sha256": "c8d509c127255c5bb4ceb7e9a26b42e6574f44631e7617a6d9c55cdfe72adf75",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "In June 2009 Kodak said it would stop making Kodachrome,",
        "exact_native_cache_key": "87c8bf1615d9b990f5382ac0c2d9bbd822375918.pkl",
        "cache_input_text_sha256": "759766dff0a360776c4c9e0fdd5ed6534020a52b0991aa50092ecba84fd9f042",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "its analogue film,",
        "exact_native_cache_key": "208876489f01d86f0ae78fe161c6430ec07fca30.pkl",
        "cache_input_text_sha256": "05b746ebd29c04efb71c3469d4ca9112be96f9203ca52e99c6d7cc60d607a67c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 3,
        "source_slice": "citing lessened demand in the digital era.",
        "exact_native_cache_key": "012c7583923ae78887c07c9c57e5f49995ebdd70.pkl",
        "cache_input_text_sha256": "d481425b98824b7c3442b41ca493216b1650053b21092adc3731088c9a03cea3",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "By 2012,",
        "exact_native_cache_key": "5590097de586c490deb55adb7a8b7f15c1ff4414.pkl",
        "cache_input_text_sha256": "b4556c304d0d2d7af08f281f1d726434e6f1c1c167761912de3f748fb14eb636",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "layoffs since 2003 had slashed 47,000 jobs,",
        "exact_native_cache_key": "c4e7f6854c55eef29a81a4d0ecbbbe2c5cd0fe08.pkl",
        "cache_input_text_sha256": "893523c1af1a7bfb615b5d9c7454a88d334ead149824d854008a6aefcb2854f8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 3,
        "source_slice": "alongside the shutdown of 13 factories and some 130 labs.",
        "exact_native_cache_key": "01417e1f18c73fe0fa7cb4884f6dc4051abcdb4c.pkl",
        "cache_input_text_sha256": "c2485b006a4abf6885231f14c941c83c98fab3071651f7150129513113e7da86",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 1,
        "source_slice": "On 19 January 2012 the 131-year-old firm sought Chapter 11 protection from its creditors,",
        "exact_native_cache_key": "19f6c4ba41fa3f2592beb9eecf10a21695bf8c77.pkl",
        "cache_input_text_sha256": "8fdcb8e61344fb7738ec495e09bb9a908a7708b5554075a16fad882ad9b88192",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 2,
        "source_slice": "sapped by pension costs and years of slowness in going digital.",
        "exact_native_cache_key": "89a7e70e7066b3be585861d10ec86d042657a154.pkl",
        "cache_input_text_sha256": "79d2f8ac8d48b591d2c340dd2401d6e286c92d903eaa73709f160ad30d22d9f1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "Citigroup,",
        "exact_native_cache_key": "bc322ee4a554ad0b7b983b997394881b8eb541f0.pkl",
        "cache_input_text_sha256": "0008c95e3add01a8359ca8e892182ee1cea40e00ec2398a32d61b395b10ce681",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "a lender,",
        "exact_native_cache_key": "383342c9ac6ffe1a621b1805cfe662cb7cefb3cc.pkl",
        "cache_input_text_sha256": "a4ed8d688c44619993dab6f83242b913850ab927797c500fcc6a00dc659e72b2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 3,
        "source_slice": "provided $950 million for its restructuring.",
        "exact_native_cache_key": "3849bd42fc38976fe7c207a0e78ec441ec263f14.pkl",
        "cache_input_text_sha256": "0dc1057c6cb989cbab76fe75d862f14bb85f540acdfdfaa0fa53e2adf51b84ce",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S16",
        "piece": 1,
        "source_slice": "A portfolio of 1,100 digital imaging patents fetched about $525 million from a consortium of twelve buyers,",
        "exact_native_cache_key": "431cead86b44354956da073de33cde14db3c73af.pkl",
        "cache_input_text_sha256": "0c30eaecc8aa7575be2c48bab54cd00184a9fc5457eee2df262a34892e9282a9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S16",
        "piece": 2,
        "source_slice": "including the giants Apple and Google.",
        "exact_native_cache_key": "2b95a23fd53968914497bf066daddf370e3c24ac.pkl",
        "cache_input_text_sha256": "0a6caf96babc665377b640b55cd9bcdecb8ad3d28d4f90efba89d552d530dcd1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "After 19 months of reorganisation,",
        "exact_native_cache_key": "a1bf3e532b7b5cb1d9bb003a6be4e391735cce2a.pkl",
        "cache_input_text_sha256": "deaa4e81a69cdfe4871df39880ce2d4e483809b949d5f2a71f2a89e391e36f9a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "the once-mighty Kodak left bankruptcy in September 2013,",
        "exact_native_cache_key": "66481e42a1cb4502e24acf2ec630b2f6f6216118.pkl",
