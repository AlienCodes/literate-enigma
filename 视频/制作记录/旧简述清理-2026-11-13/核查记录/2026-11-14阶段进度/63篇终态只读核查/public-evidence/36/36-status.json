        "cache_input_text_sha256": "5a60658aa1e528276f7f575fc4b7f89eafebdd7d72f826d81c2bdb94003d8254",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "and a playback unit showed it on a television.",
        "exact_native_cache_key": "54785fed306dd47c7ecda10ea27e8d18b579646e.pkl",
        "cache_input_text_sha256": "79b9de9b67dff546524500176a37c669c1d876de52656675da5f0a0ab14224bc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "Kodak's revenues showed its dependence on film,",
        "exact_native_cache_key": "7540bb5983acb17c17a23894e2af8c1a0e913688.pkl",
        "cache_input_text_sha256": "2580249e6db94ed8a645e5b2cb4cfcc86673f49fbe4f6c130e16fced6aade36e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "the profitable pillar of its business.",
