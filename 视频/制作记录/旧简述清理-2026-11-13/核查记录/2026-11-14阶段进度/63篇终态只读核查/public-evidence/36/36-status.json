        "source_slice": "and refocused as a commercial printer for business clients.",
        "exact_native_cache_key": "365e592eef37ced1c72df72c2b198d91d002db05.pkl",
        "cache_input_text_sha256": "845ee5bb18acb3ebf3683953822ff2664e3ad5f794381382839e664974d2246b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S18",
        "piece": 1,
        "source_slice": "In November 2009 President Obama had decorated Sasson with national laurels,",
        "exact_native_cache_key": "018e85657bf53c650aaccd25f77d26c91b25367f.pkl",
