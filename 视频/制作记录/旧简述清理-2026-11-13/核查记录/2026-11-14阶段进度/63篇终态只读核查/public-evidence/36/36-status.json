        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 3,
        "source_slice": "downsized,",
        "exact_native_cache_key": "9cf3d388613045d2487a559466cd6be40e734f9f.pkl",
        "cache_input_text_sha256": "722023dde623f1a3e6830f96873ed80ec701767901e88c07a8ca10d05bde5a42",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
