    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "J. Robert Oppenheimer,",
        "exact_native_cache_key": "aeef27b61adb5babd0cb22f0c0980561c99d3aa6.pkl",
        "cache_input_text_sha256": "f45c4be2fa9a0a572d85c0027c0006c885ca4d8628a8de692ddc57b959d19177",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "born in New York on 22 April 1904,",
        "exact_native_cache_key": "7953961d9bbe2dfb0a28d64d74fd011e76c525f9.pkl",
        "cache_input_text_sha256": "b6f043242f29e18e1a56684003561b50a883d3e583c3b5a560ea8742cd2c2740",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "was an accomplished physicist and prominent lecturer at Berkeley and Caltech.",
        "exact_native_cache_key": "6db7baa66baa9b9237be22916be1f5fa5053f4d3.pkl",
        "cache_input_text_sha256": "0a1a1c1bb5b6da2e01bd9ca5043e1d3148cb89f02d32cbe7d0e92177630ddfab",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "From April 1943 he oversaw a secretive weapons installation at Los Alamos,",
        "exact_native_cache_key": "66195ae6fedb59b7b3af369dd63cccdc8cd99c80.pkl",
        "cache_input_text_sha256": "5aba248f8d51035cfb2f29708b0feb729692b8778801aac69ccac4f833095578",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "whose bombs were the collaborative creation of a thousands-strong workforce.",
        "exact_native_cache_key": "e78a11f6fd868c4a50534e289d6295c402c0a471.pkl",
        "cache_input_text_sha256": "3787303a9bc7d3dce339e55351bebb3fe6a86f6a0a8a559399920b8f992fa5dc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "In the pre-dawn darkness of 16 July 1945,",
        "exact_native_cache_key": "8e4a1a77f5cc6001637135e0382399fd73e75289.pkl",
        "cache_input_text_sha256": "7531c2f8cd26ee4d7a2c05232aa18e7308e428fdf9afd920b4a974fa1195f9df",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "the first nuclear test illuminated the desolate New Mexico landscape with a blinding glare,",
        "exact_native_cache_key": "e3d72d788e88078c3fedffeca97d8e4b4ab3c1f0.pkl",
        "cache_input_text_sha256": "61f71c9224caceb8e6e5709e534bf352a00b343af6ce8ad09644367201f64946",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 3,
        "source_slice": "its explosive force roughly 20 kilotons.",
        "exact_native_cache_key": "9a93646f9dad91628ed4392f300d1fca37c6fe83.pkl",
        "cache_input_text_sha256": "8222e68f378093632124c2a3578c7d2d68e3a4105ca35cdcbaca678dd49d1170",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "On 6 and 9 August 1945 atomic bombings devastated Hiroshima and Nagasaki,",
        "exact_native_cache_key": "619f300689fcf16e8376e42441c749a3ee315c38.pkl",
        "cache_input_text_sha256": "ca7c4153f2c4cbf7b83df1364ced1e50ddafe8e05aca991921b4fd14791ded50",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "where year-end fatalities numbered well over 100,000 and about 70,000 respectively.",
        "exact_native_cache_key": "5986341d770a6e2b8d15ee5906e24d0f549f5dcb.pkl",
        "cache_input_text_sha256": "e0e8459a685655c78e5d37276e81a5ffc0db61617ad2f87f8a196849e0db1964",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "In October 1949 the advisory committee he chaired,",
        "exact_native_cache_key": "aa7bc3f8296793440287f3078f5b380ed6db81d3.pkl",
        "cache_input_text_sha256": "a5a5b11926f1cd48f34b1723d3e6d27c6871296d39e7714d2d7b1489251a8834",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "expressing misgivings,",
        "exact_native_cache_key": "98dd7f254dce0ec04cec5104762ba7c50fc47850.pkl",
        "cache_input_text_sha256": "a702b0cc01268ea17d36274e81a62925715e87512f94551105c88bcf94fccf27",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 3,
        "source_slice": "unanimously counselled against a crash programme for the hydrogen bomb,",
        "exact_native_cache_key": "463f63af59fa07c0858992c45f30fed1b122fd17.pkl",
        "cache_input_text_sha256": "e3219ffa7e3dbc25fe4426558d6aee01c7ddc66296309038f45146cb55fe495b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 4,
        "source_slice": "a vastly more destructive weapon.",
        "exact_native_cache_key": "61d4fd13ae92b0d8e755a18d3444c8b6d4a7ee84.pkl",
        "cache_input_text_sha256": "2d7378f00a621908812c0ee1c7b0bb932d1829e48e92bbde9351847a738a74d3",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "From 12 April to 6 May 1954 he was cross-examined at a security hearing,",
        "exact_native_cache_key": "fa1396368158bf6914053449fe372b00344d625e.pkl",
        "cache_input_text_sha256": "da10932e9c925e96b1c5f5c1c3ce4cbbaaeaa4a5483ed249ac147fc2fc6146e9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "an administrative proceeding,",
        "exact_native_cache_key": "c52278450251d22e98bc5f460f6474d3386daaee.pkl",
        "cache_input_text_sha256": "aa0809632e0efad56f42297a6562cae5dcfd5a06940c265847f8b4c2c4e5e28e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "not a criminal prosecution.",
        "exact_native_cache_key": "537e03c27d8284935c714c3a1ec4e00edfb734fb.pkl",
        "cache_input_text_sha256": "6c2adaca985aa91a9445d7735ed66c709d174b630a4e7eecad7b0cfc1aabfecc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "On 29 June 1954 the Atomic Energy Commission voted 4 to 1 against letting him regain his clearance,",
        "exact_native_cache_key": "245abd6c2b7bf3cadcc905c2b6a15cdf49a70183.pkl",
        "cache_input_text_sha256": "7b62b91192aff87c2509c59482921bedd9131df1023254271fc752b386ba5866",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "two days before his consultancy contract was due to expire.",
        "exact_native_cache_key": "7fa764ba06e68aeb6380e069f656f99c82affc53.pkl",
        "cache_input_text_sha256": "03fbdb546a5518e23c73dd700d8a8c055ec0b6044303832630c8bfa12076658f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "The ruling did not find him disloyal,",
        "exact_native_cache_key": "94a9f88c5a942aba7ac430afb3f99901cc1cda38.pkl",
        "cache_input_text_sha256": "d59daf193a46ea35298307f0019e02b5051d88c986208501f99b6c4efbad1e07",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "but nonetheless questioned his character and associates.",
        "exact_native_cache_key": "0b119f898b0da372b4207e12ba6a3225cac984b1.pkl",
        "cache_input_text_sha256": "69f9f0425f3c65200fed3502fccb00658efcf116259fde81d52a796e653ab108",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "On 2 December 1963 President Johnson bestowed on him the Fermi Award,",
        "exact_native_cache_key": "b6cc93c90b2c46f7895eb8cee9101c63a2b89106.pkl",
        "cache_input_text_sha256": "cbeca378c02ab7e96065a48c9bf22b6c628e3aa448e5eed11935056d2717f967",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "which Kennedy had authorised before his assassination.",
        "exact_native_cache_key": "df5912e124f736e51381c1e79dfbffee97fc7591.pkl",
        "cache_input_text_sha256": "8f69c0ad4cb3fe1481e9494b201f8cd7955b90359295e3c439b1a8be5a2a852a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "In December 2022 the energy secretary officially vacated the 1954 determination,",
        "exact_native_cache_key": "79f22c22ccb70faa4f4b7a7bec4fc8892eb088bb.pkl",
        "cache_input_text_sha256": "291c935b3f14a496b4b3309c8ff302182cde8ad5b30c15994db394339e1a16c1",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "calling the process flawed and contrary to the commission's rules.",
        "exact_native_cache_key": "c6220eade4a280b3a6d22bff77713dcd0f3fdff8.pkl",
        "cache_input_text_sha256": "e3a8dda901d191677ddf107281e1a592c3f02a1175a0651a25506c3e302de3ee",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      }
    ],
