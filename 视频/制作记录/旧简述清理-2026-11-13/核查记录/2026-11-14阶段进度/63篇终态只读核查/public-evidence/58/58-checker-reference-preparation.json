  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "Smallpox,",
      "exact_native_cache_key": "aa14315d073b97c79a30a961d5125cecfc311042.pkl",
      "cache_input_text_sha256": "cb4fbbe6488f745982de34f4659dca236c98d411ba12c6fd98c78bfb16aef80c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "a contagious affliction,",
      "exact_native_cache_key": "35d0ed4527750ace968488d2a699327096849b61.pkl",
      "cache_input_text_sha256": "68849a2cc04ba1d0a1b423b07beaa19573c1de97f861f98e9f935b932da420ef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "killed about three in ten of its sufferers and an estimated 300 million in the 20th century.",
      "exact_native_cache_key": "1685482f6b7108baf86d92db0d7db4827cdf808b.pkl",
      "cache_input_text_sha256": "26fb2046a9068f9f4313a894cfb590d017afca9b99f747f2fe5569907bb21bf9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "An early safeguard,",
      "exact_native_cache_key": "fe01fcc9fc7fe7ef54442b529148882a98c2f8c9.pkl",
      "cache_input_text_sha256": "f5e5f856b5f8d99078469bf9d1a0b27fbc37531be8f43cefadfa6e843c0dcb39",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "deliberately implanting matter from its sores in the healthy,",
      "exact_native_cache_key": "15aebe7e8947d47be69ded6f42d2809e22668137.pkl",
      "cache_input_text_sha256": "66658f93f39330dffa1b25fccfeb71fb8e5aa74d2c6dca4ff8ac4518a394a720",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "was practised in China by the 16th century and reached England in 1721.",
      "exact_native_cache_key": "cbd7f08cb16fdd56e83dd0bdb368363a651468ee.pkl",
      "cache_input_text_sha256": "3f81da59f27c207eb20f3993a1c78f8b185a0e44dc5ddcc8654c942208606b06",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "The procedure itself could cause grave sickness or death,",
      "exact_native_cache_key": "268d5029347bbce905cec521420d76da6d28ca24.pkl",
      "cache_input_text_sha256": "c4f73ba5a4afb448a00b633b0d65401820040fdae08f6ddde65c04d432c38c1b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "if less frequently than natural smallpox.",
      "exact_native_cache_key": "adb26e723c4fbdf784a0f3bf0314556021931c19.pkl",
      "cache_input_text_sha256": "e30d803f10a17476ca1d73ec5cf03de4dfa627813266a26d31682a37c57c36e4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Rustic lore held that milkmaids with cowpox,",
      "exact_native_cache_key": "066910d089dacec38f853f6ce6f03b74fb696093.pkl",
      "cache_input_text_sha256": "e3eabd9814d8a1a649f0d6b16d0627a9718bc2b3965f42418a55c54c8e80d0c9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "a mild ailment of livestock,",
      "exact_native_cache_key": "5b01cd09ef5772b14e9d5d22b039dbde46a6bc04.pkl",
      "cache_input_text_sha256": "bbfa25eebd82509c4bf363aaf21419bedf9776edbbce3872853af59dfdb30446",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "were immune to smallpox.",
      "exact_native_cache_key": "0536a6e5ece48218fa9411e8a8d88a3ac11935f0.pkl",
      "cache_input_text_sha256": "4be18713fe576bdebd1135a3b479e7747ad8f00c96fbdac2733c5ca5c34f2191",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "In 1774 Benjamin Jesty,",
      "exact_native_cache_key": "0ddd0a1e9a73c6d9a61f5ef7928e12959a5b91a1.pkl",
      "cache_input_text_sha256": "4d8f2d4f357c7fcc63926874a73572e13a7f847c147f2c5392d392d5b2ceaa0f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "a Dorset farmer,",
      "exact_native_cache_key": "28a22e5ced1e5b90af4a7cdb024dbaf5090a64ce.pkl",
      "cache_input_text_sha256": "1688a6cf775f7290ceeb7579ba17be0a92ffa6683af91dd68cc72461dd1a9484",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "employed cowpox to protect his wife and two sons.",
      "exact_native_cache_key": "5dd9f19a7c62aca97043355f5c0f4be56ac1567e.pkl",
      "cache_input_text_sha256": "d468496f1ec59d2b145bea75d5c7e65d0fd1865370259495da736e13b49a4dd1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "On 14 May 1796 Edward Jenner,",
      "exact_native_cache_key": "b9f13fd57ad1c4e4ab1cdc74d2c79db0114f1b30.pkl",
      "cache_input_text_sha256": "db95d9ae2a2c6d1c69faead3eeb7ed4b8946c68127e63071297cd7b6571f4158",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "a provincial practitioner,",
      "exact_native_cache_key": "8b802d8a078fddf64b1bc8964733d238c39406df.pkl",
      "cache_input_text_sha256": "88f08d163ef6365f41011f8227f0b4c89c8c0de13113cb0112f49cd7fe8c2637",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "inserted fluid from a milkmaid's cowpox sore into a scratch on eight-year-old James Phipps.",
      "exact_native_cache_key": "051a20ba8992350ab83f383bfdf54d5418535928.pkl",
      "cache_input_text_sha256": "7dbc10fe6885defe60a209ffd5fd9391aaf8687700f12f61db1329b46aac5b43",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "On 1 July 1796 Jenner exposed the boy to smallpox;",
      "exact_native_cache_key": "47d6f4b57b36399864b1d3b28afeeabef3b6664c.pkl",
      "cache_input_text_sha256": "a0e211a5d0d5b74cbbfe042722fc2bdeefcdd5a430399b343e94ce83ed1253f4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "no symptoms ensued.",
      "exact_native_cache_key": "8b86e3c938132caac6723b6ce84cc8bf0ac790d9.pkl",
      "cache_input_text_sha256": "131c99fdb2c13fa03082cb0865370ee2936b6fdb0ba2e87e7ec1f68288bcb726",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "In 1797 the Royal Society declined to publish his paper,",
      "exact_native_cache_key": "21ac61306cb4a683fb1153779b050400f18db313.pkl",
      "cache_input_text_sha256": "d3780869b53f264a065f8ec84fa9098a218d185dfcb3db5f55550d42b766fa85",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "judging his evidence unconvincing.",
      "exact_native_cache_key": "ae3e8ceaa1a4453499b5893c39aec0949c226b2d.pkl",
      "cache_input_text_sha256": "5fc9b9f96108fa8c5a3ff9f9b5c257a24f1f5723486a1d5bdd64ab3249859bb4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "In June 1798 he privately funded his book,",
      "exact_native_cache_key": "8396ebcb634176fbebe700ba1a055a8742c49ed8.pkl",
      "cache_input_text_sha256": "c9ff4329c5d8a4f80f2ca1d50c5878737ec02c714d9eade4e3df0ab0ece3a51f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "the Inquiry,",
      "exact_native_cache_key": "ba83dbb35d703a16f1f1051c69f0479e4bc5080a.pkl",
      "cache_input_text_sha256": "9cbe655f60fc210d13563eef1fd7f89d17c249405fa293d21dfd07dafe014599",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "with supplementary cases.",
      "exact_native_cache_key": "e4328735ddf18b17dbc843b0894c371a5bf1970d.pkl",
      "cache_input_text_sha256": "ea390ec9caeaf5c98d6f7ce18805d6427ed81f43dfea4cd0f1c46174aaeeb8f0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "The word vaccine derives from the Latin vacca,",
      "exact_native_cache_key": "6f0a856446aa785cb81983cd28ad795845933c97.pkl",
      "cache_input_text_sha256": "525350cecf30cec14577adcbfceb2ed636659b9c696e05506d00be60ca378288",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "cow.",
      "exact_native_cache_key": "a67c20b9e59a727eedaf6b7d3a3c59ab227e691c.pkl",
      "cache_input_text_sha256": "769a6dce67e575ddc317a05ab1f52ca4b85710fbcbee1294a5396c7b5aa5a571",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "His contribution was a test,",
      "exact_native_cache_key": "132fbb99878b12b437517924d5ceb6b7e18e38e8.pkl",
      "cache_input_text_sha256": "658df1a93495cce185fc318f971d1dec794077fc510b47861c6e1bf5a48b7a40",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "with results accessible in print,",
      "exact_native_cache_key": "78c9a2a1074e12d44453fcbf340ad372336f6a7e.pkl",
      "cache_input_text_sha256": "5735a5ccdd96a0ee791ebca7c915f706d997c3801939ddceeba2a7cff62b2dae",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "so other doctors could replicate and disseminate the technique.",
      "exact_native_cache_key": "50ccc70700e51e912fc2eabf867c42b5d493e662.pkl",
      "cache_input_text_sha256": "5dc2ef45cc1af8531d93d968e2a61a3d0e9a90462c9b8b682fa885d0aca974a9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "By today's standards,",
      "exact_native_cache_key": "a97e151b62f1d5eee9d988329be201cecd1f47cc.pkl",
      "cache_input_text_sha256": "5cb1ea55b7d03db17f9fa1a6804ac0831f476ce981ae7ac7853bc8d47701c42b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "experimentation on a child without informed consent would be unethical.",
      "exact_native_cache_key": "4e17a23a46cef439800542621a5b0b5f04866d3c.pkl",
      "cache_input_text_sha256": "a9ae4f9a229e3f624aeffbe2895dfe02cd632f6ff81959ea51c4f19d82713be7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Jenner died on 26 January 1823,",
      "exact_native_cache_key": "36615268a6c78c3c2ddf529a63919a186d6d3e59.pkl",
      "cache_input_text_sha256": "70a60622518753e597a3fd5cf0004163791f600934cf7395a0a0e836c4c2f168",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "with smallpox far from eliminated.",
      "exact_native_cache_key": "fa1d41fad7ffcaf4bd5ff24cd7f532b34319025b.pkl",
      "cache_input_text_sha256": "796d6a68ed8af36a9a15ae0cb7bb335e4e94ad250b4b4429869b1ffed4909b04",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "In 1967 the WHO launched an intensified,",
      "exact_native_cache_key": "4a1d60c4204ade51d6dace00f5ebdfbc17ab798f.pkl",
      "cache_input_text_sha256": "cd625fc2de47e66e1e4b4afaf864d301de865a50bfb089b25da85c8e4507b3d8",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "concerted campaign to eradicate smallpox.",
      "exact_native_cache_key": "4b49a1e1e2c824d7687caa76e4320543e125f69a.pkl",
      "cache_input_text_sha256": "ea43acc666fee4e78001fbc5be164b877090e79332b33ba84b30e36900136adf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "On 8 May 1980 the World Health Assembly formally declared the world free of smallpox,",
      "exact_native_cache_key": "6172537b3174d39d76585eeda156fe99bbddba1e.pkl",
      "cache_input_text_sha256": "eedb99338303e13c9fec44e71bf820008f76316b01e1b96bf17a821999225fbb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "the only human disease ever wiped out.",
      "exact_native_cache_key": "a07717ebc1425f7b8e9e399cdf2a12dcaea86d62.pkl",
      "cache_input_text_sha256": "4859a75de0801c5dbdae55ac6637cbd87d933dbc8c6bf4456307281e8045ddaf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    }
  ],
