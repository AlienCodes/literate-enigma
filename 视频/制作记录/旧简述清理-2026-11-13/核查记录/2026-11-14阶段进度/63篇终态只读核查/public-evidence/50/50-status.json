    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "In May 2004 Richard Thompson,",
        "exact_native_cache_key": "6fd309a30ad38b087733af36e03f966fb125ef44.pkl",
        "cache_input_text_sha256": "eedde017b10b21412fbf4edfce101f5fa3c2677144e55cfd2d1019ab64252e07",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "a marine biologist at the University of Plymouth,",
        "exact_native_cache_key": "919ca3b01d7af62ed63f9bcb782733a98236beff.pkl",
        "cache_input_text_sha256": "6cdf8bb7517fa9f10343ba27366ada6da1f3edaf86850b929a554f54afe127e1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "and colleagues described an overlooked pollutant in the journal Science.",
        "exact_native_cache_key": "51eada2598ca32e6a9fa0d5b1379f3b6bed00320.pkl",
        "cache_input_text_sha256": "3b5c2059cd290582e9dc4463ac71c76493d001887f4726306f344ea99bf6a664",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "Sifting through plankton samples kept since the 1960s,",
        "exact_native_cache_key": "cd8c1200cdebdbc048681578a8a4bd94ba080d4e.pkl",
        "cache_input_text_sha256": "1392685cc6971c90c734cf03d1b9625e9db1ee0e95000950bf5a772ffe6eb5e6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "they found that microscopic plastic fragments and synthetic fibres had grown more abundant.",
        "exact_native_cache_key": "2242a56e28dfd5319515cfc1c5207292109669e3.pkl",
        "cache_input_text_sha256": "20a91ddac31618be0e88437c8174ddf4e54cbc8b2d6d728e68c1918392d372a6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "Since then the durable debris has proved ubiquitous,",
        "exact_native_cache_key": "4b1955daa1068d769ef1abb9cc5673d858d33f08.pkl",
        "cache_input_text_sha256": "ad85856e0ba5ed98d74a85e440db0fdd8f87309d3b358c1791c05d2ca0858c49",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "turning up on shorelines,",
        "exact_native_cache_key": "ebb8d448ea202d4d76152acc4d386299e4aedfa2.pkl",
        "cache_input_text_sha256": "b743e82221ff24cd4e949b8c6a7e3d778baf229db5d2ec3cbf9b25ef3a620204",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 3,
        "source_slice": "in deep-sea sediment,",
        "exact_native_cache_key": "f25a166791890805a11d6c87bd12e2267df9931d.pkl",
        "cache_input_text_sha256": "01a6dd0879c062e009a64ab937639cc4017a3ea266ac06905601eac659851818",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 4,
        "source_slice": "in rainfall,",
        "exact_native_cache_key": "86979f28969144182af68509e0dde1f1dbbc1f4b.pkl",
        "cache_input_text_sha256": "e968375627565b2baabcda1bac7f4cd91374a4de38cc569bb7b34ec76439e8da",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 5,
        "source_slice": "and in Arctic ice.",
        "exact_native_cache_key": "9d4051b9d153f06e86805470f645698abfec034b.pkl",
        "cache_input_text_sha256": "e545c7e298293c5965544652c28792351bdbe654c324310cbf33c0b1e6927c5c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "Regulation came before proof of harm to people:",
        "exact_native_cache_key": "a6cd27bfb6bbf5cf82bcab0695a267c9d427806e.pkl",
        "cache_input_text_sha256": "ab23eb3213d7474759418eb75a93d7beb0d61890d9668a3f1ca3fc0f76878bc0",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "in December 2015 America passed a law banning plastic microbeads from scrubs and other cosmetics rinsed down drains.",
        "exact_native_cache_key": "255439db465f2ee118dd6b5138c64c29e54e98bc.pkl",
        "cache_input_text_sha256": "e72c9d74bfc829dfdc32dd4f4ffa805c2c5c7c712fdb8785a6a0ef42320bc755",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "In March 2024 a study in the New England Journal of Medicine linked plastic in the fatty plaque of neck arteries to a higher risk of heart attack,",
        "exact_native_cache_key": "96672b8f28d643d9406dd2601959fc7a5392ccc6.pkl",
        "cache_input_text_sha256": "1c2993b6675a0af169f24714c8dd159f65a4bf34d8d7b34e43f5905305420dbd",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "stroke,",
        "exact_native_cache_key": "59ed2ebca55c51c4603cafc8ef1c241b59df27ff.pkl",
        "cache_input_text_sha256": "aa71967547002610ea861a3a09f065f1a4af9e54d80940eeef3b35b64c43fbd9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "or death.",
        "exact_native_cache_key": "375c32c7994a6a36f398b92b6c7b6dc6c1819e3f.pkl",
        "cache_input_text_sha256": "185770e5e4c78dd0073332f1a038fe95789683b6ed98b492cec919cf21ee2e92",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "In June 2019 a report for WWF,",
        "exact_native_cache_key": "84e9500258c4876297e4c3b31dc08265fe218b2b.pkl",
        "cache_input_text_sha256": "e13d8b1f191805af7cedc66067bc7aca7c715a6d4a4c68abd19458b2024e5bdb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "a conservation group,",
        "exact_native_cache_key": "767a560eb2c3b96abc549368acc4cf8a04b9dd41.pkl",
        "cache_input_text_sha256": "6d7f3cf79f2af433a462f32061b1d26abfbcfca65ad22ed3ed61d79a0d924fd1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 3,
        "source_slice": "reckoned people might swallow a credit card's worth of plastic a week;",
        "exact_native_cache_key": "7592a28e43257952d986ff8071519b6622351123.pkl",
        "cache_input_text_sha256": "0e9423a2acee09457ecadd1079f84b95e42f720cd134c2d6a54eb4a7536426fb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 4,
        "source_slice": "critics call that an overestimate.",
        "exact_native_cache_key": "66c7cd9b3ea99c7dbbf02ac125ba66ed3f494bbf.pkl",
        "cache_input_text_sha256": "e0032fb7b79e8f5d512c7cd57a8faf19db802d5bfbc902941b22e94f6145a815",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "Two months later the World Health Organization was reassuring but tentative:",
        "exact_native_cache_key": "ecc84d45e9d6a655e3759646429548f4adbb19a2.pkl",
        "cache_input_text_sha256": "eb0dc0131b00d4b76ceb37066f7cba546cfd68b981456ca988f7c60623216419",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "on limited evidence,",
        "exact_native_cache_key": "01abbae77c49eecd3c3a840a80fea7eaa4c96f6d.pkl",
        "cache_input_text_sha256": "b0c503bc8548f8aeda08ae0e3e89d1f46aea078cb2c1d8bf9516fe873f318c51",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 3,
        "source_slice": "microplastics in drinking water posed no apparent risk at current levels.",
        "exact_native_cache_key": "f641551bb827c8cac5d3b744088ba706a6e75ec1.pkl",
        "cache_input_text_sha256": "e54a7274400fc08e49ccda6e0df16890c0063e72158e05daea7402a6fba47973",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "In February 2025 a study in Nature Medicine reported plastic in brain tissue in an amount popularised as a spoonful;",
        "exact_native_cache_key": "a1489fbdacde522516f1d56151ad932b61dfeb78.pkl",
        "cache_input_text_sha256": "0f68084f6503c75a3281080b2a0ea6bb62de3c38af22786606eef813996931b1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "others queried its methodology.",
        "exact_native_cache_key": "25792be0a5d6fa22e2c2cb50777bd2e0a3af5b31.pkl",
        "cache_input_text_sha256": "bd7ed2808920b7d107aeb60841efcaf7594514936b0fc27836afcd1644737bb2",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 1,
        "source_slice": "Detection has outrun understanding;",
        "exact_native_cache_key": "ba51d69cd3d6cc92a7756231c0016ccbd2d33a41.pkl",
        "cache_input_text_sha256": "2f2352f3d61fe82922d868b0b695b26b4cefb22d9efb1fe9e4ae3e657704cee8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 2,
        "source_slice": "human studies remain small or observational.",
        "exact_native_cache_key": "3b5417fe0e1255e5c686901bc23e09c1c0938835.pkl",
        "cache_input_text_sha256": "d00600c2036eaf1b7ee9ab13ce43dce2b445533042745007e1abf4502d8988a7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "Harm is plausible but unproven,",
        "exact_native_cache_key": "f2f1f6e946d5c20fa61ffd0f52f75726134449ca.pkl",
        "cache_input_text_sha256": "872db02e88c9fa146315a8cde7d6c33ca3ab381c33a471d39879dfd5ef56da02",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "and until the verdict is in,",
        "exact_native_cache_key": "60aad3e38626f7259ba9069160910888fab7adc1.pkl",
        "cache_input_text_sha256": "e4f7a2194a3ff27022278f305206aa7fba07e0f8a4fcc1857252eb2c9891fc83",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 3,
        "source_slice": "better measurement may guide policy more safely than panic.",
        "exact_native_cache_key": "8eab49ca50a56bedf058b9d8cb73455cd36c111c.pkl",
        "cache_input_text_sha256": "8734ca9eb73a893f11f0fa9af8e2f4ee921d23becbb992df72d4eefa8968589e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      }
    ],
