  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "Before 1840,",
      "exact_native_cache_key": "5ad372864e383e8a8296c553b26bd2ab051f71f6.pkl",
      "cache_input_text_sha256": "b01837ce55b996c24b2f5275607bc9b59d3fe6c486cb3ce3f9e1044147d8d73a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "British postage was levied according to the number of sheets in a letter and the mileage of its carriage.",
      "exact_native_cache_key": "f08718581ee1157128cced35b9e3d9630a8d7475.pkl",
      "cache_input_text_sha256": "8c00ae141a194093f4ad14aac2684dc1a131fc8e78d6d8a9fcb2e95799cb6656",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "The sum was usually payable on delivery,",
      "exact_native_cache_key": "c93e674bba3457db9532db1d007ed6248cbe8e67.pkl",
      "cache_input_text_sha256": "0619969d1da4c7806d6e53cd962a209f8cfa7be9470532068df0313c63055f6b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "so the person receiving the correspondence,",
      "exact_native_cache_key": "27425486f9e56495a7bd023b5a6515b27dc39206.pkl",
      "cache_input_text_sha256": "88c27c21a2b93a6f43ce5c86edb0b055a0f4483c026b000bbe9bee0fdb44b52d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "not the sender,",
      "exact_native_cache_key": "94e12cf12fdeaeb1484f4a26cc7cd3af7a46c279.pkl",
      "cache_input_text_sha256": "75ad99b7e781072643b22f0f1867a897efc4704b5a28cdb41773752d91a513f1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "settled it.",
      "exact_native_cache_key": "f363005c8f89fc7311d9e23af981056a1fe5bb8f.pkl",
      "cache_input_text_sha256": "31023e47e1396d9574513547e92fd1de6d2c6a56108420835ddf8efe9dcf3cb4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "Parliament enacted the campaigner's proposal in 1839,",
      "exact_native_cache_key": "a974b1e7eb72a78b9101a83f30afbfd78e9d1945.pkl",
      "cache_input_text_sha256": "0aa6eddea28745bf916e934121371cb65182aeb40608108704fcbd9ed0401211",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "and on 10 January 1840 the Uniform Penny Post began.",
      "exact_native_cache_key": "0fb0db0038b16417e075c0245eb0aa092326c4c2.pkl",
      "cache_input_text_sha256": "3ef43af6ef370dd7ec4a64e1f6e72edd8a83e7482467928a66a346162905bebe",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "A letter of up to half an ounce now cost one penny to any destination in Britain,",
      "exact_native_cache_key": "0b32f233bc9f051599a44a780a9877bcb7ee1a41.pkl",
      "cache_input_text_sha256": "58ac83e696575ce89f8b21b19297b03ac7e079c78db7a0e5470deee24b689310",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "and the fee was prepaid by whoever sent it.",
      "exact_native_cache_key": "0c4d7793064fbe8efe0a109ef1e47b53ee942eb0.pkl",
      "cache_input_text_sha256": "26a20239284296c20f6f97a031766219f13737c14e072b8e4aa9400c532f3b47",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The Penny Black,",
      "exact_native_cache_key": "31a001bb70d9aaabdacb1500fae831b1a0cf0509.pkl",
      "cache_input_text_sha256": "58c136a28d5727593dd2bbcc160f32da51b7de0cd088ef54097ddd7a749e71a5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "a one-penny denomination,",
      "exact_native_cache_key": "a697043f5be18f9d30da638c36d2f2ea81f6d4aa.pkl",
      "cache_input_text_sha256": "8d93f0113505e8885797c2e6444cc981e7f6f4e901dd94d92d0918e29dc9693a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "was released on 1 May 1840,",
      "exact_native_cache_key": "f4e392078bbba01703886d7c115bcf8bf842ee6e.pkl",
      "cache_input_text_sha256": "7a42cee14758143d3c0a6282660105f8ae35f09c90d3c7b1105207d52107c72d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "its validity starting on 6 May.",
      "exact_native_cache_key": "e92996d3f374f60301dcaee8cac8da31ec89af1a.pkl",
      "cache_input_text_sha256": "1b47ce2eb500a19e771753db9d7f7ae9b1ff84468a84b1c88c5671786305167e",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Engraved on it was a youthful likeness of Queen Victoria,",
      "exact_native_cache_key": "1e88f57e56cb9a3d7edf6a9d305b86569326c975.pkl",
      "cache_input_text_sha256": "ec18e4d56a2fe4fb97387f87bb38a9f4c87bfbc3fc3c1ecc2e21e3fa95808bda",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "the reigning monarch.",
      "exact_native_cache_key": "313aba3d3eeb4b900dc0749fc3db2ea7ab0dedb8.pkl",
      "cache_input_text_sha256": "a2a42529d28b355087ab161e49fc585b28b807cb0192a6bb97b4361de8b751ad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "The sheets had no holes for separation,",
      "exact_native_cache_key": "bce93a9e9c75dc9efe5c60e8cb2056862540f594.pkl",
      "cache_input_text_sha256": "18634856cc79f03ec72379ca39396a9187db022572aff46ad19f68236951b76c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "so each stamp was cut out individually with scissors.",
      "exact_native_cache_key": "8244f68c0d7d7bbe5a2e83a753a2909e0727d6e2.pkl",
      "cache_input_text_sha256": "6f0a5501660b7e99b6a885a77327f1b7b96b8ce60a42f421d848adc6b49f0ab6",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "Mailings doubled,",
      "exact_native_cache_key": "69b831a6319ccaff52807c40a13777ce54b57674.pkl",
      "cache_input_text_sha256": "9e6f7729bf809096f9abddea7bd0c8badc869882dce95e0c370c56c0bb8005ad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "from about 80 million items in 1839 to over 169 million in 1840.",
      "exact_native_cache_key": "d64b4b20fba97ae5654819793f9a12ad976ddf6b.pkl",
      "cache_input_text_sha256": "50546aab01668fbc68d7bc64a6b8595d0be671e865f4621680b41292ff83c353",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Against black,",
      "exact_native_cache_key": "4e8e0cef4ecfcc201b29bd2f949b88ae1a21df34.pkl",
      "cache_input_text_sha256": "79f7136dfe88df283a418862d1fc8576c95f35d10264165c14fb70b79a369fb5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "the red cancelling mark was barely noticeable,",
      "exact_native_cache_key": "543b71e4cca680e8f206c191bcc0ab2d8fb9f3c1.pkl",
      "cache_input_text_sha256": "5acab6ace86eb2a2f5211ae0d44301a4232a7d31b38a68b30abdda0b511c02a6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "lacking contrast,",
      "exact_native_cache_key": "d24d4decf8c2a2c6fb60c24c83783f7dd9884bdb.pkl",
      "cache_input_text_sha256": "30812d386c5fa792d3963fca31c29d544cc034fe8c88b85f95f06d878ca0a4f6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "and the ink could be erased,",
      "exact_native_cache_key": "6847e78b764bb436aae476c16ba2d285fcbfd66c.pkl",
      "cache_input_text_sha256": "64420e92212b0ef17e3d27647f10b168f8ddbaa5880b2ecb95e9fc5fe6d6d9f0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 5,
      "source_slice": "leaving stamps vulnerable to reuse.",
      "exact_native_cache_key": "455e3986f5fbe61bd25c88982baca4acd830550d.pkl",
      "cache_input_text_sha256": "c37d34b37d8ab808ab061a9db673b3af620df05dc0cebd25d81fae803314b67c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "In February 1841 the Penny Red,",
      "exact_native_cache_key": "346841149c54df978ec41fc2b319b389d8f42c0d.pkl",
      "cache_input_text_sha256": "09dbdbb21f6b4fa705a6fc3c5e7ecef15be84a0d22d89a6d82d9d5b36beae2b3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "cancelled in black ink,",
      "exact_native_cache_key": "f1cb50dab181cbeceb191b3d3dc3c4c6ccad3a94.pkl",
      "cache_input_text_sha256": "9e22a38811ebc7b6db986abf0a5a36442dc28a09f18bca951a623986eaba8d08",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "arrived to deter tampering and fraud.",
      "exact_native_cache_key": "490e3c2abf8be3ef63e17d5b144cbebb0012ad39.pkl",
      "cache_input_text_sha256": "006ce9e254f4917a9ea51891b7fb7e4efc7e390bdd81554e8b93259aeed65079",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "As the initiator of postage stamps,",
      "exact_native_cache_key": "846dc432e5e41670a96da6cc7cf5a7bdfb8f24f0.pkl",
      "cache_input_text_sha256": "2378968d02194854372e752729f98368743070b189b1afeca98a107c1a9c73cc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "Britain set a precedent and earned an exemption.",
      "exact_native_cache_key": "98501437b60e8e4c20bca3532f5ab68dfc80749a.pkl",
      "cache_input_text_sha256": "f890cd8a047b74fd7df788f9ecf53959057a635ec69560ee89a733f0870543b6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "Its stamps are nameless,",
      "exact_native_cache_key": "e61579f5542389fa7bc21b7774ab661a3a57bc56.pkl",
      "cache_input_text_sha256": "cca5f765367fdb67b4826010d88708d8e0bf141afb2c241bb633659e641a1f69",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "with no country inscribed on them.",
      "exact_native_cache_key": "338903df11784e0d17759d4a527a65dbcee280ca.pkl",
      "cache_input_text_sha256": "6e7cbf3370ba486d132cc3a823b718e2844d4be4507653f43964c0308aaf90c6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "By international agreement,",
      "exact_native_cache_key": "68fd05efd7d035ea80c3e514eb2fbc5ace36039c.pkl",
      "cache_input_text_sha256": "b5530e64b9d037118eea033e8ffba8aed17682074d2dd935525317f942843ff8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "the sovereign's head suffices for identification,",
      "exact_native_cache_key": "793c9763a0e5168b1d96caad18d6113c3a76a9e0.pkl",
      "cache_input_text_sha256": "f6fc88bd1f3f988ec1e722e860dca928775f69e9f2ef5f3206152f69f9613a6a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 3,
      "source_slice": "an implicit designation that other countries spell out in print.",
      "exact_native_cache_key": "f56caa5fe5a2552a79f930bf6604af79616ded49.pkl",
      "cache_input_text_sha256": "7c451f09cafc34a6fff3c17906c0a3006681bfc8e858c743fcdc746afc9c16e5",
      "cache_input_is_phonemes": false,
