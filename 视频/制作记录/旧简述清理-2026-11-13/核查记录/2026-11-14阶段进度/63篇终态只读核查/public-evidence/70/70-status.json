        "source_slice": "an implicit designation that other countries spell out in print.",
        "exact_native_cache_key": "f56caa5fe5a2552a79f930bf6604af79616ded49.pkl",
        "cache_input_text_sha256": "7c451f09cafc34a6fff3c17906c0a3006681bfc8e858c743fcdc746afc9c16e5",
