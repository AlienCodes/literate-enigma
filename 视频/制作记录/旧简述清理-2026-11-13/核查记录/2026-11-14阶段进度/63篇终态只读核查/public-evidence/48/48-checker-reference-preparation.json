  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In July 1964,",
      "exact_native_cache_key": "65744273d4b54a64d0a04e0c12168ea612a7709d.pkl",
      "cache_input_text_sha256": "5a905eac962b84774200dbb155612090d4dc7436e615932c1804e06ddcbbecf3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "inspecting rice ear by ear in a paddy at Anjiang Agricultural School in Hunan province,",
      "exact_native_cache_key": "8843fe6ff2e85380d887911620edbc649ec0a1eb.pkl",
      "cache_input_text_sha256": "48db391470e81477cf7aeb77a3d72d9420ec3982e68890621f80c4ac20cf3d9b",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "the instructor Yuan Longping spotted a peculiar plant.",
      "exact_native_cache_key": "b1f2d8525a0f97f3a753f127580ae47cb5913fa0.pkl",
      "cache_input_text_sha256": "22062de7ff16427a1d47bdaa62f4777cb8445685c740f1cf3c41e240f61219e7",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "It was male-sterile,",
      "exact_native_cache_key": "fd2dfdf3b9833c056eb95918a88d9aa55f746a10.pkl",
      "cache_input_text_sha256": "17dfc5379993fbf0682e511f3f817dcb9f4b1b680abdcad0a53eaa7aa878a476",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "shedding no viable pollen.",
      "exact_native_cache_key": "32b374c305f4e630f3278315757370d6ea340e15.pkl",
      "cache_input_text_sha256": "6ac447fcaf50baab7a9185e49aa312324e18a87d23cf5ff5d1d2ec0b70efeda9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Rice pollinates itself,",
      "exact_native_cache_key": "6556e45b712339a19ece167caf78564bc363e5df.pkl",
      "cache_input_text_sha256": "7aa876bdaeaaf45b714cfa05b85903b341ebd833e1f933f8604ccb6cf1d6eb96",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "so breeding hybrid seed in bulk depends on such plants.",
      "exact_native_cache_key": "dbbc5bc8a45eb717b033666483d0a27e0acfb182.pkl",
      "cache_input_text_sha256": "0c01ec49d1115c3bb25f971f7f135dfa65140a5efb2d06c89d0d19553bb4831e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "The specimen launched a six-year hunt:",
      "exact_native_cache_key": "a2336cd4c17e2d9beb85b0ea57f94bbba968f09f.pkl",
      "cache_input_text_sha256": "4911be642ba58da5330c199744addb61498132d6753c432ff82760070d353f7a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "Yuan and his colleagues could not breed a sterile line whose offspring reliably inherited the trait.",
      "exact_native_cache_key": "e2b29efa1d8df86cbc2daf59c43b9d007df4bb5a.pkl",
      "cache_input_text_sha256": "41bae9fac47379d6a2742b3197c943eb6e51f5fde1d370b522ace1f264eba884",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "The breakthrough came on 23 November 1970,",
      "exact_native_cache_key": "e10dae380a6ad5af91cdb3f9dd627c35762ab185.pkl",
      "cache_input_text_sha256": "1ef65e631f0dad361c5b59cb25e14c29a5a865b3c91f980d812e6db44a37ed1b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "in a marsh near Nanhong Farm in Sanya,",
      "exact_native_cache_key": "789a590850c6be67e2862c2a606c01ba5f7c862f.pkl",
      "cache_input_text_sha256": "4dc2f9fd44e1e3c2375f1c45aa0255d29310438a28f3382a77af50b3d83162e3",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "Hainan.",
      "exact_native_cache_key": "34722f0b2c8dd299249b4b8750aeda65885cb87b.pkl",
