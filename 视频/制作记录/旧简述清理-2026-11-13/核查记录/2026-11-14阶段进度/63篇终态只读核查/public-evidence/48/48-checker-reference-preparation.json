      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 5,
      "source_slice": "found wild rice whose pollen was abortive.",
      "exact_native_cache_key": "95e36b0ceb4c10ceefb82a175305fe9fd48ba881.pkl",
      "cache_input_text_sha256": "e6b3d1a47e7af175b63c0bbb5ac1857ea206b200ffa3335a5593eb0a1c8e4570",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Then came Yuan's decisive move:",
      "exact_native_cache_key": "050f36c9fd7ba6422d349727f29b6ac2c2d12b59.pkl",
      "cache_input_text_sha256": "49182508e6a7bdebb3a439530b1c9b6d03f594aa081d4cde0095b24ab0457b80",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "rather than withhold the strain,",
      "exact_native_cache_key": "a8845de72e6ec9f7cc61836bf9db3276b1fcb3f4.pkl",
      "cache_input_text_sha256": "65d2c94803f948a2332694f85854abdf6da19d4eb23fbee66ab48259e742dded",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "he distributed it to collaborators nationwide.",
      "exact_native_cache_key": "613d30fa35c6f7f1ca0337565134f11a9cf806e9.pkl",
      "cache_input_text_sha256": "65d9b915d62ac1393ac449f1dbb07987c8842b27e138769819214bda7f4f4b8a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Hybrids need three distinct lines:",
      "exact_native_cache_key": "bc5e7bcb367cb8c3e8ff2d49632daf72f18b9358.pkl",
      "cache_input_text_sha256": "168c3f462f4a6a3ed597852b5c9b82a5290e8feeda08ae1bfdb1aecbc7bdc73d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "a sterile line,",
      "exact_native_cache_key": "6ead726518fed8a62a9de9b321f8977150ab6ce2.pkl",
      "cache_input_text_sha256": "cee496e606b4549799df81bd38f8e523fb61f90fefad6e5072bafbe2da3bfa39",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "one to maintain its sterility,",
      "exact_native_cache_key": "4483808e0904470c40f821a980177a06c36a5e25.pkl",
      "cache_input_text_sha256": "fa7f35dd16607ac2dec45caeac65786ab07d1ae156c61199cc4ae1778704ccb8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 4,
      "source_slice": "and one to restore fertility in the hybrids.",
      "exact_native_cache_key": "16a4e8bad80ae6a907ef5bb47fb8a4277cd6b9df.pkl",
      "cache_input_text_sha256": "7927694605f16bc17415b25723452fc74594dcf27194315271f930e71ae39b6b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "In October 1973,",
      "exact_native_cache_key": "a60e9b135692166bdfb0911a6ad76d20a557becb.pkl",
      "cache_input_text_sha256": "e381a66899d53211f817d92588ee893dbd0cbfa2ed696278a4a4c486ad1bdc7b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "at a national conference in Suzhou,",
      "exact_native_cache_key": "f06e7a60824ce4f934eb975f0d258ef61c941329.pkl",
      "cache_input_text_sha256": "afbeae588f31dc20e3f0c1a003592313552a6ee993d2953b2672a2a7f89b38e7",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "Yuan declared the three-line system complete.",
      "exact_native_cache_key": "a7b1f0e8ea761563f1e3f8e1603085fe8b91045e.pkl",
      "cache_input_text_sha256": "8aed1716b553a9ef9830df1fbf3d9bcab2d6a2f34b8538927e1af59797104ee8",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Yuan,",
      "exact_native_cache_key": "bb148c6f6bf643b74f0b9008f326e4864917ad6e.pkl",
      "cache_input_text_sha256": "878f3edf46676eda2a4e45fec88fec024591dbbf89dc83250747450d1451fad5",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
