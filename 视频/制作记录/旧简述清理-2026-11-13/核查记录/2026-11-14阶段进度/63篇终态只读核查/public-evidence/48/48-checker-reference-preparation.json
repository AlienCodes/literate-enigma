      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "Yuan's assistant,",
      "exact_native_cache_key": "4df59c6d6a9052cbb56992bc3c7e4260ace606e6.pkl",
      "cache_input_text_sha256": "cce478ee9635bd12d274fab2973d0964e8b35cb4d1e22788144957b1e5d4765f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "Li Bihu,",
      "exact_native_cache_key": "fc87e676f903affc2e694dae7d6055ea4e7d046d.pkl",
      "cache_input_text_sha256": "13d34d04da5178717daea9dca5d588c59fcd14433e14f4b1ff51c91884e1d101",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "and Feng Keshan,",
      "exact_native_cache_key": "ea74457a4ba5cdb2e37bd03dc2203b6a82beed0c.pkl",
