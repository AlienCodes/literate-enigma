        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "Wozniak calls their significance inflated.",
        "exact_native_cache_key": "69aefa24980cd9b3baba94a8d90b26d2ee131d50.pkl",
        "cache_input_text_sha256": "03a8b373a7adf7a936f7822c4e59d58cbdc0741871e45ecbabf7a0c83454f237",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "Apple floated on 12 December 1980;",
        "exact_native_cache_key": "828a31d9facea24d8115153f76dd722e6d465a11.pkl",
        "cache_input_text_sha256": "27214e905350d2e386281d9dfccf2c1e1397170fe452ef3d5052c1a07b7528f1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "the flagship Macintosh debuted on 24 January 1984.",
        "exact_native_cache_key": "d1d4bfc276a01d8c88ebad26f4f3fdeba25c297c.pkl",
        "cache_input_text_sha256": "b5f909cacdbe17ec23630406369b5e092641ae0bc29f45d2d5c129336404680d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "Later in 1985 Jobs founded NeXT,",
        "exact_native_cache_key": "6cda3d2cadb3bb8a0f2fde09c5758823960039ea.pkl",
