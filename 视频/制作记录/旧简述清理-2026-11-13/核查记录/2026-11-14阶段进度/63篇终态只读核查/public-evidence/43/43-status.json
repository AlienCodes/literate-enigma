        "piece": 3,
        "source_slice": "and iPhone followed,",
        "exact_native_cache_key": "a0533e464281c3a608fde643212a4643e5166eab.pkl",
        "cache_input_text_sha256": "4bde958956e8d2989b6091d5a2dda35c044fa2275771b125fad924d57220faa0",
