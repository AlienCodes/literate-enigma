        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "Apple's garage origins are largely symbolic;",
        "exact_native_cache_key": "d66d3484bd03fa660cf79cd559dfb107274127b7.pkl",
