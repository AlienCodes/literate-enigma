        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "Steve Jobs,",
        "exact_native_cache_key": "2a3ea6cea9c350cde6d94b323f2aa9f7c6c96181.pkl",
        "cache_input_text_sha256": "8d74154bccab66082bf2dabfc565c500dc52b6611cfc6e3bfcaa8360aec44f39",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "30,",
