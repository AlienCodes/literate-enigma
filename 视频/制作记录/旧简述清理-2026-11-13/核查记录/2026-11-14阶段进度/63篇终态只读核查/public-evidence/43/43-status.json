        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "The iMac,",
        "exact_native_cache_key": "e5052706604b56b53d2b7afc920251b7f11da766.pkl",
        "cache_input_text_sha256": "f0dc0a57d421c1e412eb2ae4e35253d072fca0142e4854a835b37d53afd58781",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
