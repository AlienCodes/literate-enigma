        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "Apple's board ultimately backed chief executive John Sculley.",
        "exact_native_cache_key": "76eb7ba523c24365700d573d9fa050830efe52e2.pkl",
