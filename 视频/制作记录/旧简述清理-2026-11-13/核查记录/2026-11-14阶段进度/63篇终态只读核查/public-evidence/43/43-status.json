        "cache_input_text_sha256": "3994160d5d6474b83a3a1b0c4d9e5125eabb4574dd7f19625306d24ceb8beff3",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "In August 1997 Microsoft invested $150 million in its distressed competitor;",
