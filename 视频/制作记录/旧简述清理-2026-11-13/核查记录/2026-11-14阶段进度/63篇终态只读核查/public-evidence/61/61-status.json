        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "In January 1963 Sea-Land,",
        "exact_native_cache_key": "27eff77c752dbdd64e201b2306f0b4dbeed16522.pkl",
        "cache_input_text_sha256": "463fa6a4a889f676eae55148329de0dab45575e1e656d7a98b41a7a8513e8d65",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "the Ideal X's renamed operator,",
        "exact_native_cache_key": "fb778a220b2f51189b4eb30a183fc1296cd35574.pkl",
        "cache_input_text_sha256": "75fbf65fbc91b44f3e2abd3f98756136f205bb72b3f72d26403ec7db01b82629",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
