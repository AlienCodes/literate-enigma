        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 5,
        "source_slice": "for Houston.",
        "exact_native_cache_key": "56d1c5c1a229f6e7ef0ada2c035e21316d3eb161.pkl",
        "cache_input_text_sha256": "e26388af50e80f15687587c3e3f8b1f3b4151f92384bbddd5b286844190cd4d5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "Clamped to her deck were 58 containers,",
        "exact_native_cache_key": "9c2de27bef3551237a2e9a3977dbd138cf03ef93.pkl",
        "cache_input_text_sha256": "e1381db96203b20c14f2cd554cce399399260d9d2e8af63f604ea213197d266c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "trailer bodies detached from their wheels and chassis.",
        "exact_native_cache_key": "2d53e677dd6bb13fd4f0e6e9acacc9402741df42.pkl",
        "cache_input_text_sha256": "1f01c6e323d246e4928d44e13d5c09b5731b05ecb8ccfc57f3b6d0e9ab28e427",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "At the time,",
        "exact_native_cache_key": "5ce514a60512940dee7479051ccbe7b952e45e1b.pkl",
        "cache_input_text_sha256": "78c8cbb5102fa9b52c94884ce6514f95e7c6c312f20afb701fbdd794935a03c1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "freight travelled loose.",
        "exact_native_cache_key": "fad37536f225171c41fed04a04f1737562d1cf04.pkl",
        "cache_input_text_sha256": "95c164db0f2103c6ea61cb367267d21e4a419fe4bfd37316a7c1abd1b6553ea2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "Gangs of twenty or more dockworkers carried sacks,",
        "exact_native_cache_key": "b369daee81eb31bb2ea57e967fc59748843329db.pkl",
        "cache_input_text_sha256": "698c824808c764626221d502d598eb5080e740e4304ddc7f1dfeaef0e7f817ef",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "barrels,",
        "exact_native_cache_key": "00f0ef56d5956bde16c298dde69b6439b52f0078.pkl",
        "cache_input_text_sha256": "126aca79184c5460d3410ee784b4f64bce688d0546bea67c59dbed9c36445bae",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 3,
        "source_slice": "and crates piece by piece.",
        "exact_native_cache_key": "993c1830e1ee21ffcf62ef8ecd2824cf1dc5fc01.pkl",
        "cache_input_text_sha256": "65a1158cc0ea84e70f08d5add7ad56829d01d3266fdcfef4f2d24909412cd909",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "Ships could spend up to half their time berthed,",
        "exact_native_cache_key": "65b68a01feaf22263e2f8ee1970ac0da05f0c350.pkl",
        "cache_input_text_sha256": "1cf40e69abd0d5875e864d8c5f8f8e8618462305290911bf1e0bccc8ce8d05ee",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "and theft was rampant.",
        "exact_native_cache_key": "a49040e08f117dccf280a159c218aa1c8491a27e.pkl",
        "cache_input_text_sha256": "aee901746a9b68f345af7d55748567844191363d56ee7c81db995c7bfdf592d5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
