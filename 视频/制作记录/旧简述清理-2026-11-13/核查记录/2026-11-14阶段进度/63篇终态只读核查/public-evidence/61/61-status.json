        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "Lifted by crane,",
        "exact_native_cache_key": "dfe7119b43cbca8902c06ec0083cbd05dfa6aca4.pkl",
        "cache_input_text_sha256": "d8b0da6d4a14739a50d5bc8770fc639b2b3631490a19a716ce288361ace4ebf5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
