        "exact_native_cache_key": "4c069d9e160944d08fd544173d29aa5d889adddc.pkl",
        "cache_input_text_sha256": "adfaafd3264b5bf9c2585efa6bec0b737e6b52ed57fde11c928d4a75490d705f",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 4,
