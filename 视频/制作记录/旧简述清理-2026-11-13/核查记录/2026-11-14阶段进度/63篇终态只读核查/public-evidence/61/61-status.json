        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "loading the Ideal X cost,",
        "exact_native_cache_key": "dc8bc98d6c3d8fa2f0b6291bfa220de3f5100914.pkl",
