        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "the Ideal X,",
        "exact_native_cache_key": "73f6bc4a9a05d19605af950e0e22c800888915b6.pkl",
        "cache_input_text_sha256": "7f4ad5212d3958da4c22bdd865f25bb96f7aec76161cf95267f277fafd0f373b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "slipped out of Port Newark,",
        "exact_native_cache_key": "d28e66cb3257cdd89397a7d25c01a5b3654c0462.pkl",
        "cache_input_text_sha256": "e88f99dab6246d04f5e082a232ead5ebd3cedbabd844e0a8ebe8179decf426ba",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 4,
        "source_slice": "New Jersey,",
        "exact_native_cache_key": "91cf6a273c42e094634ff805c0530408b9df42df.pkl",
