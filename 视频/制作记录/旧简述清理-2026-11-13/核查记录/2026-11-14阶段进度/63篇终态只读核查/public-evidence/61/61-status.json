        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "by the company's reckoning,",
        "exact_native_cache_key": "5b0b21f8e0f6445f4a91eb9c8de4cc9e0d0240be.pkl",
        "cache_input_text_sha256": "68c7f113508fc8cd843bed13d6d8da98615ed98fd1e2156c8fba027e1d1a3e40",
