        "cache_input_text_sha256": "f0552c92dc3bbe6a0d105a215025237bde98e1bdce11ca4bd85a6b6ef55dd554",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "The hurdle was consensus:",
        "exact_native_cache_key": "9a6914bfd6f8f2b9f776d8a390a35ee4c57153aa.pkl",
