    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In 1968 Spencer Silver,",
      "exact_native_cache_key": "1c37ba9b350c0a7e069dbee4d90a050d85d51bf4.pkl",
      "cache_input_text_sha256": "5a312349ae40eed73c6c3c51a23a270012b8c0a0550fd7edace37d8d23bfe58f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "a scientist at 3M,",
      "exact_native_cache_key": "42d1820ae3ea065cbbfffc3f0f484812fa50aee9.pkl",
      "cache_input_text_sha256": "81787928db2a8292e454f080d5538c59ef5a620d564ca5e0e020d55fcfd2cc50",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "set out to make a super-strong adhesive.",
      "exact_native_cache_key": "82b090fc4618efb0c915e16cec59ed9ea2dc5ae9.pkl",
      "cache_input_text_sha256": "5aaccb83246eeb160846ec40c317c6947f5063e152acc0cdede2b1913d9d6d2b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Its tiny spheres formed a layer with little tack,",
      "exact_native_cache_key": "9d30a15086718872d7b2abad2bcf56b949d7ff3d.pkl",
      "cache_input_text_sha256": "d29c524886b96b9fc2ca4bf7e0b1d76ec24e47304a59161601fa81706f17845b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "giving paper a temporary hold,",
      "exact_native_cache_key": "72714babdb67ec0d238ae19a8e9ba71c687f80f8.pkl",
      "cache_input_text_sha256": "609275e7393efe6546acbcb87aa318495cf5c76ac95527474bc671454a326707",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "so it would adhere,",
      "exact_native_cache_key": "6f67e7bf1dafb4247d861f57732237083276a75a.pkl",
      "cache_input_text_sha256": "3cf22a8602df69222363768390a882fbebe565001b1e025f0f237fef4f1c67f0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 4,
      "source_slice": "peel off,",
      "exact_native_cache_key": "c662697e3f2b3a400d76763a95b298da867c8ca2.pkl",
      "cache_input_text_sha256": "ab3cdee057aa49f14e49f0d3e1681a2418cb7fb1223c8381e92e6c82d2a1a6a1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 5,
      "source_slice": "and be reapplied.",
      "exact_native_cache_key": "79895f9de0a01266e0c56ccb31be95790b0fd919.pkl",
      "cache_input_text_sha256": "222c89a60831a838923f6e9a77bb8e92e1826238a59da78a401a6b9788a9e79b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "To an inventor chasing strength,",
      "exact_native_cache_key": "41112e9648f397b95aa0103b708dea2f70e5ba22.pkl",
      "cache_input_text_sha256": "198e37b1aa600250149c64609fa9da9e0a4f46f0500e6ca0876d4d057fef7f1a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "the formulation was a setback.",
      "exact_native_cache_key": "e55529552ebf966cd312d733a0b1e6a1b7d89006.pkl",
      "cache_input_text_sha256": "374d14e1e29ad72993f3b7abfaab44ce5d1a5541e3c8e12a937797de36b6b3df",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "For five years Silver acted as its promoter within 3M's corporate ranks,",
      "exact_native_cache_key": "85392c8ce5bb23c708e412adde27aa0d53565588.pkl",
      "cache_input_text_sha256": "2cbfb681e816776359c9ff91b257123d2af6a952f886f85509472ed6c77a6b7f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "in informal chats and at seminars.",
      "exact_native_cache_key": "3a075f465f9f3e9f90425d56b243c6cffe1075e4.pkl",
      "cache_input_text_sha256": "0f51141e05564721c158c89198860147768c9345bf2b905da3d4c66b26b96b0e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "In his own summary,",
      "exact_native_cache_key": "fbfff0d1d54b654ef038c7c5699365b047a2cceb.pkl",
      "cache_input_text_sha256": "56e92068eb3e65c27eae8102ed6520d92b8624cf6869b6629c327cf24998032e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "it was a solution without a problem.",
      "exact_native_cache_key": "c49ed0dd6437aed0e230b8329e9d4e955f60e075.pkl",
      "cache_input_text_sha256": "34b68856f223d42c0f7a970ab9de82eae794d1e54a70c129032dd35372bd8b0a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The unconventional material found no use,",
      "exact_native_cache_key": "2647d083699a9183bcced5f62f02948887fa53cb.pkl",
      "cache_input_text_sha256": "879b245090bd60f16feca0142ae81e41dbb13f8b5d4d28a1c7e20171a88035a3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "and the pursuit proved fruitless.",
      "exact_native_cache_key": "4cb1cba9e6fcfe6f461ca41d9e6af83b85958a18.pkl",
      "cache_input_text_sha256": "35405740b885be20e4b52dc4990e62c56281d552ab16cd33317cacee6f6840f1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "In 1974 Art Fry,",
      "exact_native_cache_key": "bcbd521419356806741f5814382c3f3bad086f1f.pkl",
      "cache_input_text_sha256": "c9eb4a0f117001a0dd95b09a3fa30e6c09effd3a05c4df071d799b482996e85b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "a colleague who had heard one of those talks,",
      "exact_native_cache_key": "4d6f8836ff7640931d7d5f6e3ed86f79bcb6f417.pkl",
      "cache_input_text_sha256": "8bb4d1aeee1675eba693c506d176cc64fe75a67fbc76da827cdbd1eb667dd8da",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "faced a small annoyance at church.",
      "exact_native_cache_key": "7536553e7c926040bbd45a3855fe523fd7c7797d.pkl",
      "cache_input_text_sha256": "af1b7ed7e7e0745c499a9093198b4a961bfed35e24c09c22884b67d33191639a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "The unwanted adhesive could make a marker that would cling to a page,",
      "exact_native_cache_key": "04eeb59dd6e99952a7622a0fd22842db676df2cf.pkl",
      "cache_input_text_sha256": "1519d28dad176acbcd7dca21ed3c192b31171c8afd40522923fdce8facca1482",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "stay put,",
      "exact_native_cache_key": "4085c455b7fb32ffc0bf07197e16becc455f83be.pkl",
      "cache_input_text_sha256": "dd26023dc04bd7155660c33ae767aa772e67719ac083e91962d0f1f7610707cc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "and leave it undamaged.",
      "exact_native_cache_key": "05d8e701177fdc17c106c3eaee350808f2234261.pkl",
      "cache_input_text_sha256": "1eed401a2827120bc624de23056e6002cfbdd3e0b173c478336f7befe5af13c7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "In 1977 the notes were test-marketed as Press 'n Peel in four American cities,",
      "exact_native_cache_key": "cf3a7e66fbe917295c0fd145391ed34a0739f3de.pkl",
      "cache_input_text_sha256": "0963e38d8dd871ce12061a8ff16e047db886cd05082cd538112c5b4a25736db8",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "where purchasers showed little enthusiasm.",
      "exact_native_cache_key": "7509804ad2a5e4aae3e7b6a0690bf6eb5b22c058.pkl",
      "cache_input_text_sha256": "86b076430e66ea0e0bd580509030b32361e6940ebd6dde3d548dcdf13020c02c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "In 1978 3M's marketers staged a blitz in Boise,",
      "exact_native_cache_key": "46c1158678f5a4b6bfbdbd5a5c7b54df73598129.pkl",
      "cache_input_text_sha256": "ae1312b8cb8fd6931a8b25e55601237bb85a5703032e4bed1a54f5ebe84b11f0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "Idaho,",
      "exact_native_cache_key": "2009d41f0746cf5cfc7a272ef61d8b98fa16095d.pkl",
      "cache_input_text_sha256": "ee071bb487d191215a49fe5d8f61b27d3fa4f32073a99eff2fce4dfa42fc3e84",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "and dispensed complimentary packets of notes to offices.",
      "exact_native_cache_key": "d10fc276b8c14f12c37554d27d4564308f1e652c.pkl",
      "cache_input_text_sha256": "a3927f36856360f8bb16a7b60d25bfc9254b174b2337cc15025fba7e3e903b20",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "On 6 April 1980 the pads,",
      "exact_native_cache_key": "684e475f54f713e23b7c7647e430bfcacbd713e2.pkl",
      "cache_input_text_sha256": "40a263e0aca5ab863ddf4a197c7c4fa492d388bfd2f8792605bbeb28d93f7109",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "rebranded as Post-it Notes,",
      "exact_native_cache_key": "73bac569443ffe8d40231ff0b2a9260e7e7debf1.pkl",
      "cache_input_text_sha256": "4e5f760ae1bd585b4b674f9623b1b725b068260616891e051b811a0bb7267e1c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "went on sale nationally in the US,",
      "exact_native_cache_key": "20cb4b9cfd7cc50de110e291a1d73879dcc42c55.pkl",
      "cache_input_text_sha256": "5ad03ec00db07abd32d578624724b9409a3b0efe04753068b4738f3f48b6085b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
