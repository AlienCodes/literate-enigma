  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "On 23 June 2018,",
      "exact_native_cache_key": "3ecdd5741aff6c3f9992f65ba2d6b84992f0d4e0.pkl",
      "cache_input_text_sha256": "b9614f99f45f6f6ccb0fef2895c159a9eb99c89ca96ef452a2e706335266f469",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "twelve boys aged 11 to 16 from a junior football squad went on an outing with their 25-year-old assistant coach.",
      "exact_native_cache_key": "220fc9a8cff35692420fe8ddaa94106343176cf9.pkl",
      "cache_input_text_sha256": "b6732167faf59946ca1fadbdbca685488ba69407687d18107a1a5805f712eb77",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "They entered Tham Luang,",
      "exact_native_cache_key": "aaec20be98f5b6e9b2570f69e5d5a57d2932e348.pkl",
      "cache_input_text_sha256": "006d70d1eac9dd0475bbbc4cc61417f9bc1c060ad5df0b80ff901152ed094005",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "a sprawling maze of tunnels in northern Thailand,",
      "exact_native_cache_key": "8d2a1d16a953da52d81e4cccb72528f2e7f1dc3d.pkl",
      "cache_input_text_sha256": "8501a1c005436c1eba2addd293140583f9a91af31f143552634c3931948fb5e7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "to penetrate its gloom.",
      "exact_native_cache_key": "9f82160f029da6cfa08fa9d1bdd87e634da67df2.pkl",
      "cache_input_text_sha256": "195651662e2dfae743a3479ca7b284053597d68bf6c35353a2cb4f9899886c13",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Monsoon rain then flooded the passages,",
      "exact_native_cache_key": "c3dd3a6f1b7d42dbbc1a8cf813d12716b5decb6a.pkl",
      "cache_input_text_sha256": "6396d304cee4ac5b46ad1d74592444af19ed410ec93cd6a87431dbf1d51f8b82",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "and the rising water trapped all of them.",
      "exact_native_cache_key": "bc320955d707ec8e1485237203a8a249fceb8c54.pkl",
      "cache_input_text_sha256": "7ad8970ee3324f96cd192ab4781eef4bb97cfb1cff4e363b15b7ac8b9c4336a9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "On 2 July two elite British divers,",
      "exact_native_cache_key": "8d2574f745595f0fbf4d5d71db727922a10536b1.pkl",
      "cache_input_text_sha256": "5cc063977ec7ee0b3a2f985370d4b9897fff2bacce6d237b371b03d1333ec31f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "threading through submerged passages,",
      "exact_native_cache_key": "1a8af7bce1fa16c441e6af9a9ce97ced05e1f075.pkl",
      "cache_input_text_sha256": "c313e52bf5a1df3366bf17b11555cc32ef1cddb4b17629066eaeadfe440fa3eb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "reached an inundated chamber about 4 km from the entrance.",
      "exact_native_cache_key": "706ab4d163871cc4bc8600e0c6948a097889e619.pkl",
      "cache_input_text_sha256": "7e1029374ce4014e044bc2e7e3584a297c14539a6d95a147ebf44d6c0fdb122d",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "All 13 were there,",
      "exact_native_cache_key": "48e2cc78ef37d5384d6b6a510fa3b72a6fcfe201.pkl",
      "cache_input_text_sha256": "fe3ff5f6ca8c35fecd0cf0224fe905e2fd38df5a9fba9d4bf24276c7d6c0edc1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "huddled on a muddy mound and perched just above the water,",
      "exact_native_cache_key": "c94fc18c6448301655233d54c971ed7e43f82e94.pkl",
      "cache_input_text_sha256": "4ace1ca0408abfbe3d94837f9baf2156da5762fad86a2d6def1ed1b8ff49acf8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "every one of them alive.",
      "exact_native_cache_key": "4fe10f11007c655c7a6a6c112844d5a71774a3a4.pkl",
      "cache_input_text_sha256": "daf00407c1c859433ccc021a03e0c23721d48d823ebdae456b25b0bea021bf85",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "The only exit ran through kilometres of constricted,",
      "exact_native_cache_key": "6858b59093397f976085637f10e5b83703cf98a1.pkl",
      "cache_input_text_sha256": "5669dcdb668426942b51edbdf73853b2282dab74e494244476c17cded19d13ef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "treacherous passages,",
      "exact_native_cache_key": "1f09d4f338c2054f1e71543a9ad8df414813c98c.pkl",
      "cache_input_text_sha256": "1795345b914041863b6d1fb16aaad5641abafa23840c5dbcb982464c55f8a87f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "many of them navigable only with scuba gear.",
      "exact_native_cache_key": "7cddcdb411596cecb3034644a1b38de7a2d4e714.pkl",
      "cache_input_text_sha256": "fb567618a7b787e87ecdd2343f4c046a7200a3dfa68d2f08b88b03c4ca3796da",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "On 6 July Saman Kunan,",
      "exact_native_cache_key": "d3344bdd4d1074b6de9f469d1e7ef173f8e2cd4d.pkl",
      "cache_input_text_sha256": "66532767713839ca206253882f0403a99795b2f0d02716763f95358016f30b94",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "a former Thai Navy SEAL,",
      "exact_native_cache_key": "eea7aad3f46d589c3363041419283c5c84015087.pkl",
      "cache_input_text_sha256": "081c51a15a3314ba1c92b313d2820cbe799a1a558215423bba6849fa6ab13110",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "fell unconscious while laying them and died.",
      "exact_native_cache_key": "cf55b021938310cc906f0daa76e898a9cf18a931.pkl",
      "cache_input_text_sha256": "57910ff64a2d25be54085a96c99850860646e73c3199ceb26c59ca63952ebf9b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "The evacuation began on 8 July,",
      "exact_native_cache_key": "4340d4e29c7ad85e4fa845b17d2da27937448d74.pkl",
      "cache_input_text_sha256": "3ba55c18fceb4f632053a455e0d59eec8713a33d6946e502c90fd8503fa314a0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "and the boys came out in batches.",
      "exact_native_cache_key": "a6b4ad9a658dc38904e8fc0bbf5a2298312ed5a3.pkl",
      "cache_input_text_sha256": "04ddba399137825dd6512fee85b5f6a204bdfc70289ad7d701248dc72ef7a025",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Each was given doses of sedative,",
      "exact_native_cache_key": "eca9e06980d11f389c623a42241339182839b1bb.pkl",
      "cache_input_text_sha256": "bddc0b613069a3a86330692bcafdd35da8df83ee466cb24112de0722713aaedf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "wrapped motionless in a stretcher,",
      "exact_native_cache_key": "d5602e13d7f094245b1c633b9d0ebf5c7f1959ab.pkl",
      "cache_input_text_sha256": "c57411027523efb567af8086ec73246965478da1130bcbb477200c9602924f27",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "and passed from diver to diver,",
      "exact_native_cache_key": "2439b267e9372a843efe53cd483266e566eb0bed.pkl",
      "cache_input_text_sha256": "10925d9fa4bdc55e7a868569109caf4b9060806d90362ac0070c79a669f90d98",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 4,
      "source_slice": "with medics stationed along the route.",
      "exact_native_cache_key": "d644ca3cc79021f6db81a35549a31dca3fc98d06.pkl",
      "cache_input_text_sha256": "1d8c2c6ad7a96139eebbfa6167cf97960b00ef2c46ef767361339f1663caf609",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Some 10,000 people converged on the site,",
      "exact_native_cache_key": "412d4aaa42194b6a9a9bee28c1afa18357fb28f0.pkl",
      "cache_input_text_sha256": "d6604342170942879249b7eb3c2a45e9180a1298937cc64f09178149e27982f9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "including a contingent of more than 100 divers,",
      "exact_native_cache_key": "9112685e474afcc7e8c95d19333eaa29731cfea7.pkl",
      "cache_input_text_sha256": "d9de9f88c4fe0ee1f72fa308ef5835b2579af1cd79d2551c9ae0f29cbeb0cb33",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "plus 2,000 soldiers and 900 policemen,",
      "exact_native_cache_key": "d8ae182172aa5b00febaa72dfeb82369f3f45e71.pkl",
      "cache_input_text_sha256": "e1275c0a1524423951a627dce1af923b114cb181f6aeed8a0f81983f814cc53f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "with teams deployed from abroad.",
      "exact_native_cache_key": "a41fc42b38549805e1d1d6d9102959f990f0e017.pkl",
      "cache_input_text_sha256": "279f5112fc277c9ea8693b97eac53396e2dcc7bc30aeb4533659273290bfe8e9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "The rescue had a sobering postscript:",
      "exact_native_cache_key": "78cc841c37ca6932f1b311ff17a86b45867851c1.pkl",
      "cache_input_text_sha256": "190922a87c13b113248f8049efcf4922fbf34e5a0e7403bc85569c4aff002f5b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "in December 2019 another Navy SEAL died of a blood infection caught during the operation.",
      "exact_native_cache_key": "4a8bd310bf17c14873513699d7b9e895257a86b2.pkl",
      "cache_input_text_sha256": "25768b905e5e25316cc2e3a8607a188e998f1a878b857879c71fb672b971e11a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "Every boy came home alive,",
      "exact_native_cache_key": "a043db54c739605cdf2c25b39588f842d9ffb1b1.pkl",
      "cache_input_text_sha256": "63ce12c88210e13169f597a1a397d03af2dcbb4fe7ffe50db9bfb68fef7214fc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "and two rescuers were mourned.",
      "exact_native_cache_key": "e9d3ab5db67db70edef59ace5aa8c1cd4555b0ec.pkl",
      "cache_input_text_sha256": "957212d7e6f6d8326b4f3e8458a93c30eba8994c7f192683b698c33a6f984267",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    }
  ],
