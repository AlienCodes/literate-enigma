  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "The Y2K bug,",
      "exact_native_cache_key": "e4ffb80cbcb0059f4c8ebf040fbb06359f394510.pkl",
      "cache_input_text_sha256": "2091000863a1df500b7a235e189edd1069403971b1c5bf17f86afaadc5d1f267",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "or millennium bug,",
      "exact_native_cache_key": "8fefed48861de63799acc01008e2d47191090fa0.pkl",
      "cache_input_text_sha256": "1fcd65a13b1d29b57220454bed92191cb6dbe39854a2a94bf1818674af3202a0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "began as a shortcut.",
      "exact_native_cache_key": "706217e69b5ed56ca6888acc4c06c592223e2741.pkl",
      "cache_input_text_sha256": "9e7e01ccd9ee079265a10baf49bc94531cc546718e357622faa60864a3589c27",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "When memory and hardware were costly,",
      "exact_native_cache_key": "ef7a6f784b6259b0218eeb1dcf14545e3f1e2841.pkl",
      "cache_input_text_sha256": "6f65f4bfb3551a323efb654deecc6adfae028daf11d9c59e12e227a9fd7c2d84",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "programmers stored years as two digits,",
      "exact_native_cache_key": "66f85ce30218d004434e0b99c33692f304326c1d.pkl",
      "cache_input_text_sha256": "a657abf8cc185531a6213fe79b869c218132ac098dc40d982efdcdef866abbef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "writing \"99\" for 1999.",
      "exact_native_cache_key": "3352b469e47a56b166847d7b76c56e0ed382c930.pkl",
      "cache_input_text_sha256": "b7bc7fb1916f57aed0c954dc1d721175ea627d04f00bb6094a4e63383b32d135",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "That compact code hid an ambiguity:",
      "exact_native_cache_key": "c15f958571e50d959e681da04c7cebff940dfa64.pkl",
      "cache_input_text_sha256": "ca5869aaf7fa9b517c84464d5eca8c883c21c48c78056ba1386f5e24aa0130a6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "a machine might read \"00\" as 1900,",
      "exact_native_cache_key": "ed88c4cdc6fc18b00af6ba77380c80ad6b700abf.pkl",
      "cache_input_text_sha256": "b9097343bd48d2539f3e5d4b798b7af1de6fe4a2d35a94147789c4b3376dbc7c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "corrupting calculations of interest,",
      "exact_native_cache_key": "eeb59a0648c668cc963d16c5d72d754ed5460613.pkl",
      "cache_input_text_sha256": "e0e3fd52f38b5ee54af448363e5c385114f5943aa7ae65d17870e58c0796c2b7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 4,
      "source_slice": "ages,",
      "exact_native_cache_key": "5a20b5fb18d6999a19b98fa4f4b699ffcbbdc58e.pkl",
      "cache_input_text_sha256": "61a9901f922edba1fd9a398ee09a49757fa22bbd305a4ae526b9d3a6eeba8ea6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 5,
      "source_slice": "or deadlines.",
      "exact_native_cache_key": "d66e6895cdc5cfc15f6ca4d263c3f8803f9fec99.pkl",
      "cache_input_text_sha256": "7425170d2b2fd3a121ddc0cb5a51642cfe21922da4d1586e6cf83e2e001eb9c3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "In November 1999 the Commerce Department estimated American governments and enterprises would spend about $100bn;",
      "exact_native_cache_key": "c144f652d32237e852b386b6d44c8ab81fb7e1f1.pkl",
      "cache_input_text_sha256": "fe6850a9c52cb026137d15457bd67494789ace623f1f0fb99477411faa557951",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "projections of the global bill ran to hundreds of billions.",
      "exact_native_cache_key": "eafefeb9f68a7d66d29d3ecb419a39bdce1cadd7.pkl",
      "cache_input_text_sha256": "0c7b58a53c927d53acc76fd6c071aa57d85a45e3c082e2fd190491c1e57c49e5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Then midnight struck on 31 December 1999,",
      "exact_native_cache_key": "24882868e29a0221d7b5a5d8d4f63637873783bc.pkl",
      "cache_input_text_sha256": "4b6b6761bac26e6a367bb6f2108ed31a76165b86e335b00a9471ac292f963358",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "and little went wrong.",
      "exact_native_cache_key": "febaffba3196826f596ab91d042196c04aa86a95.pkl",
      "cache_input_text_sha256": "3c2617feda2b2eb6889037ea0c639f291e90b3c1c36cb9e20745b8326cb2ca45",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Radiation-monitoring equipment faltered at Japan's Shika nuclear plant without any threat to safety,",
      "exact_native_cache_key": "118212cfcb89f6e1cdccd86c22b62b8e72acf2ba.pkl",
      "cache_input_text_sha256": "0e2d2834beb6b07e3fa1a1360fe437ab85105b8249898b90157e53265b2b4065",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "and a Pentagon ground system that processes spy-satellite data failed.",
      "exact_native_cache_key": "facb5f79e080fb122be4b069ff6bec8e8e4cdc8e.pkl",
      "cache_input_text_sha256": "f1ce7860cd28cbd347419a75bfedcd563d8e5221d113992f33c055079fd5b677",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "Many saw it differently:",
      "exact_native_cache_key": "1a13b939359d85ecd81d43a1b43fdc8ec15a4089.pkl",
      "cache_input_text_sha256": "41aaa64a101371595de2b8a690524354d672d5caa8a04be46cc774a808f7429d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "the threat had been exaggerated,",
      "exact_native_cache_key": "c90a0cdf07eef5328557950fbd739d9338f04dc9.pkl",
      "cache_input_text_sha256": "8e4a7ff0a75eeca3248c37a7b7a0cdb88c7f3503ea65a82bfe57061fdeaa2438",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "even a hoax.",
      "exact_native_cache_key": "a5d096c9268877eab4d8f8a429721ff9dc95398e.pkl",
      "cache_input_text_sha256": "a8bf4aaf5707d9648f876f3af87a68cf7f7d8f4bd6590c0213f886fdcbd11c87",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "This is the preparedness paradox:",
      "exact_native_cache_key": "f07cbbf5f9a1fbcfd9fcfc74add8caa9e91dfffb.pkl",
      "cache_input_text_sha256": "8c16c1a44bbdd830e921595b2e262d831713ee131c58bf23673d3a299d7cb69a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "when precautions work,",
      "exact_native_cache_key": "42b1aba18e476e0369e5591bb68836cf36e8ceaf.pkl",
      "cache_input_text_sha256": "33e928e7a452a71bd93ad951b9a7b62bede9d465760016323dd80c91f2f3bf25",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "the danger they ward off never appears,",
      "exact_native_cache_key": "c2feef2217df3e44e7e36bd8d854eab48316fc90.pkl",
      "cache_input_text_sha256": "b7f58d1f48bb3e6c72ff632d2ede5a27a9fe20a0063879c806e4fdf9d254be6c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "so it looks imaginary.",
      "exact_native_cache_key": "24795f08389631c3740bf7360e93bf369299b4f9.pkl",
      "cache_input_text_sha256": "21404afac31a9ea0fd7d29b13ce47231916db4419f4beba1239ebba0959ef737",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "The comparison misleads:",
      "exact_native_cache_key": "1edd68a480f5178631d2dceceec6f0d4556185fb.pkl",
      "cache_input_text_sha256": "d63c2ce602fd66a7132c559afaf0ea25c856e5a7707807296ff3c5f25b2efca3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "those low figures often omitted what firms spent,",
      "exact_native_cache_key": "afa4c4d71f5fa957f4aa255b852cd21acf340dde.pkl",
      "cache_input_text_sha256": "e23a267aaf86a0d2780c2cf81d0f64172df2e8ec0e0444bd81343360f98100c9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "and much of the remedial work replaced obsolete systems overdue for upgrading.",
      "exact_native_cache_key": "adbdb649adcbd7c966b4f1e90aa725f6a5b94621.pkl",
      "cache_input_text_sha256": "33e0bafaa36d41b18591761f228b168eaeef7b429da33f3d413fee0fc821281c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 1,
      "source_slice": "Prevention that works may leave nothing but an invoice,",
      "exact_native_cache_key": "922635876c9e9b36b020036c86177c8097ea8367.pkl",
      "cache_input_text_sha256": "59d5daa8c9d27f5c5bafc354cacec489ef84be9b671eb754bce40e8de438577a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 2,
      "source_slice": "to be weighed against a catastrophe that might have been.",
      "exact_native_cache_key": "e1ce7f8d87d2de2c4db3e8d05237dc74b30c295c.pkl",
      "cache_input_text_sha256": "3abd7bbfba706ef2383690be568191b10c03f09cf3ebcd7ea85fa4f5c0dc076d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    }
  ],
