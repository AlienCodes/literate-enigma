      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "Scotland,",
      "exact_native_cache_key": "b7519f8b3a16535838265b0a5cb2c22052146779.pkl",
      "cache_input_text_sha256": "ca20c12e270a28052e30c495652c59da50331be5d21a449c2614b16dee60d489",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "on 5 July 1996.",
      "exact_native_cache_key": "82c67889fc387eabadb8eb602d09e15a4ca5f0c5.pkl",
      "cache_input_text_sha256": "5d0aaced74f12b3387cfe45bc643222e0a4e5b8ef66ff215100800b514cc942e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Her genome came from a Finn Dorset ewe's mammary cell,",
      "exact_native_cache_key": "e69ce6a0689eb8cecc2459125291516ee9c2308a.pkl",
      "cache_input_text_sha256": "1b6b4773503e9a6982cfe27e140969a8b23be5fd56bdf802dcd2d50a14023a05",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "fused with a Blackface egg stripped of its nucleus.",
      "exact_native_cache_key": "e8c1aa7d7b71c3972fdb44d169644ee03de09642.pkl",
      "cache_input_text_sha256": "3f1c6ec50f5945517c3c8900c9940cd2d716bbf2c84048fcfd92e9252747452a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "A Blackface surrogate carried the embryo through pregnancy,",
      "exact_native_cache_key": "39390dbe699e15c254c226511d67c06ef6167c35.pkl",
      "cache_input_text_sha256": "8a521ef04c2d4e23a1aa2880474a9b223fff652ab623ef6c600fab6110b22091",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "yet her white face was proof of a genetically different lineage.",
      "exact_native_cache_key": "6157c15555cced6bee2457173efba18d6b0ca33e.pkl",
      "cache_input_text_sha256": "1f2a0b2a1a89420d7800775265252c527b4c57b5e920be71245084bef59300dd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "She alone survived from 277 attempts,",
      "exact_native_cache_key": "7213b3bd60c05f006bbf26b4788d4cfc566bb223.pkl",
      "cache_input_text_sha256": "bb8438779d4a9c453951e585c818ed7d8177b7ef1cb913f16d30c1f3bfa794bd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "an extraordinary failure rate.",
      "exact_native_cache_key": "67b5b8324b400ac000223ae2d64509b6962b4612.pkl",
      "cache_input_text_sha256": "f89826bed292af725f468e8a5796a95541802708f1236d70b3290d70636d337f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "Dolly is popularly called the first clone,",
      "exact_native_cache_key": "566dec972351e370b56af021b3302cf0b0916781.pkl",
      "cache_input_text_sha256": "66ebb4f4d483c31d83ae443c6e58d1ed7995a8fd690ef45147536c981fefe1ce",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "a misconception.",
      "exact_native_cache_key": "45eba502ebfb085b97ed8df4fd759919e525e7b4.pkl",
      "cache_input_text_sha256": "ba3e6290221bb81c48b3a6b7c3e95150c9ebbb82276725ad8fe6a2ecad18e377",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Her predecessors included frogs cloned from transplanted nuclei in 1962 and Roslin's embryo-derived duo,",
      "exact_native_cache_key": "b482a8d03a31a9c5b8f9a52971f8b9527ae2f614.pkl",
      "cache_input_text_sha256": "cda87066a749a5d1c33fdc23943be5b4a1fa8ff53528772c5f11050ca832aa78",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "Megan and Morag,",
      "exact_native_cache_key": "75eabcfa366e501e726a32a259d7c59b4e4edf0f.pkl",
      "cache_input_text_sha256": "41f0c77dc40b044573b30bf396f5e18818cb223c09bd803b315e6557b10675d8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
