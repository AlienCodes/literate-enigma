      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "and her name,",
      "exact_native_cache_key": "a6f88e5aa7520633c786e4ec2ccfd155a020fae6.pkl",
