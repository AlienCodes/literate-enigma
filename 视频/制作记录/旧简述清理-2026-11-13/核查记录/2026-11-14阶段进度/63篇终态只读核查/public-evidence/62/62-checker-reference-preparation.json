      "cache_input_text_sha256": "120e00c0bcf31e77cd3e195280d4d42f8dd8dfbf8f0b59674c1a14d643063f04",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Roslin's announcement on 22 February 1997 coincided with the paper,",
      "exact_native_cache_key": "c6b18ce8d5c35090f35080d5308890c2d5461673.pkl",
