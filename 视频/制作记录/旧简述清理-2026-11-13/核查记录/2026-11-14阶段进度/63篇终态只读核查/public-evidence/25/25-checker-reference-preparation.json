  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "On April 11th 1970 NASA launched Apollo 13,",
      "exact_native_cache_key": "f5518eab69f4297b6c810dc4887c3bf5318a394c.pkl",
      "cache_input_text_sha256": "a4a5668f9830c0c944cc335826f75d5fba7be52a700921c9b2ff7afb71491d38",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "meant for the third crewed lunar landing.",
      "exact_native_cache_key": "714833215e00fb9ee3bff3bc2ecd6d3a32b25985.pkl",
      "cache_input_text_sha256": "f4e41d73bc9ee664424d21dbc6d0ebbde7d0cd35fd7e209d36ea9f4ff2d2433f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "On April 13th,",
      "exact_native_cache_key": "51fe2b96c165d2b0b708360b6e12c6d45a81cf1c.pkl",
      "cache_input_text_sha256": "bd97191a378ae2625810d01f1f63a69d5e8acc2ce43ec0d59328494ff2874c90",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "some 200,000 miles out,",
      "exact_native_cache_key": "8d4e7f6587053033c63807b74842cc4adbbfa0e6.pkl",
      "cache_input_text_sha256": "48336f6c213119838bbf29977d21459270761058cde9fcc74ae92d8f765044cc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "an oxygen tank exploded in the service module,",
      "exact_native_cache_key": "6fe6a5b608d9bdf98a9d2be7ee5c7e72efbb71dc.pkl",
      "cache_input_text_sha256": "a3ed527bffc3d368aebcd88bab39449bc4aec86ebba18267135e534068b48dc6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "home to most of the ship's oxygen and power.",
      "exact_native_cache_key": "ba3212033c48df08830d02c1a25c78228223ab00.pkl",
      "cache_input_text_sha256": "c4871b770f5f6cb9309161561630f6c6dec6b747b8b003ff2e953a11e3d8b90e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "The blast crippled the spacecraft;",
      "exact_native_cache_key": "f96c31dab15b005ca7ead117c92d72b1a4b46f6c.pkl",
      "cache_input_text_sha256": "3538a11ee440c0ee7465563161144f1f49ab8ef259093054221a9d814a522103",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "the landing was aborted.",
      "exact_native_cache_key": "527e10894c58bc58d23a5ea0eff87a1cec087895.pkl",
      "cache_input_text_sha256": "e5355b90d9dea6c79030008e56195a4f30a617743030e0a709a90bbb4c66a2ae",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "The astronauts took refuge in the lunar module,",
      "exact_native_cache_key": "6f72ece15e1c62b8d13246754cf81664b68e2261.pkl",
      "cache_input_text_sha256": "137ab21b1419093b1be28fef48aa1a0c1eb3b241d0da1c8711cef959ac712ceb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "Aquarius,",
      "exact_native_cache_key": "bdeaa4f17e51be5470d7a3063d187ac1601f6b19.pkl",
      "cache_input_text_sha256": "c6778effaa37e144d68d16ceba6fcc2d3f64e7e6f476230534deaaf8a067969c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "built to support two men for about two days.",
      "exact_native_cache_key": "4ea423b7db3b03a7f5e12804d9ad5af9128f0520.pkl",
      "cache_input_text_sha256": "e7694f8d14a17aa2ace435f68644e93882767b810d1e2ed7960c29797a837f71",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "Using its engine,",
      "exact_native_cache_key": "b0dba47779095c84428d7158526bebe32a8023c4.pkl",
      "cache_input_text_sha256": "ab7b8ab8b4bc190fcb438de1a99a4b0e662f312fc53f4538187d33aa22481160",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "the crew steered the craft onto a trajectory around the Moon,",
      "exact_native_cache_key": "829d5e66f468f33401236e828707adf5ca86b737.pkl",
      "cache_input_text_sha256": "1fe3714ade43340381245a6981800a98101664d1d56af1c477e6fc8b527845b2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "whose gravity swung it home.",
      "exact_native_cache_key": "fcc9c755afbf87fd7b48b7b8ba451a0a4a9d68ab.pkl",
      "cache_input_text_sha256": "44754a45fd4b8d10cadb3ad569199b48250f9cbf001c9a0ef66bb3a896bd0e06",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "They rationed water,",
      "exact_native_cache_key": "069e753d4d84b34512f54b0eff33806a267fee5f.pkl",
      "cache_input_text_sha256": "abed7d7d20bd272dc654c45c383ba8614c9cb3754c6189782782e2b66d7adca2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "conserved power,",
      "exact_native_cache_key": "f4931b2d25e24b6d221564e024f0df2b6c7a3130.pkl",
      "cache_input_text_sha256": "1baf37b6d698ff445d73b700b663fb6ed1cab32a3e268fe338e6e4861a99af63",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "and shivered in a bitterly cold cabin.",
      "exact_native_cache_key": "fb64a4f340efafdf9bff50710f6b6f1b876f983d.pkl",
      "cache_input_text_sha256": "54efadfaf8106ddc2a20eabd3947ed9fb728ed99f9a19b9e24aca1dc8a0d27a3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "A quieter hazard emerged:",
      "exact_native_cache_key": "7e198155663bb36b47e408d698488a891bd9f3e9.pkl",
      "cache_input_text_sha256": "d8639a5051e9cfd010a375c98259be8fbf33bb5cccc3f2440607c4b116c3807c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "with a third man aboard,",
      "exact_native_cache_key": "2cce22ac5194f76efb0b191cf1e1323a6cbd3f11.pkl",
      "cache_input_text_sha256": "71e7dd633bd0b3f04fbfe8fe1541fca169d4a92835d0725f2a619f398c5e0b06",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "carbon dioxide was accumulating.",
      "exact_native_cache_key": "13845d7d5e2cca451ca17d2c847733892f95a7b7.pkl",
      "cache_input_text_sha256": "25c91658a917ee3ad1c1ecf5e36e1fc0e7fc9459535c64745c01dbdf26f088d3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The command module,",
      "exact_native_cache_key": "91ec3e64714f0f8da01c3964d7b601769b414694.pkl",
      "cache_input_text_sha256": "c5e006092a5d4daae5d09d21b58b9abd7fcd361383eff8eb4d5fef786c906321",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "the crew's capsule,",
      "exact_native_cache_key": "28e88f3ca8839320972c24e30bd738269b2c4493.pkl",
      "cache_input_text_sha256": "c1052c179e2c6fc20555447a724678c07a32554c2f7d453508fe558978335357",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "used square filter cartridges;",
      "exact_native_cache_key": "f67499f2cc800e9b2c290a73adf3f5a03b2e1e92.pkl",
      "cache_input_text_sha256": "6d95161c1cc1de9f62d9b20645ba576d403cf8c9b8c580e70a151f2f8e2c3c7f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "Aquarius's sockets were round.",
      "exact_native_cache_key": "0e727768246b1acdddf055187abfe4488cbc9918.pkl",
      "cache_input_text_sha256": "f708f149da3509eae2262028422bc02ac078a2ef900f5a213f7c3f962b99ec3b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "From plastic bags,",
      "exact_native_cache_key": "ecb2103a8257e848e159014b4b4c01506941ce54.pkl",
      "cache_input_text_sha256": "fb60f56cfb835066e28f39ccee61e936dda280393bacc1ebd1ac989586810fc1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "cardboard,",
      "exact_native_cache_key": "11b71bbc5700668b7373770dac8d760493111446.pkl",
      "cache_input_text_sha256": "2bd4b8309ab3f2e776b944adf400840697f704be41c65e9b4f247cde9e3ccbcd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "and tape on board,",
      "exact_native_cache_key": "f1c33d0d168feb1059af3d40035acf65d75cae2b.pkl",
      "cache_input_text_sha256": "f4817b9c7e6e9f1045464158aa56cae0228f085625009e72d005cf6d70ba8889",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 4,
      "source_slice": "ground engineers devised an adapter,",
      "exact_native_cache_key": "c2b733a467a267026e728cbc1226befe27a5177f.pkl",
      "cache_input_text_sha256": "7494523a2ab60233f6a9ddec601803238a638aab750514ed3ff1ed22f1f9cc2a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 5,
      "source_slice": "then talked the crew through assembling it.",
      "exact_native_cache_key": "b277588a2fcd0ff954ce94700d64875b7b9d8b6a.pkl",
      "cache_input_text_sha256": "d46ac0f2c6825f7d124467ef172641d76eaf1dbb1fb83bd66c27092b25ddf229",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "A NASA review board traced the explosion to the tank's thermostat switches,",
      "exact_native_cache_key": "5898b1aa1ee519264e4a0453328a51f7ac13549e.pkl",
      "cache_input_text_sha256": "f81929f76ee0035e02ee9502d3fa77d5fe1840b2a7b3bc9b4060fc495cc0502e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "designed for the ship's 28-volt supply.",
      "exact_native_cache_key": "f8c85c4ff6156d69a860468fc5ac8f55b580d640.pkl",
      "cache_input_text_sha256": "d4eefc0d2db47556d9baa95b4af9b325d7f06f4da85a4fc2d59471f5355e3862",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "In 1965 the spacecraft's builder rewrote the specification to let the heaters run on 65-volt launch-site power;",
      "exact_native_cache_key": "7045c10aa3487cff529520bff5ee796636e2259e.pkl",
      "cache_input_text_sha256": "987d4dd17ff2f3d80311e0cc50be2f9261bc13f94f145422998077d3d5d22627",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "the switches were never upgraded,",
      "exact_native_cache_key": "00eb22963428c417d429af60827aeb720a2ae4b1.pkl",
      "cache_input_text_sha256": "f769a56da573aac0035dde0e31b334af44e0f54cee4b60403ecd38c22a656064",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "a mismatch neither that contractor nor NASA detected.",
      "exact_native_cache_key": "39399f5616dfbc386d79193573096ab4e19de242.pkl",
      "cache_input_text_sha256": "44f9bcc06c3e5ee53c605a63209e1d1d68790b1d7c39500b457b242b16ebe6fd",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Weeks before launch,",
      "exact_native_cache_key": "9bed88559e857d8735b399a5abb6ff29636bb240.pkl",
      "cache_input_text_sha256": "ed1056c725bd79a5a083a462a917f108e39f40248b36c4ded41022dfcf67d8fc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "to drain the stubborn tank,",
      "exact_native_cache_key": "3d27f5e72f1d11aa3e99da577f7545cb74a51976.pkl",
      "cache_input_text_sha256": "befc490ca23ab155fe8ac9d1d83ebf9b8ca31fcaa2bd74fd7e0df9fca1c1b7aa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "a heater ran about eight hours.",
      "exact_native_cache_key": "fad5b70af9691a7560ff3faf528cef63762fabdd.pkl",
      "cache_input_text_sha256": "21ac9a3e487e239c6e2cf0484db05eeb610575e9c470f230b6ba22d6d46f12cf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "The switches probably malfunctioned;",
      "exact_native_cache_key": "794a078535c352678f144dc1002e0641da62d7dd.pkl",
      "cache_input_text_sha256": "17a9ccc3a06569b277a9f8eb2a8d2b403a4320cf6c57fe17365eb41caf1b49db",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "unchecked heat scorched the insulation on the tank's wiring;",
      "exact_native_cache_key": "816f7d85771abb5586d5d79d440f14cd670df333.pkl",
      "cache_input_text_sha256": "19ff053c2697e64ca78121d8b19985bd4b97104605cb70c4c5a7ecb2902229ae",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "in flight,",
      "exact_native_cache_key": "893406c88a07b6fa88c70c1ea9d2ad60d8715fa0.pkl",
      "cache_input_text_sha256": "9ed40cbd5789b173e73548ecfab1d036b6686778aea0e4eda2bbd6eb6d1c2255",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 4,
      "source_slice": "that insulation ignited.",
      "exact_native_cache_key": "ee10ecd4192a4a1fb53072cdcd6ea9e78860fa9b.pkl",
      "cache_input_text_sha256": "8b3ca5c262ea1c4f98c39b8027b4087621ef3fe3260f09d1ceaf88bde1a50433",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "The paradox holds:",
      "exact_native_cache_key": "743517c9c8f076967140c42049020f4387c774b0.pkl",
      "cache_input_text_sha256": "1934db3e573582bd75bb343b6a7f0e1ffe1d55a39a74e47a42d43002e2f51b71",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "a flight undone by a five-year-old engineering oversight was salvaged within four days by ingenuity on the ground.",
      "exact_native_cache_key": "c34668bf6cdd2166211932338088c0abe739b910.pkl",
      "cache_input_text_sha256": "609be8c29a59a7de0cfe7c819d52edfab6f5bfee2731ed4f596ff687bb1d2bad",
      "cache_input_is_phonemes": true,
