  "reference_calls": [
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "In a Canadian forest,",
      "exact_native_cache_key": "1a3a5856fd7629ec4afb3d910f510fd267e2adfd.pkl",
      "cache_input_text_sha256": "62879a342e64643e51770091573ee1c736ae68df2867bbd33210f6cc530dd03e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "researchers enclosed paper birch and Douglas fir seedlings in them,",
      "exact_native_cache_key": "de074a56aa9484d7235d1af8043180db68408c42.pkl",
      "cache_input_text_sha256": "e14ccc3bbb8d7a8c2cd92be2326ee60ea0c89caf74e325e0f4e41e5f5178999f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "then bathed each species in carbon dioxide laced with a different tracer.",
      "exact_native_cache_key": "f655586b27733ef6810eceb7ed373783ab7e7a62.pkl",
      "cache_input_text_sha256": "dac9a95ba80e8a7ac9e562eb52902e447c6b5b47a7c2771df7461ae1eddde9af",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Carbon shuttled both ways,",
      "exact_native_cache_key": "c6c773f9909032717c8bd43a466a17e69d1ca8b6.pkl",
      "cache_input_text_sha256": "bb83f6fcd4b6ca1f1ce290e1cc68ce5ffaa1c876abc9588c154d6595ef8d73dc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "apparently via fungi linking the trees' roots,",
      "exact_native_cache_key": "fb648df261724dcce729cfea0e9449c4685da18d.pkl",
      "cache_input_text_sha256": "557900df5cb159fe64e340b89012e8921e402022b37d80600bff1009fdede781",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "yet the firs ran a slight surplus,",
      "exact_native_cache_key": "69ae6fb4cec31131c42f310bf1bd4e38cad4c254.pkl",
      "cache_input_text_sha256": "2e33042b82b4714c0a40aa96e9959643f25d056477a00111a39c6626171b5edc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 4,
      "source_slice": "larger in deeper shade.",
      "exact_native_cache_key": "6ad2bfadd6dbef197944b1776536959235b024fe.pkl",
      "cache_input_text_sha256": "19fdf4880f0837ebd508303a6129c0771b913b49c0031707a536c2c37cb1c88a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Most terrestrial plants harbour such fungi,",
      "exact_native_cache_key": "bb40f400df6b44d628918a419a86b72b047beec6.pkl",
      "cache_input_text_sha256": "9b480b4ece26642ce3bb37bfa939ffc0a83e8075974e633e9df7177f5300801f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "whose filaments forage for water and nutrients including nitrogen,",
      "exact_native_cache_key": "c2b60da9aa2ff1eda512698e8899880bdf16bc0e.pkl",
      "cache_input_text_sha256": "a52f606f1114acfdf1cff7b59a4a779c9330b2edc2dfd5952c7e4bb73180a6ec",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "swapping them for plant sugars.",
      "exact_native_cache_key": "b98baa0e52feef296bce648188e7fd6b6aea0542.pkl",
      "cache_input_text_sha256": "daa88d369296fdf0d7260e11a5fcf070ae5820240e4ad342b65eac85b1c74d5b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "The journal Nature unveiled the study on 7 August 1997,",
      "exact_native_cache_key": "3036d51801021d8a31ec8ccaea847daaf4be83f9.pkl",
      "cache_input_text_sha256": "6bec2dd9cceb738d40d4f71ec20c416095b55b5208dc3e876736cc3e9f2b5d45",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "its cover offering a catchy coinage:",
      "exact_native_cache_key": "bbe3846575fcb8c7b48ba820336c5e0e9dc9a0b3.pkl",
      "cache_input_text_sha256": "5ba1597b9373c806985ca3688bc7c4f7bc28225cb9979c0bdc89024e7beb024a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "the \"wood-wide web\".",
      "exact_native_cache_key": "47a05f34584ed1fb88dcaff5abb8a30d3b6948f6.pkl",
      "cache_input_text_sha256": "1c798259e67a4d9c317cbabdd7dd4c8c13fff2cb7f5ef12d730578b6e0c95641",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Between 2015 and 2021,",
      "exact_native_cache_key": "15732a7289e5a700f8cc282ca1c33712d82b9b84.pkl",
      "cache_input_text_sha256": "d26f551483af51027da95473fc53a530431b2e418a6f251ecaf78ba96e4e0681",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "a forester's bestseller,",
      "exact_native_cache_key": "32f096fb6e232db0c58e16d585ab21e19f678f49.pkl",
      "cache_input_text_sha256": "62fef1d532afe097d12e499656c6a16d4dba334f204798afe52fd1252d586749",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "an acclaimed novel,",
      "exact_native_cache_key": "d10653a82d96df4c6b78697ef7ba05e0bfc2a575.pkl",
      "cache_input_text_sha256": "b6b12405d975c8c83380e55dc36cf8de9b871632012ca6949b588eeefbdbf097",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "and an ecologist's memoir told readers that trees converse,",
      "exact_native_cache_key": "a6b4c34d280d69f229815160a94fb4e60dee670f.pkl",
      "cache_input_text_sha256": "3f901055887dac5d11acfccb71e67454f1eb63da9d2db336c116cc62325add7f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 5,
      "source_slice": "warn one another,",
      "exact_native_cache_key": "daa465349dcc99c27d8b2da0521048074a879308.pkl",
      "cache_input_text_sha256": "4a78a9215dbd84452e21f48c66959f8c9fd4b0298615ff9b53207b200def30ab",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 6,
      "source_slice": "and,",
      "exact_native_cache_key": "e09ed47ec5014c2d23f5640c5b43e1faa5627a39.pkl",
      "cache_input_text_sha256": "eec699222cbe4157babc8e84b8a23236a2686fc8530dee44ce588a22ced69c89",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 7,
      "source_slice": "as \"mother trees\",",
      "exact_native_cache_key": "170be3c04537e395109bf8e293d7cabe4a8f03c9.pkl",
      "cache_input_text_sha256": "fb71c43de592131f9cf5a388e0ad1c753b1eb9f5ba6862c1486da7411b32aaeb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 8,
      "source_slice": "nurture their kin.",
      "exact_native_cache_key": "6abed713a8b8d3e906df0ab24eecce21ce07a736.pkl",
      "cache_input_text_sha256": "10d1c7d8b6cc1a2f00a2f52b0af84b5918fb8ae6326a8e7831c1fc8cd401f4dd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Yet the 1997 trees were seedlings,",
      "exact_native_cache_key": "b55053a6b1fa3369e7bd6dfc3c551fab9051ea1d.pkl",
      "cache_input_text_sha256": "619ca9d7a360ba5fd6e92fc9f543dc694fc41f5a12eb9180e4d8f330df9cef1c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "not elderly mothers.",
      "exact_native_cache_key": "d455be10030998240d7ea8155c6ede554282e249.pkl",
      "cache_input_text_sha256": "5a89ac8ded44887ecffc29d9fb5252cef4e356991b12fa8a1057d97f5b741fbd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "In February 2023,",
      "exact_native_cache_key": "919661ee6f11f4e9852e077761554d20b9c06288.pkl",
      "cache_input_text_sha256": "330a2265162b763391ec53933cf169c1b1b1eb76b1377226138e04067b4018e6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "three researchers combed through the field evidence.",
      "exact_native_cache_key": "12c788674167ad44181f22809db874d50fe08601.pkl",
      "cache_input_text_sha256": "57f695ea284195c41bc92ffe46324805b69a5b1bded6b0dc3e7b815bb7898e52",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "They judged it too sparse,",
      "exact_native_cache_key": "a20943a45219c438cdbda52d863613d3332bc074.pkl",
      "cache_input_text_sha256": "18982677ddfd22ff0507475ff8405c1ea09de1225dd1d0d559d4f5cf0d183a39",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "inconsistent,",
      "exact_native_cache_key": "5c9deed80b401e58e9ebdf80e487f7c789c3d474.pkl",
      "cache_input_text_sha256": "71348284dd3ddd9a885b2860d46bb8081ee55efc4aaa03c57c28cdfd20ab7766",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "or ambiguous to demonstrate that shared networks are widespread.",
      "exact_native_cache_key": "032da7b672dd130a865ee25df7ac8b8b918087ff.pkl",
      "cache_input_text_sha256": "83526e9d1e8deb2e7cc96bd4caa6d02d2c2a32e87726ac20bd8b8c0bee3ecd57",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "In 26 field studies,",
      "exact_native_cache_key": "421ed905ba79c599763e3e9f3b307cafc4753065.pkl",
      "cache_input_text_sha256": "71c07f2f1cbb2bf7bfbec4c453c6b03ebc8f54e11fcd32f8c662d94fdea6e452",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "networks helped and hindered seedlings about equally often,",
      "exact_native_cache_key": "9f81aa50aec939114139ff0c54f398cba15ffe96.pkl",
      "cache_input_text_sha256": "94c2aa2f37dcaa7951275ca47a3beb48ea1321d6f18728c38327a5bc86097182",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "with neutral effects predominating.",
      "exact_native_cache_key": "cb07c5a585412cddd7ee02aa32095e6ff458e484.pkl",
      "cache_input_text_sha256": "62b64ca5333305f64df0a66b26394f733cc9fcdd03aa1f22b936a8f09456cb07",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Unsupported assertions in later papers had doubled over 25 years,",
      "exact_native_cache_key": "88b5347428c781355d33ace39c3d9bf113bb4253.pkl",
      "cache_input_text_sha256": "2231f01aa47efc0674c1ab3b79f142eabe44fe1f5a7c7862a859c56f9c677311",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "with citations skewed towards positive results.",
      "exact_native_cache_key": "5e9972b1211854f98287dc1f402b26015d9e5edc.pkl",
      "cache_input_text_sha256": "e006d5d0ac4d970bb791de09d204d55dccedf74dcc3a31e5147d52c9347ef0bf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "In January 2025,",
      "exact_native_cache_key": "6d0d2d94832597771319703952b20ae90acb6d36.pkl",
      "cache_input_text_sha256": "df13e3430e330bc46b7382968b380967c5c44934997a6bde99ab647554082655",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "defenders faulted the critique's methods.",
      "exact_native_cache_key": "137a6e3ae6b9843763ff3baaa72455d7115a7ec3.pkl",
      "cache_input_text_sha256": "49472fb26344926979b166bf52dc60559ca12c6259c8c1a639bbde2143f3804a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "It is evidence unearthed in real forests,",
      "exact_native_cache_key": "55a73a8508b65f583c5f8f85afbbc2334ea65073.pkl",
      "cache_input_text_sha256": "c9aed4e71e88d60176f2cbe7914fa060768c4afe33c785cfc703dca2ca50fb99",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "not the allure of a family saga,",
      "exact_native_cache_key": "81848af8ed13023603a8c0ce36a521afc312bc60.pkl",
      "cache_input_text_sha256": "ae70422aadfe4d19bf9e96b216580d1679a83d9ff0488e3d15478eb11f99a364",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 3,
      "source_slice": "that must settle how much the networks convey,",
      "exact_native_cache_key": "38b9bf07bf075480fdec2fbf7abd25d16429eb61.pkl",
      "cache_input_text_sha256": "69b9b5e53d280088ad7201933f3eab90b55287070a48dc724008a0722a1b1a49",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 4,
      "source_slice": "and whether it matters.",
      "exact_native_cache_key": "b54120a62095b07af479914b2e362ed0ac74a323.pkl",
      "cache_input_text_sha256": "debd55d22dbd1063eb63f4d9eeb4c62ec9f5833c0c7b75f73ed25a95571131ea",
      "cache_input_is_phonemes": false,
