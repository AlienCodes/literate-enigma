        "exact_native_cache_key": "1466a4b96b4bb88e5be7df5e85385b4e0ca67e34.pkl",
        "cache_input_text_sha256": "ac8cb8645d7b8f9bb71bba4d2ea1306235778c3fd18085a8bae638ade0283daf",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 3,
        "source_slice": "but kept flowing through samples without quicklime.",
        "exact_native_cache_key": "243291a613c6cfc6e796cc3cd65cf75b3221f6e7.pkl",
        "cache_input_text_sha256": "1a9b350abdac4f592fea30937de54c05c5b999eb1e3dab880f4f2e4c55fe73b2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "Cement manufacture accounts for about 8 per cent of global carbon dioxide emissions,",
        "exact_native_cache_key": "c70ce8681abfde62c20b16088b124638c977e9d0.pkl",
        "cache_input_text_sha256": "c6b82d51614ca493d8f4a228a681b2997e3834d85f3ad7a858af623a07963f7e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
