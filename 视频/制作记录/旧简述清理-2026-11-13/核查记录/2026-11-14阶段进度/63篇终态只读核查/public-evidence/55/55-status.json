      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "Nearly 1,900 years after its completion,",
        "exact_native_cache_key": "f35e55d162730bc8f54d407a5eaf539ea91128c8.pkl",
        "cache_input_text_sha256": "7a912ef69853568b0497e7e5258da1d7e02e03e746fdeae412e477b6970bb235",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "in about AD 125–128,",
        "exact_native_cache_key": "97c2c9ae9b247c9c6fe5a977945a02f93e2309f7.pkl",
        "cache_input_text_sha256": "8fbbc76d669d3dddf3b16dcc210fc0f6014b8876a4f22c327f3130e14004df2b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "the Pantheon's dome still crowns the vast chamber below.",
        "exact_native_cache_key": "475058e9acdf9148700d8a2bcf08e4413ff48375.pkl",
        "cache_input_text_sha256": "afe85eb054b6c44c828a6aa3813dffe963aa73e39b9cb815af15b8636da0aaae",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "About 43 metres in diameter,",
        "exact_native_cache_key": "da22a5eb7ffb5aa7eac47dbaac3204ebe3081a12.pkl",
        "cache_input_text_sha256": "6cd6076ea61829248b78ca500beb4fea0321637d1bad9ec20d59db3cd7607920",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "it remains the world's largest unreinforced concrete dome.",
        "exact_native_cache_key": "a3587c5c809e7164f3a5a4990f69fa5790dcf930.pkl",
        "cache_input_text_sha256": "437fcd442a115724034890b3c3f434e10dd9341033902c1c50c96d1807a98dff",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "It is an astonishing feat of architecture,",
        "exact_native_cache_key": "8b81bb19f25e524f63d8859f85ce7fe1f69e0db4.pkl",
        "cache_input_text_sha256": "c5cdf72d761c054175196acf1408708c5b8e3d09b997f785e762b7163db6e840",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "and a stubborn puzzle.",
        "exact_native_cache_key": "74004ea1465cf7fad70d2ac3fcfd926a7ce2c8d6.pkl",
        "cache_input_text_sha256": "0d97867c51e8e9099456fbdb0024ae63e4c83c60b7105fe1f3e3a98a04e3f747",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "Modern concrete is usually reinforced with embedded steel bars,",
        "exact_native_cache_key": "da74a3ff39a08452d2b7c8243af9eeabe5070663.pkl",
        "cache_input_text_sha256": "9893c18aa5d5f55163e892448baee8c5a83a34cfc146b85108530230ab3a02f1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "which are prone to corrosion.",
        "exact_native_cache_key": "787bb548eec10038e39745f02e631f548d231201.pkl",
        "cache_input_text_sha256": "e73bf72bc82470addabe7c93bff9abed0cf1339f0ad6cb2df5a06211cc3a4b99",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "As the steel rusts,",
        "exact_native_cache_key": "0e65db92475156e35f198a7076391365a860b0e2.pkl",
        "cache_input_text_sha256": "8c384c0813f888fe9b6470bc19ff7d510deca47495b30d3bb629163a2976148c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "it swells and fractures the concrete around it,",
        "exact_native_cache_key": "41a6d4869e22b933bb76cec1cd23f4b23b58c356.pkl",
        "cache_input_text_sha256": "4585141ab62e283850b3224486dbed575600d8f5c8bf07d9eb2aaf2e236d5494",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 3,
        "source_slice": "and many structures are designed for a lifespan of around 50 years.",
        "exact_native_cache_key": "42646e0ec9991ad5786c1e5e785b9ddbbbcac04a.pkl",
        "cache_input_text_sha256": "8fcd4e22042899b2025175a4e7d1508ab3222f37cf216586ceee467f0088c54a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "Roman concrete is not stronger than its modern counterpart;",
        "exact_native_cache_key": "26b670812a9ae94f704a0ad5dc2dd76c8bc5f1d9.pkl",
        "cache_input_text_sha256": "0e33fbd396ffbc14f1f92caa06195e69fc4dbf22534da89a3dedf9091f644207",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "its merit lies in durability.",
        "exact_native_cache_key": "4a6318730a06902830b53b72aaf92b9e6436c7cf.pkl",
        "cache_input_text_sha256": "cca4ef6fa267ac7ebfcc2bff3d416b6dc862a2333cae41136df69285befeb766",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "It is dotted with white chunks of lime,",
        "exact_native_cache_key": "943af748cd04fd22df44da9a6c2f220b51f13305.pkl",
        "cache_input_text_sha256": "62fdca21b0504c3e4f08b5429008bf50bfacb6527db92000f20d2835f708b225",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "known as lime clasts.",
        "exact_native_cache_key": "47c1befcbd21e2f75778ed5485fd2f135708ed5e.pkl",
        "cache_input_text_sha256": "62023c284cff3836115354958cd460411259e9afeb51db947cb5854470e6c640",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "Experts long ascribed these lumps to sloppy mixing or inferior raw ingredients,",
        "exact_native_cache_key": "8979cfa7c8b42ebf9924fb17fd79e04b8434f47a.pkl",
        "cache_input_text_sha256": "4c90fdfc35b8125e545cae44f2970b0f61aef4e985b576a5307732cd9ccad6ce",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "a defect that,",
        "exact_native_cache_key": "c20b494865d53336afe1eab454d86ead37f8ecab.pkl",
        "cache_input_text_sha256": "cba448020eeb075b32aca0c3913d9f3d2636b6d1bf9d1315a9a4d169c4afa9cb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 3,
        "source_slice": "they assumed,",
        "exact_native_cache_key": "d44f0ada5aa7630e5a039ee923a78d370a637564.pkl",
        "cache_input_text_sha256": "2f20a7b13195fda6a8dabee528932d2da465d2451ebd4deffc950fe36483f096",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 4,
        "source_slice": "a more conscientious builder would have avoided.",
        "exact_native_cache_key": "604570a4f20ecbff963fceb5e1124c191bba6f25.pkl",
        "cache_input_text_sha256": "cb148b29ec250df6dbdaa09360c13947ecff4ce48ff8f2c0399ed9ccc8747bf5",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "The clasts,",
        "exact_native_cache_key": "fd5e9e0852e5911f0515d6c73346174310bb0182.pkl",
        "cache_input_text_sha256": "86c88f51e057f347ef3add2e2d512714e1d87cbcf769820993195e390eac40ca",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "it suggested,",
        "exact_native_cache_key": "caacd5e8521afbdd5080d5b7d5dea41c64027e4e.pkl",
        "cache_input_text_sha256": "256ab2eec8f498cb4ab9fc0cc25c87cca5ad29dc3d97f92a6b9a9872014d34f8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 3,
        "source_slice": "were a by-product of \"hot mixing\" with quicklime,",
        "exact_native_cache_key": "4360e1a4c902f219b7ff435d842e0d4c4487fe07.pkl",
        "cache_input_text_sha256": "b62760b2c6bcf2e6bb7cfe8b923fe9861d0d99b8929b3d81e89f8bc7f7052f84",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 4,
        "source_slice": "a reactive lime that heats up in water.",
        "exact_native_cache_key": "96da1526b3384c0468d2debc16190f5a2596b903.pkl",
        "cache_input_text_sha256": "81372eef8c2c490df2b2af1c8b57c29c88c8153d4ec13ed8715370bd9b8950e8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "When water seeps into a crack,",
        "exact_native_cache_key": "c707895ebae97eeccef499afda30434ca88e4a6b.pkl",
        "cache_input_text_sha256": "b4fc9241abaa6aa753dc6550960c7abfcdea3859ad9ad5cae73a63726040f4c3",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "the clasts dissolve and their calcium recrystallises as calcium carbonate,",
        "exact_native_cache_key": "23410e7c136be6b04eaabeeb3d9c0a08d5e51b2e.pkl",
        "cache_input_text_sha256": "9306f9686299a29458e280a0c333d61d3f3a43082f22a0a1ffeba999235f77d1",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 3,
        "source_slice": "plugging the gap.",
        "exact_native_cache_key": "327288178df43a5d5e5fe859b39f355587f9bc7c.pkl",
        "cache_input_text_sha256": "7517e70c2d5b59af306aaceaf181fe4c155528a6ec5a21a0f116df42c7fffa32",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "In tests,",
        "exact_native_cache_key": "889539d9d1cf0ea250bc0e6968c24351944ed3ed.pkl",
        "cache_input_text_sha256": "58a1178ecfdd1e5ccf32e302468cfee790a41dce46306ff71c70372a46e2b830",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
