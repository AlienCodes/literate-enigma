        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S16",
        "piece": 1,
        "source_slice": "Concrete that mends its cracks could last longer,",
        "exact_native_cache_key": "0ab52d15f71452f1b4309885432f0fc9ddfe28d8.pkl",
        "cache_input_text_sha256": "efaacdd80baf79adddbd12824e05fd11bba4f386bd69301d26e1b5a8f1d9ec0c",
        "cache_input_is_phonemes": false,
