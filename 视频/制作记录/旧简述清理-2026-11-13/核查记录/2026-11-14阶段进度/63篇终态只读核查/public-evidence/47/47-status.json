    "reference_calls": [
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "On 12 January 1995 eight wolves captured in Alberta,",
        "exact_native_cache_key": "f0ed3668a9d10e38b9017d97e2f527deec33831e.pkl",
        "cache_input_text_sha256": "0d879abeb12671b3081f6a3a7b01c07ceb657bad0538e9d4163ea5b93b621fcf",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "Canada,",
        "exact_native_cache_key": "f37bdc25569cbafb041f0087ca13dd1db2f374f1.pkl",
        "cache_input_text_sha256": "01adc911463c14348859a86a3094f52bb697ce747c2e36547e3de3c142445ae5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 3,
        "source_slice": "were hauled to the park in crates;",
        "exact_native_cache_key": "240e77821f1bdf7ccfedb69ddfa098e10ea42a87.pkl",
        "cache_input_text_sha256": "ea21261fdc991d12ed749df0e2e131835b5eb7b515da37f66237ebce67cd38ee",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 4,
        "source_slice": "six more followed.",
        "exact_native_cache_key": "b061cec80c3af87cc564e5a851ccd13c04119c19.pkl",
        "cache_input_text_sha256": "f491b58ed015880baf4f8b39f2b3a4031f2ce9afde159003e319836e901edb66",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "Released from enclosures in late March,",
        "exact_native_cache_key": "5647255400f56c728f67a4c14358834afc434d97.pkl",
        "cache_input_text_sha256": "46de021138545fd2536c29e1aa8e1f3922a30ea106ad7d65b271c162c8ef736d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "they roamed the wilderness.",
        "exact_native_cache_key": "c5800fa3805f860661af1573058106520a882541.pkl",
        "cache_input_text_sha256": "f3e9635348eade12d03241bf0326d7cebaa60d346ed4891c696131b6ff535a23",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "In February 2014 a viral video narrated by writer George Monbiot spun a compelling narrative:",
        "exact_native_cache_key": "bdad5a2d1ebac0006f77973862e4ef257f4e4581.pkl",
        "cache_input_text_sha256": "3ac9a6ae09d6903cb492699cf9dc745fcbed4202efb5f7a798a9b46ee6ee62bf",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "elk,",
        "exact_native_cache_key": "2117805ab1da78bc5e184d25041630d5737f8dec.pkl",
        "cache_input_text_sha256": "acf84c414c6314a83f7e9aaee1118133c4394dbc48985edd66b9940a0f0ce69e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 3,
        "source_slice": "thinned by wolves and wary of them,",
        "exact_native_cache_key": "e02e7c3c2a003b5bb39cf88314657d3a10ef829c.pkl",
        "cache_input_text_sha256": "d211c91e00a0a169b1aff6074d1dca8dd616090383a72e0ce3413b0848c33ccf",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 4,
        "source_slice": "retreated from valleys,",
        "exact_native_cache_key": "941d13bbf77e7901d5eeec030911fbfbccca0132.pkl",
        "cache_input_text_sha256": "eb50cbca58d70006e5dbe28e52140c124bf4676c5a349632660c28273dbcc751",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 5,
        "source_slice": "letting willows flourish and riverbanks stabilise.",
        "exact_native_cache_key": "cda8c49f74876be7183dcad4704753d33ad32e59.pkl",
        "cache_input_text_sha256": "f8f582ff3d84e08d8f282b2a16c6343d7a0362083939461811e3befb21d46c2b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "Ecologists call this a trophic cascade:",
        "exact_native_cache_key": "af771427df5bc43057b6e52bbb6b081459e1f6c0.pkl",
        "cache_input_text_sha256": "fbbaf37eea6de066d7fccb7bb886e91f2f065ab4ddfbac5562350d4b5a78c4b2",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "predators eat or deter plant-eaters,",
        "exact_native_cache_key": "a8ed94b3c70c551ce0a018c9b746f4fa169f30a6.pkl",
        "cache_input_text_sha256": "16bb957d5834ab352a9ff9af2116243a38268a0445e12a2a97f077fc64ca579d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 3,
        "source_slice": "and vegetation rebounds.",
        "exact_native_cache_key": "a3e5e1a7f2e777e438093edf235f84020301e135.pkl",
        "cache_input_text_sha256": "0513ea79a1cfa47698f53083a20a5fe8fbc72f6eeadd8c72842152e50b7012c4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "Yet the census undermined the thinning claim:",
        "exact_native_cache_key": "02900712dde75fadc561e91b0c54fc3cca3532e9.pkl",
        "cache_input_text_sha256": "bc28bb075a197d033b263290318bba6d587b404b8b23331f773bcc48079ff64d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "elk on the park's northern range peaked at about 19,000 in January 1994 and were dwindling before wolves arrived,",
        "exact_native_cache_key": "35367d6c74e9095237094ab6d7122b58e814f382.pkl",
        "cache_input_text_sha256": "d07965872e8a68933ebf14afc7b000fabee93f3f105558a63a44e3cae772e45d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 3,
        "source_slice": "depleted by hunters,",
        "exact_native_cache_key": "f33b2e56718c2e53aaedae9554a65cc3aa9a6f0d.pkl",
        "cache_input_text_sha256": "7c6c11b8515cf354b9efe7811dac2aa5e44509f7e7302bd7c97de90db710579b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 4,
        "source_slice": "drought,",
        "exact_native_cache_key": "2afecd950b3fed0084d9f51a2550b204a2c56840.pkl",
        "cache_input_text_sha256": "86cecd4f8c053451d0cfefc09e888fdaa65336729a5cdc412df961ff6004116c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 5,
        "source_slice": "and bears.",
        "exact_native_cache_key": "cd351cfd2f58a9d4778248ebd3ce7f080822e763.pkl",
        "cache_input_text_sha256": "8e699934e76fd1af019bcb93c0f93d8fa43fa3bbfe63f24369d06080884f5458",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "Fear looked weak too:",
        "exact_native_cache_key": "7629066ac5f9346af2144bf4878003545b3fe99a.pkl",
        "cache_input_text_sha256": "6eb785b97b92ff402b7e1b8b66513d517117f20187208674a29233d2cc28d3f7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "in June 2013 Arthur Middleton's University of Wyoming team found that collared elk east of the park kept grazing unless wolves ventured within half a mile.",
        "exact_native_cache_key": "f4c3d5c63c9af4b870abe633af5b5b1ac94087de.pkl",
        "cache_input_text_sha256": "5cfd51ca60f303c587bca36ab3feeec466301069c7c8e8ad2813a4e52154192c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "Trees fared no better:",
        "exact_native_cache_key": "2ed296451c723fd288d5ad7cf9d5c5d0c3face56.pkl",
        "cache_input_text_sha256": "459dde9cb84a1fbe08a6f4a2d8d81a21cdcc9a9d7b89303c044e2f32545d1e25",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "in November 2021 Utah State University's Elaine Brice showed that sampling only the tallest aspens overstated regrowth four- to sevenfold.",
        "exact_native_cache_key": "cda303b254ac7db14c931dd2842f475cb333aee1.pkl",
        "cache_input_text_sha256": "f2824c151c61a2ad94431569b50f6c5af3c799f2ad28cbbf546b48883473e6b9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "In January 2024 they reported:",
        "exact_native_cache_key": "5bbd44e897abbaed54ebb045c7a416b6317de5fd.pkl",
        "cache_input_text_sha256": "2da91c59fbb9ed5a3919f84b469e13326e4812318f7ccec0f99a47612bf8f3b8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "eroding streams had cut so deep that stunted willows no longer reached water.",
        "exact_native_cache_key": "0f767bf8f8d1fbf78edba0f0f02705f28361a522.pkl",
        "cache_input_text_sha256": "1d5dfcec3a041330039cb2d952fc08e48519b3f5874faa972fd972cb25e8f302",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "In January 2025 Oregon State University's William Ripple,",
        "exact_native_cache_key": "5402396305245853c7e0fa61c016680efabcf351.pkl",
        "cache_input_text_sha256": "c45ad76352b705d789b1325e4967ebfe72ceeaf204a588f215bfc0f6dab8bf10",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "an advocate of the hypothesis,",
        "exact_native_cache_key": "df2f015f38d200c7b2a419bd8d2fbca8917b2d17.pkl",
        "cache_input_text_sha256": "42db7f0c11132e10afa7de80c44fd1785f2a14d08fadf0476881f3a2b6c11d56",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 3,
        "source_slice": "reported one of the world's strongest cascades;",
        "exact_native_cache_key": "60b683d8a4a735aec68400da232dd3a64178ac68.pkl",
        "cache_input_text_sha256": "55f614486742c7f1b4c749ec3915e0f9b2770d9b851424e5e5e6eacfcd2bda21",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 4,
        "source_slice": "critics disputed his methods.",
        "exact_native_cache_key": "ed837bcd38e0c479cb29a40470dc2b749fb5da01.pkl",
        "cache_input_text_sha256": "172a958caa7637ed81964fc8a0890a5d276562a1ba3a3b6b637777430df433ca",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "The question is unresolved,",
        "exact_native_cache_key": "279e8576f534fb7e417c1b89e4286725671d81c3.pkl",
        "cache_input_text_sha256": "08edad5c2e043d4a7696e65a209c9a96667b2a546cd48ea9e11d368bd251cc0d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "but the wolves' shadow looks fainter than the fable suggested,",
        "exact_native_cache_key": "0be4e1d70611cabc00f88c202fff3b0e7ca780f9.pkl",
        "cache_input_text_sha256": "3fefee0627a7edab49bdcf005bb206bbf936cdf1ccd9ea8e76d7efd227cb1e54",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 3,
        "source_slice": "and the science messier.",
        "exact_native_cache_key": "c6e7bce013fac7ed0fd85037ae62518a1e3e3191.pkl",
        "cache_input_text_sha256": "6754429d57be33e023307e64bb82555d1003fcde0412669cb1b0a0df070be82e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      }
    ],
