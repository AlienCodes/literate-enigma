        "cache_input_text_sha256": "4aa6b6f1632359e4dad03db41e4a0e77f96e03d7156adeb04433e2f165aa23d9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "The sleeve gives guidance on playing the disc,",
        "exact_native_cache_key": "b8caf5ff20a343ccdc8101dd00d71f09b7e0d234.pkl",
        "cache_input_text_sha256": "d26288babda42f723a87ade37e4fdc9cf4aae225ba9f5d7f52a16f6e63bddcc4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "plus a diagram fixing the Sun with pulsars as beacons.",
        "exact_native_cache_key": "52866360a746cf0d9c269deeeb6fb614cb1ac3db.pkl",
        "cache_input_text_sha256": "bfb83359116fdb5d5738deca80af8b56deb899b7b0b20d929badce1860e13204",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "On 14 February 1990,",
        "exact_native_cache_key": "9a9b33cddaaba34cb95853dee6ba07ee8c7870e7.pkl",
        "cache_input_text_sha256": "7af68d4b852b9b80cad6e4b5f00f2ba4b1693de96be48d7762c7dce912ea5d5c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "at Sagan's request,",
        "exact_native_cache_key": "779335f116670810e4e71cc3357fe5b49848169e.pkl",
        "cache_input_text_sha256": "458969dfc7cf961f8f3632304e5abdee9b0d81510903395b8c75a249c1ed545a",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "Voyager 1 pivoted its camera for a glance backwards across about six billion kilometres.",
        "exact_native_cache_key": "7152353b92e5737c555a0cfd9abbbe4942025f2a.pkl",
        "cache_input_text_sha256": "728d4f414d64a6dc0dee33309aa9361fef7a4f0e45c36285845c2db512ab6422",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "Sixty frames formed a panorama of the solar system,",
        "exact_native_cache_key": "cee515f73b83ee9d7e57b0e6fca00fb613302056.pkl",
        "cache_input_text_sha256": "95aac85cadfbe0e37c03c72381768740bc34ed46e5382fd0c9cae29457c7f69b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "a mosaic in which Earth was a glimmer about an eighth of a pixel across.",
        "exact_native_cache_key": "7ee414ddae420755fcb4a3130f9b5a32460567f1.pkl",
        "cache_input_text_sha256": "534a0c4e0458571a945d276b3b67d099be2fa7a50e4f0bc8c558e07988708061",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "They reached Earth's receivers between March and 1 May,",
        "exact_native_cache_key": "8d783b4ea5318ae8fcee439b62b7bcbb47092edc.pkl",
        "cache_input_text_sha256": "9d62ed4e20742be1c50f75c2cac4746e4859adde60d4e16e2543a15847518e59",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "each signal taking five and a half hours.",
        "exact_native_cache_key": "c8f9780cf11aac2f58d96a4d80b11a25a9db1c51.pkl",
        "cache_input_text_sha256": "ecec5b6ce5adaa9bdf316df88bfb20ab9663e89c6da9af4c762a06c92f2ea29a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "In a 1994 book,",
        "exact_native_cache_key": "0199d4fe2112a832103044e043002aad7d52bf7d.pkl",
        "cache_input_text_sha256": "1f087118be6b0f4edccb62db21a47fb2b7c5f26a0a74a17a5597152d739f2ad6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "Sagan offered that pale dot as a perspective on our small and ephemeral place amid cosmic vastness.",
        "exact_native_cache_key": "faa3e538ccc3ded01dcede02fd8b0dbd754b01c9.pkl",
        "cache_input_text_sha256": "b0cb61d1fcc72b46f5f947ac2158c5defa8ceb9cc5db1c8ba804dbde51a7a7b0",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "Voyager 1 crossed into interstellar space in August 2012,",
        "exact_native_cache_key": "d588e655b8246c064efef31320276b44a0b75c83.pkl",
        "cache_input_text_sha256": "27c4b0372d8849200f8abe1acb6f15acba89080361bee44f7ab70c7aeeffabc3",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "the first human-made object there,",
        "exact_native_cache_key": "0a561d2ad05afbdde30a3d69d0bba20cce969fd0.pkl",
        "cache_input_text_sha256": "4317887749765a41a731647d975eea3c9ead6f9057875c3e97d4c00d66be81b4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 3,
        "source_slice": "and Voyager 2 followed in 2018.",
        "exact_native_cache_key": "64f55accc3cc6d9ebc57a551f88b969c49b50186.pkl",
        "cache_input_text_sha256": "1b7beb29100f5071d83c30de329f4d0ab3389d734b7e8e0fdd169541d3bad48e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "Both work on with a longevity unmatched at NASA,",
        "exact_native_cache_key": "1ecc02173b1aaae3bc717e5c53ec7ebb45743f7f.pkl",
        "cache_input_text_sha256": "ac27295a007571bbc54ea69f3e94c13c8bf2134aa3fe072347613866d8ef0fb8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
