        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "notably Bach and Chuck Berry's Johnny B. Goode.",
        "exact_native_cache_key": "927ed66b4f5e3f6dc869f38c7576e6d9f2b70675.pkl",
