        "cache_input_text_sha256": "7581512dd23e964cbbd1becec34b427f71bb3cb8cbb301a74d25b71b8bd23139",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "encoded in analogue form,",
        "exact_native_cache_key": "9295daf44a070e8495ee03a294f2fa5a03a0f7fa.pkl",
        "cache_input_text_sha256": "e8a94d84bf3ffd71b999d4c9ff8c3c69b10ec59fcd0c041dde191c25c317c9c2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 3,
        "source_slice": "sits beside printed words from two statesmen,",
        "exact_native_cache_key": "b0818bf9dbf70fe5c3118248011fac419e638a9f.pkl",
        "cache_input_text_sha256": "94628054537057a6aec90cfb2b254fbfdca8449222845d4e0d1b0728b6e0ff69",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 4,
        "source_slice": "Jimmy Carter and Kurt Waldheim.",
