      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "as a total eclipse obscured the sun,",
      "exact_native_cache_key": "3c4602b7e4f8f03adbbbcd32372def14cf38987e.pkl",
      "cache_input_text_sha256": "a73342576810501db8b6bccccffcbe8450267db9a6d40949fca927d366178243",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "two British expeditions photographed stars in its apparent vicinity.",
      "exact_native_cache_key": "a687092a14a735ba4af8b11d9399ec56a10e57cf.pkl",
      "cache_input_text_sha256": "ada9d85efecf453a0b7274699438381d3837f8d2d943054afa8370ad4a0111fa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Arthur Eddington observed from Príncipe,",
      "exact_native_cache_key": "d66c3fcbdac406ba5a30657a39c697be14559851.pkl",
      "cache_input_text_sha256": "9c221cbb07bce12d643b2d0c58215ffbc19f7f3adf514891cb6d1dd9fd79fc3a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "an island off West Africa;",
      "exact_native_cache_key": "c97cfdd96bc216686fc365a70fcae84f166ec445.pkl",
      "cache_input_text_sha256": "31f0b8737fd84bf8f7d86b1954d064c26d82520a1fbb719116f2d148daf9e962",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "Crommelin and Davidson from Sobral,",
      "exact_native_cache_key": "6a2293668d322267c775848953984f7312152c2b.pkl",
      "cache_input_text_sha256": "55f282b02f25b29d2f55ac985e7009ceaf80b1b3b1a33f60d96cee624b338831",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "in north-eastern Brazil.",
      "exact_native_cache_key": "e3618e6ed57849906c47f5e5fcd16773e6b71fe1.pkl",
      "cache_input_text_sha256": "3a6b4e06879b9789cd11c1921f5f29760487584748aab3fab69f23def7f928a0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "On 6 November,",
      "exact_native_cache_key": "d37ac4fe2f98cdfccc0f0f963d625c8f50722ad5.pkl",
      "cache_input_text_sha256": "26d9125a9575dbb7824c465a1c3dbde130d372ee84dd642ed1efd3c63e817a82",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "at a joint meeting of the Royal Society and the Royal Astronomical Society,",
      "exact_native_cache_key": "173ab0052a47e25a2a1f41b1806008947998b5e3.pkl",
      "cache_input_text_sha256": "768f4f9eaa869dccdafde518457284dd9813ccc033195309f1319bf30d463031",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "the findings were hailed as confirming it.",
      "exact_native_cache_key": "07563d90f28fb88629380382fd92d4cc8c8605cb.pkl",
      "cache_input_text_sha256": "43f7ef0a565c187c6b4001af143b8ae3592094b10fe43288e1048ba352158c62",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "The Times proclaimed a \"Revolution in Science\";",
      "exact_native_cache_key": "d8c928e60f711286ff807aeb00ad3eb60748457e.pkl",
      "cache_input_text_sha256": "e2f1cf9b7aa4f5606c83e113524668e1b1655b0ab812e30b8531c64468770416",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "a New York Times headline read \"Lights All Askew in the Heavens\".",
      "exact_native_cache_key": "65dbbefe5f5030a34af99d511adc9aa94aa41cd7.pkl",
      "cache_input_text_sha256": "6c8c4593c82ee858f3a77dbe196502ca8ba712cb021c947360872160a6ca5aad",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Almost overnight,",
      "exact_native_cache_key": "cdc99d5db7ed43c614cdf295fd756c9e72c62ae3.pkl",
      "cache_input_text_sha256": "6c34bd35f9bcb9749de4e88f0b357e7e29d39df2461887430143fc709e4b9b72",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "Einstein,",
      "exact_native_cache_key": "fc79eaed8b869133a2e8553bbc16ee05117115f2.pkl",
      "cache_input_text_sha256": "c24eb39f1b1a42070a0df547ac5122228023cc6cddc7e786d773af9e86093dba",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "eminent among physicists,",
      "exact_native_cache_key": "702b86915107f40f56531f73f4aea64795c2e6c5.pkl",
      "cache_input_text_sha256": "109acc6e63c082bc4111fa542bbd9db5a44af71d8740c5279b1cac0a4bfc756e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 4,
      "source_slice": "became a global celebrity.",
      "exact_native_cache_key": "ed66ea8b905c417e0414bc8360bef93072b8f1a2.pkl",
      "cache_input_text_sha256": "c2a4d95e9946702538cffec41fe37a0abd75d9f62c5afd005d15413775809a48",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The Nobel physics committee valued rigorous experimental confirmation,",
      "exact_native_cache_key": "91441928c13befcb07ed990e7c3bfbaaf1d7e032.pkl",
      "cache_input_text_sha256": "4c081cf12f06fba3048ce8cc793c3c120c83db45fce8ef4879785f8b55c5c3bb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "and committee member Allvar Gullstrand,",
      "exact_native_cache_key": "c9e9a8558a0240363ae8df58702fddd60be47f05.pkl",
      "cache_input_text_sha256": "9e75f3b4163fe15b2b4f9fd37e0d962fc2f441f87264a21c027da50f49f90a9c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "a Nobel-winning eye specialist,",
      "exact_native_cache_key": "2365660d1f64b4195cb6215180ff1c0579e648dd.pkl",
      "cache_input_text_sha256": "0305bf75612b1906e943cd448a6157d764d09731d182f05077caee72c281ccf7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "deemed the empirical support for relativity insufficient.",
      "exact_native_cache_key": "b77ea07187e9acd1cebde5eea878f5ca7e28da34.pkl",
      "cache_input_text_sha256": "afe829f6cf9dea978aadd3ed810af35ca1ad227a84115c45076d665565cb20e3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Since no nomination fulfilled Nobel's criteria,",
      "exact_native_cache_key": "56c22b5591d1c6ba3eb9c64958a95e4a5a9d5477.pkl",
      "cache_input_text_sha256": "30861ec96410d751b6510f13d268b55c94ecdea916e0cfd1a2de7cd466d5956e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "the 1921 prize was reserved for a year,",
      "exact_native_cache_key": "4fae8a1a29bfaf61531fbe776a0b772ea6d3d435.pkl",
      "cache_input_text_sha256": "74fe89d2ffd6927e3c85030e5f62f71b6fe853f49584181a87a648069f95b9c2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "as the statutes permit.",
      "exact_native_cache_key": "cb386f43d441420f2539df6223d3595603a269f9.pkl",
      "cache_input_text_sha256": "070c9942c48b2d569002c28a7cc24bea83ca727f426c8347874731e5dda44e2c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "On 9 November 1922 the Royal Swedish Academy of Sciences conferred it on Einstein,",
      "exact_native_cache_key": "45699b38c628d76d38a01e1f2cbabb1873ee0a2c.pkl",
      "cache_input_text_sha256": "2efe566920ab99ef55ec99ab0417a50d6df6d1da6b27e0dc3897173c8a2929ea",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "citing his services to theoretical physics,",
      "exact_native_cache_key": "cb14d66e4391cad0212631e82fe6ef79a3c2d4ec.pkl",
      "cache_input_text_sha256": "27ad775340bde5f5500d27817465430cf7cb331001afb617961012288847f22d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "especially his discovery of the law of the photoelectric effect.",
      "exact_native_cache_key": "55173de1064e3985925e376ab3143b389ba32461.pkl",
      "cache_input_text_sha256": "6619d484fa5f0479ef851dfd88ef92962b22a7b04d0912f6aa7072f885fb4625",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "That law,",
      "exact_native_cache_key": "b5619f2324c8e76d6c25a45bb430cbefbf08d119.pkl",
      "cache_input_text_sha256": "8bd5c588c68ae72d65e16f8a9b7bdedd52849c519fdfc5dbbc1bf244357d307c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "which governs how light ejects electrons from metal,",
      "exact_native_cache_key": "bd181ce5e0d9876a1d68d757d45bda9a6d05232e.pkl",
      "cache_input_text_sha256": "109e1aec84e93666e6ba858310250ca8ee5a8888b9d2d850d3b9bcfeadebb21c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "helped underpin quantum theory.",
      "exact_native_cache_key": "5521765d1387049381c70346bf25d7aa0ce3b742.pkl",
      "cache_input_text_sha256": "15a024325d66f0c6cb937bca7b0265a97e74761682f7c7b9da4985d9be9fd4e2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Einstein,",
      "exact_native_cache_key": "fc79eaed8b869133a2e8553bbc16ee05117115f2.pkl",
      "cache_input_text_sha256": "c24eb39f1b1a42070a0df547ac5122228023cc6cddc7e786d773af9e86093dba",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "then aboard a steamer bound for Japan,",
      "exact_native_cache_key": "94168d0a2650ec9a02f1be3b40310db20d031e5d.pkl",
      "cache_input_text_sha256": "38ee698edc36275b15359775ed9aead7f46b622c5aded0088f8297a44355f7db",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "would miss the December ceremony.",
      "exact_native_cache_key": "f6429e42d55a158e74099b03095c5c8b6ea2c825.pkl",
      "cache_input_text_sha256": "c2a2a4e0060b9e41b8a47e242211c9b6fd829f4a5f3a1a16a5a73a5c93bb9136",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "On 11 July 1923,",
      "exact_native_cache_key": "9c7631106332418e5d374b3a7db3defb5ffb1a7d.pkl",
      "cache_input_text_sha256": "13ea35b5ddbd9e5fe8ce14bc019dedbd54ad170a905aa1714de714ba1f5a3dd8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "in Gothenburg,",
      "exact_native_cache_key": "8f3f0ca071dc2f4749b29b5c1d5790922f44db03.pkl",
      "cache_input_text_sha256": "b0aab6a1722a89ada4237de0e9861bc9618613cba1fd31f2c2a425aba4430556",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "Sweden,",
      "exact_native_cache_key": "408c9155b4b9f8a355d303c547cde49ea8b69792.pkl",
      "cache_input_text_sha256": "f8e207e456cf025d495d1cfcf9bcd51e0ada4adecfc4a5d4668145ef3dec8afc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "he delivered his Nobel lecture before a congress of Nordic scientists,",
      "exact_native_cache_key": "1f4d09fd4e6cb18655873bd92a1912b92d822df9.pkl",
      "cache_input_text_sha256": "bfd06bcb5ddd38e9184faaefd9e8a6bb22f26eed928467e9e67834059e18f501",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 5,
      "source_slice": "devoting it to the fundamental ideas and problems of relativity.",
      "exact_native_cache_key": "d42d0f1a35074911360c8ec3e00a5af9e5104657.pkl",
      "cache_input_text_sha256": "a7d22682740e70d1049d717043aba863408449a45a29d78b06f71233a99446f7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "The theory the committee looked past reached a Nobel podium after all,",
      "exact_native_cache_key": "ef4381d0cec19a12bf9a224b463678aa82d3d3e4.pkl",
      "cache_input_text_sha256": "30473a92c5660274276b361f34aa576280c8459b390e7bbadd666f7811ce88de",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
