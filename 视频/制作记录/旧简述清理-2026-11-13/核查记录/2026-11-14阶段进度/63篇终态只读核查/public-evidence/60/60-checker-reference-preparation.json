      "source_slice": "carried there by the man the prize had honoured.",
      "exact_native_cache_key": "e32bff4a592ad1ade6d605b0087c952a9684e422.pkl",
      "cache_input_text_sha256": "693abce7c388616ed297c350912e9c98a0156c3b289096cdeb1272a28b65c21d",
