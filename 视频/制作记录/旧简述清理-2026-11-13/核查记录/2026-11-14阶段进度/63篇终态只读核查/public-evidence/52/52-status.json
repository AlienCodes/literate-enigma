      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "On Friday 5 December 1952,",
        "exact_native_cache_key": "bf543751e3fa7f20c9ae064611e6bbadd52d54fc.pkl",
        "cache_input_text_sha256": "8323a6031798f632624a2d403dfc0dadd8a79fa017f4aa9947d9d5dd4a069477",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "cold,",
        "exact_native_cache_key": "d4ea4cfa9d59f60e19ae035d9d45757baa38d268.pkl",
        "cache_input_text_sha256": "63332c2ba313f19a660eb859967cad3949dd4bd831c76ae0e218d8c1ea9099f1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "stagnant air descended on London.",
        "exact_native_cache_key": "0a9990ba9d7ee7bd751af0cbaef9093f6e0fb604.pkl",
        "cache_input_text_sha256": "8fd113c7823916020f857b7fe325442393e4e7b42e3227519db8f7e3d28be0a7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "Overhead,",
        "exact_native_cache_key": "ca914bb95696890bc0865c2abc91f7e7fd24517b.pkl",
        "cache_input_text_sha256": "5c9f3ebd86d14b2a9a6a1d04d12a013b2cd541fd2780c5f74209cc6de7497bfb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "warmer air pressed down like a lid,",
        "exact_native_cache_key": "fcd4f3b1a1710a0b8f6dfb8ce05ccf27ddc7fb4e.pkl",
        "cache_input_text_sha256": "05f50c1eab5aaa72339c5823be92fec9014040d3f9393741d31758c8a0a508b2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 3,
        "source_slice": "holding the chill captive beneath.",
        "exact_native_cache_key": "b3ce43201a045ad34418614d3047c5c80484aefb.pkl",
        "cache_input_text_sha256": "9c368f9692024f7b7d438c98061ebcd1d0cf3ff82b30c757f8f443357563eddc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "Londoners were accustomed to murky,",
        "exact_native_cache_key": "03cad1be779b7d65686b0124331db2042c4107e0.pkl",
        "cache_input_text_sha256": "c383dd27e2ddf6b71ebe20900cd2980e8c8300431dfbae5e7f33dcf1c0b4f2ca",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "dreary winters.",
        "exact_native_cache_key": "614a8b85198964b194bb65ef915fd4f42537218d.pkl",
        "cache_input_text_sha256": "7332f0a3e5a59762a199e7e1485c89a2f14adfb7ce4e9952c29417b37d2b170c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "This time,",
        "exact_native_cache_key": "28ba3ac8f43569f6e102a398c6237cad7b90ef38.pkl",
        "cache_input_text_sha256": "660f042ddfb88054d797c6b668df682cd70689990f903d3ac3253a91fcf48bd8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "though,",
        "exact_native_cache_key": "89cf384adbed3301b92aef73e0d5a6e2dd699fba.pkl",
        "cache_input_text_sha256": "f74aee97c33b02ba3bb560ab7eb95d8df67087734052e01c0b90f44a49ffb18b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 3,
        "source_slice": "the capital's smoke was trapped too,",
        "exact_native_cache_key": "9e05aeedaae791ec1f7c0a59cbb317fe764aa009.pkl",
        "cache_input_text_sha256": "37e1d34c08a392d461e1e87d8340119f4b40975489870002f971ca79c5f05371",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 4,
        "source_slice": "thickening into a choking smog,",
        "exact_native_cache_key": "af9072585a3a2c12b147535b3db4a297ea3e5743.pkl",
        "cache_input_text_sha256": "0abc788a7b6f7f3f3c567bf041c6ddb86eed57d4f2ff109eb00927c70b742ed4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 5,
        "source_slice": "a mix of smoke and fog.",
        "exact_native_cache_key": "23f7820b8467c09ea8a229e293a9a657487eefae.pkl",
        "cache_input_text_sha256": "ed823fc1e51537719b45806fece04191c68064a4e5af9f9744e80b8eac20a726",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "That smoke,",
        "exact_native_cache_key": "7439febc72dcb7d78ef250d095760447e48891b0.pkl",
        "cache_input_text_sha256": "d1a194ec9b8a42b6005d0400046c87b85d4b695d91f899d6c54f69647929eb87",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "from coal burned in domestic fireplaces and power stations,",
        "exact_native_cache_key": "01e82348f738e53e2128f58defd8705e983a3f0d.pkl",
        "cache_input_text_sha256": "1ee5c3c627e1f4f315231dafac88f65f697a34b5dc09cb3bcde86184ddfed2cc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 3,
        "source_slice": "was laden with soot and noxious sulphur dioxide.",
        "exact_native_cache_key": "8b853293c57e25e8765009b3a6892eadcadd58cd.pkl",
        "cache_input_text_sha256": "b1b7939bb4144fabaaeba09b60744656f47869f65f8df677063f5d822b368f2e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "In places,",
        "exact_native_cache_key": "826bb39ba21c1506c2b881d13858eda2b6bed123.pkl",
        "cache_input_text_sha256": "7014ebe263ffc2b2902338a8f0d7341d5f5a46a91aff40a10f22c9e551089546",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "visibility fell to a few metres.",
        "exact_native_cache_key": "e0fde084d1c904bcc48533ac9e8fc6f28c7f0b9f.pkl",
        "cache_input_text_sha256": "6693bf7b93b72940593f867be5a61215cb8edf454a363f02c5bc8f64d23e4fe4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "Ambulance services were suspended,",
        "exact_native_cache_key": "9a75c96858d80f44c151043adb48a8240e3125d4.pkl",
        "cache_input_text_sha256": "4cb4b692aa9843c6536cf081d7e092a40722c818be04746dea97eee72f2a8e03",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "an opera at the Sadler's Wells theatre was abandoned at the interval,",
        "exact_native_cache_key": "08acda25a04601952c08268ec0ef496c0eb60162.pkl",
        "cache_input_text_sha256": "1ecc5a4cac11da1dd14543c4f6af041a3d00deacae8224604e70ed502e0e3619",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 3,
        "source_slice": "and prize cattle at the Smithfield agricultural show died or had to be slaughtered.",
        "exact_native_cache_key": "e6e60b75acd41309deef6f5789b57c1e61441a16.pkl",
        "cache_input_text_sha256": "9d1a12b269f98392dad98f9088931fe3585adefd86bd5421a40d2a71ddc9f0a6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "Officials at the time put the excess deaths at about 4,000,",
        "exact_native_cache_key": "01afe54eb1629a3375733ac82f244d17cda1bd58.pkl",
        "cache_input_text_sha256": "97c8ed2402ba13129ed91e411f3784cccd361b63fa176ddda70fa9d017249a1a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "but a 1954 Ministry of Health report blamed later deaths on influenza.",
        "exact_native_cache_key": "51c9551cc69034928783e83bc29ce6999646761b.pkl",
        "cache_input_text_sha256": "17daa380c66c9798f716dd2869c993ab0f18df1074493e8353a6d3a4ee2242ab",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "A study published in Environmental Health Perspectives in 2001 reassessed the evidence and cast doubt on that explanation,",
        "exact_native_cache_key": "3612b25ffc9549b7c7d8592f2fb4b315aae7e4bb.pkl",
        "cache_input_text_sha256": "12b139944721371d2f8bf402fedc2a416ec0423b5f0124764455cd476f636d9d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "estimating about 12,000 excess deaths between December 1952 and February 1953.",
        "exact_native_cache_key": "a76a0a080649d6073f897aa9d841f08a13d305a5.pkl",
        "cache_input_text_sha256": "cca9ca4d9c7d00b6c883569a7b17ae394749427c75f658ab2b2ce186fe76747d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "One villain flickered in their own grates,",
        "exact_native_cache_key": "5f8ee2568f0a8ea9f3e743d88c73bf8d07ec5a49.pkl",
        "cache_input_text_sha256": "968c77ff82dd9505ba3c191efa0126900b6b511c519bd5dcbe8eebeaec8cbe0c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "a source of warmth and comfort so habitual that few thought to accuse it.",
        "exact_native_cache_key": "e76db306147383f394d54bb5ae29c03dafb827f4.pkl",
        "cache_input_text_sha256": "6cd7cdbb0e917f58d14e8e59807f45275c4a616ac7bb547ba09a81e9cb324380",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "Reform proved protracted,",
        "exact_native_cache_key": "87f898124c067b6f3b186402ea5f5613d2ab46ff.pkl",
        "cache_input_text_sha256": "0c77449caaec41743e1786538b994cf2d419163c308eb6d2dc9337649a79671c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "slowed by official inertia.",
        "exact_native_cache_key": "b0001ac9eda9498dd61026200a86d69709c90624.pkl",
        "cache_input_text_sha256": "7d63d62afe914c4e7811141a75594a745fde1277b40578363b73197b7230326f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S16",
        "piece": 1,
        "source_slice": "The Clean Air Act became law on 5 July 1956,",
        "exact_native_cache_key": "a6daa008e3a5d72095a9a99c3f35f1a142446eea.pkl",
        "cache_input_text_sha256": "ee2303309a5a2965cd7972cf81a27ee9904224257ea6b2cd3c3613e0810f0159",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S16",
        "piece": 2,
        "source_slice": "three and a half years after the smog.",
        "exact_native_cache_key": "9640033bd7c264ad7c1e443b915862109abf104d.pkl",
        "cache_input_text_sha256": "09fc8015680e3b66b2925a70b02d5f1e02349cd296af6452a457f8cfe6519d7d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "It empowered municipal councils to create smokeless zones,",
        "exact_native_cache_key": "5650afe369938bf0ea1ab88f0177f1b72ba940e9.pkl",
        "cache_input_text_sha256": "53cf305a4b9892672f48d4127539d93fb25784f0928343d1e7161d550d1fa9c5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "combating smoke at its source.",
        "exact_native_cache_key": "7e179f68808aa03000c003f62cea0ef39eff5c7d.pkl",
        "cache_input_text_sha256": "e378425978b50b487486ff79dd5080f2f954c6c205e7771f222beddd006fd58a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S18",
        "piece": 1,
        "source_slice": "The cosy hearth,",
        "exact_native_cache_key": "239a358d16de20fbff45e0cd8fc9344408561a6a.pkl",
        "cache_input_text_sha256": "a9821db51122d374109338f4d1b7d559d1c05b3d348478e0a026b9bada85e5e7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S18",
        "piece": 2,
        "source_slice": "beloved of British families,",
        "exact_native_cache_key": "46a64819d3e9b820e427c3e3002f15997e7ba136.pkl",
        "cache_input_text_sha256": "b39f978c7d8a49e985f85ba48024f7c1ddc96e5fb3c254e4bda72aad0fc42197",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S18",
        "piece": 3,
        "source_slice": "had,",
        "exact_native_cache_key": "e8ed41c1f59e182ef807af97d7044aa8215fea34.pkl",
        "cache_input_text_sha256": "60388f876db4103b2b35e7cb08037fd10adec08b428661ef4ae976c4f1a3b12c",
        "cache_input_is_phonemes": false,
