    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In 1936 the colossal Hindenburg made 17 Atlantic round trips,",
      "exact_native_cache_key": "9af0ed5392a304510ed7aa0ebda9aef548e0eb76.pkl",
      "cache_input_text_sha256": "27e14b4ffdf75752ae49027f61fe7d3a5ac9e089fb635036ed575f82cafc7a86",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "a marvel of luxury and glamour.",
      "exact_native_cache_key": "d0cda3ae27c013b3d63e5baace42492845e9695a.pkl",
      "cache_input_text_sha256": "63007caea67c4c54a1895ddcfef16df9e06e85c4282149e4d8076e13add04b63",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Its amenities included a lounge and,",
      "exact_native_cache_key": "6b3b4c28200f1d0378d9c1fd5226b27da1b258d2.pkl",
      "cache_input_text_sha256": "4cc9ccc833d3fea0250218a24c0e46153cb5e92b430bdd04abfe1f0e12745671",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "that year,",
      "exact_native_cache_key": "5eaa79df69e3bbd51e29ee8275b8aa684a7cea0d.pkl",
      "cache_input_text_sha256": "7539cfd03f6fa6bd8125946c73ab45588fb24d0224b868ea2dce80ed31b3b20e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "a grand piano.",
      "exact_native_cache_key": "386013ba0316a756d0490e226c57a5021ec9659b.pkl",
      "cache_input_text_sha256": "0a7f1fd531b63f9201efc30c21e59930c150d6fa719025b04ec1d41f359672be",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Because that gas was combustible,",
      "exact_native_cache_key": "d364b3747679d87c518de697e0642f64e6548864.pkl",
      "cache_input_text_sha256": "723d14b05fd17858fcedfda5ab40f21e737be11b9e2ba505aa2640b77c8a9e4e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "smokers sat behind an airlock with one electric lighter.",
