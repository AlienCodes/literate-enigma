      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "leaving a crumpled frame.",
      "exact_native_cache_key": "ce4dff5dc40cc6c58f836e431a3eb7861d584be8.pkl",
      "cache_input_text_sha256": "79f55f9574ac14064ed761592196228778f1c2f79d86cfe96887d7bf5f60c6a6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Of the 97 aboard,",
      "exact_native_cache_key": "0f4fbeacc2a91586e8e20c998f6f9ce9acc6ebaf.pkl",
      "cache_input_text_sha256": "72dc5775f7032c67760a3aaa5934f1e846e868a795d6176133ac2965f038f862",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "62 survived,",
      "exact_native_cache_key": "2f6490bbb96c846a8221091ab4ed03b2a25e00a9.pkl",
      "cache_input_text_sha256": "e0b4e02b63e7eace205fb15571871cb655140868636d97fec3b13eea0b949cc6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "a proportion close to two-thirds,",
      "exact_native_cache_key": "725b634237c163ad854426bf0176945257f3afed.pkl",
      "cache_input_text_sha256": "ea9b6076940b22e948642770138683d247d049e808c5084b170e464f75cbcfd9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 4,
      "source_slice": "while a minority of 35 died,",
      "exact_native_cache_key": "53699fecc73a3f6e97f7369510dc98bc99013bc7.pkl",
      "cache_input_text_sha256": "8131f02920d9c8ddcfcb30278932ea17e93bab100d450b3eb28fa6f11999c258",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 5,
      "source_slice": "as did one man on the ground.",
      "exact_native_cache_key": "c2bd3b5ff557d6caae6285b011b8ff2713f51f2f.pkl",
      "cache_input_text_sha256": "8f7184a3d6bfd320d8d12d3d43fe3af5854e6c41512b9192dee26db4743be828",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "A 14-year-old cabin boy was drenched by a deluge from a burst water tank,",
      "exact_native_cache_key": "17b72ad03d8e0ab4a47dc3c89ad3ecde0cf99e5f.pkl",
      "cache_input_text_sha256": "952e51fa33ef150f22a2209fd4c14b074355f9d8de72047680bc723422b8688f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "and the soaking saved him.",
      "exact_native_cache_key": "e6dafe46029cdea6ff499770a7038fbab6f86116.pkl",
      "cache_input_text_sha256": "eb8cf137f87046e946a57df694e44011a2cc2977e849368571de2a0dec6328d9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "He dropped through a hatch and scrambled clear,",
      "exact_native_cache_key": "257e7e7f0925fdaa353b6096202ac3bec1c04f0e.pkl",
      "cache_input_text_sha256": "9bbf776982bbd9460efe1f4fc8b51f92b3d31ed7222655044420676765f9d42d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "escaping only narrowly.",
      "exact_native_cache_key": "6c308af5e7d369b1c280478090dd240348c40214.pkl",
      "cache_input_text_sha256": "acf34b485b8381a18db9bd7c73ee239800a26f59ae4df7fd45acf57585651c44",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "A radio correspondent's eyewitness commentary was not live;",
      "exact_native_cache_key": "94ac769e3c3399410544c9efa54286e836a73d40.pkl",
      "cache_input_text_sha256": "f311e05d32b72a97f2b744334d103e9b254ea53cb306de653714b5aba7aec6c0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "audiences heard it the next day.",
      "exact_native_cache_key": "45a4fa7252e16efda182d95a84ab18fa4c662d9c.pkl",
      "cache_input_text_sha256": "c14101c58119a50e05afbf966da299c6469a49eb49ab172727e8df0c8f684f4b",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "The cause has not been definitively established,",
      "exact_native_cache_key": "e93422b6eb39acb8c7819f804908817cea07b50c.pkl",
      "cache_input_text_sha256": "ac648bc296482b23bc2dad5210115ad1fe2110c5be0106e4306888c19db3d5a5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "but static electricity igniting leaking hydrogen is the leading explanation.",
      "exact_native_cache_key": "eaf87e28f745b7941f20ebd2f541b0ec9f897ad1.pkl",
      "cache_input_text_sha256": "2eef0cec7520230499181c83f824c6196e1e598c85b25c339ddbbdc8656d172f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "As public perception soured,",
      "exact_native_cache_key": "99ab1fd9c362d12bb8d87dc82217b7641c066985.pkl",
      "cache_input_text_sha256": "b4ff80fc72a36ca6c0d9ae5a986ced3ae341d502781621939de2c5d77915cad7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "Graf Zeppelin was withdrawn,",
      "exact_native_cache_key": "8b1a3ae000bb18f6cae6e3fda264eb87d20f8d35.pkl",
      "cache_input_text_sha256": "ba5b414c532b8ddef478073a2c2ae87047c0b7002f6da744abf49598a381ab0c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 3,
      "source_slice": "later scrapped,",
      "exact_native_cache_key": "1b49f298c7149c7f7a52de40200e47be3db4dda9.pkl",
      "cache_input_text_sha256": "2d6386e1fa448c87378d428e6138341056c9027f64cd5a8ae6a4d01fc79c0a3e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
