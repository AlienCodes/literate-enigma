      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The inferno incinerated the ship in about half a minute,",
      "exact_native_cache_key": "696c40b95124d61fb99bd2f1bf5cb185db58ca6c.pkl",
