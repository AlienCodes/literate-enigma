      "cache_input_text_sha256": "45e3f26181095e7cc754494d06b5f23b95e17f79fc86c46d0cd6e77950ff471d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "At about 7:25 pm on 6 May,",
      "exact_native_cache_key": "ddf16076e25b1fae8d62ffa15c317dc97a2e6ec8.pkl",
