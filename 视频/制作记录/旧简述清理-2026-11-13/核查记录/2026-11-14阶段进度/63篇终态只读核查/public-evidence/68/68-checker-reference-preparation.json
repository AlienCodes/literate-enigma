      "cache_input_text_sha256": "ef0e2d9c12e1a9f6bbcd608159ed59f700ae528761dabeb55ec2c439e5028e8e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Hours behind its timetable,",
      "exact_native_cache_key": "e530ea89791908907b54a01ca85b628ff1ee6579.pkl",
      "cache_input_text_sha256": "8235774b31728378b54df6025b17105a2e4df9fb02003c574958abdbf94e7e37",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "it met thunderstorms at Lakehurst and circled for over an hour before its descent towards the mooring mast.",
