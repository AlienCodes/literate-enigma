    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "In 1990,",
        "exact_native_cache_key": "5200873f4f69101599f68ab9db1467ee882cc53c.pkl",
        "cache_input_text_sha256": "7c5a35efd33a4b4a184646ed2c400c54c8c2a779e9620f7c0442f548f2c5b054",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "on a delayed train from Manchester to London's King's Cross,",
        "exact_native_cache_key": "07de0d3568ab53438c9cbe29e012eef3a5d3354f.pkl",
        "cache_input_text_sha256": "3fcda67d988469b3b53f322ef671070a995a02b9dc659abc42bab9a23f8b2471",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "Joanne Rowling,",
        "exact_native_cache_key": "fddd7928a6f4dde2c80c8f9fcb5b6f9d711ae0e2.pkl",
        "cache_input_text_sha256": "173e11030130f9df15fbb30eaa1365c29911d05acc9270db280e924dbeea357f",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 4,
        "source_slice": "a would-be novelist,",
        "exact_native_cache_key": "d05891d88e139fd40ead0b420ab8d4c08b962350.pkl",
        "cache_input_text_sha256": "be801f1261c296b1718d5ae302b7798f3726e7563e460b907d8bd479e7815110",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 5,
        "source_slice": "was unexpectedly struck by the inspiration for Harry Potter,",
        "exact_native_cache_key": "e5e0076d24f042599efd677db960fc119b0ea860.pkl",
        "cache_input_text_sha256": "ed4b470b445db4f33fc780210957d858406475b3fcc4466e330498a55614d9d4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 6,
        "source_slice": "an orphaned young wizard.",
        "exact_native_cache_key": "ad7f281466bb8243d2a6411a7d77f7625a37f510.pkl",
        "cache_input_text_sha256": "0fd57b66e29f0a3fab88dab445dad6694e10b805c93cc303b9b7391ac8db3049",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "Grief soon overshadowed that spark:",
        "exact_native_cache_key": "6ebcbde6b4f37311095cee76da1b8ad0739eeb5e.pkl",
        "cache_input_text_sha256": "003af409823483760279358d852854838ef85ac3187186e86f034d3c836b86fa",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "her mother died on 30 December 1990,",
        "exact_native_cache_key": "91d53cc80bcd146572d34f153e358d65be01e5a8.pkl",
        "cache_input_text_sha256": "29d52083f01f01697369bfa42a4bcec1e78542a21e21557d384f4ac76bab0ce9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 3,
        "source_slice": "aged 45.",
        "exact_native_cache_key": "b5b2a0507c14ee2c42fa5a18595fbaec2dab7151.pkl",
        "cache_input_text_sha256": "c6383890047ddc31db3ecb9c319da186ea0bb51e57d44dd2040e21a026c5ca3e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "Rowling married in Porto in October 1992,",
        "exact_native_cache_key": "d41e90dbe90fbd395a40208e07f73120d2fd648e.pkl",
        "cache_input_text_sha256": "931fffaa474f249fc3cec89f5135f3994e771d617787c193ea78e8bdee6381f5",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "and a daughter's arrival in July 1993 ushered in motherhood.",
        "exact_native_cache_key": "8417d8eb975e24f184e7347242eb540c9f12c5d4.pkl",
        "cache_input_text_sha256": "5a86f1a3c2aa5603e255b51a4ae889921dde1e70b261c30afea44be6a948f74d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "At the end of 1993 she resettled in Edinburgh,",
        "exact_native_cache_key": "a659a4b2e311ed9f14e6489ef753f8ec56dc4678.pkl",
        "cache_input_text_sha256": "a11307af618d581fa724abc3aeb22004b3c276e9e454b7e03816dcd1ddf35004",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "a lone mother reliant on state welfare.",
        "exact_native_cache_key": "d6d25933965302aab0b8cc54ee9eeec9070bf7f2.pkl",
        "cache_input_text_sha256": "7ee3b67177ff04d71e3db4f3864bab9ef75de4221edc0de6bf9b79fd92d0eb5a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "She habitually wrote in cafés,",
        "exact_native_cache_key": "b02fc0bdde384c61a8c0c481c32623f9e1985a60.pkl",
        "cache_input_text_sha256": "849e652786f4b899b2bd7e0f5e7f6441aba206c116f7ab86c617d28f80c59561",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "patiently polishing her unfinished novel.",
        "exact_native_cache_key": "f7c18264b109c7144bd10357cda196cb6b53c77f.pkl",
        "cache_input_text_sha256": "52466e5cb77026762417f6fed2065507be92d8daaacf8e5a6603fc28e4eeb0b4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "A literary agent,",
        "exact_native_cache_key": "418f4c2c3b9e2da8e0b074bc646249adc45c4fa8.pkl",
        "cache_input_text_sha256": "0ea3248a5a0bbc1bce792cb7f7197fc475b20cc7f7f8db8f2d55c621a674dcef",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "Christopher Little,",
        "exact_native_cache_key": "286da54b81bf1baa47ab2c39693ea18afd0fed0f.pkl",
        "cache_input_text_sha256": "d5e31f30bb0afb4f0b7e662e7de490fb77e7c195470c7a51322426798c28481a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 3,
        "source_slice": "took on the manuscript and pitched it repeatedly to prospective buyers.",
        "exact_native_cache_key": "a9a3b039cf7976b9b673eef19f267a80c326c573.pkl",
        "cache_input_text_sha256": "02188715c42e9558ca243302ccbabeeaa83027ccdfeda94b73346660c26b18f3",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "It was reportedly rejected by twelve publishers in succession,",
        "exact_native_cache_key": "9b22dacfe0900dc2c262bbbb4aca3d4708d0fb09.pkl",
        "cache_input_text_sha256": "821db934b3ba1cdd87409bc09791ae8243c12f031400fd06033ba03651d5e69d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "a relentless run of refusals that offered the newcomer little encouragement.",
        "exact_native_cache_key": "4bf2af178b21bf651dd18c424e539779068aa612.pkl",
        "cache_input_text_sha256": "87b7541b9ec0f08c033fdc030ca1b174384ca8b19a87af1b06efd2d3c6cf84bf",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "At Bloomsbury,",
        "exact_native_cache_key": "39dbea4fbc1904bf5ea6cb311762c4b7c92cfd95.pkl",
        "cache_input_text_sha256": "c1c6645fa6edb8a5cd900d5d4778b91ca347b5bbd1849bb310b248f5055768a1",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "the chairman Nigel Newton gave the first chapter to his eight-year-old daughter,",
        "exact_native_cache_key": "22f63ed5335065b1be206213ea49ce853f453d9d.pkl",
        "cache_input_text_sha256": "2ee5c51b983aa1bc2d1f737cd814f5961ea182e2a98a7a15c4266bdfbbce3754",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 3,
        "source_slice": "Alice,",
        "exact_native_cache_key": "4ca53649b344e9d56212d333c8c50169a6689241.pkl",
        "cache_input_text_sha256": "0be86c87cad6b1e8918b730d9fbe2ac0dbaafe17c991bb29dae2badf762078db",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 4,
        "source_slice": "who relished it and eagerly asked for the next instalment.",
        "exact_native_cache_key": "7a052c24e521379b563252eea23a9ec91d8613f0.pkl",
        "cache_input_text_sha256": "b33116d99221c0fb789463452102abc9a6013cd46cc19500655f68cedf1a8ca5",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "Fearful that boys might disregard a book by a woman,",
        "exact_native_cache_key": "8e2f71068dc6354314b0d45de474e1a3d6280d8c.pkl",
        "cache_input_text_sha256": "edfc35399ca5b2cde5c61664cdada5f8f304cf2ad761eb0a5d99f0905abfd2a5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "the publishers opted for initials to mask her gender.",
        "exact_native_cache_key": "af6fbbdaf85455573b5f908b7206ccc0fec0c7ab.pkl",
        "cache_input_text_sha256": "e72cb58eb2798308833ff1c9026f0732a7f1d7f6dbc968a5f0bea183ea2f8674",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "Having no middle name,",
        "exact_native_cache_key": "8ac225b28dcd955be71605b85575d82cdd38d092.pkl",
        "cache_input_text_sha256": "6a68bf39d616d1ff6b0e082b0a1244fe3232fa93fcff1cd5ae99f14460cbf8ee",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "Rowling took the K for her pseudonym from her grandmother Kathleen.",
        "exact_native_cache_key": "ffa90daa0be5cd0929e2463d8da3476ce542bc2f.pkl",
        "cache_input_text_sha256": "338848015d6c1b6867d2f7fc4f0a692515d5d0b2e7608756c4a5f81f9073bdeb",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "Harry Potter and the Philosopher's Stone was published on 26 June 1997,",
        "exact_native_cache_key": "da638e025a9bccf316449a9b51df266aba6ef909.pkl",
        "cache_input_text_sha256": "d34fb2e114654b956f545e13f76bd1aadedbd947224219c3b63ce0b345e47276",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "in a cautious first print run of 500 hardbacks,",
        "exact_native_cache_key": "164dd497ae1dba2fd65bf4c1f047c814b4534d88.pkl",
        "cache_input_text_sha256": "f547beb36fa1834f1fd8e3adfbd3f64b5e8f6894ff587bb509dba94ec14b0214",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 3,
        "source_slice": "300 allocated to libraries.",
        "exact_native_cache_key": "8e4e74e13254655afa733e0cde35790b6d5d450f.pkl",
        "cache_input_text_sha256": "b7606d691106f172d67856b11ffd56ed4ef09fc8b9f1d768a6689b5736dde128",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 1,
        "source_slice": "The American publisher Scholastic paid $105,000 for the US rights,",
        "exact_native_cache_key": "30b91c0f549a499b75f04a40e536889c91ddf428.pkl",
        "cache_input_text_sha256": "ff7be27250865de9bf604120b1fe41b0d15605207f733b63f7223631f4dfe5d6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 2,
        "source_slice": "and the renamed Sorcerer's Stone appeared there on 1 September 1998.",
        "exact_native_cache_key": "f3b9d9659e7b65b30290113f0a48cba0f7272930.pkl",
        "cache_input_text_sha256": "acf889da90c8d734deefe1df84fbf2e7c27149fae4cd5ac2f3f43de88c9314e7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "The series and its spin-off volumes have collectively surpassed 500 million copies sold,",
        "exact_native_cache_key": "32b9507ab6d0fb9f3377236a6818b4b294a7324c.pkl",
        "cache_input_text_sha256": "e207b66643ca5667fdcbaa26217c89492906738f429d71d1bc6c73a46ecadd40",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "in 80 languages.",
        "exact_native_cache_key": "aa2febfbe9ea972658ed5d0c07a153c11d4ca462.pkl",
        "cache_input_text_sha256": "126fa611440398532d7d2bf03b7e176a5dae677e021d85debc9bc823d8a70fc7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      }
