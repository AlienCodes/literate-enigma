  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "On 18 February 1930,",
      "exact_native_cache_key": "24151fd06bcdaaa09f5f94e66f00f149463d82a0.pkl",
      "cache_input_text_sha256": "8cdb3f2747b27000166a8752ae90ffddc692d30af5f1536f79e07538c899b7bf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "comparing photographic plates at the Lowell Observatory,",
      "exact_native_cache_key": "8d5f2aff15517284290049a7a8613c7da85854e0.pkl",
      "cache_input_text_sha256": "1d8b8b0ef2194e71782515dfe31a03de4dc8de5b7d3a72841b964aa4acb478d8",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "the astronomer Clyde Tombaugh perceived a dim dot that shifted between them.",
      "exact_native_cache_key": "9d11555b7489463cb91a8760678be4e1e49ac461.pkl",
      "cache_input_text_sha256": "c89cc7397df2bbc042aa7df4fd4900e24278370e996c4a6da28f41b15c041641",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "An eleven-year-old English girl put forward the name,",
      "exact_native_cache_key": "a091deec6afd37c0890ad27b237932114ac47b1a.pkl",
      "cache_input_text_sha256": "299c714ac4367e6f2a8383f69926cd6fb5788b2a5aad77feb96c850bf5c899d3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "after the Roman deity of the underworld.",
      "exact_native_cache_key": "226a9fe3cc38389d0127be666d817eb8eb3db804.pkl",
      "cache_input_text_sha256": "6d3b5e32daca30962329f38106470fbba8bd90a9e08029263a77c0f1cb52c439",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "In January 2005,",
      "exact_native_cache_key": "c8e9d3fc7bae287a949bbf867aa7dd224a7dbe5c.pkl",
      "cache_input_text_sha256": "cde03e81ac162712185e2edfa3653ef29378fdf30a276859d34cccd22fb0e238",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "astronomers found a far-off body,",
      "exact_native_cache_key": "00a6b4b1b76e3ff71294b99a86af4fbd8e87fbfe.pkl",
      "cache_input_text_sha256": "cd429b023706542ad5d60db5611b398258f933dede63792b0878234f3ba53227",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "later named Eris,",
      "exact_native_cache_key": "4b9c7a8000cb2b4fd716a69828c663838207ddf7.pkl",
      "cache_input_text_sha256": "3087fe948da81ba5c838d537e34fef334126be757b1aa17ddf4ab96739d8aee6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 4,
      "source_slice": "at first thought larger than Pluto.",
      "exact_native_cache_key": "8a72afd1ad213688eadf8945bb2785a4568b77ce.pkl",
      "cache_input_text_sha256": "d7fc3df5e0f2139ee26e6f32864233d8dd85f4924cf94f208e016473051b73ac",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "The term \"planet\" had hitherto been used loosely,",
      "exact_native_cache_key": "a9137008ede416501163d0f64ce483fd3fbc8021.pkl",
      "cache_input_text_sha256": "057e5d3aadc9b8e0877737d2346d0a30f71bc63b52b06e1f2d4ac09acd487828",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "and with more icy worlds likely to be found,",
      "exact_native_cache_key": "00f8cae1dcb14fcde93722bf272af119da04540f.pkl",
      "cache_input_text_sha256": "1ce0448128a75033353ee16d2511f638e41a555b58d1b04d45c8ff0bb57837e0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "a precise definition became a necessity.",
      "exact_native_cache_key": "99856ea00f5f7d6b41956f056d17076e37b7a7f3.pkl",
      "cache_input_text_sha256": "c101adde35ae2dd46881651ae48e1a302c7ef5dcb5ac8c9176fbd6087de3ae97",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "On 24 August 2006 the International Astronomical Union,",
      "exact_native_cache_key": "a760cdab6998da54a1acaa89b3de2519b762a723.pkl",
      "cache_input_text_sha256": "3f571ad23577d44c720544235b617764dd970671c6961d74acd641c4bf84cab3",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "convened in Prague,",
      "exact_native_cache_key": "935c4c49721b5c60efcf1a889f6153ed702f78ea.pkl",
      "cache_input_text_sha256": "7295730cd4c849bcf452a2bc344178c346bec2d6eb8b94104ad25da4dd8ee65f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "voted that a planet must revolve around the Sun,",
      "exact_native_cache_key": "95c401115106a226d89cb7269b050be3628875cc.pkl",
      "cache_input_text_sha256": "50f26e2ed3ad28d3eba404c1e74e2d4238769a38861c47896e1f2d4085f5582c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "be nearly spherical,",
      "exact_native_cache_key": "5f5adeb794ffba184c21771df8b29b47d3c28900.pkl",
      "cache_input_text_sha256": "e9fb039e214a6f8a768ce5e847280344fb3b553e6efa9df016572c0f166c35e6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 5,
      "source_slice": "and have cleared the neighbourhood around its orbit.",
      "exact_native_cache_key": "98e7d4169dd71ee5e05a4f535af7a7bd60ae84b8.pkl",
      "cache_input_text_sha256": "fa29402c9165bec28fe9f7aeccc50a9ec28e2384fcf7ce15dbd2c3a3eef275bd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Pluto failed that last criterion and was reclassified as a dwarf planet,",
      "exact_native_cache_key": "8c0b38286c0897acfc2ba2a245c4d59ee073e61b.pkl",
      "cache_input_text_sha256": "a15b3bcdb4c1db5b13f59b9e380af80df511889af7527aec23721849b9cd7b88",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "leaving eight.",
      "exact_native_cache_key": "ad4f77301d9a54cca4d14ccf111b505af73f41c4.pkl",
      "cache_input_text_sha256": "9d272ff269e83c66ddef8dab7f81f15db87bb7f60bd14bcbf2004684b94c1991",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Pluto was physically unaltered;",
      "exact_native_cache_key": "47b3dac5f4e80256cd7acb33fe4c35921f5b380a.pkl",
      "cache_input_text_sha256": "cd25d6f9b9e7df749c72e54ea6e10ab53610819f3d78b4ecb8cee3b0c76a8b98",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "only the boundary had moved.",
      "exact_native_cache_key": "721fe0c33eb8708f0bac22690459afddd746bb48.pkl",
      "cache_input_text_sha256": "79d5f19a39f449c9ec4ff5b548dc18f8a2170431ee6f71b003b2480d1c211283",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "The vote was valid,",
      "exact_native_cache_key": "58649c76d9f94a2318060286a75758c111a766b4.pkl",
      "cache_input_text_sha256": "a0dc49b7f7d7f0360014d1107a68193dfa43e5b98299e3277349d21eddc36c04",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "yet its legitimacy drew criticism:",
      "exact_native_cache_key": "0a9c849e0012881eed6c0ba9e1f6503389d49725.pkl",
      "cache_input_text_sha256": "f889a15841f003813c2fba5d6ac23ede4127931fff37ddec910e6be37e7ed031",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "only 424 of some 10,000 members took part.",
      "exact_native_cache_key": "391fca61fc9bf27eec303265aa921807b1deb225.pkl",
      "cache_input_text_sha256": "0cf3d62c80c3a70c02b5faa0407059b0e252bd77b3e8e4b92a27f2a48d015be1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "The American Dialect Society made \"plutoed\",",
      "exact_native_cache_key": "9d4540feb94bc67a49736dd0804e2e6c6c38c257.pkl",
      "cache_input_text_sha256": "1b49ab0c1708fc184711c819b217c31a1da9d1e1be478bcbeb3a8d9d9e7380ff",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "playful slang for \"to devalue\",",
      "exact_native_cache_key": "8ff63afff89c8ad3759fa41677d52260cc3d3cf5.pkl",
      "cache_input_text_sha256": "518956cc0ae1cc5eb6432aed5dcbe2747219b6a95993d3fcf661216cef05531d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "its word of 2006,",
      "exact_native_cache_key": "dddfa06c058b9ccaa6bae6fdd076fba9c8a079c9.pkl",
      "cache_input_text_sha256": "35c07cb3920593512d133c4117d000417c83cb9608d21e6a8c737a7860540f47",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 4,
      "source_slice": "and New Mexico and Illinois lawmakers passed resolutions affirming that Pluto was a planet.",
      "exact_native_cache_key": "8d83ecd8221c16b8bdb346a0bbe32188b1858fe5.pkl",
      "cache_input_text_sha256": "75a087bc6a0efcd481f6d256f455b8986d3b23df41212758a0b9ab08ba50da1c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Amid the controversy,",
      "exact_native_cache_key": "38501ca8efcda57690eb24543342e43fdcd72b6e.pkl",
      "cache_input_text_sha256": "230258dbc854fe79d639a28024075b1c4e23cc50b76aa937f4d54dc7252636e6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "an irony was already in transit.",
      "exact_native_cache_key": "f759b9c3549789cdf90c08410a86da25c2be36cb.pkl",
      "cache_input_text_sha256": "fb11f21f8150d69f59d7b994107423cbe0d1a492b9462f2f17b0b81f2b3d39dc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "New Horizons was launched on 19 January 2006,",
      "exact_native_cache_key": "3fb4081514bf893ddc2817b2bc6c8baa9dc64355.pkl",
      "cache_input_text_sha256": "353b2802106e7a3af630ec88d702b2c16cb473268eb8475468cd9e08913e2756",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "seven months before the vote,",
      "exact_native_cache_key": "430f1fefbbe0b70cce33137c1878d4de4eff6c67.pkl",
      "cache_input_text_sha256": "a6e81ca8fbaf5b1a1a4401e0c5809f828eb2b3934a5f198eb522a5cfe5cf0563",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "carrying a pinch of Tombaugh's ashes.",
      "exact_native_cache_key": "c7268a3ff3339f9c02b0cc41ca6706ac0e472f94.pkl",
      "cache_input_text_sha256": "7cd9b9868991199a910755a1f8d78e5abcf9df90b9ddf2515fe16e377e18fec7",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "On 14 July 2015 the unmanned craft flew past Pluto,",
      "exact_native_cache_key": "c6803ee6bd8f81aabb34bd351ea472a0dbe76eff.pkl",
      "cache_input_text_sha256": "ccc9126569731630c34e964e5aac9eaa5ffab81f336b533c1b2184f186bf359e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "transmitting images of an enormous heart-shaped plain,",
      "exact_native_cache_key": "93f5de611a9b9446f0fc0420e338fc92bcc31354.pkl",
      "cache_input_text_sha256": "1f120ad846bc7be1573958f3e22e3b3711502f69acbf513d9ba32d2ce73f9b77",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 3,
      "source_slice": "fittingly named Tombaugh Regio.",
      "exact_native_cache_key": "fc355a2032086d04dae7929a8fd622be1346c60d.pkl",
      "cache_input_text_sha256": "6366d9ee9ca972cdc525aa09628f6ac35999309cc466d78a28f2a621113a409f",
      "cache_input_is_phonemes": true,
