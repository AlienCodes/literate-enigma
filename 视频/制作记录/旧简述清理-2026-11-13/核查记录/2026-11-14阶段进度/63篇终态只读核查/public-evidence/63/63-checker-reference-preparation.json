  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "On 10 February 2009,",
      "exact_native_cache_key": "e9c371334b9a4d90140d28a4bb67af3a271c744a.pkl",
      "cache_input_text_sha256": "4b0d219b0cd77e22c4a82d9eca484ad0193a41ddbc5920dab44f8a90b28a15f6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "nearly 790 kilometres above Siberia,",
      "exact_native_cache_key": "1a90e697bc830dac9c05c509fb31edfc6dae4c99.pkl",
      "cache_input_text_sha256": "abd55c0f4689b3003b43db0a3402c0f36cb8127f9e394bd79c48110a744f194b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "two satellites slammed together at about 42,000 kilometres an hour.",
      "exact_native_cache_key": "5b9445dd34438746c8a700357dd5359ef4f8cfc3.pkl",
      "cache_input_text_sha256": "b8887d581a17b39b90c8a4f9c6491af88d365e7be5a02ff8ec6d2293f8f4fb40",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Iridium 33 belonged to an American satellite-phone constellation;",
      "exact_native_cache_key": "d1b4580384d8e45816db7b041b4a9007a2bc56a2.pkl",
      "cache_input_text_sha256": "2b9be367d9ed826c2f458ecfaaff7a1eff03681680797c1f7192eac87f75657d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "Kosmos 2251,",
      "exact_native_cache_key": "b28add85161a270c0a402097cf41cca366999b74.pkl",
      "cache_input_text_sha256": "50edec2204544d013e637069f4364b066cbde2b5ff9b311f4b4dc1afde0f269a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "a Russian military satellite,",
      "exact_native_cache_key": "cbf83db6cf3ed727e77ae2b871d0bbb8c70ecbc1.pkl",
      "cache_input_text_sha256": "c0ce4dcad61cb079323a434d4ab38f7512c4814b724d26955cc5e34935a41b8a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "had been derelict since about 1995.",
      "exact_native_cache_key": "283e1ccdfa4d82e112430a2ce2c08cbc9bb83076.pkl",
      "cache_input_text_sha256": "a9d65b84a254d6c940caf04aa418047e239d170cd5aa41251d676da7ff75317b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "The Russian hulk,",
      "exact_native_cache_key": "e16a7e688d99c820b9c1100b5d6c0c0854239a08.pkl",
      "cache_input_text_sha256": "a76a5d2fd352112256d558fa8494f391cdcdc6ecef253ae1094373e4e992f112",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "lacking propulsion,",
      "exact_native_cache_key": "1d1ed7f949dc520052cdf7b26b7518ed7d4cb02c.pkl",
      "cache_input_text_sha256": "e3401d8272aaec3fd1d57a00822733d387a6ecc84cbe4c11f3a0aad74973d348",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "could not.",
      "exact_native_cache_key": "2a537728dd587a79ed51112474049040a90543ca.pkl",
      "cache_input_text_sha256": "26e24b9ea9ec1772944318b78d20ce6737e8fcc54cf14ba5adf432a9eb1b592d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "A public collision-warning service had forecast a narrow miss of about 584 metres,",
      "exact_native_cache_key": "ea19f8f6585d510871c5eac5d0cb854fa1185b29.pkl",
      "cache_input_text_sha256": "20257da5672bbcb5f2fe948103c938db19ed3df86fdd0e4dcd74c7ea4a8f05b7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "yet the predicted encounter was not among the week's closest;",
      "exact_native_cache_key": "e747ab56cb2a2d58582ebaa26c31368f1c62c980.pkl",
      "cache_input_text_sha256": "7f2906ed266cff4449e4ed3dbe375023ac519b03c42685ca50adda978cdcb9ac",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "such warnings were frequent and imprecise.",
      "exact_native_cache_key": "acce8d35458d5370089b2084f52b402c339ada44.pkl",
      "cache_input_text_sha256": "9e87e14625c5ee8eac6a323902db239acb644d06e415ef00df0d839e4048e18b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The wreckage,",
      "exact_native_cache_key": "268a44c3a19d589a26b1f3bdf9356d05a3b18232.pkl",
      "cache_input_text_sha256": "fa857f4bf65a409efeb966a221c294c094c466c0053dd3600d2aa9d4c3638a84",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "however,",
      "exact_native_cache_key": "297b7cda4a221e878f1387c3ae26ba3e4016c6fb.pkl",
      "cache_input_text_sha256": "4860ed8c70b23f76771f0681d90724ce76e5c2a97c99f459b574117522a0b4f6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "endangered everyone else.",
      "exact_native_cache_key": "e231c49ba926d2e2f4b96f8fd115237102d86d1a.pkl",
      "cache_input_text_sha256": "756a98d9b8411fb2fee6c0be0716c6383650b9147f6bcde8d01700925c4a4309",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "At that height air drag is feeble,",
      "exact_native_cache_key": "b5b3974b1b110704ae1211739049196918375e31.pkl",
      "cache_input_text_sha256": "c5dd3082d9faddfd7d73a93ca64f861241ffcd638852fad19d984f9ebde6dfc8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "so many would linger for decades.",
      "exact_native_cache_key": "d865c831cf6e948005790b61ff0a0ff8cde2f836.pkl",
      "cache_input_text_sha256": "ad85ab3e0ddbdb3b08fc477ddd50d1e6132686dcbaac8be2a98c8eff316ce00f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "In January 2012,",
      "exact_native_cache_key": "aa315a4dc0c51155341f055dd20a0833fe962d8f.pkl",
      "cache_input_text_sha256": "f61e58083ff0ff8bad254dd7e508d9442dd083df924596bd77cf545a5b587833",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "the International Space Station fired its thrusters to dodge an Iridium 33 remnant.",
      "exact_native_cache_key": "f7a6dd130cb76dcc7fada6096b616b82e8c03c4e.pkl",
      "cache_input_text_sha256": "73ff867ecdff1790f4a9d5afef176ac39175ec0f0474eed9980dabc0c56f34d3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "In June 1978,",
      "exact_native_cache_key": "5156c9b33974fd81b5d05a21bb29a148b3e63fcc.pkl",
      "cache_input_text_sha256": "f3c90f3acb68d194be1eb5db7d09f3819b5413a2075c2e8e90ca0589fda732c7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "two NASA scientists envisaged a vicious spiral,",
      "exact_native_cache_key": "47ea7c4d0abc1d724b27d072dbdcaf403434a78d.pkl",
      "cache_input_text_sha256": "a51eb15ab9803e8481b8380e74d2f1a395251601a5a95060a8f9a97a04582d77",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "later named the Kessler syndrome:",
      "exact_native_cache_key": "d89b44fa7d7aab5f36aaeaafb1608e9dc18d7e71.pkl",
      "cache_input_text_sha256": "24f0954f52f530af2d48da98dfe2ff87bf62d4f8410aab80f0a18bd9f5c0e789",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 4,
      "source_slice": "each collision would scatter fragments,",
      "exact_native_cache_key": "fe0b474f0e679b47a8f779d0480676c302092f73.pkl",
      "cache_input_text_sha256": "0ffc8cee18d44107e7d809436e86cdbece810430dce2a33bdd1fc00f23dafd7c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 5,
      "source_slice": "raising the odds of subsequent crashes.",
      "exact_native_cache_key": "04ddcdbec49f7a67895d427ec971bf95221ac511.pkl",
      "cache_input_text_sha256": "366eb5b8ccb30aa8d97705e44feaf50928a118677520df37fc9f6d3c0b466e9b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "By the end of 2024,",
      "exact_native_cache_key": "4f5b37a3dff005a2454922f65181e5413be1a1a1.pkl",
      "cache_input_text_sha256": "0be89d65b2ed56f4116cffcf7107ccd3235f3293b41fe2475f866044cac8da7f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "surveillance networks tracked about 40,000 objects,",
      "exact_native_cache_key": "026a19533a48efebfe672f2e75a2dd271a4cc7a2.pkl",
      "cache_input_text_sha256": "0a2964cc55e0a7b428c17e45e6796c470c673cf41608e1db31aab0f27d82cc0e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "only some 11,000 of them functional.",
      "exact_native_cache_key": "080793a79d888013b586dc8e4ac6c8371e898bab.pkl",
      "cache_input_text_sha256": "157d1abd39969a8da2bd71a13b9f8e3fd16f88993619d27e0c771e3260b9ebb4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Such a cascade would unfold over decades,",
      "exact_native_cache_key": "c21e4f2c5eafcbd024deb71834c2462916ca41b9.pkl",
      "cache_input_text_sha256": "b8b60bfd574406fe05284e0058ea63b8f8db25d64ef7404ffcf1dfa54eaf4a85",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "though,",
      "exact_native_cache_key": "89cf384adbed3301b92aef73e0d5a6e2dd699fba.pkl",
      "cache_input_text_sha256": "f74aee97c33b02ba3bb560ab7eb95d8df67087734052e01c0b90f44a49ffb18b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "and is not inevitable;",
      "exact_native_cache_key": "40311e0e9c98f5bc9cd62994484095f4dae22f5a.pkl",
      "cache_input_text_sha256": "7ead647a557f8f343b4a73a2f482dd05c4fb6bcfae4b0a4ad63f31a4aca33eba",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 4,
      "source_slice": "the risk can be mitigated.",
      "exact_native_cache_key": "3eecf349d60f0d4df111d9e2a92f5ca9b3e4d938.pkl",
      "cache_input_text_sha256": "34d4ff31c1af994ea29b4c230043e4dc2e5ceafa79a457a4dcd6428f25991819",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "In September 2022,",
      "exact_native_cache_key": "1eca1e4824c306ba6d12c0c10a0f3aa494140f36.pkl",
      "cache_input_text_sha256": "978530bc3e5b45e62622bec9eff39745a910c9f43080ccfa2042f7cc7f404f0b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "America's Federal Communications Commission,",
      "exact_native_cache_key": "036908ef2df8807e7100e70278d8c46758ea1711.pkl",
      "cache_input_text_sha256": "87168a7cec4b8c826eb434e34a07e8b8d49b47001648eb8b3e94c0dd76c86d33",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "which licenses satellites,",
      "exact_native_cache_key": "fc0992521243f6df5754b18600a09ad55a92bd16.pkl",
      "cache_input_text_sha256": "23bc894c723ff7b750d3a7e24c4d9950d546ffcbf05b2feb4ed7fdc5e8d73c1b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 4,
      "source_slice": "mandated disposal of low-orbit craft within five years of retirement instead of 25.",
      "exact_native_cache_key": "e3cff9903c79457396c9d2c4ec09d6db9e31c899.pkl",
      "cache_input_text_sha256": "f82e1e68c5db23d8679d20ceb9be6ea0a7916b5309cd1b8ddbae510827483429",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "Years after the crash,",
      "exact_native_cache_key": "62bd76a6b3891de7d446eeb899770ac3b0d54bdc.pkl",
      "cache_input_text_sha256": "7bffc2d5a9dd614f08b411955e1e202a658f1f099bf4c7ebe9ea57c7c1834623",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "spacecraft whose owners had no part in it kept swerving around its splinters.",
      "exact_native_cache_key": "568e5631507b6049a95610b2c5830550addd233b.pkl",
      "cache_input_text_sha256": "0e57662ae34620bde6dfeac4a6a5d1ed3600408809e3b378d5fab53692d5ff1f",
      "cache_input_is_phonemes": false,
