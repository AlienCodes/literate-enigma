        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "In September 2022,",
        "exact_native_cache_key": "1eca1e4824c306ba6d12c0c10a0f3aa494140f36.pkl",
        "cache_input_text_sha256": "978530bc3e5b45e62622bec9eff39745a910c9f43080ccfa2042f7cc7f404f0b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "America's Federal Communications Commission,",
        "exact_native_cache_key": "036908ef2df8807e7100e70278d8c46758ea1711.pkl",
        "cache_input_text_sha256": "87168a7cec4b8c826eb434e34a07e8b8d49b47001648eb8b3e94c0dd76c86d33",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 3,
        "source_slice": "which licenses satellites,",
        "exact_native_cache_key": "fc0992521243f6df5754b18600a09ad55a92bd16.pkl",
        "cache_input_text_sha256": "23bc894c723ff7b750d3a7e24c4d9950d546ffcbf05b2feb4ed7fdc5e8d73c1b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
