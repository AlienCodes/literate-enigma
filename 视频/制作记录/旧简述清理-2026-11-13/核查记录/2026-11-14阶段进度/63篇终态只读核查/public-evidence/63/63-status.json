        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "so many would linger for decades.",
        "exact_native_cache_key": "d865c831cf6e948005790b61ff0a0ff8cde2f836.pkl",
