        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "Iridium 33 belonged to an American satellite-phone constellation;",
        "exact_native_cache_key": "d1b4580384d8e45816db7b041b4a9007a2bc56a2.pkl",
        "cache_input_text_sha256": "2b9be367d9ed826c2f458ecfaaff7a1eff03681680797c1f7192eac87f75657d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "Kosmos 2251,",
        "exact_native_cache_key": "b28add85161a270c0a402097cf41cca366999b74.pkl",
        "cache_input_text_sha256": "50edec2204544d013e637069f4364b066cbde2b5ff9b311f4b4dc1afde0f269a",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 3,
        "source_slice": "a Russian military satellite,",
        "exact_native_cache_key": "cbf83db6cf3ed727e77ae2b871d0bbb8c70ecbc1.pkl",
        "cache_input_text_sha256": "c0ce4dcad61cb079323a434d4ab38f7512c4814b724d26955cc5e34935a41b8a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 4,
        "source_slice": "had been derelict since about 1995.",
        "exact_native_cache_key": "283e1ccdfa4d82e112430a2ce2c08cbc9bb83076.pkl",
        "cache_input_text_sha256": "a9d65b84a254d6c940caf04aa418047e239d170cd5aa41251d676da7ff75317b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "The Russian hulk,",
        "exact_native_cache_key": "e16a7e688d99c820b9c1100b5d6c0c0854239a08.pkl",
        "cache_input_text_sha256": "a76a5d2fd352112256d558fa8494f391cdcdc6ecef253ae1094373e4e992f112",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "lacking propulsion,",
        "exact_native_cache_key": "1d1ed7f949dc520052cdf7b26b7518ed7d4cb02c.pkl",
        "cache_input_text_sha256": "e3401d8272aaec3fd1d57a00822733d387a6ecc84cbe4c11f3a0aad74973d348",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 3,
        "source_slice": "could not.",
        "exact_native_cache_key": "2a537728dd587a79ed51112474049040a90543ca.pkl",
        "cache_input_text_sha256": "26e24b9ea9ec1772944318b78d20ce6737e8fcc54cf14ba5adf432a9eb1b592d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "A public collision-warning service had forecast a narrow miss of about 584 metres,",
        "exact_native_cache_key": "ea19f8f6585d510871c5eac5d0cb854fa1185b29.pkl",
