        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "In June 1978,",
        "exact_native_cache_key": "5156c9b33974fd81b5d05a21bb29a148b3e63fcc.pkl",
        "cache_input_text_sha256": "f3c90f3acb68d194be1eb5db7d09f3819b5413a2075c2e8e90ca0589fda732c7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "two NASA scientists envisaged a vicious spiral,",
        "exact_native_cache_key": "47ea7c4d0abc1d724b27d072dbdcaf403434a78d.pkl",
        "cache_input_text_sha256": "a51eb15ab9803e8481b8380e74d2f1a395251601a5a95060a8f9a97a04582d77",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 3,
        "source_slice": "later named the Kessler syndrome:",
        "exact_native_cache_key": "d89b44fa7d7aab5f36aaeaafb1608e9dc18d7e71.pkl",
