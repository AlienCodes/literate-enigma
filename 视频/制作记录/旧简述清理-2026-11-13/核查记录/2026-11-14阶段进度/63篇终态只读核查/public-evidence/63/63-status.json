        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "In January 2012,",
        "exact_native_cache_key": "aa315a4dc0c51155341f055dd20a0833fe962d8f.pkl",
        "cache_input_text_sha256": "f61e58083ff0ff8bad254dd7e508d9442dd083df924596bd77cf545a5b587833",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "the International Space Station fired its thrusters to dodge an Iridium 33 remnant.",
        "exact_native_cache_key": "f7a6dd130cb76dcc7fada6096b616b82e8c03c4e.pkl",
