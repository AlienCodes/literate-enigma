        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "Such a cascade would unfold over decades,",
        "exact_native_cache_key": "c21e4f2c5eafcbd024deb71834c2462916ca41b9.pkl",
