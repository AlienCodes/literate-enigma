        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "yet the predicted encounter was not among the week's closest;",
        "exact_native_cache_key": "e747ab56cb2a2d58582ebaa26c31368f1c62c980.pkl",
        "cache_input_text_sha256": "7f2906ed266cff4449e4ed3dbe375023ac519b03c42685ca50adda978cdcb9ac",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 3,
        "source_slice": "such warnings were frequent and imprecise.",
        "exact_native_cache_key": "acce8d35458d5370089b2084f52b402c339ada44.pkl",
        "cache_input_text_sha256": "9e87e14625c5ee8eac6a323902db239acb644d06e415ef00df0d839e4048e18b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "The wreckage,",
        "exact_native_cache_key": "268a44c3a19d589a26b1f3bdf9356d05a3b18232.pkl",
        "cache_input_text_sha256": "fa857f4bf65a409efeb966a221c294c094c466c0053dd3600d2aa9d4c3638a84",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "however,",
        "exact_native_cache_key": "297b7cda4a221e878f1387c3ae26ba3e4016c6fb.pkl",
        "cache_input_text_sha256": "4860ed8c70b23f76771f0681d90724ce76e5c2a97c99f459b574117522a0b4f6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "endangered everyone else.",
        "exact_native_cache_key": "e231c49ba926d2e2f4b96f8fd115237102d86d1a.pkl",
        "cache_input_text_sha256": "756a98d9b8411fb2fee6c0be0716c6383650b9147f6bcde8d01700925c4a4309",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "At that height air drag is feeble,",
        "exact_native_cache_key": "b5b3974b1b110704ae1211739049196918375e31.pkl",
