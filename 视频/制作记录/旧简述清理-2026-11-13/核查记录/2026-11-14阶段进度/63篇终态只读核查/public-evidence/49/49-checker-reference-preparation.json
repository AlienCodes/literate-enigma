  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "Marie Curie was born Maria Skłodowska on 7 November 1867 in Warsaw,",
      "exact_native_cache_key": "24ccfeb5b3735fe5d6a19a77f298e6ae5a6af0ec.pkl",
      "cache_input_text_sha256": "9ab95b35ba557c69950d33858beb603ae898e92a994efe4a1e6b23b55ea13a00",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "then under Russian dominion,",
      "exact_native_cache_key": "15e5f6495364332ff6eb7cee1f1a64644bf08342.pkl",
      "cache_input_text_sha256": "4f8b0b1e036d221d3c3ef6ac88d36aa78f1defb88c0693206f0e51e013bef282",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "where women were denied university admission.",
      "exact_native_cache_key": "b1526eb361e56d94ec514e777ef792600d5487ed.pkl",
      "cache_input_text_sha256": "560845225296a881b2ae693b6bd96bd2cba73f8e86fb3b5e57618dab9c7bb3bb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Eager to pursue formal study,",
      "exact_native_cache_key": "ab7d906fc74c8547dca96c133a75895faac3031f.pkl",
      "cache_input_text_sha256": "20af5a04ff9007d2c37fb8777c6fdbcafdaade224571b8aff9365e307bed6d62",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "she emigrated to Paris in 1891,",
      "exact_native_cache_key": "2d4526291fafea603fe598c196d52baac3198678.pkl",
      "cache_input_text_sha256": "d59c8158cbe72a35564a2a15047bf1100383ee135487ec460ac436af99462400",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "enrolling at the Sorbonne.",
      "exact_native_cache_key": "a29021b095df96bfb3211acca34187fe69584a3a.pkl",
      "cache_input_text_sha256": "25096fc1b12ea310ee73e066521f422afd5b6f68e7ca7e58a2891ad80a4262a9",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "On 26 July 1895 she wed the physicist Pierre Curie,",
      "exact_native_cache_key": "c54bd29b3098ac3507d8b4db862d5069f8de3761.pkl",
      "cache_input_text_sha256": "44de345ec3b780eacda53bacd1b1525a0a68fcffd92ac127d771ed8a141f3e3b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "forging a research partnership.",
      "exact_native_cache_key": "ae3c4190f764bbde6c137c25824e893887888e40.pkl",
      "cache_input_text_sha256": "38448360bdb149f69a0e5b5ad77ff5b7010cd7ec42cf7e127dbe4f8ab2a1dec4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Henri Becquerel found that uranium emitted rays;",
      "exact_native_cache_key": "12ab450f4349d5cc970b23ce138a456a99474299.pkl",
      "cache_input_text_sha256": "baa414c12e785b025084f8f3e623b1ac953e7d1c4d5b78d6d27f22ee24207f8b",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "she named this property of certain elements radioactivity.",
      "exact_native_cache_key": "a7dcec12944b3a980d072557bdaeea4ef1c89ca6.pkl",
      "cache_input_text_sha256": "e04985f09fc71b0bb66b17b9887b5ddd80e313686f8d1a463fd059fd5adc7d97",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "In July 1898 the Curies announced polonium,",
      "exact_native_cache_key": "18d81a1db7cf365008d882c532887ab5841ddbf1.pkl",
      "cache_input_text_sha256": "39aa04dc9dd40026b6ddc0ae43da170aa77a89267e77b0967a23d023f0800ed5",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "a tribute to her motherland,",
      "exact_native_cache_key": "d18f031a232288c9083c88f6c29d36bffd24d2c6.pkl",
      "cache_input_text_sha256": "54fcd9fdafd5e47ccac44442a6ec878e763ae742ec73b3650e64d3112a173a1b",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "and on 26 December,",
      "exact_native_cache_key": "7a5edda8fdb18eb98b8a16287d26c23261e11c68.pkl",
      "cache_input_text_sha256": "cd83349b60cdd833b16284796e651f21a8bb73bdd30aee2eb1c5a3b8c8605939",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 4,
      "source_slice": "radium.",
      "exact_native_cache_key": "9341a2dcf3389f6002b8f8d1bb9ef89bdf4a8ed1.pkl",
      "cache_input_text_sha256": "40989fd92510e3adaad5701945bad905e84e03510c1e1c6a4f747220a4ec8d59",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "In a leaky shed they painstakingly processed tonnes of pitchblende,",
      "exact_native_cache_key": "d59c9c38263ac9fb8eae813592448ee17f172f35.pkl",
      "cache_input_text_sha256": "5313b15eee3224ed8d52dba7b811f75ed3b78007806066a99ae3c80810b50999",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "a uranium ore;",
      "exact_native_cache_key": "1f403b4b1f3435cd45e4a31837ab044a690b9fdd.pkl",
      "cache_input_text_sha256": "7601039f5db418ebccfd2dc4d2cadc92d6b263068e9de235b799660e409edf0d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "by 1902 she had recovered about a tenth of a gram of radium chloride.",
      "exact_native_cache_key": "8bb5cf06bab06f9f79aef5253d21dd4690ca4623.pkl",
      "cache_input_text_sha256": "1181265fdcf14d0f67772abb31a99c89f77f48d16ba8ec50982436cf3018b27a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "On 10 December 1903 she jointly won the physics Nobel with Pierre and Becquerel,",
      "exact_native_cache_key": "8c92ba56735cb6d5b3af0a5b2a6a201e33de8bb6.pkl",
      "cache_input_text_sha256": "50dc98cd194446eae60002a4054401a96d191d8db221c96a2c202c84c09a5224",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "the first woman so recognised.",
      "exact_native_cache_key": "62fa09ed49c341f3e3cf9febb7880539d8d1c0af.pkl",
      "cache_input_text_sha256": "b3c6be2cdf4265fc3dc9780ed47dfd38e4690d3c0d603e82ce6ddec57fafee66",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "The nomination had initially left her out;",
      "exact_native_cache_key": "949843eeb94d0ae80dd58a3262da4f9263e72146.pkl",
      "cache_input_text_sha256": "756c154a82e88daaeb1676b15627045be264fa937fc21462216d08095d0c99c6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "at Pierre's insistence,",
      "exact_native_cache_key": "4aadfc9fbfc61dc571487096a37ae672155d9cec.pkl",
      "cache_input_text_sha256": "66f6b50cade4c3a9529b156778df33020c689ff34845fc340c07ec8a54fe0503",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "the omission was rectified.",
      "exact_native_cache_key": "c00d7e16bc73061238da8b5310bb78e572dea485.pkl",
      "cache_input_text_sha256": "2886279b9f0f44a5cd9efb84af6dcfdfe8d56c12f6b52a5dfabcbf12fb562947",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "On 5 November she gave her inaugural lecture as his successor,",
      "exact_native_cache_key": "cc1b856be9805d46a2bb9048a9056a6255a0f1be.pkl",
      "cache_input_text_sha256": "2dc43f5fb8de8d6039213cdab2e83dc8a922cc72d51daf8b6d82d142b590cd3b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "the Sorbonne's first woman professor.",
      "exact_native_cache_key": "4e15887f044ba75807a899f44e79c6cf5acdea3f.pkl",
      "cache_input_text_sha256": "2ee2503579c85e09bec2db7c7aade8cc74c04c9d4441d3adc7abdea35dff5316",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "In November 1911 a press scandal about her private life erupted;",
      "exact_native_cache_key": "904f8453a9473dca36d86502789b047b39c36478.pkl",
      "cache_input_text_sha256": "700051df802718cdb17e00deb251466d52d6424048dd4176323b20d0ea0523ba",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "she was urged to stay away.",
      "exact_native_cache_key": "eb673a3c735395a85e96e88d9bb3843e9ca4d29b.pkl",
      "cache_input_text_sha256": "1902f03083e28b7c7f3e9bc08c28001db07e56effd7d669518bbd617519aa8ec",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "Undeterred,",
      "exact_native_cache_key": "8b6e778d61927c98e2721ab7d917a7d034f371ad.pkl",
      "cache_input_text_sha256": "665374ef4a268293540759d7aa4a110d2612e661f5820f862558d7a87d7dea32",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "she collected the chemistry Nobel,",
      "exact_native_cache_key": "1537eda354aab103152ef0954d7309f1c88c4b3b.pkl",
      "cache_input_text_sha256": "b63e735da6449a2ef68d052b9b9218b11f08f58ac439deaa2fe0ea41257fa9ac",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "won outright,",
      "exact_native_cache_key": "0dda06149da6f03570822e31fd1f5bf9a70f4cb6.pkl",
      "cache_input_text_sha256": "d781f9fb4f0b16131ddc52bf6f922db08558b18911542ae8731058bd7d703112",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 4,
      "source_slice": "on 10 December.",
      "exact_native_cache_key": "9ad512eaf160f24c0082b9526726e57c4f52ac74.pkl",
      "cache_input_text_sha256": "e4bd22ede2e0146d9845707903d10373179e2958ed682bf743775e0e89211872",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "She died on 4 July 1934 of a blood disorder,",
      "exact_native_cache_key": "db3457184f8edf055ec74a6ae61b5186dd97e087.pkl",
      "cache_input_text_sha256": "83b52f885dbe3c25cecd07a4ceb2ac1bd057d771173835f3dbdecb4d398ab909",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "probably caused by prolonged exposure to radiation.",
      "exact_native_cache_key": "dec275715aaada188189a56c5d171b0305fe8643.pkl",
      "cache_input_text_sha256": "acfb6d3d843dd601db58ec85d2e1cf4b144e657337cb8ce6e0fbe18421a35e89",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "Her notebooks,",
      "exact_native_cache_key": "44187a64357c09ef011442731ae9aa8cb87f9da3.pkl",
      "cache_input_text_sha256": "474256535e17e5114d7e208e275a7d78fefe06b3cf86c8f9a9b09eae384b6f98",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "still radioactive,",
      "exact_native_cache_key": "86f8ab8684338172b32b336127212863eb7d5d80.pkl",
      "cache_input_text_sha256": "7dae88b726d47cdc824096c6e5f63d01137db34a522c9d091622ff2be6224c73",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 3,
      "source_slice": "are preserved in lead-lined boxes at the National Library of France;",
      "exact_native_cache_key": "2c4292f1bcdf3071d7166439ac09d628b71b20d8.pkl",
      "cache_input_text_sha256": "d5ef98f07f8afa58b7d7e79069cd26da93d72d4b8fad35d7f9b3d6655c3e667c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 4,
      "source_slice": "readers sign a liability waiver and don protective garments.",
      "exact_native_cache_key": "fb5cd467ed475863c8719ee46372d4026107c764.pkl",
      "cache_input_text_sha256": "1b5dcb15b0bb347fcb91c908701d0337f7ca006cef7dc4a226771bc0dacb5777",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    }
  ],
