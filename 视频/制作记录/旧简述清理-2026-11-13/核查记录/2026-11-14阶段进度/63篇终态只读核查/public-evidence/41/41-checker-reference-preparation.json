      "cache_input_text_sha256": "ddbce9658d3682646464666effae3b77672b0539ea3e928bad0a55fb116995c4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "The scheme flopped:",
      "exact_native_cache_key": "849c20f136bfef44eca946c10c1e3f8f3d88456a.pkl",
      "cache_input_text_sha256": "0fd033594bf36a990ee4de0da27e43870eaede999e76e62210cd4e98a148da14",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "the toads barely dented beetle numbers,",
      "exact_native_cache_key": "5c9c174113f85b880b10f375f42bb9e8d4acc2e5.pkl",
      "cache_input_text_sha256": "5f8e48540aab24fb26fad35c39247c6f68f54d2e52470e661fb92e6cb07d7967",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "perhaps because the insects stayed high up on cane stalks.",
      "exact_native_cache_key": "7bda57134200606ce7045f4b617d8ad3080195ee.pkl",
      "cache_input_text_sha256": "6b8212d659103cbd6b4cd55891a83fa939d393330151228db2ee2c80b7b4573d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "With few foes and fertile females spawning thousands of eggs,",
      "exact_native_cache_key": "012533ddb9d79400b642da00d7f110b0d6a20723.pkl",
      "cache_input_text_sha256": "ebe1e190ec59cb520b02e57de016eac66405a264c0f711aa794dae0238aa39da",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "they multiplied unchecked.",
      "exact_native_cache_key": "d6184e9519bca972a5677345dc7b6dfde9fd6e4b.pkl",
      "cache_input_text_sha256": "e0411549ad413611e1f5b063fb777ec1ec9d084c0bd86d0304a05dae85f30fe3",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Their invasion frontier,",
      "exact_native_cache_key": "33b6ef788fefacdbda88aa02be4bdc8c017f092f.pkl",
      "cache_input_text_sha256": "856e472d937165310f3215fdd50be3f2c483231a8bb84877c23b175d66189c2d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "creeping about ten kilometres a year at first,",
      "exact_native_cache_key": "70023ad68726027c80144e8432c70fb0921550ec.pkl",
      "cache_input_text_sha256": "81259fb37e875857272c7af21d8df8b68047606a6e743cb883678e62461ebbda",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "accelerated to about 50 a year in the tropical north.",
      "exact_native_cache_key": "691d94f6e5d410dfebf520667ce3a838daa149ac.pkl",
      "cache_input_text_sha256": "1e5aa9aceb2b895c7bf2542f5bd8867946d83ef6447f3cb2f16729119b35c68a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Numbers of goannas (large lizards) and northern quolls (small marsupial hunters) have slumped in places;",
      "exact_native_cache_key": "8045b017470cebc08e32d975d4d9dfde876f3468.pkl",
      "cache_input_text_sha256": "4c48e0cd7ebf27292d75f5630385b24f7d28cb307da8560bb06618c97bd2d8a8",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "some local quoll populations were wiped out.",
      "exact_native_cache_key": "7e9e7ce93adb9e17d26218be56ea266076b7477a.pkl",
      "cache_input_text_sha256": "746c4e6f19a79fc9b8f8156844a9bd1405f5e5be49afab792aaf9d7d6cd5864f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "The toads have wreaked havoc,",
      "exact_native_cache_key": "9b064ca7ce18bb4b3d5a1fd2662a66e6eb415920.pkl",
      "cache_input_text_sha256": "74dbb32f07c75cd932117ecb221055fa95c9d1015d21015c9e5d157cb6a1ba1e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "but the damage is uneven;",
      "exact_native_cache_key": "f00c2b6dc343c6a32355f1c1b9255d82eb6407bf.pkl",
      "cache_input_text_sha256": "9581f8b5b118239c935844ac26e103d6eef23b705640a841691c3fc25507daa0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "some species have prospered.",
      "exact_native_cache_key": "2183e85452938f51e0a0e4f14bcacd8c55e1071d.pkl",
      "cache_input_text_sha256": "e5bc96042def88e90d3e3540443a6581c9768ae232d324e97c1aa75c1e986b23",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "From 1926 the cactus moth,",
      "exact_native_cache_key": "6a4b86ae6c271d861c527daa719ff58c3fab2876.pkl",
      "cache_input_text_sha256": "e3de9121d85f1a664b34699e95c1da6b72c5c5c0438a54729326ca727d943f20",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "Cactoblastis,",
      "exact_native_cache_key": "0e654dfbe6120005e3296cd7e7634ec44f869876.pkl",
      "cache_input_text_sha256": "0f7af933ac140e6c2c1a051a7ffdf433aea780f015d648b4a6b77e87410c0784",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 3,
      "source_slice": "cleared most prickly pear,",
      "exact_native_cache_key": "848d89211ac9e747046c5452274fc29507f1d30e.pkl",
      "cache_input_text_sha256": "4c8165ade7cd8c9fc4e68157509c5b82c4488a2dde4c70f37fd7562186b8f422",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 4,
      "source_slice": "an invasive cactus,",
      "exact_native_cache_key": "3030eaeeddcf264dc8d14b6a3ff52b731c8f6c40.pkl",
      "cache_input_text_sha256": "3d969601984b3391732d54c0c67be2050869433b99f46d743cc372e3dee16a51",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 5,
      "source_slice": "from Queensland and New South Wales within about a decade.",
      "exact_native_cache_key": "fc0b986bf0cb7b1b671c3a2b826316ff7140cc9a.pkl",
      "cache_input_text_sha256": "3694c955dc2d91758bc8617870f1e0cb9d4c61e00268e11584152ddf08b7b340",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "Tested first,",
      "exact_native_cache_key": "8a5d9199b918dea72a3f455287bae8c6f46695fc.pkl",
      "cache_input_text_sha256": "7f5acb333ffd2e1fdf4cef50a0de45348e0152625a86862ed1b0eb3a3b3decc2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "its larvae starved rather than eat fifteen other plants;",
      "exact_native_cache_key": "f06b4483a179eb07a4ae9b1b00d0c81aa075a10d.pkl",
      "cache_input_text_sha256": "4287ad972b14c78fae4e39c92d22cffd9abe8747e25b59061efef97f32f7b343",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "the toads faced no such test.",
      "exact_native_cache_key": "63eb655b36a201ac58d57942ec47d0811e1348ab.pkl",
      "cache_input_text_sha256": "82779d2ed141a30fd7243becd311994bf7b3b72f9bf2c7e2ae87bf574e9ee9df",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "Under an October 1984 law,",
      "exact_native_cache_key": "cbe37e6a847001573a04f429c333b436ca842a01.pkl",
      "cache_input_text_sha256": "34503056a6fac0c69bdf5153f30b89f1d85dda76943f9b76216dd7aa608ac94a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "recruits now face stringent scrutiny.",
      "exact_native_cache_key": "ce792971e17738c611d673dbde9bdfa62b1e73d6.pkl",
      "cache_input_text_sha256": "b5a6f32fb90f1e049a6bbf08f66b27b1f8c48e6476a9c961260eb59756db7709",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 1,
      "source_slice": "The blunder was born of haste and sealed by lobbying that overrode a warning:",
      "exact_native_cache_key": "3ccfe3454fa71824ca78bd1a26ad072883cd257d.pkl",
      "cache_input_text_sha256": "d124cbba7b63ac34d6cf7e0af019f1ecd00330ee41627a639f72fde82231b1e4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 2,
      "source_slice": "an untested ally,",
      "exact_native_cache_key": "dbc8d21f5f34bcb15b6ea4c36efafb9120d4f3a6.pkl",
      "cache_input_text_sha256": "5807d749ad56c7b3418fc6fde60b4755ffd7178c5a7290f00f51c959fc0887c0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 3,
      "source_slice": "once loose,",
      "exact_native_cache_key": "e4fa669c9370b011232254fc84f28499f8838048.pkl",
      "cache_input_text_sha256": "cd7e39790191222f319a48e570c6ad5ca41d12ebd9ddb4e88b03dc036d687ab1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 4,
      "source_slice": "may never be recalled.",
      "exact_native_cache_key": "fbff96d5a543b18c7772f7f61c1318bf9c204fc4.pkl",
      "cache_input_text_sha256": "3171aeaaabee3bef705ffe99e9888c4eb8fe9d4f6ef81aa09bd876c231f915c8",
