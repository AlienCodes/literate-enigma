      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Biological control,",
      "exact_native_cache_key": "0a064ba789ebcab1ab6edb066f8064b4829e5a07.pkl",
      "cache_input_text_sha256": "6d323225839edab0f7a0c018b3c1d81e5492dc47e752703a10c118b3ac972e07",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "setting one species against a pest,",
      "exact_native_cache_key": "4ed0aa0f7c7f69e36b2d1bbe42551180f64be1b7.pkl",
      "cache_input_text_sha256": "43163adbba6af6ece61c87e988e8b69f2b0bef599f91841605527f88991491a9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "had an ambitious new recruit.",
      "exact_native_cache_key": "3dc8a01a264d9e1ab1a259a044eb72f049781cf4.pkl",
      "cache_input_text_sha256": "86154c6f69e4d1f7d7656c44cc20e027e6e189dc81d29aec3abbacb47d4e7231",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "In November 1935 an insect expert,",
      "exact_native_cache_key": "bbd045129f52125770fa66a6bf7e98312a728e23.pkl",
      "cache_input_text_sha256": "e3d881373f332441cd37160640e90aa8a44b7fbbaa555918fedcddf6ce3e3cef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "Walter Froggatt,",
      "exact_native_cache_key": "3c7db31b6119768af144747d814a134638660007.pkl",
      "cache_input_text_sha256": "54d8ae2c26a23688f0b20651f80a72e73ad03dc506bbb865500cab423fe1185f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "persuaded officials to halt releases;",
      "exact_native_cache_key": "48cb9ab3d77d65ec84ca65903e46c95eedec35d1.pkl",
      "cache_input_text_sha256": "5213e62d21fd92817f1f718ed561a5cef76088f18f055387b41a7f4b53ec35e0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 4,
      "source_slice": "after Queensland's lobbying,",
      "exact_native_cache_key": "1376cb37b892e8e33f9af1e7cd6ad394c97fa5fb.pkl",
      "cache_input_text_sha256": "ec987931533f7a231d8788bb649f40a2065cecb0181e3d3492ed014d31c3a12a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 5,
      "source_slice": "they resumed in September 1936.",
