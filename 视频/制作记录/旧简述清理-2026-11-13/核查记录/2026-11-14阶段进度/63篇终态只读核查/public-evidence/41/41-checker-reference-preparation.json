      "cache_input_text_sha256": "27922e0c5f089fbfc21eec38e2db282ee293fc07fac0daae6289c7ca273f1d4f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "bulky amphibians native to the Americas,",
      "exact_native_cache_key": "e8e53677000384a1485df9ab342a3a377afb560f.pkl",
      "cache_input_text_sha256": "6992d492cc8046c280a27c2c6a2b73aec56c75dc54cca78c170353927e60dcc3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
