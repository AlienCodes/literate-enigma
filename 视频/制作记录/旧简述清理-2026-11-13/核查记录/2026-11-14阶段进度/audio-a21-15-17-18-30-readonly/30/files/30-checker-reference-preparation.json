  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In the fierce heat of summer 1858,",
      "exact_native_cache_key": "5daaa4ee6b6b2a7831d8e26ad32b125865b94600.pkl",
      "cache_input_text_sha256": "213385d883bcbc000114ace3939ebe20b7bee293866185e2bf16fc87577af5e6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "the curtains of the new Houses of Parliament hung heavy with chloride of lime,",
      "exact_native_cache_key": "d7db673be20b5ffcbe805ebd9f2db9765885d644.pkl",
      "cache_input_text_sha256": "9a57db316ae7a3c48966dfb668545b5e0d192271ff4c541605eefdbd65ac4066",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "a bleach to make the air tolerable.",
      "exact_native_cache_key": "e86913a7858f8e0bdbfb36cb3ddbba5428482e4e.pkl",
      "cache_input_text_sha256": "5c8cc754e3772cd3bca52cf3945e21661842816b64c05b550f8cb6dbc7e706e9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "The Thames festered,",
      "exact_native_cache_key": "4d6345804029465f27799f9fa2e2e4a39b952e5b.pkl",
      "cache_input_text_sha256": "5709a2911f6387dd9cf59258c85fc18b1d4d17a6964dca42e551339ba392edb9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "and MPs contemplated moving out.",
      "exact_native_cache_key": "4109f2a9ea7bb0f966f240ced1533ff1f434fe8e.pkl",
      "cache_input_text_sha256": "a5474f5d47b3bd3cecf89f859d10a37d453328236b07fdf430f08de0ee14c496",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Antiquated sewers and outlets discharged the untreated sewage of some three million city dwellers into its currents,",
      "exact_native_cache_key": "0704549efaabc75c35d6077c448dbe43d20a844c.pkl",
      "cache_input_text_sha256": "02dd324fbc784fd97ff018af738e28a94bae5d9c688d2ec7b2f598c2ac629f18",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "where the excrement stewed and decayed.",
      "exact_native_cache_key": "18b62d5b91b10defd79c0e8fc665787d016c9165.pkl",
      "cache_input_text_sha256": "9d6dc50f7d2c25a0df5eba6443556dc517c961d237f0f11eb05f20e5bf542420",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "The vile fumes grew so overpowering that the episode earned a name,",
      "exact_native_cache_key": "7ad9ea92a3b42c88576ae3fa008c2b13fea9f36b.pkl",
      "cache_input_text_sha256": "954018c0122da52bf41abce4889627af25d07ca01bc3c78b811e3116f9b246b9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "the Great Stink.",
      "exact_native_cache_key": "29eadd2a9ffb9d745665a3058f06aedc935a6902.pkl",
      "cache_input_text_sha256": "ce76b6988441486f920884f52853cf3624f16bf7ba688737a896feaf340e8d16",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Disgust found a voice on 15 July,",
      "exact_native_cache_key": "bcc8587a2761b978d3c495c2a6e7ec6140390618.pkl",
      "cache_input_text_sha256": "dcb9698acbca520863569bd7c5de6849e65750bc47b2499cfc0ca30f282ff554",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "when the Chancellor of the Exchequer,",
      "exact_native_cache_key": "407872a9763bde5b2d69c654139f075bb13dbe84.pkl",
      "cache_input_text_sha256": "c7af0457b79e5bf0f5ba48ed1800ab0a28c8cd94a02ee92e659ce633d0f7a76f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "Benjamin Disraeli,",
      "exact_native_cache_key": "ac15a199bdea4f39bf0313c9fca000cdd0b49087.pkl",
      "cache_input_text_sha256": "621697471a622429adaf489be625988bf249a440395610788b585f74b2813d35",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 4,
      "source_slice": "denounced the river as a hellish pool of unbearable horrors.",
      "exact_native_cache_key": "43073601c96385348ce413fa416f22a0e055bc94.pkl",
      "cache_input_text_sha256": "bee753f727c16f5a26e2ebb4efa49024315cd7108efe700024062f8601f4c29d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "His 82 miles of stout intercepting sewers caught the flow short of the river and diverted it east,",
      "exact_native_cache_key": "594fab7d074f6ab627f1e7e56a75617b1efac36a.pkl",
      "cache_input_text_sha256": "a904fb251483c19f130e8e4ea81c8e9f72f70e8ffdf33e61dbe4fd88133c7e3c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "downstream of the city.",
      "exact_native_cache_key": "403d203c9c51691da74a0024f880314c5e569dd5.pkl",
      "cache_input_text_sha256": "7915e8b9292f2ced8622a724ce1638aba9fb17225693dcda5894dc558be1639d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "With some 1,100 miles of street sewers as tributaries,",
      "exact_native_cache_key": "1d203c37eaa4919dd4aaecf4e60cad764b403613.pkl",
      "cache_input_text_sha256": "1dac2c5d099c1d810601f443eba2c5b294347ed6bac56e7a3bc5f49f97df0cde",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "the infrastructure took 318 million bricks.",
      "exact_native_cache_key": "5b45e642989ea6b760887fce7475055fa17a1838.pkl",
      "cache_input_text_sha256": "3e502d71db8cd43d3c3dc07a11042469199959a322149a4f0e3c10c91a620452",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Having calculated an adequate calibre for each pipe,",
      "exact_native_cache_key": "3404aa6370414c828a98e7c959ea834a119514b8.pkl",
      "cache_input_text_sha256": "c13c2fab371709d19e9d48505429eac2e589d248e8719524c1613d0454085c54",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "he doubled it.",
      "exact_native_cache_key": "7d2030954a13434203e312886ceed481d69af821.pkl",
      "cache_input_text_sha256": "c1fcd2ba4a2e3fc84ebdcf82e187fb2f8cfffa87c5f26b4e805f33394b89f1a3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "The backbone lies buried underneath the newly built Victoria,",
