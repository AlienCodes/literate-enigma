      "cache_input_text_sha256": "c10dfe99db07ca166b4878b068abf530853ce0f41cea13f011e686c9f6c49778",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "Albert,",
      "exact_native_cache_key": "87f94fcaec5eb416d0e26451b0f57bf08b516b6c.pkl",
      "cache_input_text_sha256": "302dce9c21c5d50a175ea4da2b41c50d091413b7940d975d6ec9ccf39b5de199",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "and Chelsea Embankments.",
      "exact_native_cache_key": "a7d759c1327fb9f47419e8c5eda870541ca847e5.pkl",
      "cache_input_text_sha256": "7bfd14f8af78aaa639dca38360466c029e6b755969f0bf2880c8d0978a759c9f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Substantially complete by 1875,",
      "exact_native_cache_key": "a2a9714163899672adf9843c4858c2e61a968767.pkl",
