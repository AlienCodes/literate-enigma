      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "The predominant belief,",
      "exact_native_cache_key": "903b0f161626f3efedfc50e73fac5c6d35bc5668.pkl",
      "cache_input_text_sha256": "70b74d1ac0ad63ddff30dae96473ef6fc787a7dcb7d056559d1c4d81eb5cf54c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "miasma,",
