      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "blamed disease on foul air and vapours,",
      "exact_native_cache_key": "84fe1d6af750c39d15719306eac94cea15130caa.pkl",
