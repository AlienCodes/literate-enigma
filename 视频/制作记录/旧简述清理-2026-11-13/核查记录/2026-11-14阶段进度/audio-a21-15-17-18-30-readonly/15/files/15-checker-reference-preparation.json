  "reference_calls": [
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "At about 11.40pm on 14 April she collided with an iceberg;",
      "exact_native_cache_key": "1c6e9ae91a9eee95698048877bd1f3873e8b8300.pkl",
      "cache_input_text_sha256": "09ced40f07a4b4f62edc8ff7bb462e9d315927ffaff09cc184c8b06ea90bcc41",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "by 2.20am she had vanished beneath the waves,",
      "exact_native_cache_key": "3c109fc0869188fbdfd4412b206ca12ab627b739.pkl",
      "cache_input_text_sha256": "dc760802698a18e3e3bf23b85804d4a5a9b789d8f2fd794f1b9fb94f9a4393aa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "and the death toll would surpass 1,500.",
      "exact_native_cache_key": "69c97c484823403b18a309d8f20893bfba6804ac.pkl",
      "cache_input_text_sha256": "63b9c8f153fc746cacb89feef1cc01f709ae10efe3d9e7263143ed948b6a6919",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Under 1894 rules,",
      "exact_native_cache_key": "0caec48756d2b4484c7dc3ec03bf5cabf3f49555.pkl",
      "cache_input_text_sha256": "ed066973cb32f1f8219fb59ea4d6f8f4c200120effe7f0db0332b589f5f33000",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "Britain's maritime regulator pegged lifeboat numbers to gross tonnage (volume,",
      "exact_native_cache_key": "001360512563e908aeaeca89bce3e971a580c70a.pkl",
      "cache_input_text_sha256": "cc810ba34fd532158f5516c73e37c5b6cc79c547111a7f53b5dc7284bbca6043",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "not weight) on a scale that topped out at 16 boats for 10,000 tons or more.",
      "exact_native_cache_key": "7e6e46a3963360c12f954f9aa0bc65f9dd4e6161.pkl",
      "cache_input_text_sha256": "87428e8a9d3224c9f0accc9701fddbf0583830df3de8177801e803345562acb8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "At about 46,000 tons she carried 20,",
      "exact_native_cache_key": "2b876d8f0f512c461dc8d9c207a0719c56969ab8.pkl",
      "cache_input_text_sha256": "93adff6eb0c3509890bb5b819fefd100c7e48b9a8acd8f1e6d20279f07500563",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "exceeding the requirement.",
      "exact_native_cache_key": "34a9702029299a17dd081c3adabe52d51c33438a.pkl",
      "cache_input_text_sha256": "c71194c2003e83edbdd26e5f3411cdcd7e08a88ec6a9ceaf28737163617a6780",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Their capacity was 1,178,",
      "exact_native_cache_key": "a093e52f26c68f7212b0fa3c09b32091e2ec689e.pkl",
      "cache_input_text_sha256": "1b61e27d75071beb4df5af4776195d3b1c63d5197dd6721956c3ef4cedd1c186",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "roughly half the 2,200 aboard:",
      "exact_native_cache_key": "d87e9472cf602d18ed4c0aa98d7f28fdaacb2b22.pkl",
      "cache_input_text_sha256": "bdcba1fb107e7f47d0247b51ec7190ed83aea29fee074f461cf0bd3e2aefe76f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "sufficient in law,",
      "exact_native_cache_key": "3722ad0de50cc35651bb76aa85bd9d9d213695a3.pkl",
      "cache_input_text_sha256": "d2efd20734e6df683f3b29116d42aa16221850be2ba83dcf76b7c6b9cfc7d113",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "inadequate at sea.",
      "exact_native_cache_key": "019f9a6129815455253ab54a7bcd3bd0eda1aba9.pkl",
      "cache_input_text_sha256": "fd02a8f03cbb41a38315b007ecb24e3fa98db7cf3f0f2ec962cbe1bef9ebfb9b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Within radio range,",
      "exact_native_cache_key": "8b629f1918754bce4370bde6a0f3268331e69b3e.pkl",
      "cache_input_text_sha256": "049593ae8ce27965798e272a1cc69c67953eb378647b58df24c7bf5e81ae8e75",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "the steamer Californian kept an equally lawful routine.",
      "exact_native_cache_key": "6d7fd7834110b72c26cb988485dbd50e6c65123a.pkl",
      "cache_input_text_sha256": "931dad6170b41381bd5b4ee63279cc69410f78c02512b2b280f8c63694e9248e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Her sole wireless operator,",
      "exact_native_cache_key": "20e2152945994e2aa27da021c12b1730578361dc.pkl",
      "cache_input_text_sha256": "6eab695dbbc3713932cd8fbc44ce91a1eb35f8c1253558ec45fcc4da1b0b0399",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "Cyril Evans,",
      "exact_native_cache_key": "7b1b326f619c7c40baf333cb959740bf213a873c.pkl",
      "cache_input_text_sha256": "aeb603584967423f7eaba6f81f858a4c9b20986da950f13db13893432687de4f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "was on the payroll of the Marconi company;",
      "exact_native_cache_key": "522f95cf9d483229b92601ed284d2f0645be9ff5.pkl",
      "cache_input_text_sha256": "e3a89bea159d334fe4a9e530ea4faf57d5c7085cceecd0ff9c8f8b48aa56044e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 4,
      "source_slice": "when he slept,",
      "exact_native_cache_key": "89e1fb1a785350df3d1cbb272e057ad559e2a34e.pkl",
      "cache_input_text_sha256": "9bfbc3b98063e5f0342a759fe3b2aee22aa506f1efcd99bf685ff5d2e8c70693",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 5,
      "source_slice": "so did the radio.",
      "exact_native_cache_key": "e4f0adfa9364e3870a11ee091495db754126907b.pkl",
      "cache_input_text_sha256": "f0f4b182c12e7f836c738cb140cf9ca484a8938fd65a246fb886886e10a414ed",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "Hindsight may call that negligence,",
      "exact_native_cache_key": "d68d561c668f105a88aaaa8dba83ef2b58c92294.pkl",
      "cache_input_text_sha256": "a5f4a78501e35f8570c99226415fcd13f3ff6740c0783e2d59dd9233e6ce4bf5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "yet no rule obliged him to stay vigilant,",
      "exact_native_cache_key": "92d7d0d0c02f0d67510a67453192a32bc5a732c3.pkl",
      "cache_input_text_sha256": "6702719829dc4f8295c952e0b422fab5319f42391d7da39ef15b73afd50edd89",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "so the Titanic's frantic distress calls went unheard there.",
      "exact_native_cache_key": "a4294163c23ed125cce5c5fbb1c5978e26c9f728.pkl",
      "cache_input_text_sha256": "c025a3658fd437cea40911853ff659de3ec9e9ba4f6d89b5a2f381406f9e8b91",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Between April and July 1912,",
      "exact_native_cache_key": "734e25f87b080e2bf5c0495e945e01f3c82aff62.pkl",
      "cache_input_text_sha256": "600eb4ec449deb6a3647117ffdd2e675f9554a7a8c005691809eca120dec17eb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "inquiries in Washington and London heard testimony from survivors and the Californian's crew.",
      "exact_native_cache_key": "bfdb56590b26d0c7040c65b5ab424e629a51e7ea.pkl",
      "cache_input_text_sha256": "1af81283af9e560de60e24cbd91356f05b06dd3ab8a627fd36975b86a85f6b3b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "That July,",
      "exact_native_cache_key": "546e638cd5528ac30ab912d0dea5067dacf08c4b.pkl",
      "cache_input_text_sha256": "762e8aa083bf50f0ccc619ae2952fed79ddf1132f48ffb444d455d79b0c94f44",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "American legislation made round-the-clock radio watch compulsory.",
      "exact_native_cache_key": "cddf42d91f0a3d23a9009ad9edfe2bf13aaf1523.pkl",
      "cache_input_text_sha256": "0b7b8e00adf1ae39ec3ee3c15b8da22e63c781591c65e9656aaaa96db142a256",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "In January 1914 delegates of 13 nations signed the first Safety of Life at Sea convention,",
      "exact_native_cache_key": "c4d832d673fd877a2abf26da2ff814e25f6f59d8.pkl",
      "cache_input_text_sha256": "6ece3d4fc24697361c5fa0a7d7fd1fb9a46a7f21f17aa7e320e21b02b7c06e97",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "stipulating lifeboat seats for all,",
      "exact_native_cache_key": "c9074a79876fe065353db27a0e24cc2096c13716.pkl",
      "cache_input_text_sha256": "2e07a666dec2c9045ec13c9fb849fd69dfba8d91eb96f1e6902c7698a7551900",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "continuous radio watch,",
      "exact_native_cache_key": "7395c353679da46a9cd7c7fc177ede67aa7e8b43.pkl",
      "cache_input_text_sha256": "e19a520f8bd1fbfd3c7ed4f91849dd22898528454cbdc9025a6987469f9105d3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 4,
      "source_slice": "and an ice patrol.",
      "exact_native_cache_key": "829686defe4151ad9c1d7721710432d18a2ce61a.pkl",
      "cache_input_text_sha256": "50139742fe7fbeb33239e946936e78815ad03ddf1009eab68ad4240034475190",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "The First World War stalled the treaty;",
      "exact_native_cache_key": "98b365772020aef3ca52a5937026969f15efb1c2.pkl",
      "cache_input_text_sha256": "ab7de1ac9cf35c2e1b1798afc735c7c1294067dda6c2c6b80a6afe490b96d101",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "the patrol went ahead regardless.",
      "exact_native_cache_key": "9971c91da0fdb767146681781501734a51ca1c04.pkl",
      "cache_input_text_sha256": "0dbb5496d40f09070a2faf8e6678f6bebfb49f9580fe3fa5ce4ae329febbbb54",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "The outdated rules she sailed under had stayed afloat since 1894;",
      "exact_native_cache_key": "21d710835bb27cbdb317743ead6c5ba1458398a8.pkl",
      "cache_input_text_sha256": "18b6cec9618dcaeaae7cf4ce632c6030f624f342d71c97bd6fc29d711617fce2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "it took her dead to discredit them.",
      "exact_native_cache_key": "bd01b36214eab566a3f7ce3bab56fd3500f53e4d.pkl",
      "cache_input_text_sha256": "986932af4f2748245e7c6a3d0b61b2010ff5a6bbfea33dbc7b4855d1f775a589",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    }
  ],
