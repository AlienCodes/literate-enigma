+    句子、篇号、标题只认 genNN。"""
+    for k_, v_ in old.items():
+        if k_ in ("no", "title_en", "title_zh", "title_fx", "sentences"): continue
+        out[k_] = _深合(v_, out[k_]) if k_ in out else v_
+    return out
