+def _深合(旧, 新):
+    """旧脚本的值并进新的：两边都是 dict 就逐键往下合，别的一律新的（genNN 里写的）为准；只在旧的里有的键保留"""
+    if isinstance(旧, dict) and isinstance(新, dict):
+        return {**{k: v for k, v in 旧.items() if k not in 新}, **{k: (_深合(旧[k], v) if k in 旧 else v) for k, v in 新.items()}}
+    return 新
+
