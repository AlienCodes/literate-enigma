  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In a 1955 referendum,",
      "exact_native_cache_key": "c92d2d4896736a21473571c90808acf21353ffa0.pkl",
      "cache_input_text_sha256": "1f7a30924aa7bf4f4fa9624c8fb869caff5d9f138be0f395c11c725c4396a68c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "about 83 per cent of voters chose to keep driving on the left,",
      "exact_native_cache_key": "60da19886d649dfff7a718e5d0ead051d3c60eb6.pkl",
      "cache_input_text_sha256": "b4cee4e1c4501d10fe22521d40f50e5ac3809a46dd832acae9ab6cf336747491",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "an overwhelmingly clear rejection of change.",
      "exact_native_cache_key": "b9303d4c4f8d1ac6f6b074c353d6fd4a35ced585.pkl",
      "cache_input_text_sha256": "06d2ff2df954050d477a9bfdacfd5d854c0404dd50c1d2d8c6995f55cd918cbd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "On 10 May 1963,",
      "exact_native_cache_key": "5d7cfaa5d4440729d3eedad6470a81f895de27f4.pkl",
      "cache_input_text_sha256": "ba95687880255c0d1e3325453c5ec3a328489f4dbc4594050047471a6b83a311",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "however,",
      "exact_native_cache_key": "297b7cda4a221e878f1387c3ae26ba3e4016c6fb.pkl",
      "cache_input_text_sha256": "4860ed8c70b23f76771f0681d90724ce76e5c2a97c99f459b574117522a0b4f6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "legislators in parliament overruled the electorate,",
      "exact_native_cache_key": "41506a411b2c463d99e7f4d83206e0831aefd9cc.pkl",
      "cache_input_text_sha256": "db691764b041fbd9b9b58acd1cbd9eef2f2ac1527ac8f7979c65ab7420efb07d",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "approving right-hand traffic from 1967 in defiance of a populace among whom the plan was unpopular.",
      "exact_native_cache_key": "2ace8f7531e1a9a5f27af4e3f4b69125ebc9852e.pkl",
      "cache_input_text_sha256": "bc9404d706af4a4a4678005f04a836173ee1e6ac76e85141dbcbd58feeda9c79",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Norway and Finland drove on the right,",
      "exact_native_cache_key": "d72880947dcf22aa20bf84e0718c8f97c91ca4ae.pkl",
      "cache_input_text_sha256": "6b53a0c676bc8387d1cadf802e9297e96f89d04d32e6345a29b8e64955f882ef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "with about five million border crossings a year,",
      "exact_native_cache_key": "b2bbbc3a7e66ee92670c919d85eaed0b14af09ab.pkl",
      "cache_input_text_sha256": "d88e4ae125c80e3ec921b7b77c7c7eb253ada908cc4a3c925c8fe91f7d83b805",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "so a left-hand orientation meant isolation and inconvenient journeys.",
      "exact_native_cache_key": "35f34a5b32612e83fedbe463bd43926fd061e8d4.pkl",
      "cache_input_text_sha256": "8c1db9ff3849b84ac7f766fb32236fc4147ef62148ea8345f7751dfbc968e3a0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "About 90 per cent of cars were left-hand drive,",
      "exact_native_cache_key": "1a080e96b0a06a6dea4cdaf4b396284600ddeb40.pkl",
      "cache_input_text_sha256": "70bbe79a0fa6fc45a7b3aa45393982c840cc4bc0c379c49e3329ad3678d6c581",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "so motorists overtaking on narrow two-lane highways risked head-on collisions.",
      "exact_native_cache_key": "fb46070bb621e2b0fcfed00ea5f61f72dea63a6c.pkl",
      "cache_input_text_sha256": "8ab87d4ec036b4feea2cdfa3dea59938dfd711155ad90eb42ec3f2adda1f9e36",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "A state body ran the mammoth preparation under a logo,",
      "exact_native_cache_key": "b3990a040c3fde43f05d9df18ad2d824d2011728.pkl",
      "cache_input_text_sha256": "c9a504492b6477a3eb948e147e0aa1fed8036b799393d372d3ac495738e9cf73",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "a large H with an arrow.",
      "exact_native_cache_key": "503dcf813454268c6f521430bb2cafbad350943e.pkl",
      "cache_input_text_sha256": "fcd163602314b5c3736ba5274d37ea911ebe4dc9a0a0a5b1cb2dcee804382d6e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Its propaganda included a song contest on television,",
      "exact_native_cache_key": "d505c691664d46712810de5a351ab9e629765b42.pkl",
      "cache_input_text_sha256": "ac50356c152491323fca75c7750f5b807d298d7daa931187720490047857db73",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "and the winning jingle,",
      "exact_native_cache_key": "88695f851bbbbec4b68a9e79a8cd8cb6023503c7.pkl",
      "cache_input_text_sha256": "c0fc60a39f74c4197b4a5bf4177a95561577e9b019f5f213693cf9456ba17eb8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "whose lyrics urged people to keep right,",
      "exact_native_cache_key": "3e0263fab9e06a1a5e446c23ceaab320b3ecf6c3.pkl",
      "cache_input_text_sha256": "08f4df6c7b5c7f3d48809b5ccc607e83196f4b209e2abee084156e38e176d1e3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "reached fifth in the chart.",
      "exact_native_cache_key": "c3b139ec02465362c65d73af78f39537fff70997.pkl",
      "cache_input_text_sha256": "b993b9cd2926f623dc2d6a6ac80a9570008918d2ffd9a2d774be13e788db16a4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Some 360,000 items of signage were changed,",
      "exact_native_cache_key": "55b612883986592b448b51f6b66ad131d92651a0.pkl",
      "cache_input_text_sha256": "c59e2e43dca7ac93ec0fa89223c61211bf719f709ba422646e038bb24bb0ea8c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "and a massive fleet of over 1,000 new buses with right-hand doors was procured.",
      "exact_native_cache_key": "c1fcfbf7e925c94c18669d02138297a9369b806d.pkl",
      "cache_input_text_sha256": "274865a1dd5f05ed25571b1d5aa2e8db1e9e77eb2cc27795a6a8870aa89d0030",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "A curfew kept non-essential vehicles off the asphalt from one to six,",
      "exact_native_cache_key": "a9616ca03cc456072b8d48781d92a89ed89ed6dc.pkl",
      "cache_input_text_sha256": "aef80672e8ed5b306741b4558f47cbadb76f57a4558b285b1a1002a71fd5d72b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "with essential traffic exempt.",
      "exact_native_cache_key": "b03101ccb3d9dfd1aba179645ab7c05056b2a81b.pkl",
      "cache_input_text_sha256": "f56d29a9e1a4295e8a8f0d2e8dd334b7c76ac8f03218f7a2b9a563c9c2bf035c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "At ten to five,",
      "exact_native_cache_key": "890726c366670743cf2d443c4e8ae69c09eec5f6.pkl",
      "cache_input_text_sha256": "b8f98957db5fbcecd3513960148457a32ee42ff5670a0f20b7ae3626803564ad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "all traffic stopped and crawled across,",
      "exact_native_cache_key": "0d4650c6b9cf0d484a91a48d801ea6c9d2b207c6.pkl",
      "cache_input_text_sha256": "597056cc3de5416da231ea98f1b8ac88c1e5faa6996c0a3d2996c6a7a26369a7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "restarting at five,",
      "exact_native_cache_key": "cc105364fdac0a2ec19d5a0abf31765083969557.pkl",
      "cache_input_text_sha256": "881e37c62695d173153f77308af6bcf1c57f9d31b3c882f58e50df85c8fd4c86",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 4,
      "source_slice": "before dawn,",
      "exact_native_cache_key": "322ab8eb3b79872c14c91f565c970d3d3293102e.pkl",
      "cache_input_text_sha256": "149031c170182dfcd4d52281d0535793adc26b18ea3c00ef87fc9fc69d3e1edf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 5,
      "source_slice": "with its direction flipped.",
      "exact_native_cache_key": "57ed1001693c36035c7de738e2a6b7c60316f24c.pkl",
      "cache_input_text_sha256": "c4c069e5af4c6a14804a89f5ed15e9d7c0c13535b5d9e8f03f29ecf7c18c9930",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Stockholm and Malmö had a longer closure,",
      "exact_native_cache_key": "f574138cedc2df84d5b3b43996d8d61d9d2c4d3e.pkl",
      "cache_input_text_sha256": "f718cf087d432d051ec23fb07d04e290faae219b8916679c032d1c51ad616b63",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "from Saturday morning to Sunday afternoon,",
      "exact_native_cache_key": "0f2f42c30154d71fc621e4463d8868d05d5cc6b4.pkl",
      "cache_input_text_sha256": "b6e67577660bbe0f9363431a0d8fb658a5cd03a547ecc65a166b044495930112",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "while crews reconfigured junctions.",
      "exact_native_cache_key": "09e1771acbbf3567346fab1635dc2a9a6ca26573.pkl",
      "cache_input_text_sha256": "9c1ed92df9b1dad84fceee961e2d02a08525c0f9316abe4b220bd9bf80efd42d",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "On the following Monday,",
      "exact_native_cache_key": "f5845be1b50ffb232bc75a5bc3b96ac4525e531a.pkl",
      "cache_input_text_sha256": "07c9f2734520d1565247fa54b15274ad3bf53166dd10c718762ec2c0d75b3d4f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "125 accidents were reported,",
      "exact_native_cache_key": "ea2b8146264ddb0a67532b91b8fa70ebbdb642c5.pkl",
      "cache_input_text_sha256": "71bee07a8a8175b5b1643721f4504653de642d14c58a98165c044b687d6c5cdd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "against 130 to 198 on earlier Mondays,",
      "exact_native_cache_key": "fb5103daaa319a40f1cbf256008a7b3e8e0e40d4.pkl",
      "cache_input_text_sha256": "70eafde15e2c701cb300e3cf36b0e0cb2acdea8b3af933e6af3321babf0d70be",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "a statistical improvement put down to the heightened care of hesitant drivers.",
      "exact_native_cache_key": "6356f0d79d66115d7ff0680a524b3842097d9291.pkl",
      "cache_input_text_sha256": "c54cc8e3fdfc3fc2be5d5e8197c5ad93de94c27da6a1b7272b8a60dcb22d2cbe",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "The nervousness apparently subsided and prudent habits faded,",
      "exact_native_cache_key": "d8966adabab234732e0837511fb8d6c36554cb37.pkl",
      "cache_input_text_sha256": "fdffeb42ce7354e79a5fb5a6319dbac8b89e69a21adfc86cddc2b441fe6ca3b2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "for by 1969 accident and fatality rates had reverted to their baseline.",
      "exact_native_cache_key": "e256765aaead2f25c15f0d880f07e6bf9fb91c5e.pkl",
      "cache_input_text_sha256": "7469d0f25a1b83cf10743b9b7ef8e1cd1c2e7bd39aeed85c4abb2d925cddebf1",
      "cache_input_is_phonemes": false,
