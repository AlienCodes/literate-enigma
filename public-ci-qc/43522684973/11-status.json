    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "Go is said to allow more configurations than the universe has atoms,",
        "exact_native_cache_key": "e4439b8ee6b2194812f91d988de7976fd5567207.pkl",
        "cache_input_text_sha256": "6dcff1430d02b223addfbfae83d3f1931fd4e113c082c03f26894f847a548f6e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "a daunting computational challenge.",
        "exact_native_cache_key": "028265e74b4cc25c104edcc89ac79b6c02454ede.pkl",
        "cache_input_text_sha256": "64d885816d06005413e6a682c682f7c4dfb4a4ac6d8cdb45b351e1a28832f12f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "In October 2015 DeepMind's AlphaGo reached a milestone,",
        "exact_native_cache_key": "01d118b6d228d4bc5ee05457e45219b974df701c.pkl",
        "cache_input_text_sha256": "188d9328ee7c94eeb107a90e20a47272a86260ee9b44aafdad3c2a322b960adf",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "becoming the first program to beat a professional on a full board without a handicap.",
        "exact_native_cache_key": "a4530fdc60bc97f78fe4ab10e8deb86ccb8b95bc.pkl",
        "cache_input_text_sha256": "3e81f8e007e8bc33f12b773c610301cd3f7be876a5da2da604a2d598a368117f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "In March 2016 its opponent in a televised Seoul showdown was Lee Sedol,",
        "exact_native_cache_key": "fa902f1beb184c77a42cad72e924b9e67874dc93.pkl",
        "cache_input_text_sha256": "86e3df647e28c29ebb2ed6b620548c6e618f9a611a77c8e41c86e7479a11842f",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "a South Korean strategist with 18 international titles.",
        "exact_native_cache_key": "84c7610894d029935a6a2da03ea1436a7a6212ed.pkl",
        "cache_input_text_sha256": "99185ecd38dfc54060434aad816a31135b42e9f31913e9caf17a66e20294e099",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "In game two,",
        "exact_native_cache_key": "36a0acbcea8317e6d94f7ee90c4aad6af0cab282.pkl",
        "cache_input_text_sha256": "d45b20c479a0c9cbcd23a1c13e39cdbb0e9229d6f32c315cfdba292f490e0d30",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "on 10 March,",
        "exact_native_cache_key": "66b992048d83d8ec357346a6d815ba7bd307efd0.pkl",
        "cache_input_text_sha256": "49e15c759ea6a526b1445b2634e77d6844d64e360aa03afede1352bec185b2c0",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S4",
        "piece": 3,
        "source_slice": "AlphaGo's 37th move was a shoulder hit,",
        "exact_native_cache_key": "44d746b1cf2d9a386e7e3a73daecaf57241446ec.pkl",
        "cache_input_text_sha256": "8765ab91a796f26218d5985f1845aa50954af48d2bee4b2e814835b34d7d489d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S4",
        "piece": 4,
        "source_slice": "a tactic placing a stone adjacent to an opponent's on the diagonal.",
        "exact_native_cache_key": "b8ceb35e721e279645cfb8bbc1486a286c5700d8.pkl",
        "cache_input_text_sha256": "b69791dbd7fbc8378d2fed00a9c8017275b46fa39881e3e5981800c5f5e5adc7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "On the grid's fifth line,",
        "exact_native_cache_key": "99cc458a628d7b53cd25e623f55212b9c0f93384.pkl",
        "cache_input_text_sha256": "312a3d7779ca6b8ad21e0e1983ab2f9f3bf35dc70537523dd38fc7f6bc35a42a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "it was hardly orthodox.",
        "exact_native_cache_key": "c92d6bed94a05913e59f126f30c3db48eff2facd.pkl",
        "cache_input_text_sha256": "905e6dc9ff1143f5baed629b688c1ce4b4994285347df1e83babb4964704e377",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "Commentators found the unexpected placement bizarre;",
        "exact_native_cache_key": "49547ace3c33b2bac47fc9172b121518498afb0a.pkl",
        "cache_input_text_sha256": "e02e3ee01110fb6a1b5ad555dd6b4bcbe45bc44595cfff3105ac116acdd6a21c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "one took it for a mistake.",
        "exact_native_cache_key": "63ac20f877c413738b1fc138893a1e4fb8e6f80b.pkl",
        "cache_input_text_sha256": "3434bbd86a79a6ae45d3b884f79012ee0fc0ad19537a06c5631caf7bd9cf3195",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "Lee left the room,",
        "exact_native_cache_key": "4de11b517234990bb14eda3de7bfdedb990a8252.pkl",
        "cache_input_text_sha256": "e95f69d5817b53e08115752b75782f2d0e7b49388c95d758104f05fa3303302e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "his pause for deliberation lasting over ten minutes.",
        "exact_native_cache_key": "e0b3d72ba1f53458beceb93b2d58748d8edcc77a.pkl",
        "cache_input_text_sha256": "b0579e5be3b60748e7ad78e05c4825c4ae21f17ea524cc4ef2db06045933f2fd",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "DeepMind's diagnostic tools showed AlphaGo had put the odds of a human playing that stone at one in 10,000,",
        "exact_native_cache_key": "40bbe20d193a5216dc8b775d530dbada518c98f4.pkl",
        "cache_input_text_sha256": "3a434411fa0cd80f019a33f0ee41c1ddd42a766e7a1829127f19752af5f975a3",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "a staggering rarity.",
        "exact_native_cache_key": "66a6b4f4fa5c889628966999784357d67a7529e4.pkl",
        "cache_input_text_sha256": "a9ccadc026a488ab681908af304fb3ee60fa190a5ad95407f0ffc779eb52ed19",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "AlphaGo had first learned to imitate strong amateurs online,",
        "exact_native_cache_key": "cf48ea080089021cfe3f12f6b76b10fec92443dd.pkl",
        "cache_input_text_sha256": "71914efd6eec02438ace456fabe441477dda2fbaa90e5de9ab0d76d4107a05da",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "then sharpened its play over tens of millions of simulated games against itself.",
        "exact_native_cache_key": "6ad88cf1b3b283da3455d7872136336c805639b4.pkl",
        "cache_input_text_sha256": "e2c5a7fadd7ff324a3409d99b499b4d123e9cd067c1d22b36dac0acc132d0373",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "The fourth game,",
        "exact_native_cache_key": "92ce806e89d1e4b5ad27aa2bd653a8e29dc307d9.pkl",
        "cache_input_text_sha256": "ecac589830ff5fe4f67aefe1cb230d1a71bafe7c7a6a18f642290c25a9c93aa5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "on 13 March,",
        "exact_native_cache_key": "cd036ffd028ebe4c7edc3359f4a712421576e0e1.pkl",
        "cache_input_text_sha256": "2b16b6ae687ada0552537e0f077e71a9f385076c129b0c51f1e6a08784711fab",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 3,
        "source_slice": "reversed the roles in neat symmetry.",
        "exact_native_cache_key": "bc7bab6c03cea467d9e99c7c26a7c28db55cdbc9.pkl",
        "cache_input_text_sha256": "c60c02423437ccd803872b09071334d23389466d45eafd975d49cee0a4a8f496",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "Lee's 78th move turned the tide,",
        "exact_native_cache_key": "94adc9f744421b3b12172b9535e7eaaf02a937a1.pkl",
        "cache_input_text_sha256": "4daad6da5a53c0c150526a993e4028c0fd3af82826036d573caaabee1fdc3e20",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "and many professionals heralded it as divine.",
        "exact_native_cache_key": "35de1a7bf4c12604d57dfbdd45dc774f8a08b2e0.pkl",
        "cache_input_text_sha256": "f764897b4ce1e1c06622fc0b18971aeae19d02c313221414ee76924ee997b75f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "DeepMind's team computed a professional's likelihood of finding it:",
        "exact_native_cache_key": "fd69b4f228c380473febd3bcbabde3605335959a.pkl",
        "cache_input_text_sha256": "61cdd2b4061ef2c82685e2d45acec29c8f2e926541e1a7bfc7d81762b2a0cbe9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "about one in 10,000.",
        "exact_native_cache_key": "c8679099b39ac2d1c7542369997cbe26c7e1cdd5.pkl",
        "cache_input_text_sha256": "59d1f8cc4a93a49008c75199aec44bd3dc35422cfa29facb5a1704db22b58755",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "In November 2019 Lee withdrew from the professional circuit,",
        "exact_native_cache_key": "0086cb7c4c6478a0b7f9ad8065e6d3d6a5168138.pkl",
        "cache_input_text_sha256": "3ff1a8a1155a05a0ab720a566248e9e7954109cba2ada104945160e961a003ce",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "a farewell he tied to AI's unrivalled dominance.",
        "exact_native_cache_key": "f18d73f595707210869f6a06943d8bbb21c59309.pkl",
        "cache_input_text_sha256": "9e8e87b32a79b864fc7544cf0971f234807936e5ca9ce9de721b74f40603de63",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S16",
        "piece": 1,
        "source_slice": "Calling AI an invincible entity,",
        "exact_native_cache_key": "42eb00b85ec9bd3a45870814c8d6bf557737d18b.pkl",
        "cache_input_text_sha256": "f6774ec31374ab8cc9468b588e017d2b6fd38f364cd57f7f969dbfc80adc68c5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S16",
        "piece": 2,
        "source_slice": "he said the summit was beyond him.",
        "exact_native_cache_key": "99c9e79127934dbb71d94374a59a00d3f5749327.pkl",
        "cache_input_text_sha256": "14c1bcc6973ddf80e1e7fff438d11e8847c44d59f5882e2d13b3da82b854e172",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "Yet his one win came from a stone whose odds,",
        "exact_native_cache_key": "567cf7ea859853de734b2a3979eb126dcff3445e.pkl",
        "cache_input_text_sha256": "beaf827141cb6d20e900dd7c09ea41f48427c2b544eefce354d69bb81baf655b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "by DeepMind's figures,",
        "exact_native_cache_key": "9f7061e02465ba822222cb46fb59b504c70c4f95.pkl",
        "cache_input_text_sha256": "5eadf03efa90d1060c0d5e7a57f739098ad61dd3c12283ffda5ac445fa7cf4d8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S17",
        "piece": 3,
        "source_slice": "were as slim as those of AlphaGo's audacious shoulder hit.",
        "exact_native_cache_key": "c7cfc468b64af9631bf110ceb5d0e4f9821f2b81.pkl",
        "cache_input_text_sha256": "3bf2013aac35ab452ec95b631e0779987e9a6d7755378c6d1d6b7245016a69c4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      }
