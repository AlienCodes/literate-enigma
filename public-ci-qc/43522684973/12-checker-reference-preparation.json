  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "Pepsi had set up booths in shopping centres across the US,",
      "exact_native_cache_key": "5af9d1b920b0ef41c1f0beac883b3c02de974fd1.pkl",
      "cache_input_text_sha256": "48687340138d0eb7aa3585db5316d5fdcee2481e335a865f2f80ed1627fe13eb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "inviting shoppers to sip two unmarked beverages and state a preference.",
      "exact_native_cache_key": "fb006db18004ef2b86a188abe4afe6c386ec08bc.pkl",
      "cache_input_text_sha256": "50477dd0be92f47c21248e793f0190730e65a0df322e895d0808cc8794a15433",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Figures varied by region,",
      "exact_native_cache_key": "146aa7d5ca37163948afa8b7cd99a17b53a57e8a.pkl",
      "cache_input_text_sha256": "0df339709da20358f1dda1c0407487c22603d217f139e8a1c4c2a05b4554bc9b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "but tasters generally picked Pepsi more often.",
      "exact_native_cache_key": "e73f411db9c292d1715249dd7a6d264e834b358f.pkl",
      "cache_input_text_sha256": "0cb6f9f4cceb1f74e7be70e533537575f72a7ee50d653f8531c30bccb9d2babb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Each stall,",
      "exact_native_cache_key": "68a6f0aeaea3131f96b06c59b774627653fb8852.pkl",
      "cache_input_text_sha256": "b58ef0d0d95e1f01551829c6a25d4cf047ca4a0e71aa7b8ccd8c0012306c8efa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "letting consumers judge by palate alone,",
      "exact_native_cache_key": "e3701c230b09f57a5bd9a874e7e417b104f6ab53.pkl",
      "cache_input_text_sha256": "51fd266bc62e9d8c29ebcb4e5bddf4d960ef7ce79d782ad2f7227b32ca1ff7b3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "doubled as publicity.",
      "exact_native_cache_key": "5fc049dd37630ad18a1ad22b43f8e087088c9e3c.pkl",
      "cache_input_text_sha256": "4b0542d40437621581dd55d12e164e27b3e47a8285ab08c0f35b978bcaae1b67",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "On 23 April 1985 the company announced it would replace its 99-year-old syrup,",
      "exact_native_cache_key": "464375c6944e9ca18c50589560809d2b718f8bfe.pkl",
      "cache_input_text_sha256": "123c48adc8cb5b69ed70acafdb01d95a178b5f2d1113a976d78b9331da4d25c4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "a year short of its centenary.",
      "exact_native_cache_key": "c3304dfa8f7bf08d94650ea9ab1f3a63a69d5d93.pkl",
      "cache_input_text_sha256": "55d1aa4b6b8edd835ca5ec3911d8d8a277dcd519c95faa91f442ac8fd64cdfd5",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Its sweetness had given it a winning flavour,",
      "exact_native_cache_key": "fc34c45cfc99d574d12e0a7e37fc0764b9b2842d.pkl",
      "cache_input_text_sha256": "dcc8958d325de7ad49d0dcd21fc95dccef4bbd0d8287fea1df55e0698c49120a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "but launching the concoction was a wager.",
      "exact_native_cache_key": "b5c5b7eace1b281fc71695da92a06a15bb515626.pkl",
      "cache_input_text_sha256": "45e083ba089f8dd68a4c522bff5c9eb4070380dcc6585f768fbc63167f260793",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Consumer hotline calls rose from about 400 a day to about 1,500,",
      "exact_native_cache_key": "662848c1049449878078fdc7217453482a7597e3.pkl",
      "cache_input_text_sha256": "ba228146908566d6f31698ff89963061e989d602571cb33728132b94c3df24e7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "almost all furious complaints.",
      "exact_native_cache_key": "202d8617c8ffd259f5ecb8cfa63bfd5b9ba749f8.pkl",
      "cache_input_text_sha256": "9edc8784bc3899c42839087f9b2309e3e5e5b329048bad374bcb33bfb8e71afd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Protest groups were organised,",
      "exact_native_cache_key": "ddd57751102518499af4443b886204b91124d5d3.pkl",
      "cache_input_text_sha256": "b22984517c244a113f1d2807f4a7ac5697166fd985a6a3f67f380b8762e24efc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "and some faithful drinkers stocked up on the original.",
      "exact_native_cache_key": "fe06eacfd7b2c2bb52405ee8a38fc2ccc2b9413d.pkl",
      "cache_input_text_sha256": "535e96d78044b575d3dd8a3d159ddc5e8b1d4e28d8e923f78da53fd2f8b46699",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "In June 1985 one protester,",
      "exact_native_cache_key": "1e3e5f89f7751959b714c657d6b81c40dc090cea.pkl",
      "cache_input_text_sha256": "3eaa9a5f9be10b5599eb5c598d530bd3ce314edeb76363985a39f4a65daa6643",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "Gay Mullins,",
      "exact_native_cache_key": "990c627b867eaafffc601aaea922528929de9bf3.pkl",
      "cache_input_text_sha256": "21413d0cd40507327f524b2e8d6b659c04dac5e900d888345f18b0a9e314feeb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "filed a lawsuit to keep New Coke out of packaging like the original's.",
      "exact_native_cache_key": "9eb4825462b9b919a23ab3c0f3360c5a3e32b22c.pkl",
      "cache_input_text_sha256": "0d42ef7660cd4e1fc4ebc218eb8d3f002d78c448664e3dc548c838254b64b921",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Pepsi's chief executive gave his employees a day off,",
      "exact_native_cache_key": "9592683bfc729d18da721c6834133a07fb76140f.pkl",
      "cache_input_text_sha256": "123f1af9c542d3f1251fb630dcf44283a87374e526218066a0031cbf9fee8d3a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "treating the change as Coke's concession.",
      "exact_native_cache_key": "a816aa3784b871808ee15305ff7fee4c33c899ad.pkl",
      "cache_input_text_sha256": "6584b6b095547c19742326d4c7d886e41a23c022718d8810fde1503a58b09285",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "After 79 days,",
      "exact_native_cache_key": "d6da8d6815f823e842d91547f9388b092b73136e.pkl",
      "cache_input_text_sha256": "73de24845bb0715b06f28a149d4c720c0808c95fb7d7fab8e3c689cd86a10709",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "on 11 July 1985,",
      "exact_native_cache_key": "434f340c0dc7d4cc0856c9f41871d90a631ef52f.pkl",
      "cache_input_text_sha256": "d8d0fd301a1e3ea5d4c734551eb51ee92f8eff72b8017e5b641f8446b1a324eb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 3,
      "source_slice": "the original formula was relaunched as Coca-Cola Classic.",
      "exact_native_cache_key": "f46706b7ae8803783c9c1e9c56029b73f755c5cc.pkl",
      "cache_input_text_sha256": "022ee1a97d12a960f2bfd6211d6ace751642918514f26992afd82efc0c5f66cd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "ABC interrupted a soap opera to broadcast the comeback,",
      "exact_native_cache_key": "42d01df009771330ffe1194cb56ab8d038533716.pkl",
      "cache_input_text_sha256": "58c66da02637406527068afb56954338feb715b7a49f516a4d24a187bddd1bff",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "which led two network news bulletins.",
      "exact_native_cache_key": "a2629eae747d551931f50e7e0397554050ede419.pkl",
      "cache_input_text_sha256": "6eb444ad815f1bfc534c573d25a0e90f85b8870da77d0f67ee699b0916b54ba6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 1,
      "source_slice": "They captured a mouthful,",
      "exact_native_cache_key": "4b944927971c1bc51e98ab484f387d5f48920a56.pkl",
      "cache_input_text_sha256": "a7c7be9d0012945d7282986e25cc7af351373a41c7f8d1713dc840ad1dd67735",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 2,
      "source_slice": "not the emotional attachment that nearly a century of familiarity had built.",
      "exact_native_cache_key": "abb4e748bb700d87e34d3cd82404d4cd2f826952.pkl",
      "cache_input_text_sha256": "f3c9d2f59f0abc7fe68a6310d3e4d9adc10af27eb748977a6b049442951b50b3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S20",
      "piece": 1,
      "source_slice": "To many,",
      "exact_native_cache_key": "10a126850d9c42be1f9edfb7dc5e7799500031e4.pkl",
      "cache_input_text_sha256": "9fcc807888576e9f3dadb11e8f9f0dae39224083106f87e6d45f9238766ea4c3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S20",
      "piece": 2,
      "source_slice": "the old taste carried nostalgia and heritage.",
      "exact_native_cache_key": "26c938c1817b966df33554341a82a47cb5bf1229.pkl",
      "cache_input_text_sha256": "6f5ced903a7066eeb03f8f3bbcfefa1eab6d466629f6430778370a6305d4123d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S21",
      "piece": 1,
      "source_slice": "The tests had hidden the brand from every taster,",
      "exact_native_cache_key": "529800098b7949131cead7139c5633c8a296caa1.pkl",
      "cache_input_text_sha256": "a18ae7cae88d39acaa251d3e4e22d5525e53c233260ac8af36212da5f6de7ee5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S21",
      "piece": 2,
      "source_slice": "so they could not quantify what it meant to fiercely loyal drinkers.",
      "exact_native_cache_key": "bf85fd234845be2604532f1e1adef89f3f297218.pkl",
      "cache_input_text_sha256": "6d121d80e879e7cfefe9bfa496d685eb2360f650bf9e8de8be9169035f22de68",
      "cache_input_is_phonemes": false,
