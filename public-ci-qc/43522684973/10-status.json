    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "On Monday 21 August 1911,",
        "exact_native_cache_key": "1779cdbdd68560e1ecd50d812c5c8a8a0df6394c.pkl",
        "cache_input_text_sha256": "1725c070d13c77c6f4be04665d1a9c9f59882d589945429dfd63c50bafe70c2c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "when the Louvre was customarily closed,",
        "exact_native_cache_key": "849001ae0dc6c1436d06f5c608358bcdca630f4b.pkl",
        "cache_input_text_sha256": "4c15bd3714fdabf072086fe71ee8398e8edd4acb74e1d3d6cf78438549e524e1",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "the Mona Lisa was discreetly plucked from its wall.",
        "exact_native_cache_key": "cc0f01c912012e660f13a8899a10e62d9d51c816.pkl",
        "cache_input_text_sha256": "d100b9b894c7f8e6c97cabfaa41bf0e8eb585ddf56f8861e3c23e4eae6cf059c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "The disappearance went unnoticed until the next day,",
        "exact_native_cache_key": "a13458db3a93a9cfcaabc8d7ab4f24337197fcf5.pkl",
        "cache_input_text_sha256": "0f88c89b9c5b7ca8cdee50cd0147fae61adc06c5d86db0da40d206d63462d3e9",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "when a painter arriving to sketch found a conspicuous gap of bare plaster.",
        "exact_native_cache_key": "bf3e7931f5ba0fa12ce4a0c94357ddfd58190b70.pkl",
        "cache_input_text_sha256": "e319adffc16f9ed5ad0a7ac7e9ebfc72305c3217fbdfb187e0b339032753b1c7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "When the museum reopened,",
        "exact_native_cache_key": "a864f879ce839b9f1c38f25899a48405f2ccbe70.pkl",
        "cache_input_text_sha256": "c7de01d49699ec48bb89a9a918ec1a9a639e9267e4e4d0e901ce84e6fb266db1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "curious onlookers queued to stare at the vacant space where the masterpiece had hung.",
        "exact_native_cache_key": "cc27de674af7704e5a1ff6dccc5185ae34903ca3.pkl",
        "cache_input_text_sha256": "10bd80f9a13a317f6ee8a9ab0f6639f4d8aee81df22e0ec12ce665d87512f7b5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "On 7 September 1911 the poet Guillaume Apollinaire was held in custody for about a week,",
        "exact_native_cache_key": "1603e66e1acd0a25622bc4d7f6b3c8cdde978038.pkl",
        "cache_input_text_sha256": "1de99048331540ced40c65419942f5649ba99e5f35ce94ec7987b9f6f4fd70c2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "and Pablo Picasso was interrogated.",
        "exact_native_cache_key": "3df817c7199fed2d5e947160d1d0bcc81410dc90.pkl",
        "cache_input_text_sha256": "25b0df49cc857ade18bd156773f231b1df903cbbdd0362ca556af84c8c78fc9c",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "The intruder was Vincenzo Peruggia,",
        "exact_native_cache_key": "686a8cd543e47c7caaf96860ecb3ceb1b1cbacfa.pkl",
        "cache_input_text_sha256": "00928139d77c3b3bb88487a923701afbba3a88b625058cf0510aedede122501e",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "an Italian who had temporarily worked at the Louvre as a glazier.",
        "exact_native_cache_key": "af486670b6e59954bb2d82594d779a46bb6df660.pkl",
        "cache_input_text_sha256": "b2f3a7a6ef179ab91bd47730d1c66e06c36af0e0f8010588c477f8898cd601b3",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "Having lurked in a storeroom on Sunday,",
        "exact_native_cache_key": "7b462f1f0362aeddd4c694f337ccfa8e1d032bc6.pkl",
        "cache_input_text_sha256": "e31698dff6aab7add4c2402939856680733e37eec5514a887adb10195c759af1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "he strode out unchallenged in a workman's smock,",
        "exact_native_cache_key": "bf1c54a47522a1f8e490a7f529ecb1944b425064.pkl",
        "cache_input_text_sha256": "472af0cad7224600f7bc7753a1e99e840554467a96d58aba2da1fd84f3b1b8e6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "the painting tucked beneath his clothes.",
        "exact_native_cache_key": "9b58241a4196bfd59d21184e1e73d380f057fe86.pkl",
        "cache_input_text_sha256": "0635570550b76e7c07a7a5d8561c667f317b2d9251ee9e9fac54d324ab8fca55",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "In December 1913 Peruggia contacted Alfredo Geri,",
        "exact_native_cache_key": "88d0d5bc0ecb88b40699d254b637000bf0e5fed1.pkl",
        "cache_input_text_sha256": "8eda26f339dc6eadd2bd6f02ae1f19708c306d4f4d8900031a5d87dd1672e746",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "an art dealer in Florence.",
        "exact_native_cache_key": "bd0b413dd5f4249588b60d8a1fc80e6c9a282c72.pkl",
        "cache_input_text_sha256": "f12d9554d18a79e2e710b92a4c89641048f77d5128b49e25520c380aa472d6e5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "The Uffizi's director authenticated the painting at Peruggia's hotel;",
        "exact_native_cache_key": "ae259011f6cfef1557131dd27cfd8f53617be114.pkl",
        "cache_input_text_sha256": "e6365cebba97905b2cbf5a82a3b270efa8e07862eaca28cf1a7b6214a793be8b",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "Peruggia was apprehended on 11 December 1913.",
        "exact_native_cache_key": "f69c983b0710a97bc8a30049c00ad8f6518e8ef9.pkl",
        "cache_input_text_sha256": "c45880dacd0cec53ff66c9517da2d01fb875fe1adf94ba21f7cd220e8af582fc",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "Citing patriotism,",
        "exact_native_cache_key": "b200d61534bab29f70dd51363b358fa34ecba2b1.pkl",
        "cache_input_text_sha256": "e6c1507d4b5439477723483b708cb5f76d44767e8b19d0de57f9f9afab50acf5",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "he said he wanted it repatriated,",
        "exact_native_cache_key": "ec078c34e7de70e6038c22abb094a5b9c9879b3f.pkl",
        "cache_input_text_sha256": "ccc9c74de6ed6d0dcf1cbdd0496bd966ca6da42e5a14c2ab4e1dd861d4ee5a4d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S12",
        "piece": 3,
        "source_slice": "mistakenly believing Napoleon had looted it.",
        "exact_native_cache_key": "2a380a0671a928b9ec825dbfad565dd42e842cd0.pkl",
        "cache_input_text_sha256": "f08910d527afe4cf8d1c9f1a5af853262c445b3dec91e40487545927b5eec300",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S14",
        "piece": 1,
        "source_slice": "After showings in Italy,",
        "exact_native_cache_key": "5a5b92514920921f3621d04f2196adbda844dcd5.pkl",
        "cache_input_text_sha256": "8a825ec9bb4c2d5bdd184b48537301416ecb09bee0d774d9faf6daad3b1b9a8d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S14",
        "piece": 2,
        "source_slice": "the painting was reinstated in the Louvre on 4 January 1914.",
        "exact_native_cache_key": "4c8b9f320dad6d5a3313239c339b57d736101270.pkl",
        "cache_input_text_sha256": "bff00a0101100cd92984d9fe162a1c01c93949f098af23690d80e007ead04db8",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "In June 1914 a tribunal imposed a penalty of a year and 15 days,",
        "exact_native_cache_key": "bdbcbf9d697453018deb0e6128605a35b0d3128e.pkl",
        "cache_input_text_sha256": "7b838f82221bd58229b1478bf4da754d14c4d6500013b99db7fd53ee62d7cef2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "but he was imprisoned for about seven months.",
        "exact_native_cache_key": "743acee94aa206483f5ed3a8bf39ceb6262687cc.pkl",
        "cache_input_text_sha256": "483211660b7a931572ed70bd29f9a446f19b9c14f2f19e7e4326c837d7284b93",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "If so,",
        "exact_native_cache_key": "83b78513bb2829a303b1a634d861d559dc1ec2ed.pkl",
        "cache_input_text_sha256": "ef4022b69b97c1f8723b730578e84e23c4e8facb75e2a58285ee11c22de1144c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "its fame began with a bare wall.",
        "exact_native_cache_key": "34f4953e94c82788c9db28db8c28d6c692b62214.pkl",
        "cache_input_text_sha256": "a9fe8f5e9b30a5468cc07782fd2625f6bfe5ed82795d9169d256d09e3f0e8082",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      }
    ],
