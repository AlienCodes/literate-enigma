      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "often said to be the planet's most frequently spoken word,",
      "exact_native_cache_key": "c07ee292bb9a8fb83669c9205525570b8776351c.pkl",
      "cache_input_text_sha256": "e8f9c7a773abf9a0a866c97335f8a21f9edb93ffcf6ecbc23358de907eabfee1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "began as a newspaper gag.",
      "exact_native_cache_key": "693d42eb476d589751e28ccc62e8340ce7fdc8b1.pkl",
      "cache_input_text_sha256": "0a427f8bdc35f4107556338b53142dc8e5ff198e872cd3654b0d75a904e245c4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "From 1838 abbreviations were all the vogue in Boston's papers,",
      "exact_native_cache_key": "d64f4dfc40b7bc438b326c0e1aa612de7fbe5e9b.pkl",
      "cache_input_text_sha256": "a2adc4084009db3ee6c72534960ebde4a56be1556f51bef7fcf0480deb9b2b3f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "and the craze turned comic through deliberate misspellings:",
      "exact_native_cache_key": "1b714f81dab5f0f3140734756fcd8acb8ac4c035.pkl",
      "cache_input_text_sha256": "8cb414c07aef36da54799fc48ffb02b6c9242f2f0ae26f0b28c4cf13e25a5109",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "O.W. for 'oll wright',",
      "exact_native_cache_key": "4a14402b16e51a818487e72ad703cf3077e1aa64.pkl",
      "cache_input_text_sha256": "e167bdb367446933a4c6f8f7415a6536b88818e193072d848d81bf6959322026",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "K.Y. for 'know yuse'.",
      "exact_native_cache_key": "ea174cdb55d25b406c9d5acd2385613c3d38f0f8.pkl",
      "cache_input_text_sha256": "bcea02c706151c200b881baa7cba6db2892cbc71d6426c90596bb91c59a404ad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "On 23 March 1839 a Boston Morning Post satire took a swipe at a contemporary,",
      "exact_native_cache_key": "e5be9e721a7268d5fceebd6e1985b45e0f09fe2e.pkl",
      "cache_input_text_sha256": "9d64dd7f053eb961c5b82cc91e59708d406ecdb00a120a7af5c3706dfbac34d4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "the Providence Journal,",
      "exact_native_cache_key": "c291e4b412dd2cb0bf90d869e1b5f4d80841782c.pkl",
      "cache_input_text_sha256": "db060681ac509b733bb24d27b6051f33abcf81b64bccdcd11f1a00515d766458",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "over a mock society parodying an ordinance against ringing dinner bells.",
      "exact_native_cache_key": "756524cf1fa59937f66e5ad3ae83cfb05420d5fb.pkl",
      "cache_input_text_sha256": "43785c1fedf18d8dfb78681fa9f7683d62cfa6bcd4481df915a7d6a89da8e254",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "It carried the first known 'o.k.',",
      "exact_native_cache_key": "73d8b6c37f812306d3e14da9e1d49212c2e69879.pkl",
      "cache_input_text_sha256": "4cab80b8a223fde8858914724c97a550abec4f56548417a8c31c2b006c8fe843",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "glossed as 'all correct'.",
      "exact_native_cache_key": "ce0d3c77675c2bd6a96b36ca871d65869840c614.pkl",
      "cache_input_text_sha256": "a6bfad9f7d624f926d572bc181e0b4c0474519408a8626b64083ed3328b79e49",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "The presumed writer was the editor,",
      "exact_native_cache_key": "37a0158c2a2abeb9f746a5be033fb4af5fbefe50.pkl",
