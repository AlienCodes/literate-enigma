      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "a supposedly inept speller,",
      "exact_native_cache_key": "2a309c26c25d03f80dfba1b2db3a9bc97634c2bd.pkl",
