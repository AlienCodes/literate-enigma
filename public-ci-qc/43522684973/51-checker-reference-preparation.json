      "cache_input_text_sha256": "6ffe5c26e60020b1b800568015691599dcd5578debb38e3309604825082ca9dd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "the former president Andrew Jackson,",
      "exact_native_cache_key": "4441eb54efcf8a8a7ef623b9301d2bbc290109a0.pkl",
