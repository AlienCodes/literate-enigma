      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "His New York backers,",
      "exact_native_cache_key": "bced2e88b1f1b76585435ce044b65c1a61a35291.pkl",
