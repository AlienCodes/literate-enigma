        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "punning on his nickname 'Old Kinderhook',",
        "exact_native_cache_key": "c4aa0c7b1f363242a0c68829239eefd48fa20dd5.pkl",
