        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "the incumbent president,",
        "exact_native_cache_key": "1ce8094b931fc6d8b811445ce3e139642facd012.pkl",
