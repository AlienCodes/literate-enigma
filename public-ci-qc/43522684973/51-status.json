        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "That November William Henry Harrison unseated him,",
        "exact_native_cache_key": "fc06041d3d125868be2b0040fbf21f756426e296.pkl",
