        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "In 1840 Martin Van Buren,",
        "exact_native_cache_key": "ff1a0b246c77a1305335f0a20b805a2bf35ead23.pkl",
