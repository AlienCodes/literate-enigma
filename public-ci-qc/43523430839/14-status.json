        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 3,
        "source_slice": "as if intoxicated,",
        "exact_native_cache_key": "607d5677fabb87f2e155f05a66a84784f273b03e.pkl",
        "cache_input_text_sha256": "8d9254f6e0b40b21c293c1730a78a4f0dddf98db5f484d7491f6d2a87a924413",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 4,
        "source_slice": "into leafy undergrowth.",
        "exact_native_cache_key": "c4022e96df3550fc7eace1167716ce4227b499a1.pkl",
        "cache_input_text_sha256": "a34bc6bc19cf2c4eac43f418c914598679a99b1a3935f38921835e8b78b3f60b",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "Around midday it clenches its jaws on a major vein underneath a leaf,",
        "exact_native_cache_key": "3af021302c94df26c4f7c992428699017570ea8f.pkl",
        "cache_input_text_sha256": "afda847bb03070c72cb6b736d9e3e4a4f9123f91b24a17a64ea282ba2a59eeb2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "about 25 centimetres above the ground.",
        "exact_native_cache_key": "f006e476c54f85c3180a9f90ec83b088f2892bc4.pkl",
        "cache_input_text_sha256": "0cb309eac5a4a5fdf3eeb8a89f15f72f93f1f7de694d43c07a10825318f9120b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "By dusk the insect is lifeless,",
        "exact_native_cache_key": "e476a2d6660eac0f8adb11a26920b32ab12723ad.pkl",
        "cache_input_text_sha256": "945c9ec1a1faac8b822f706ad81142d00b1666b6e75ca6312954994b5b4f5e59",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "yet the bite holds rigidly.",
        "exact_native_cache_key": "229d458e900de1bddb403c822828ec928f9dc157.pkl",
        "cache_input_text_sha256": "d2f2fcd5ece492d597541c47e29ad0b5715ef3527c116c3bdd175352441e474c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "A fungus has destroyed its jaw muscles,",
        "exact_native_cache_key": "b92588befd586cdadc12d971bb94faa14fb5872b.pkl",
        "cache_input_text_sha256": "8fe7d5531136df465485e2211568e46e17872d3869cb2fdb151296cda639632e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "so they cannot loosen.",
        "exact_native_cache_key": "774f941cd34ee8146bf5bc043b9505df785dda3a.pkl",
        "cache_input_text_sha256": "a78f0abfaa1d6d329ac17ed209bf75f8b191bf6d29515c459d1bd87ec318e5d9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "Two or three days later a fungal stalk pushes from its head and releases infectious spores on to the ground below,",
        "exact_native_cache_key": "81ae11f7e343677dcffe1fee16888dc7c0d42eeb.pkl",
        "cache_input_text_sha256": "e35bd343ca3edb9fc12df1f70a20700d21c1c6aa2e2adf595dce42791e0b7b1d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "where foraging ants tread.",
        "exact_native_cache_key": "a760dff287d7e266df8fa11e89fb6674353f0df5.pkl",
        "cache_input_text_sha256": "c9f1d3dd145e4d2039ae43bd44a2eb17762321fd4d51bc092869a7f10fc6520d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "The invader,",
        "exact_native_cache_key": "086c6a6c9675cf0184e9d38469b742a682dcea70.pkl",
