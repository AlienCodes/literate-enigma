  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "Wilhelm von Osten,",
      "exact_native_cache_key": "8aa6d2b5ad6574b85da7225d640964c56e3f3318.pkl",
      "cache_input_text_sha256": "1d0f86003fb75c49550437c2a0154b6e3956f2afadcb5ee0cbac85ba048e962c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "a mathematics teacher and trainer in Berlin,",
      "exact_native_cache_key": "af967dbd7aef829df0f87fdf2dda66c75acdc52b.pkl",
      "cache_input_text_sha256": "72c752adfffae05c223f0202e374175d7028c934bbce67fcb30b23840fc69e8a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "owned a stallion,",
      "exact_native_cache_key": "6d20b8a98043b275bf9b677843357668105108f7.pkl",
      "cache_input_text_sha256": "46c66a79719b7480737a406493bbf810687879f8c7ff71b4e5ee8971e37ba22e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 4,
      "source_slice": "Hans.",
      "exact_native_cache_key": "0cbb49a173164c0488a3d9cefb891b5fb6cfd4c7.pkl",
      "cache_input_text_sha256": "67421c92e7827df8bbd8991338c151d3d03967183510cb5946b554e93c46a357",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Asked to calculate a sum,",
      "exact_native_cache_key": "68645910836c95630ca556f66b16004134c48ef0.pkl",
      "cache_input_text_sha256": "9af7b031184c0f2137542be4094fcc65b822f71aefdb8aae27deec5d51c10135",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "attempt subtraction,",
      "exact_native_cache_key": "5105623c9ac511cbdb727b4b6be1745cbc9ff1cc.pkl",
      "cache_input_text_sha256": "0585f230f45d7446312efe8481913db343a342e96818c5b55e2a72a946caea25",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "or name a date,",
      "exact_native_cache_key": "da4f61f12435e80ca9930d4d9dde1eb2785cedd0.pkl",
      "cache_input_text_sha256": "33d7ee0de5713d5160b60b48aba106c5909b87f12c2e3a6f42bb9230b0d3d930",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "Hans tapped out the answer with a hoof.",
      "exact_native_cache_key": "028d2b1ec01ce91b0a818cc0b3a8156dab36604b.pkl",
      "cache_input_text_sha256": "4ae8a8765f99bce4ab1e52507069f7f1c652e32c90df058347e27783e8091fe0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Such aptitude suggested brilliance,",
      "exact_native_cache_key": "acd1680ad94c1f20401c39b056e374a0c38c158e.pkl",
      "cache_input_text_sha256": "d60b7dea5787a4c2d9c3a30c39ba75cd019b340c08f03972ec004e99946d8265",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "and demonstrations in his owner's courtyard made him seem intelligent.",
      "exact_native_cache_key": "a00089f3b02e9be6289884b091f7d136525aa21c.pkl",
      "cache_input_text_sha256": "43d19503c8efad8d7e2793bd7ff726030b1aaacb47a2dea5c18b2cf4cf57603a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "It included a veterinarian,",
      "exact_native_cache_key": "3b265c9a468ef2fc8b79076429160d12817df5f6.pkl",
      "cache_input_text_sha256": "b19ad1852db39591d7cdbc97ef2a99ac9737bc7e92833c05c96bf6d519f731be",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "a circus manager,",
      "exact_native_cache_key": "24225e919e04f74c64468e2536aa69cd096632bf.pkl",
      "cache_input_text_sha256": "86b75d4a6c0f70cd53e22440a9365315721372c8415d06472b666a4cf116622b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "a cavalry officer,",
      "exact_native_cache_key": "60bb9f10f060e2e3be6057a7100317c530ebe895.pkl",
      "cache_input_text_sha256": "510584568a07ab7c95dcbd016075fe5a79c670b3aac06bd9be1ed6fc39ea28b9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 4,
      "source_slice": "schoolteachers,",
      "exact_native_cache_key": "58931904343ac0d69c18290a69ddd370b2389342.pkl",
      "cache_input_text_sha256": "2ba9d7280a03ee9b828d1ffedfb71fdd52f760400e538b211d3f6dbbb9c78d65",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 5,
      "source_slice": "and the director of the Berlin zoological garden.",
      "exact_native_cache_key": "aef057a73f3da8524074c3b6175b4790fa084495.pkl",
      "cache_input_text_sha256": "c6433d8b8363aba22c00688f76af3709acb1ecdad63931e241c8c572b4e1a22d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "In September 1904 they found no deception,",
      "exact_native_cache_key": "f7de8559292e24cb9d6274fbecaef281095d7ae0.pkl",
      "cache_input_text_sha256": "c8e350332aa98573f4ca1daa81003c172cfbacb02b44e7f35e3fbadc34f951d6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "in effect certifying the act authentic.",
      "exact_native_cache_key": "56030bd450138fa996c37c4bdcddd833b854eae8.pkl",
      "cache_input_text_sha256": "7ffc4cc7de361521b5526c9ee33782daaa2da66d84c4a066e30505d02f47e165",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "In 1907 the psychologist Oskar Pfungst tested the act systematically,",
      "exact_native_cache_key": "d5b26a358c30c9af2584cd801937f1e2f9c75974.pkl",
      "cache_input_text_sha256": "ac7e936e5d150611e580e523e7887e7057448a9b37d6e2016778395f6e03eade",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "altering one variable after another.",
      "exact_native_cache_key": "7f360bfcfd5a3d13ca4414d4e1560660efa29115.pkl",
      "cache_input_text_sha256": "cd4bfe8a39265d604f7e231651b9faa488ab311fd3c351e3ee465e58ad35d3df",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "He kept onlookers away,",
      "exact_native_cache_key": "c92def730dfddd2fa80ff41755c566c0b5170fab.pkl",
      "cache_input_text_sha256": "0d6df85c3faa757b019a0775aad06b79d142bff0955c66678fd7f017d2d2ebb6",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "rotated questioners,",
      "exact_native_cache_key": "8dbf3b17655e3b0d192b42eeb53b960424b507b9.pkl",
      "cache_input_text_sha256": "ddace0caecf459a56e575005596940926bb7dff5bd713fd35a5301fb2924abe4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "fitted blinders,",
      "exact_native_cache_key": "620c2d324de572806e04339c73f222da5240b46e.pkl",
      "cache_input_text_sha256": "734176d3c80438113fcc0a1d56f6d8c1d1ed565363f7f95d2977d251536d700b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 4,
      "source_slice": "and sometimes used people ignorant of the answer.",
      "exact_native_cache_key": "122acc2f9bafe2474782a6cea6b48eb604e702fa.pkl",
      "cache_input_text_sha256": "420d92dde2e669a034fd7b29c5e29bd9e72ff95aa4505195589c630421cf78f3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "When Hans could see the questioner,",
      "exact_native_cache_key": "2a63b91c95dc962409739ed9e83d2539aca42c1a.pkl",
      "cache_input_text_sha256": "7cb9387285a045ef605f69ebcab91177315072aae070f372349c86b9a95b8e67",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "he answered correctly 50 times in 56.",
      "exact_native_cache_key": "62ca7a4de69e10d9d55eb90ade71ea984e0a923c.pkl",
      "cache_input_text_sha256": "c8ce06968281f24e5152ca94731fe8c7625f3b11d671163df3941419e5cb5965",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "With the questioner invisible,",
      "exact_native_cache_key": "4a167cf7ba398ab09c68e36dcf2c21b780445bce.pkl",
      "cache_input_text_sha256": "bdb69572c54fbdecdb7f63873c139646e92de60529026896edc272e990a6a5cb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "his accuracy fell to two in 35.",
      "exact_native_cache_key": "8578a9f209f4d64096213058018db080f49cbb8f.pkl",
      "cache_input_text_sha256": "008cfb01917132e1b681a2fc9398083556fac9356f1f7489ee410911f8988611",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Each would lean forward as tapping began,",
      "exact_native_cache_key": "e512e221f617595aedd7267e22962544d1226402.pkl",
      "cache_input_text_sha256": "fedcf4d1fa6754dc08aa717f5df6599d614f496648d3fc209c3da2d1e78ab40c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "and tension rose as the taps neared the answer.",
      "exact_native_cache_key": "a42929bf1ff2a22e02f006b362ed14770a07f2a0.pkl",
      "cache_input_text_sha256": "fd6b170eda5e9b3e1e7578adf3eb76dd5575bfe2b42ac62b18816eeea0594295",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "At the right tap it eased,",
      "exact_native_cache_key": "347e78d9ae0346408e95385d208a26a46905dcd1.pkl",
      "cache_input_text_sha256": "5aa11324b108f85586a5024a7da51ddc7152a99cf887cc44aa076bf93a958060",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "and the questioner would straighten or jerk the head upward.",
      "exact_native_cache_key": "fce549e8a86ea1a8e4dc979b5701ac50667c4ea2.pkl",
      "cache_input_text_sha256": "c982b9b8ad48c015a3a337839c37cdb1d6d8a92e0e2ca1a36a0612ca60e23518",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "Every gesture and motion was subconscious,",
      "exact_native_cache_key": "1ad4325232e76bef306ba442a192983c4a4d4a44.pkl",
      "cache_input_text_sha256": "07ca1209dc0e834d8d2d2e2d0ae841482502d1abfba22ffb278847b871a7d979",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "made unwittingly by people with no wish to deceive.",
      "exact_native_cache_key": "ebe94a967fdad03748b8fa38e45b7326cb36e20a.pkl",
      "cache_input_text_sha256": "4b67f59443cc3cad5ab373c8d622e50a642c0302ee683b4780effa4799317854",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "Double-blind designs in psychology and animal cognition guard against the Clever Hans effect,",
      "exact_native_cache_key": "5f245d6d49a338f35e3dcedd25d24e2c8b0b6523.pkl",
      "cache_input_text_sha256": "18314b44815e7a82d6b6759bb02e95c3ccfb37c3d5775783c8f7e03331fe44fb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "a phenomenon of bias in which expectancy shapes behavioural results.",
      "exact_native_cache_key": "3f70332be1c69edb579014098f8826141aa22c4b.pkl",
      "cache_input_text_sha256": "c09e9c7961447b4c3abfef908497361e1ca639929331c93012b030e0b147c2bf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "In the laboratory,",
      "exact_native_cache_key": "89cfd0bab7b848b27870621b376296e90a1337f0.pkl",
      "cache_input_text_sha256": "3f4657f63739f44247948bde0a7e67bec1eff53a7ac7dddc8a427a30e199d30b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "Pfungst took the animal's place and proved sensitive to the cues of attentive volunteers.",
      "exact_native_cache_key": "339ecca5b2803c2aba0713e64084eccf679a54ec.pkl",
      "cache_input_text_sha256": "195e38369876cac37c72ba0113f6a5909734b1d3aaeb569a695f5e6757a059d1",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 1,
      "source_slice": "Hans went,",
      "exact_native_cache_key": "c1bf4ba0daf12cd5dd4f796b3ce29fd015d0fff3.pkl",
      "cache_input_text_sha256": "f55aa8efd8b05e55312fce5dd48d9da88b0294e141b70514b15dcd3120b4d184",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 2,
      "source_slice": "on his owner's death in June 1909,",
      "exact_native_cache_key": "c14bf12ace95cd6cf880b65a647320d4f82db2a7.pkl",
      "cache_input_text_sha256": "2e1052b0ae08fb2f24b4629be972b181a303baa0c28060937983e367caae549a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 3,
      "source_slice": "to a jeweller still convinced that such animals reasoned.",
      "exact_native_cache_key": "f8b5bc6330a9f17f63a76a399b5cd623044aafa0.pkl",
      "cache_input_text_sha256": "816b280899129cccb5e741aae1e30134cfaddf2c2d6f41aab98acb77c12310db",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
