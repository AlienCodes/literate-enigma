      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Carnarvon sold exclusive rights to The Times,",
      "exact_native_cache_key": "be30365785c0ea23e5b668af7e95ca796678eb08.pkl",
