      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "Carter made a small hole in the sealed doorway and glimpsed the glittering gold of the boy king Tutankhamun.",
