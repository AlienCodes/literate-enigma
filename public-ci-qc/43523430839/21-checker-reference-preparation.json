  "reference_calls": [
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "A deputy director-general of the Ministry of Posts and Telegraphs shared the momentous news,",
      "exact_native_cache_key": "3af5d03aa664e177c89d529d8786b04bd179e266.pkl",
      "cache_input_text_sha256": "3571f71bca41aadaa345ad5191001925cace3fba7445a96496f0a09b2461040a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "confidentially,",
      "exact_native_cache_key": "ff73f6e375922e7ad51abc3fa0c4773fbcecf227.pkl",
      "cache_input_text_sha256": "71c20ca4a18e390f38b3c26c9741ce666aa8bee9e89dfc314c5da87a95615d24",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "that the Eiffel Tower was to be sold for scrap.",
      "exact_native_cache_key": "e881dd46d7160e03379d7489357b1b75d6e675a0.pkl",
      "cache_input_text_sha256": "6f37301ac75c47c532e182fbbf82044ff834839dcfea2266a183b6501e3a576e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "He invited tenders and made each dealer solemnly vow secrecy,",
      "exact_native_cache_key": "57cc37dccc676b54a9a689f207f7aef253f17191.pkl",
      "cache_input_text_sha256": "23c19a35fba38116e402e8a983c1ebe8fbd4a8b9b4b599e27c89767b19e168bc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "ostensibly to spare the public indignation.",
      "exact_native_cache_key": "e0f6cba121a74376e941e44df265b5b701cdbde7.pkl",
      "cache_input_text_sha256": "436afe0f3792840ee8103f3b703cde651cbc589b7f8d91d27e87c61e1ad0a9b4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "Built for the 1889 World's Fair,",
      "exact_native_cache_key": "18622621d24ec072359f71833071312265d77667.pkl",
      "cache_input_text_sha256": "3bc0c17eaf9560c17825e4a7bde27bb84f8d1686a17f991a36553d07876349cc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "the monument had originally been destined to come down after twenty years.",
      "exact_native_cache_key": "038563c7b73143861aa08742f054e64e0609e9ab.pkl",
      "cache_input_text_sha256": "1f7f7d3473772bb0f373000f6310b6a7437b3256ef4bbb0debbcaa101c78907f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "The high-ranking deputy was Victor Lustig,",
      "exact_native_cache_key": "7e73e8643114bb8b3459df92053fd97a964a18ce.pkl",
      "cache_input_text_sha256": "81fdfaa4a1f056c7f3cd87a6a741050dc0eafeb395e88c6e5bf194da8e420c3a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "a crook whose ministerial stationery was a forgery.",
      "exact_native_cache_key": "a517b50510405314f3b6fae6e095af0dfdf6b05e.pkl",
      "cache_input_text_sha256": "94229a8d87a91179ff89515d55fb567637eb1b2e1ddcee8e2da76bce9e85f58b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "André Poisson,",
      "exact_native_cache_key": "8dde4e478d003bbc080814c2ba0f72a332676694.pkl",
      "cache_input_text_sha256": "95485f4eb5f727ee1fce4a18e5f01719786cfd78d9d19042735dc001eeaac883",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "a businessman impatient to gain a foothold in Paris,",
      "exact_native_cache_key": "b207aaa6d1b1e18c92ba6b6f49b320feec966776.pkl",
      "cache_input_text_sha256": "5bd6f3878b0c58f7b067556fc8654dc19b710e419bb001608a4eb6a6ba885ddb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "won.",
      "exact_native_cache_key": "83c9b0044691bd03f6dd2de477916ad485eb8434.pkl",
      "cache_input_text_sha256": "6cb1c45a1a626a4b1c589bd6dfe8bd3fd3d42edd676b763cbf42ad3954d6a99a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Lustig intimated that his modest civil-service remuneration needed supplementing,",
      "exact_native_cache_key": "85355273eebfc1f8e358fda6a8c8c6ec2d61105a.pkl",
      "cache_input_text_sha256": "7a97368037aadccab32fbd5cc6dde061ccde86e4cc9c422c07c606538422627e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "and Poisson paid an additional bribe.",
      "exact_native_cache_key": "50c2ffa2491251250e05891c3f7779d7ac0bbbb9.pkl",
      "cache_input_text_sha256": "3334a8fcada9512510648cbbc787f02d33174d477cddfeb993e53a0c607d916f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Fleeced and too ashamed to go to the police,",
      "exact_native_cache_key": "418f6a0f870eb7edb24e44643b35abf082859453.pkl",
      "cache_input_text_sha256": "6faa6619e245f4eb14698bb43d0f9b5e0ce689cc22581ea8f2bf6f5bd886ce40",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "Poisson swallowed the loss quietly.",
      "exact_native_cache_key": "d847a5fb231186afbf5a5c37fa036eb9b9b31171.pkl",
      "cache_input_text_sha256": "da5a0634ddedd603427beeeebef797f71ec9f2589ec4f5b86864d3f335367e3f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "The affair made the papers,",
      "exact_native_cache_key": "f4c23225267b96a23cbc1395f34b3d109a7291c8.pkl",
      "cache_input_text_sha256": "d191759e64ca27c880e2a77ff0c1ec027af1c7f2e5ea3c2a5a7b6d0c3951e932",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "and Lustig made his getaway.",
      "exact_native_cache_key": "4d77618de9e77be888ea245f1d04e89630bfc647.pkl",
      "cache_input_text_sha256": "841d2ee6475b4dbd361e5c17b74e043ba1eea5d90b12e00717907aad19c3a70e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "Later arrested in the United States for making fake money,",
      "exact_native_cache_key": "2ba3b3fee85e9865ea31cf490c555c4b682463ba.pkl",
      "cache_input_text_sha256": "9ff9ed976a00ae7e1808ff9724a648485788f77e4f729256759143900f0d5015",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "Lustig broke out of detention,",
      "exact_native_cache_key": "65804332581030690a9f8306e4a08cb7c00227a7.pkl",
      "cache_input_text_sha256": "3ca0aea99402e53f48b4e11b2da61c470c79fef15a3bc98b64f31253ba846a52",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "was recaptured 27 days later and served time on the penal island of Alcatraz.",
      "exact_native_cache_key": "0f8e82124805b3a097e598ef5c2ebeb3a73eb79a.pkl",
      "cache_input_text_sha256": "d595b0f63dd68782cfd894de347d6e028e63ed3d3210afaf94a8280b8b74306c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 1,
      "source_slice": "Of Lustig's two marks,",
      "exact_native_cache_key": "595faa47ab5e9b10807b5b2fa310b365e33fa288.pkl",
      "cache_input_text_sha256": "1874f9b2e76553a64e8aba6fb4121b11f0b7fa259a5a2291d23e94290d5ec9fd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S19",
      "piece": 2,
      "source_slice": "the one who paid kept mum and the one who kept his money went to the police.",
      "exact_native_cache_key": "8f965c271269754a1464de1846af1da900f66ad3.pkl",
      "cache_input_text_sha256": "b37a7be6a868ccd065801ec0056536c72ae99dc3268896146550d3dbc65fba8f",
