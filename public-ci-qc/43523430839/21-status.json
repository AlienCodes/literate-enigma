        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "Poisson swallowed the loss quietly.",
        "exact_native_cache_key": "d847a5fb231186afbf5a5c37fa036eb9b9b31171.pkl",
        "cache_input_text_sha256": "da5a0634ddedd603427beeeebef797f71ec9f2589ec4f5b86864d3f335367e3f",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "The affair made the papers,",
        "exact_native_cache_key": "f4c23225267b96a23cbc1395f34b3d109a7291c8.pkl",
        "cache_input_text_sha256": "d191759e64ca27c880e2a77ff0c1ec027af1c7f2e5ea3c2a5a7b6d0c3951e932",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "and Lustig made his getaway.",
        "exact_native_cache_key": "4d77618de9e77be888ea245f1d04e89630bfc647.pkl",
