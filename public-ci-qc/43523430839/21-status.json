        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "He invited tenders and made each dealer solemnly vow secrecy,",
        "exact_native_cache_key": "57cc37dccc676b54a9a689f207f7aef253f17191.pkl",
        "cache_input_text_sha256": "23c19a35fba38116e402e8a983c1ebe8fbd4a8b9b4b599e27c89767b19e168bc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "ostensibly to spare the public indignation.",
        "exact_native_cache_key": "e0f6cba121a74376e941e44df265b5b701cdbde7.pkl",
        "cache_input_text_sha256": "436afe0f3792840ee8103f3b703cde651cbc589b7f8d91d27e87c61e1ad0a9b4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "Built for the 1889 World's Fair,",
        "exact_native_cache_key": "18622621d24ec072359f71833071312265d77667.pkl",
        "cache_input_text_sha256": "3bc0c17eaf9560c17825e4a7bde27bb84f8d1686a17f991a36553d07876349cc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "the monument had originally been destined to come down after twenty years.",
        "exact_native_cache_key": "038563c7b73143861aa08742f054e64e0609e9ab.pkl",
        "cache_input_text_sha256": "1f7f7d3473772bb0f373000f6310b6a7437b3256ef4bbb0debbcaa101c78907f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "The high-ranking deputy was Victor Lustig,",
        "exact_native_cache_key": "7e73e8643114bb8b3459df92053fd97a964a18ce.pkl",
        "cache_input_text_sha256": "81fdfaa4a1f056c7f3cd87a6a741050dc0eafeb395e88c6e5bf194da8e420c3a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "a crook whose ministerial stationery was a forgery.",
        "exact_native_cache_key": "a517b50510405314f3b6fae6e095af0dfdf6b05e.pkl",
        "cache_input_text_sha256": "94229a8d87a91179ff89515d55fb567637eb1b2e1ddcee8e2da76bce9e85f58b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "André Poisson,",
        "exact_native_cache_key": "8dde4e478d003bbc080814c2ba0f72a332676694.pkl",
        "cache_input_text_sha256": "95485f4eb5f727ee1fce4a18e5f01719786cfd78d9d19042735dc001eeaac883",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "a businessman impatient to gain a foothold in Paris,",
        "exact_native_cache_key": "b207aaa6d1b1e18c92ba6b6f49b320feec966776.pkl",
        "cache_input_text_sha256": "5bd6f3878b0c58f7b067556fc8654dc19b710e419bb001608a4eb6a6ba885ddb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 3,
