        "cache_input_text_sha256": "6cb1c45a1a626a4b1c589bd6dfe8bd3fd3d42edd676b763cbf42ad3954d6a99a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "Lustig intimated that his modest civil-service remuneration needed supplementing,",
        "exact_native_cache_key": "85355273eebfc1f8e358fda6a8c8c6ec2d61105a.pkl",
        "cache_input_text_sha256": "7a97368037aadccab32fbd5cc6dde061ccde86e4cc9c422c07c606538422627e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "and Poisson paid an additional bribe.",
