        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "Fleeced and too ashamed to go to the police,",
        "exact_native_cache_key": "418f6a0f870eb7edb24e44643b35abf082859453.pkl",
