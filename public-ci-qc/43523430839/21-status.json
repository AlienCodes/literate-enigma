        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "Later arrested in the United States for making fake money,",
        "exact_native_cache_key": "2ba3b3fee85e9865ea31cf490c555c4b682463ba.pkl",
        "cache_input_text_sha256": "9ff9ed976a00ae7e1808ff9724a648485788f77e4f729256759143900f0d5015",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "Lustig broke out of detention,",
        "exact_native_cache_key": "65804332581030690a9f8306e4a08cb7c00227a7.pkl",
        "cache_input_text_sha256": "3ca0aea99402e53f48b4e11b2da61c470c79fef15a3bc98b64f31253ba846a52",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 3,
        "source_slice": "was recaptured 27 days later and served time on the penal island of Alcatraz.",
        "exact_native_cache_key": "0f8e82124805b3a097e598ef5c2ebeb3a73eb79a.pkl",
