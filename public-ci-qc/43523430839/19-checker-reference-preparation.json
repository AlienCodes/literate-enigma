  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In the winter of 1636–37,",
      "exact_native_cache_key": "3ca3ab3f214b783e2ef2724ef1e8c0b9205b7f68.pkl",
      "cache_input_text_sha256": "4aa8f3f85e49b681b2a5f2a53271b63d284c2ddf14e2d8ac5507d9748bf88340",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "Dutch merchants and brokers met in taverns to trade contracts for tulip bulbs still in the ground,",
      "exact_native_cache_key": "13cc941593e6271549a042ef19377a0f7f4209a3.pkl",
      "cache_input_text_sha256": "d286b36e21b4b0295520f50be4f85e16534a47a10624ad58db6b22760f8ccb86",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "a speculative business they called windhandel,",
      "exact_native_cache_key": "e96655110a53036f9837bbbf7af32dd527fed998.pkl",
      "cache_input_text_sha256": "cb81ab8942341fbb814e31139d65349a5217909e9458ac10e4ac07b7574faf2f",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 4,
      "source_slice": "\"trading in the wind\".",
      "exact_native_cache_key": "a095cc03ff2ef7b4534350ee826e464cddd3959a.pkl",
      "cache_input_text_sha256": "ab8dd32dfa7496a011a7bafb2f9a2e444c48a634871b8051ad7488dd4a0589ad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Prices of prized \"broken\" tulips,",
      "exact_native_cache_key": "b02c21f8868d1297289f194cb6abff5564da9eb0.pkl",
      "cache_input_text_sha256": "f40c8cf1decd26a96312075ee143fec4d1bb89c9fbf3d0a0ff0f04259ed550ee",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "with streaked petals,",
      "exact_native_cache_key": "350f9787287c81cd1aa5bc5761404845ee4f4c8b.pkl",
      "cache_input_text_sha256": "5c54b788438d45cc614d92da250e15c3ef74840a21cfc68fed356867a301b1b5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "soared.",
      "exact_native_cache_key": "ef8b145ff8d66cd5a09d6c9dab9d240e1bf5a87a.pkl",
      "cache_input_text_sha256": "db9fb4a41a835a1ea328730c430150ab67a713cf33e8f28cd303aeb486ec8abb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "In early February 1637,",
      "exact_native_cache_key": "f6f57d7eef6460a75312aebc67c3bd15c209631a.pkl",
      "cache_input_text_sha256": "f5bb9fcefbd2292a70f12688c6832b1f7918a8191baca742041b9de1c4b525e2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "at a sale in Haarlem,",
      "exact_native_cache_key": "1ef1d45e3fa66809b8cd251c6ed997850a76152c.pkl",
      "cache_input_text_sha256": "ae96f413094f962a07a92e1ca916efa92992f2530eefb4dcc2650dfbf355550e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "the hub of the trade,",
      "exact_native_cache_key": "d62719d5458db12f815c2a2b1b5ab002671b87d6.pkl",
