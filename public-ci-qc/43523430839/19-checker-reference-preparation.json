      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "scoured Dutch records and counted only a few hundred traders,",
      "exact_native_cache_key": "99cc81180606ade068c11c7474e3969148451b9f.pkl",
