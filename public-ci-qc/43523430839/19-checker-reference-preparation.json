      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 4,
      "source_slice": "no one would bid.",
      "exact_native_cache_key": "fed2120e9f9e9ee321c4997996268e08dcab55f6.pkl",
      "cache_input_text_sha256": "6de2bb2163a70bb7bbebc258995675f888f1ee760d8bee533cbc5b1cd06a9e2c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Days later,",
      "exact_native_cache_key": "b2e8b5ebd89387b0c8dddf6a7d0908fcf887e860.pkl",
      "cache_input_text_sha256": "7ff8561eec193fbceee8340f34d5e316ff08ea3e0221ef7cb91f122c93a613f3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "at an auction in Alkmaar,",
      "exact_native_cache_key": "fd8ceb2ec32b99b63ed0c0279e60ff1691d6c2db.pkl",
      "cache_input_text_sha256": "36d8d6d7a2c97879c2461e5f3dfd86daf8395aeda5de38313e33962379cbbf14",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "one bulb still fetched 5,200 guilders,",
      "exact_native_cache_key": "8d76ad91ac09c3ecb353004f4c47f241ddcead0b.pkl",
      "cache_input_text_sha256": "4f0cc8668728bd1084ceb975660955bc668be6db44145703006264edc0d0548a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 4,
      "source_slice": "the Dutch currency of the day,",
      "exact_native_cache_key": "910f86088b15a5fb257c2bbbf8cee86424f2e7ba.pkl",
