      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 5,
      "source_slice": "more than a decade's wages for a skilled craftsman.",
      "exact_native_cache_key": "ef46ddbdbe041e2d2e8fb767b920355dbacbcb2c.pkl",
      "cache_input_text_sha256": "911c942cb0d20ee3046b7e3e5cdbb8f84691c95ecb5efe0af64d44c28bca18be",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Prices collapsed,",
      "exact_native_cache_key": "cd6bebdd88f31ebe16cbbf006a0d26c31973329e.pkl",
      "cache_input_text_sha256": "c84cfcb5996794b375b00a9a8186fa4801aada40e45023af2a7e4eab25ba50ef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "many buyers defaulted,",
      "exact_native_cache_key": "01f157f8d0e40510e64d19a8241ce98c2726e4be.pkl",
      "cache_input_text_sha256": "4c99383374c2a8a0c5735f46148975e1fa40b7cfeb7d7ead480bedab1c14a404",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "and unsettled contracts piled up.",
      "exact_native_cache_key": "61104b573c8758fd451be41becd08fd288064df3.pkl",
      "cache_input_text_sha256": "d39cca367b3b814528aadab9ae6bb0b4080103b941edfa9dc6011d1bc350dc08",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Two centuries later,",
      "exact_native_cache_key": "a5a39134eb6c11366d846244eba0d97f8fd617e0.pkl",
      "cache_input_text_sha256": "9125d698c54aca714ee55008656d99216e5beaa3c758224ff88c4bf6e2ef4a56",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "Charles Mackay,",
      "exact_native_cache_key": "7212cc0cb90d9c7b09274d4e50e27e275ee517af.pkl",
      "cache_input_text_sha256": "aa58cdfc9696e5dcbf0fd04d57dae81ca60ae3c22a181ff9a4d9774091b2e634",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "a Scottish journalist,",
      "exact_native_cache_key": "126fc1fde9678e321b05b9f9bbe4255843431ff4.pkl",
      "cache_input_text_sha256": "2f7bd6494cef9969059c152f570e1c64e0c0f80ba9e7a6cd8bfaf33b03c30f74",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 4,
      "source_slice": "recounted the episode in a book on popular delusions,",
      "exact_native_cache_key": "0e495b98a1e32b72a83b21c722f2690a2f990710.pkl",
      "cache_input_text_sha256": "4cd4211fc6289468e28bbffbe085eda34a8c333d7e190b279066193c8ec35ae7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 5,
      "source_slice": "casting it as national hysteria.",
      "exact_native_cache_key": "026723e732ba2a316d3a137148b50ea531b07999.pkl",
      "cache_input_text_sha256": "609069c606d61d96a025e481be65b4a624e9d485c1bec17d1ec2f9e9a643636e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "In his telling,",
      "exact_native_cache_key": "f90a907a428a82376890aa6eff79ce13be7b7826.pkl",
      "cache_input_text_sha256": "387a7248a4db53169273d4bb08587ad836e1718932c8319d98019953c91f47be",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "rich and poor gambled,",
      "exact_native_cache_key": "1a02854890c0aece73f5f93040825bf7f36b857e.pkl",
      "cache_input_text_sha256": "a760182dc555b080fcde5b58eb36d8bdb4e4c2366aefe2869dc9aaa79edd9b8f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "great merchants were reduced almost to begging,",
      "exact_native_cache_key": "7ae597e35005916f0f518f1266b84bf5f9ce15c5.pkl",
      "cache_input_text_sha256": "b43ddd8569c5c3a71956c1734746c392a1006d72f3a0c069081f44305854ab20",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 4,
      "source_slice": "and Dutch commerce reeled.",
      "exact_native_cache_key": "f24944d7f8412a0e93aab48eb8e65bafc99c18a7.pkl",
      "cache_input_text_sha256": "c7f4b2806e613b91ee339b8a6cdc4070421ed69ee8de0a015ac378b65fae81c1",
      "cache_input_is_phonemes": true,
      "cache_preexisted": false
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Anne Goldgar,",
      "exact_native_cache_key": "0bfd289b4ba821da1a1abcf6d8bee589da0eb2b5.pkl",
      "cache_input_text_sha256": "d106ece108b2e1a92601c32f48d2bf94d1e34f986eeb71608a30c065be93d6e7",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "a historian at King's College London,",
      "exact_native_cache_key": "fceacde8fd41ffcfbe5dd6054c74409c98a7165a.pkl",
