      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 4,
      "source_slice": "mostly merchants and craftsmen.",
      "exact_native_cache_key": "14bc2d9208be48c9113d2bd21826c55c80c7bcf6.pkl",
      "cache_input_text_sha256": "d48bc5763c307bcc24bab227cb3437b2fbf029fa46451e6f19c902951c43c29f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Many buyers were later allowed to settle their contracts by paying a small fraction of the price,",
      "exact_native_cache_key": "7769b3d7989425b4d4da72fbf8f18438dfe63d72.pkl",
      "cache_input_text_sha256": "b2d54dab8e7a5cb40c44ea2307e2dd1044fb68c2bb7866fbc2847614ef0a37dd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "and few were ruined.",
      "exact_native_cache_key": "040515180c921e0a752463a278b08cb06af0e959.pkl",
      "cache_input_text_sha256": "f06dd3521b0ecca7e2b3158152352e154055db70fc63db037d42382641ae9d21",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "What spread,",
      "exact_native_cache_key": "2b372531e11d51a27ce39416b8dffc18aed13e88.pkl",
      "cache_input_text_sha256": "264054e04427eb53c455f6252bad825c077e129faf7e2a9149e3762f8e21dc12",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "and still circulates nearly four centuries on,",
      "exact_native_cache_key": "9013ddb5bbb5f05637aebfab9be7e4c008932687.pkl",
