      "cache_input_text_sha256": "1e89ebbb97fdfa34dbe94a44ce1a76c2d666a7dd477c5d658194d0358e761648",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Most deaf people led secluded lives,",
      "exact_native_cache_key": "6efa71b8c0987d5483e95234ba1d53b9146eaf24.pkl",
      "cache_input_text_sha256": "ef2b5e0cc9e3932587df72414ad1cde9712962633b87b04847bd4ce787a26caa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "sharing a homemade repertoire of gestures with parents and siblings.",
      "exact_native_cache_key": "711bff9312593ae9c431311831fd15f01a88d701.pkl",
      "cache_input_text_sha256": "d59369c664b377235b55095f9ad06431f25c4f96f17cdd3cbd13d7652385c7ac",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 1,
      "source_slice": "The curriculum hinged on oral Spanish and lipreading,",
      "exact_native_cache_key": "eef6dee2cb2641f9a1c8f7c99525ffe2c8c8406a.pkl",
      "cache_input_text_sha256": "fb20d4fc13c67020e6d1faf00f596ee488cc5d8c857ebfcad6412eee1f0b5bd1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 2,
      "source_slice": "and teachers signed only the alphabet.",
      "exact_native_cache_key": "ddc75555fb95ed96edc72b319c51d56d602a85d7.pkl",
      "cache_input_text_sha256": "46b88a697ed743f2e8c6459b0bcf86cc7d751ebf64684dd66bca1678ddc7914d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Pupils studied lips in vain,",
      "exact_native_cache_key": "44559bb1357f15459206c4cb1a0f4c341862e946.pkl",
      "cache_input_text_sha256": "0fc8ae04315e3f0c9e7af5d0351f9497181310434aeacaec934bbd281c2602c5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "and most failed to grasp what a Spanish word was.",
      "exact_native_cache_key": "de31ecdbb2ea0f7a4b6498db92bc5abdb927b149.pkl",
      "cache_input_text_sha256": "5c5fa4bd46f8b533b9ad8e7310b0696d5799ac062834b23fe94252b6cc4538b3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "At recess,",
      "exact_native_cache_key": "69c7275591965927b4bde718d53b877f65455eef.pkl",
      "cache_input_text_sha256": "4eae14d1c11ced44ae6a0ee381faf90c184b01f20da6a65fac19ef5995bfcc8a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "in the street,",
      "exact_native_cache_key": "6deadeeae33b7ae20e3cab5b1a84d278eacfeab4.pkl",
      "cache_input_text_sha256": "92612d4192a66fdcc568fcd21e984eb967fa996e0a7c83e66f05d1fdc3314c26",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "and on the buses,",
      "exact_native_cache_key": "4e3579baa34d96792516fda5abbf7aa8cf0bb394.pkl",
      "cache_input_text_sha256": "041fcaa392af1cb2e44b8add26b9447c8d08ad750ce563e62c2a6d7fff300c05",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 4,
      "source_slice": "they mingled gestures with home signs.",
      "exact_native_cache_key": "2bafdf5c607787d95de69ce7d0856a857a4c4b91.pkl",
      "cache_input_text_sha256": "ed3ff7184f7045cc10ec6976b89c97c30543182ed969f85d684725a77be5ae6d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "The teachers found it unintelligible,",
      "exact_native_cache_key": "d45bc70b25aad9ed46f7d70859bb7ca1a193c792.pkl",
      "cache_input_text_sha256": "263dd2959a0870a8bfe4c5e39f216f545a66fa8ec97f2dd12c1fe3c94bcc4bf0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "and in June 1986 the Ministry of Education brought in Judy Kegl,",
      "exact_native_cache_key": "0ec916b06e2c1a91443b2f8d25d8d12ac5847fa4.pkl",
      "cache_input_text_sha256": "429ab7cf707133ecb90fa6920c92494f6ef98254fd93b55c3f9ee8038357458b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "an American Sign Language linguist from MIT.",
      "exact_native_cache_key": "56ea302f0b63c5f726e2cba807a344eb2a2afa66.pkl",
      "cache_input_text_sha256": "1e8ffe0e5654da760a4981b75b1a4923613f5b73cf7d4c1fccf8f1c1eeb5c78f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "A 2001 study found that pupils who arrived younger,",
      "exact_native_cache_key": "bf409a497bfc968eda2384c34a91a12442ab8c43.pkl",
      "cache_input_text_sha256": "804b360d157a74a2f6d8e594f6d33ae085009cb1214d932c7b736a03c1cdde13",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "and later intakes,",
      "exact_native_cache_key": "72861dd8bac681ef5f877b65fea8ee1780fdfa67.pkl",
      "cache_input_text_sha256": "79528a888880cfd8c87c162d5239041f35878d08d78e0a5cfb8ceeb2acd4eb86",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "used grammatical devices more often and more uniformly than their forerunners.",
      "exact_native_cache_key": "a526b2463e55b84a17533eaca316c3d76a24cce5.pkl",
      "cache_input_text_sha256": "9cf113d7fe8207d014896ab31b1f1f6240f46dc3d50df05908d9f8d7b14fc4d4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "In a 2004 study,",
      "exact_native_cache_key": "6c140bd718a14bb8590256c0722ab952133dcf0e.pkl",
      "cache_input_text_sha256": "9bb28e37bb81f296490804c4678676b4d72c3de5a004751052e9ed52e9980119",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "gesturing Spanish speakers and the earliest signers described something rolling downhill by welding how it moved and where it went into one undivided movement.",
      "exact_native_cache_key": "a1576aeb5c89b4969faae743bf3039fccb679c28.pkl",
      "cache_input_text_sha256": "8f790fe54dcf7083434e81593213523502b3c02c29da2dba5369c5fe380b68c9",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "Later signers dismantled it into discrete segments in linear order,",
      "exact_native_cache_key": "88b1c0c9fbcfee18d5a170338d8154c530ba67ac.pkl",
      "cache_input_text_sha256": "89d27fcd927602f302c061345a4327d37ffd73ab1ec565bbb62ea44fe2fb29a3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "a framework found nowhere in the gestures around them.",
      "exact_native_cache_key": "c890f5ef78a290bdcad77d8324c05d276d188121.pkl",
      "cache_input_text_sha256": "9b45a7bd89a1d7734bb132e7fc79a6d4be7f85beb3c3219482e387aa61f7e805",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "Its builders were not teachers or experts but deaf playmates in playgrounds,",
      "exact_native_cache_key": "9d5ec39533b032caebd96588223066546a4ec505.pkl",
      "cache_input_text_sha256": "e7c58cdc5ec11aa8c4d25a91bdbc58425dea761aa208118fbe3ed8158694c2b3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "streets,",
      "exact_native_cache_key": "04594703a75578a89a7404fc90f12902564f4c84.pkl",
      "cache_input_text_sha256": "46362d528736b0c726b00f5c644262357ed9e641e3963cf5c0debce05e417bd6",
      "cache_input_is_phonemes": false,
