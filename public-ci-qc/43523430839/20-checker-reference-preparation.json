      "cache_input_text_sha256": "708e676d25d71f97540bc2f0bbfbddb48c90f1775f02db93f83aaa4e16584399",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "at about 30 metres.",
