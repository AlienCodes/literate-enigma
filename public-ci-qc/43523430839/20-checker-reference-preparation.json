      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "A scanner showed that the puncture had ruptured an artery,",
      "exact_native_cache_key": "104575de956a6f4dfc419e1d162c6489bb69b1a6.pkl",
      "cache_input_text_sha256": "6df43c464d7fbda1f6c2f59ebf0917534ea57d3c1a727503f5f14f72ecb835f1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "a mortal injury causing heavy bleeding,",
      "exact_native_cache_key": "c9235e0aa95e8693cbbc6daf34c23d54e4c8c364.pkl",
      "cache_input_text_sha256": "68a37e5bc6593ad298f46f1236e0727f152412a185897c66d92e20fedc3353af",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "and left a large clot.",
      "exact_native_cache_key": "2c2a626d0df9cf1b53de4eda634d139297dc5540.pkl",
      "cache_input_text_sha256": "fe2c5a8eeaaab24a1719f919ffd47b0733d96709dbb2597d6fe2986992b89e88",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Another person,",
      "exact_native_cache_key": "863182e8aef065d1be4db743588dcad556331ced.pkl",
