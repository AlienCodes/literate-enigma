    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "Born in June 1912,",
        "exact_native_cache_key": "4c4f898a4957bcaf26cd5ed01819aec4abfe5bad.pkl",
        "cache_input_text_sha256": "306167a01f9cfc8081b1e2445db474d61293a5cf7e930e0034857cd4350fe5ea",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "Alan Turing had a formidable intellect by his early twenties.",
        "exact_native_cache_key": "f7fdbf8bf5aee40ebe4ed302cc7919353e5fe126.pkl",
        "cache_input_text_sha256": "a9189189aa62ca727c3c7a762f7cb659af0b0cee98d18e2f587beefb05680091",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "In a paper read in November 1936,",
        "exact_native_cache_key": "98e51ba9dac2fd7c91fec0e0104396a622f02d9c.pkl",
        "cache_input_text_sha256": "2025eb494305d8effc049ec635fe35e4fca903543aa0ae84d8d176e8f16fd771",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "he outlined a \"universal machine\":",
        "exact_native_cache_key": "b0191ea0d2a4a052db97440338f9f655a344a5bf.pkl",
        "cache_input_text_sha256": "b8cc43ef2ea31044a646c406643b16e378c37d514a3d3828924739161d9d4078",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 3,
        "source_slice": "a device able to execute any computation,",
        "exact_native_cache_key": "735ef66fe7c31c513b70d7723b0f977fb19cf6e6.pkl",
        "cache_input_text_sha256": "b2db4e4f54abfb1f9134c8b5b12aa82886d72c32f856769d8591f47aa1e492ca",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 4,
        "source_slice": "given the right instructions.",
        "exact_native_cache_key": "29e2c53d0d17aaf39ceb489959d098097ac5dd4a.pkl",
        "cache_input_text_sha256": "ffe09f096ce08b282ef76828cc5bbb37693e366911f5b7dd687f01855ae5c16f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "That abstract construct,",
        "exact_native_cache_key": "d3d49df2e54284dd1ee33ae516a774a0916af1ac.pkl",
        "cache_input_text_sha256": "6b138502031f7d890965225916da273d5aaf8b7d28fb148072fbcd2d447e7016",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "rooted in mathematical logic,",
        "exact_native_cache_key": "8e670e25194f382dd0fed35c13344ec31cd095db.pkl",
        "cache_input_text_sha256": "f86ff69fb9b705fd3418053827564dc697e61fcb830857ac1124603ebc7ca860",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 3,
        "source_slice": "became the theoretical blueprint of the modern computer.",
        "exact_native_cache_key": "dd5f6ecaa4e694438a4ebd6f4137d27a4e75c358.pkl",
        "cache_input_text_sha256": "e7e6b097fc0a9f0c542261b03cc0d9b23a718b76b362620000e3e0396e60ab04",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "On 4 September 1939 he joined the classified codebreaking effort at Bletchley Park,",
        "exact_native_cache_key": "54e81b9d749e21ba3d51497555ffffc395b30dcd.pkl",
        "cache_input_text_sha256": "38fa625e81142b641b199ad366256963282ceb59841cc78a38ad8eca3f902a4f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "leading work on naval Enigma,",
        "exact_native_cache_key": "82b9d286e28f7efa3797217607d8f1a933a46dad.pkl",
        "cache_input_text_sha256": "a662e350f8e089597d8a9b1faacc07a6ac213d141ee74102cc877d13608bbfdc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 3,
        "source_slice": "Germany's encryption machine.",
        "exact_native_cache_key": "472122b31bb3566dce6a78377ddb6f97928d2d31.pkl",
        "cache_input_text_sha256": "9e90d777f0d093169289dcc7adf2549f8fca555e1aa971277d59ed3f2f39e4a6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "His team's machines exploited them and,",
        "exact_native_cache_key": "c385a8b694d0c8dad5e93fdeaeef7a0551061d72.pkl",
        "cache_input_text_sha256": "ca3aafbc17a75be3e4cdc2d79b89d2fce01efd21c387e0710e3d2bd2a6d8a77f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "operational from March 1940,",
        "exact_native_cache_key": "7e08dfef591266440208ce35cd025e782f053496.pkl",
        "cache_input_text_sha256": "c26fb2cb25d46905a35def20019228a3ba590061cb4ea0b22ab89e88046af1cb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 3,
        "source_slice": "automated the laborious search for each day's rotor settings.",
        "exact_native_cache_key": "35dc172e58570c4993989ff1956b08c280903821.pkl",
        "cache_input_text_sha256": "ac8aa4bcf70d81d58c2d57b6a4de4df1281c71d4eea187e08ea5463fe16148d2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "In October 1950,",
        "exact_native_cache_key": "9f5ba0eb3d7c105ff32a3dca0430c9b654585163.pkl",
        "cache_input_text_sha256": "bb55390a73dccf2bd96176cce336a06bc72564c4c19206b7f5f2e9f7ab0e14fa",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "writing in the philosophy journal Mind,",
        "exact_native_cache_key": "27a36aaac1ce8ccb5663ba0b398d76d56f21065f.pkl",
        "cache_input_text_sha256": "3197811d2a84ad3f103ad8fa8e487d7f0745d8882caef8af3b9d666be10be9cb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 3,
        "source_slice": "he posed a provocative question:",
        "exact_native_cache_key": "aed89ab42311b8dbd22aa0f42cc881613431f33a.pkl",
        "cache_input_text_sha256": "10450daebd88c2551cf655d609af2034ea982e415c84529c234de2f4b9b8faa8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 4,
        "source_slice": "\"Can machines think?\"",
        "exact_native_cache_key": "78098fab68c06e62cf678d24a1f13fadfd16c52a.pkl",
        "cache_input_text_sha256": "b72e94b82be58686468c0db96bedd00c7b1fd6cb11e8bb8a88d047eb3e4310e4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "He proposed a practical substitute,",
        "exact_native_cache_key": "f56ed0f3d17e377d7bca990549be954f13e7138d.pkl",
        "cache_input_text_sha256": "ce0c268055eac7a66802238085456b9f2dd91c10dfac3a721ef22de28bf6f716",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "the imitation game,",
        "exact_native_cache_key": "1b2c9b4d412613fbcab4408bc257295eb0ceb7d0.pkl",
        "cache_input_text_sha256": "d85356d8c7a133fc7bb8b747f152a3b7c463746a96a08da0e31ab34f6b1e38d8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "now widely called the Turing test.",
        "exact_native_cache_key": "6fc86be90216ef92929ec10f35e2ee46a4ac99a8.pkl",
        "cache_input_text_sha256": "7a154541ae30218ca15c84e5a3e3a77f53a22fa6ea4bc2eac7f53b49d27d1bba",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "An interrogator exchanges typed messages with two concealed players,",
        "exact_native_cache_key": "1fd457143948bd1b5db47acc70a70fe3982f15fd.pkl",
        "cache_input_text_sha256": "a5899a4c94ba8c73b7e6d5c8a194d9e7a7aaf9c661434950c1c2f30de862d6aa",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "one human and one machine.",
        "exact_native_cache_key": "e82c6b9c71efd3ef32059ae37787e8d92110f885.pkl",
        "cache_input_text_sha256": "02903690002f6c4b6bb02311ee84f4099fa06a6c53000ec7a5ebfd9336e6e73d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "If the interrogator cannot consistently distinguish them,",
        "exact_native_cache_key": "f874456f1e9764cf2efbd40ba4786b433ec51946.pkl",
        "cache_input_text_sha256": "3a2d105320bb4b561eee9621bd0e69280d4337dc565e15a44cf0c541d650d056",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "the machine passes.",
        "exact_native_cache_key": "8bacd82986acbcafcd2725d822ef333e5f89a3c5.pkl",
        "cache_input_text_sha256": "d6c2f6489dc8301c9aade9ef4061a22dda8a7d97e3a8e518e60c885d10d54262",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "On 31 March 1952 he was convicted of \"gross indecency\",",
        "exact_native_cache_key": "d23d794887c47dc2b3e2b6c6947f08bcf036bbc6.pkl",
        "cache_input_text_sha256": "23fbccf5e6330ae21168b5a32b9f1a0246f9887962ba4406e9cbd8a8a1841c13",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "the charge then used against gay men.",
        "exact_native_cache_key": "18f5a6fdbcd4505b82860d40530661a2a5e99bbd.pkl",
        "cache_input_text_sha256": "11496dab537a6b66c912e894c1ebf80e9017970d2ff94de2280a072fa5d70cf7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "He forfeited his security clearance and,",
        "exact_native_cache_key": "c024364eb847e91b0f22117e1de452b1ea038181.pkl",
        "cache_input_text_sha256": "99d989f5311287fe2c729e8efaa5a615023d12fdeb9e4a68a40172694b80fe14",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "to avert imprisonment,",
        "exact_native_cache_key": "09adedcf09a6206b353d27d720a60b9476246337.pkl",
        "cache_input_text_sha256": "eaa1c591cdfd837b241a24a622d07468696a0c31865b0851bd04f2a7e8aad3dc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 3,
        "source_slice": "submitted to hormone injections.",
        "exact_native_cache_key": "7539c5a31b3fa4a4d5167c6fa74cfe680b55f514.pkl",
        "cache_input_text_sha256": "f2ff19c148dd2cf2cae87a667ff1a1d477c3fa1166555d21eb0f68e532100494",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "A coroner's inquest ruled it suicide,",
        "exact_native_cache_key": "5af38cae7320c244347e1580d8be1fcdf7d28e61.pkl",
        "cache_input_text_sha256": "8a7631663ae64ca21f4f1b038d14417d2d44af6054189ddb4d7fb4bed5d10f1f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "though some doubt it.",
        "exact_native_cache_key": "8c0b81a127e1715b8dc06084dd85474274614347.pkl",
        "cache_input_text_sha256": "942a2e0357f491755c582cc5943862fd1acd8ebd88a3e87de6877723a420aca9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "On 10 September 2009 Britain's prime minister publicly apologised,",
        "exact_native_cache_key": "3d6a17410d35538fe95963d481558f07da9aa787.pkl",
        "cache_input_text_sha256": "e663c7cf6ddd4872188cd660b64001e2c3255f3066f444976f14e8f36c0acc52",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "and on 24 December 2013 Turing was posthumously granted a royal pardon.",
        "exact_native_cache_key": "591d41e76c27065ba476304c0a00940b71387aa5.pkl",
        "cache_input_text_sha256": "b14d03b1a9e8b427fed2a49dfb0feef353be6fbec27914ae2facebadf12f98ee",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S18",
        "piece": 1,
        "source_slice": "On 23 June 2021,",
        "exact_native_cache_key": "2abdb765945b94eb80fc6dff3f3101846b1f82dd.pkl",
        "cache_input_text_sha256": "1b7b8bb857f34d01eb5d4dcc2a802e8a9fc7bcdd319d2528282d8da7e94c5664",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S18",
        "piece": 2,
        "source_slice": "his birthday,",
        "exact_native_cache_key": "6dad079769f180b68ea7a9e171954862cdb705f8.pkl",
        "cache_input_text_sha256": "5abfda855983635210f568beb00910b4a6c7271e83c3d01b4da653f798878e24",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S18",
        "piece": 3,
        "source_slice": "a fifty-pound note bearing his portrait entered circulation.",
        "exact_native_cache_key": "e064d95a23aecb3f9f0ded7acc13bb66bc58ae48.pkl",
        "cache_input_text_sha256": "28349774881905b7f72ccc0e3da1e92138be69932c0653bcb0b1494375f6f6dc",
