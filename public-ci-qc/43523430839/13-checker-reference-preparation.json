  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "On 28 December 1963 Randy Gardner,",
      "exact_native_cache_key": "320fb14d90b460b0d4a667f36725f5172009ca67.pkl",
      "cache_input_text_sha256": "870f47cda858bb2d130f07e0ef311f6ea740d6ea26722a77ea08c00dd5d71336",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "a 17-year-old science enthusiast at a San Diego high school,",
      "exact_native_cache_key": "30dbac5efa84ee7cff6c90cdb6b41c63912a9eab.pkl",
      "cache_input_text_sha256": "c992b5f8ffdb248824650aa02d21460bfdc9eda52eba8d01786c847b9e48a0f1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "set out to forgo slumber for a regional science fair.",
      "exact_native_cache_key": "fb120784b1c1a877f596bd741964009fef63da8d.pkl",
      "cache_input_text_sha256": "0c4522f7598a14f7546b69c73e5c7d22b87962dfc2dc88d7e14913e4f8e8a794",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "The project,",
      "exact_native_cache_key": "9a4a90558eb71898d9247d30384cef26f69ab59c.pkl",
      "cache_input_text_sha256": "faadafee75226a2584b625740485aaa949455ebac097542534ea3d3e53e1e576",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "a voluntary endeavour,",
      "exact_native_cache_key": "5a853f4b3d8ea630cc914aad6ef99838886acb2e.pkl",
      "cache_input_text_sha256": "ede29b218aa31d1b5def24bd603f07ebce97a821ba66a46fcb4ad3db2d8046c8",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "went on to take first place.",
      "exact_native_cache_key": "eb3d884f940b25fe352d8aab7c7bee0f492a431d.pkl",
      "cache_input_text_sha256": "634a7d1168c04495ebb87993f6f0c9115991f0104ad50469652fa957b27e9c7d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "William Dement,",
      "exact_native_cache_key": "d18bd0daf7ba03eb425a4398c7123a8f34b10cc4.pkl",
      "cache_input_text_sha256": "1ad25b98b06fef4ec0650e7a253b6958ed498ee25bf3386d9ccb94e6cdc77afc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "a sleep researcher at Stanford,",
      "exact_native_cache_key": "f0e27ada36e08aa44605f3af538e82968af96996.pkl",
      "cache_input_text_sha256": "2bb366d2b266533b850adb1681856e034980154c07c4dce89521df88e355e095",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "read press coverage of the attempt and was intrigued.",
      "exact_native_cache_key": "fae4fcefdcbe4cc3c6e34689544482e165694fa4.pkl",
      "cache_input_text_sha256": "f4516263da4a4ba457f79f50637fa8d7ec97e46f094699cf0be08b40df3644f7",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "He drove to San Diego and assisted John J. Ross,",
      "exact_native_cache_key": "899321fae27db6775d2e907d4a4bb1b60ca1497a.pkl",
      "cache_input_text_sha256": "22b08388f795445ec0dcc4e684b4deb57a62b77206349566ed9c6a5da762c14b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "a Navy researcher,",
      "exact_native_cache_key": "378754a30674e0adadca2a3646b1abdf0a8241f2.pkl",
      "cache_input_text_sha256": "288971732a627a2740f31da5f768e7d5dc78f220525bd9d6b0a2b425ab0ac4c1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "in monitoring the sleepless boy closely.",
      "exact_native_cache_key": "d4d3356a487df448b3db529143bf08df022ff0c0.pkl",
      "cache_input_text_sha256": "c65f9b107e370082c856cc0c9db0ad143540658b796073421e96b359b7ec7ade",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Gardner grew moody,",
      "exact_native_cache_key": "371141f45a1bdc9f7f5d5676495f624a0116aab0.pkl",
      "cache_input_text_sha256": "e72b3d2b783d5adb34ed914d5725680eb0d70d07fa1ccc1993cd0583748ea483",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "lost concentration,",
      "exact_native_cache_key": "b6f22a8d8774b6dda40d3fc7b64e1cd7e8e420eb.pkl",
      "cache_input_text_sha256": "7f729ef38c75fb4b906297e179972b61d30c568148462dd82b46ff3ed0b2ddc7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "and found his short-term memory impaired.",
      "exact_native_cache_key": "be68c309b5b97b1cc7225d3eff93e88b245bfc5d.pkl",
      "cache_input_text_sha256": "0ad3e3e92e43342bb2fa17e6325dc5c459b2d10015108c3b1f7e00972bf9cbb8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "He became suspicious,",
      "exact_native_cache_key": "4cdf192a54d16b85bcb7d80682b03bae1d32e0dc.pkl",
      "cache_input_text_sha256": "a97d57651d8d303c392e772db4968239a4f1574183782affc9c590a77d4a6acf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "at times paranoid,",
      "exact_native_cache_key": "0f73c113088e648c54fee23de565510e54a22bae.pkl",
      "cache_input_text_sha256": "76882864cb868575dda841f08fac402bf48c37885904f27fee107724519a933b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "and began to hallucinate.",
      "exact_native_cache_key": "297955d5a008e4825b1c8c63862ab3e85d9b7a35.pkl",
      "cache_input_text_sha256": "b21b4ca95614a9cc242e402aec143ea8552b6e6f7690249fb981b0ce07d24528",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Gardner ended the wearying attempt on 8 January 1964,",
      "exact_native_cache_key": "79e80fddb1611b1e968363c64a796a8289e1fe3c.pkl",
      "cache_input_text_sha256": "6fe98eb33b1784aa8a5da771fc6cb1bea096208f81e65eeeac2a09a1fdd28569",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "after 264.4 hours,",
      "exact_native_cache_key": "6f3853d6f320127aead7174a6310989f38a9a30d.pkl",
      "cache_input_text_sha256": "a6dcfb6d4577c701874da3df3402ebc6d9b1b2fc528020edc152d19dcfcf2b58",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 3,
      "source_slice": "about 11 days and 25 minutes.",
      "exact_native_cache_key": "8fb0d1968a02b9db1543a9403f02b0dbea4188fb.pkl",
      "cache_input_text_sha256": "c55ca037117f3473c930ab45c7c245863676e1ac3be3211ad5f8afa422797183",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Researchers probed the case in a 1965 scholarly paper,",
      "exact_native_cache_key": "a7fba3e220516227ec57cae4741cae700af3c3ad.pkl",
      "cache_input_text_sha256": "78af833c50fd52106a0ad7fc18338add7a4d403b683c6ff7ad4577aedbf1076b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "which helped highlight microsleeps,",
      "exact_native_cache_key": "908cdfc87bebfff8c566a68c1396a48756ffa50d.pkl",
      "cache_input_text_sha256": "bae69e8aeb1a59f770332291f7d5ecb6c858b017b9a75fa77806e5a0b9fbc484",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "involuntary lapses into sleep lasting a few seconds.",
      "exact_native_cache_key": "923f69d88d13cd380b574fd7c37a8e72678a7e02.pkl",
      "cache_input_text_sha256": "12618a8d94b80b303a8c2e4fa2fb40fff0247c0360cc3276f5f3a02d8dd60602",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 1,
      "source_slice": "In 1997 Guinness World Records discontinued monitoring such attempts because of the health perils,",
      "exact_native_cache_key": "7580c420c158d95c68582cc5c4569e2cc177af20.pkl",
      "cache_input_text_sha256": "354fbc15bf0194b062703ea44bd50a2a4400193a66ebe6cb5b43eda8d5de401c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S15",
      "piece": 2,
      "source_slice": "and others have since alleged longer stints awake.",
      "exact_native_cache_key": "eb82fa92345b80a0177fe742978e4c87a08cfb71.pkl",
      "cache_input_text_sha256": "07a5cb52c00b619040ec24b9f33cd0993601ee5f18dc3f210cef302d794232e5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "In a 2017 interview Gardner said severe insomnia had tormented him for about a decade,",
      "exact_native_cache_key": "19fe9b1f1e6633ce7dd203dd0fe1e8ff4e239c37.pkl",
      "cache_input_text_sha256": "72a7d087f94e476fdb92123efa21f00e58f1e7e2ec3796ac4a893d5c7f0a35d0",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "and he himself pinned the blame on the experiment.",
      "exact_native_cache_key": "4e41a4f27e1219ceaf667c8db1ee0bd1fc639b15.pkl",
      "cache_input_text_sha256": "764bb820e8af164fd2b14a08d2d95509b09b044cf42ce83a49341790eb1a79c5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "The boy who had seemed to bounce back from exhaustion with one long rest would,",
      "exact_native_cache_key": "8565e00395af2a42fe5e6aac96c76732e827ea0f.pkl",
      "cache_input_text_sha256": "a59ca524cc7f07ad27b2e9224a74ab073ec0e0dff306567abb98c95c26de4f53",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "decades later,",
      "exact_native_cache_key": "84bd9907ca3e425dc326b17bf9120932453326bf.pkl",
      "cache_input_text_sha256": "a908afa8a8f41768ec3a258089aec65dba58182c081e8b2063cc262f5fba8b6b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "barely doze off.",
      "exact_native_cache_key": "dc6857f8738fd1b918d6eb14ce50e9dd67f69f96.pkl",
      "cache_input_text_sha256": "7fdf344bea62589fc8a10d086c6abed4920832d3c82134c4d55e8ce793cada46",
      "cache_input_is_phonemes": false,
