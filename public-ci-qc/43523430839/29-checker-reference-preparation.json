  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In June 1816 a ceaseless downpour kept a party besieged at the Villa Diodati,",
      "exact_native_cache_key": "8ed39ab49331da8cd84b07f450e07b7e6cae8148.pkl",
      "cache_input_text_sha256": "e2f1a6be7a1c50386b47790cd7e2aa195c73194e43360a9f9630fbd0e09a3f27",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "a mansion the poet Lord Byron had leased on the outskirts of Geneva.",
      "exact_native_cache_key": "8b2f75ec3cc3761f3d9b6d0dba6c8165fcfd7be1.pkl",
      "cache_input_text_sha256": "d5075fb52ccc1d6edb7c433a5689433d76dfb5f7482270caca03259016eda5da",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "After reading an anthology of German ghost stories in French translation,",
      "exact_native_cache_key": "5cdb26989fafc59a4b227cac6defcc9965a0968c.pkl",
      "cache_input_text_sha256": "e403a6d1dbcbd80b503396da16aba7331fde97973f362e7c911e85ba1315f741",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "Byron proposed that each guest write a supernatural tale.",
      "exact_native_cache_key": "f040e4244b69599e730c5bb2f2e93ed6470a1ea2.pkl",
      "cache_input_text_sha256": "c9d1055d6a1086c3f96162768aa9feff01ee39583b5fa59aa8920a9fa3b5991a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "On 10 April 1815 Mount Tambora,",
      "exact_native_cache_key": "499fe75aa96edd61d604758166afaf0fb198303a.pkl",
      "cache_input_text_sha256": "d7ac1170078d2aeb12596af20dfa1d9c376674e1dfe30280f40698e7f766a228",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "on the Indonesian island of Sumbawa,",
      "exact_native_cache_key": "6dd888919f842e07a88b3444b8b90ea216fbc7cc.pkl",
      "cache_input_text_sha256": "9b7fc47ce906e23c3451ae7dc4d1280a197128255b29db23b1b40533642d1762",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "blew itself apart in one of the most potent eruptions in recorded history.",
      "exact_native_cache_key": "72a5dd1cb533a1b26881c19aa5035773f3f43a51.pkl",
      "cache_input_text_sha256": "9c721427d47114bd714741624a9a04e342c7f5ba9aebb537ff5060a75018222d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "About 10,000 people died immediately,",
      "exact_native_cache_key": "54ca509c4de536ac8c25e5f8a823dc5eb36d4006.pkl",
      "cache_input_text_sha256": "920552a489b25a49c6f341da857da83ca428fea3ac806d5362cbf027c7198df1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "and tens of thousands more of starvation and disease in the aftermath.",
      "exact_native_cache_key": "2eaabd150558740b0bbe71cf2d671d76c4b385b3.pkl",
      "cache_input_text_sha256": "4d4c6ad7a5db7cfb0ebd08ff441b29d3a5614ff322acd3bc255dd28fdfc9a2ad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "The volcano pumped prodigious quantities of sulphur dioxide from its crater into the stratosphere,",
      "exact_native_cache_key": "a0d7ede2e1dc8008c7faf3feb55ce060390328f8.pkl",
      "cache_input_text_sha256": "6065168c6b14bfdcba1497452f5f5206ced919a9ac680331dfc765ba6a4b65f3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "where it formed sulphate aerosols that blanketed the globe,",
      "exact_native_cache_key": "1c105046fb8456b7981eb9ac7fed2f9821e5cac1.pkl",
      "cache_input_text_sha256": "6bb103ea04afe24884997bdec2008fbebabc6b6e1b839c5ff5f7414c732bc2bf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "reflecting sunshine and thereby lowering temperatures world-wide.",
      "exact_native_cache_key": "c212584d35ed2e247884d0c70b05ec498d9e3a86.pkl",
      "cache_input_text_sha256": "73cd17b8970cf2e1d65f13b67918660b82adc66790f8d83872240f4db663236e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Crops failed or lay rotten in saturated fields,",
      "exact_native_cache_key": "3a3465a710da140030949f3ba7ddff47ddfbe6dc.pkl",
      "cache_input_text_sha256": "af6300c0b73ff78d60b83eaa8ae825d4392e127f2e57fea68f3c9aba32f73cf5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "cereal and bread prices escalated,",
      "exact_native_cache_key": "c766f25d6c7c33a7cc64e6afeac5d14035c0700f.pkl",
      "cache_input_text_sha256": "9457a6adef69a23f99e8f182b480e4b0d4a6dbf61b7c3f05af576136a48d41a5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 3,
      "source_slice": "and scarcity,",
      "exact_native_cache_key": "b25ab099a733814954f6250f5e43452da8e20737.pkl",
      "cache_input_text_sha256": "105be1eabe0477475c05acf667783c9d54d743c503d162490408df91f673187b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 4,
      "source_slice": "disease,",
      "exact_native_cache_key": "97d871aa4b6e601e17d003dc8e5db8e080a62b56.pkl",
      "cache_input_text_sha256": "3851768986a04f339627ab23791855f102fdeabdcfca03f62a30da9fcf041821",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 5,
      "source_slice": "and unrest followed.",
      "exact_native_cache_key": "e335560376e1f25aa928d1c9617a036ebcf48351.pkl",
      "cache_input_text_sha256": "85233f7457354a52cd23bbc614d0b7b450b734be19b372db55322f4325d16fac",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "The eighteen-year-old Mary Godwin,",
      "exact_native_cache_key": "c60ba06ca253b8cc5d6a41ea225810d4c8cb68a6.pkl",
      "cache_input_text_sha256": "6f04f38ec23f58d46608513fd8e225dc41417e30a06b211dd55d7c7577a599cf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "later Mary Shelley,",
      "exact_native_cache_key": "8ccd4bead2760f1bd40a92778164769b93849c03.pkl",
      "cache_input_text_sha256": "5be14ae80954a8b9f730295b7e41b6392fa84b3fd8da2139af8f54d850adea33",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "had set out in May alongside Percy Bysshe Shelley and Claire Clairmont.",
      "exact_native_cache_key": "458fefe98854039011561dd13d244d41b7de6dad.pkl",
      "cache_input_text_sha256": "033a7a91913c917c44d34a63ea18844807a971b31f9ef1cdd2948cc662d2f056",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "In her 1831 preface she would recollect a damp,",
      "exact_native_cache_key": "3a620fd37f6b441db3764c59608e1358d998f963.pkl",
      "cache_input_text_sha256": "86642c4b986c3cbec61706ff77eb1347d6bcf39d11deb294ae80f7284bdc3f06",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "gloomy summer whose torrents often kept the group indoors for days.",
      "exact_native_cache_key": "483e1f168483e8fd7c8017230c7b674208d9a277.pkl",
      "cache_input_text_sha256": "d4e27e9314fe39130dd9ed4834c410594d8df007a35ac1e5be8e2e82021e87ad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "His physician John Polidori produced The Vampyre,",
      "exact_native_cache_key": "a796b482b8cfc0bdab0f2e740d0887cc1f6464b2.pkl",
      "cache_input_text_sha256": "2201de7d4d01cd4fac9d449278412b07cf65decfdda3a8fd6a82063c3cb01478",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "whilst Byron's poetic output included Darkness.",
      "exact_native_cache_key": "a552e05d9ca925fdc170468ff56c19289409ba10.pkl",
      "cache_input_text_sha256": "b2206910ec2465be828ff2482705c961f97c9fe30cfea81fd92a94ae8ad5a98c",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "Mary began the ghastly yarn that became Frankenstein,",
      "exact_native_cache_key": "0ddc7cdc496445470775246fc7adc27e86af2fd9.pkl",
      "cache_input_text_sha256": "a623c04e3d51b21998d95b33d42efa830970b01742773264065edb4311b5a209",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "which appeared anonymously in 1818 and was later reissued under her name.",
      "exact_native_cache_key": "86adea1a756e21c1780af3f3e81a978e9b14eee5.pkl",
      "cache_input_text_sha256": "46cb073750510fe1b224a35de8fcb0804237558c6aa6a2f7548ab1781b9a26bf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "A tropical volcano had supplied the rain,",
      "exact_native_cache_key": "1e9d203135aa6fffebb107e536ac65e833e7794d.pkl",
      "cache_input_text_sha256": "291afeaa3874e375ff110a82c1fbb091ab6fb55c979ee5667d4ff33faa15faaf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "and a teenager the monster.",
      "exact_native_cache_key": "c4b5e963c1a7d5e7dfb647a839d197cf465c7438.pkl",
      "cache_input_text_sha256": "91adbd5022c36b4d4b8738dd9c8b9f20ce3069155544397d483b1483d77883bc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    }
  ],
