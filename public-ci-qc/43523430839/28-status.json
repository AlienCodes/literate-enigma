        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "In January 1969 Tu Youyou was entrusted with leading her institute's research group,",
        "exact_native_cache_key": "1e3cc9337e8624f0039e335238df62312d9976e4.pkl",
        "cache_input_text_sha256": "ac38dcf512c06d886364f1b382c6121fd2750a9b80356bdeff05def73597f6ba",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "despite having no doctorate or foreign training.",
        "exact_native_cache_key": "7aa9e308526e5e9b8fd37647eb7a982d9dbb05ef.pkl",
        "cache_input_text_sha256": "2b93229fa73f8cee680991d873600cf79a7b3280cc885bbcb5a27835d7989c0a",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "In an exhaustive search,",
        "exact_native_cache_key": "c0e617430099c8f9137f20a53667c83846dfffdd.pkl",
        "cache_input_text_sha256": "85936dc59a80b9832c1d843fdcd8dfcfb2c6391a66ae7c0b3caf3bf9535a4d86",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "her team combed over 2,000 folk recipes,",
        "exact_native_cache_key": "494fc7dcff9b6d780ad73998cb899aa4b522c638.pkl",
        "cache_input_text_sha256": "e7922827d6ef210cb826910a76322591197e4596368777204200fb295e9ec15f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 3,
        "source_slice": "compiled 640 prescriptions,",
        "exact_native_cache_key": "7f87b6b67d8c825c196a4dd19d032a6444fddc90.pkl",
        "cache_input_text_sha256": "4339bf60aefc0c73e10d528dfecb9859adfb6142670848fb8ef41d200920a05e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 4,
        "source_slice": "and evaluated about 380 extracts from some 200 medicinal herbs.",
        "exact_native_cache_key": "8378d63161ce5e5fad5aba181e6712aba179dc81.pkl",
        "cache_input_text_sha256": "a281efb851eab7e880cf8ce179ef3dc79a18f40cf8d22583065a2c6d8f78b4e0",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "Qinghao,",
        "exact_native_cache_key": "f8cf3496640274757a14eed4f3227a0608c5551d.pkl",
        "cache_input_text_sha256": "f8b52971f43ae3415e5cfda1f36ef2cb9eb25be30768723f58e7b542cb304ffe",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "or sweet wormwood,",
        "exact_native_cache_key": "802203581cfbc225f56075f446cbfe482dfebf3e.pkl",
        "cache_input_text_sha256": "0f282580f97dac2a5e50812702702d726f2e952a2dc325d0e8f507704ee9ceea",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 3,
        "source_slice": "showed flashes of promise,",
        "exact_native_cache_key": "c3e26cb7d2073e18dbfff7a48a964b479f9b3f11.pkl",
        "cache_input_text_sha256": "c8f79dd4b7ab8582e0942586cad6d65e85de5abe9c5dc398e41f6a53f547b4df",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 4,
        "source_slice": "yet its results were erratic.",
        "exact_native_cache_key": "cf6a4bf6f038b3e58a9c05240d94523eabbf52ce.pkl",
        "cache_input_text_sha256": "03eff8a32395f8a2a9425ae179aecea96fa3220fae4417a9a20ee48ae47d83cc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "Seeking a clue,",
        "exact_native_cache_key": "82b4275b672dbf236ed0b57c8398585d9f188d8a.pkl",
        "cache_input_text_sha256": "6cb3d01ae2c7d1a54b7cea81e8315f1cf7b073d3d941d0d5a65140444a4b7654",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "Tu revisited the classical texts.",
        "exact_native_cache_key": "c0ba3dd39bb6164ae5cdb40945048e78dd7a0ecc.pkl",
        "cache_input_text_sha256": "88fa730fafd47fc1f06bf3c64c8953de5411a49b0352909143aef10b6fb7b4bb",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "Around AD 340,",
        "exact_native_cache_key": "7ab1b024b4e3349f163c9cafdf3c12b0f2638388.pkl",
        "cache_input_text_sha256": "bd622a73f7276d6d77837c4134ef90bbe82bb6e35f9ac21d4acb8587fbc456ae",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "the physician Ge Hong's handbook advised taking \"a handful of qinghao immersed in two litres of water\".",
        "exact_native_cache_key": "94ba4fe8b19090650228cca9c8e59d9c0764edaa.pkl",
        "cache_input_text_sha256": "04ecae2cebc020372fdd25339da3b91e6146dba4a90832f416afb41052493782",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "Tu suspected heat during extraction was degrading a delicate component,",
        "exact_native_cache_key": "cc2f3e5b96ae5f2fd2fae8f10c647eb823399f6a.pkl",
        "cache_input_text_sha256": "c06d0dd78447a59b3bd83c796c19b6c38c0416cfcaec46564e8a4223009a846c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "so she switched to ether,",
        "exact_native_cache_key": "9052a63e0cb2eebae327eb2b4f6f697a6831f179.pkl",
        "cache_input_text_sha256": "bc876ec4ecf1902fa5411c6d9f67d9c4e7777c29ae4b305391487535b3a53d3e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 3,
        "source_slice": "a volatile solvent boiling at about 35 degrees Celsius.",
        "exact_native_cache_key": "83653625bc418ed32b83bf3bff4c4ce256e33203.pkl",
        "cache_input_text_sha256": "47a0d19ae97b1eff80f7ccf03480bc2c7805e1f28e628d55a568e60ac1380b5c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "In July 1972,",
        "exact_native_cache_key": "fced03a17746951cd58f5c30f462276daabac9f6.pkl",
        "cache_input_text_sha256": "f869211fc6ef37312bbd9cc47ec4883facd466db0eb0527d3ccb16211e1a8437",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "to assess its toxicity,",
        "exact_native_cache_key": "2d7c4217a9121b8916886e861be8677c26438482.pkl",
        "cache_input_text_sha256": "6cb82bbb6da47496a81c4d1c05c49381ceb6df6abce802cfbd88435ee1d78141",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 3,
        "source_slice": "Tu and two colleagues voluntarily took the extract.",
        "exact_native_cache_key": "d457f3f4daf7682dcca8ead58a3b62aa97174a12.pkl",
        "cache_input_text_sha256": "14bb0e9f515c5e5c1bcafb411301422b7a8b9bda08443836816c1a1e441f729d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "Thereafter,",
        "exact_native_cache_key": "be72200a558052ce03edff95fcfd2dc4ed063aec.pkl",
        "cache_input_text_sha256": "c829e6d3ec4da1af8340b113f47ff7f0b9affddd69474df752504e841e371c91",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "from August to October,",
        "exact_native_cache_key": "45bf20c2c1d2853dd4b0bd497a58860a91d71161.pkl",
        "cache_input_text_sha256": "17cd27f08df19806a657588546dd4ba3566f9739c932844882b87675d39efe06",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 3,
        "source_slice": "it was administered to 21 malaria patients in Hainan,",
        "exact_native_cache_key": "d9d30c5dac328b39103a301528b268482ccead05.pkl",
