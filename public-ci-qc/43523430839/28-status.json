        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 4,
        "source_slice": "and on 8 November her team obtained pure crystals of the substance later named artemisinin.",
        "exact_native_cache_key": "ae7b3a5e1d50d054cf71d635ff70647d3fdde0c4.pkl",
        "cache_input_text_sha256": "c48468b6c1099a4b3cafd8ac42d34f7a9461e8c345759b2f5d64afb4e4d37920",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 1,
        "source_slice": "In September 2011 Tu was named a Lasker Award recipient;",
        "exact_native_cache_key": "87f9b070cbf42e40c45d95c08983ff0cfe35b3c9.pkl",
        "cache_input_text_sha256": "26dab4fd370ef34bdae42d4cd374a0520978527c1c8f03c0c2bf98224d900937",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 2,
        "source_slice": "its jury credited the drug with saving millions.",
        "exact_native_cache_key": "2f35225356fd5de550b946cf9475408b77315c90.pkl",
        "cache_input_text_sha256": "077359112a5576b9e4820a5a3c59ce732c3e161db887393625502af18d82531d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 1,
        "source_slice": "On 5 October 2015 she won half the Nobel Prize in Physiology or Medicine,",
        "exact_native_cache_key": "36312be4ed58caee9579d86dd27124a69e90b7cd.pkl",
        "cache_input_text_sha256": "fcc4c0bea23ac9a904475daed718783b3a17b4498b08031f0e6b6e5eb22898b8",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S15",
        "piece": 2,
        "source_slice": "the first Chinese woman Nobel laureate.",
        "exact_native_cache_key": "6818df7a1496707cbc06048bc7c9dc0294102081.pkl",
        "cache_input_text_sha256": "7c6a4ae913c62418d331d2e57b02e6c23231974b8b25535c27873882f911693f",
