  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In the first ten days of September 1854,",
      "exact_native_cache_key": "1b3c3a30c3fffb08dafc5ad7d25af629aacacdc9.pkl",
      "cache_input_text_sha256": "0527f459a5d433485d1cc32d38f4a2b9dd34d11ee685c295cb4ff6e3347af457",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "cholera ravaged an overcrowded corner of London's Soho;",
      "exact_native_cache_key": "21afcf1464bd40a8be6e76d200be23ba8888fe3e.pkl",
      "cache_input_text_sha256": "57684a7d367baa8a870a5cf4f076b27df0b2310033b62af3c7db4d3a08f4313a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": false
    },
    {
      "sentence": "S1",
      "piece": 3,
      "source_slice": "upwards of 500 people perished.",
      "exact_native_cache_key": "0c4a45dd86e8d391d665cd4702f364266faa8ead.pkl",
      "cache_input_text_sha256": "7a22912a170d0b84ba8ef6f96a560f3feac6ed2981d03a52cd327c55143840a8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Most doctors attributed epidemics to miasma,",
      "exact_native_cache_key": "0357e99981d48719debe3b2b3468338f3940f27c.pkl",
      "cache_input_text_sha256": "020ba86a8b6b010b0d8177d35d0873567ae53b6e6850440746fb5a90bd73a358",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "foul air arising from filth.",
      "exact_native_cache_key": "860edcd98565fb1abaf6fa8cdc072d1363182f79.pkl",
      "cache_input_text_sha256": "4c867c0b7254d75eef293f9f5a4546e94da93f084159af344af097c64ea7c51c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "John Snow,",
      "exact_native_cache_key": "2562c0940eb0288122558d32d5e8eec49063ddfb.pkl",
      "cache_input_text_sha256": "cf83a57907db9ddf24caf079a7a565bb332722c69b4a90b9a47cf3bb2433785e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "a physician who had been convinced since 1849 that cholera's poison was swallowed,",
      "exact_native_cache_key": "1ad6eb235c551f941dd77cfc8bcef97fc190d1e2.pkl",
      "cache_input_text_sha256": "37e77dbc84ec9dc2a0a4f4f998cec54bdc85adfbbe93053e801cc229fa1e0d38",
      "cache_input_is_phonemes": true,
      "cache_preexisted": false
    },
    {
      "sentence": "S3",
      "piece": 3,
      "source_slice": "not inhaled,",
      "exact_native_cache_key": "dbd1e41b60f85ed1459464350de267470ad6b90e.pkl",
      "cache_input_text_sha256": "69ae18db5ca5982457e3c02c1f8e8d2a6c078628e2cebddffea9bbacaa40bccc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S3",
      "piece": 4,
      "source_slice": "suspected the Broad Street pump.",
      "exact_native_cache_key": "10fa949ce9f781ca54c2e0d8b992fb010067242f.pkl",
      "cache_input_text_sha256": "bfc7181ae66a370626bc1bf835df856fb71dae3ae6ff9e28d20a40f9b16d5867",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "Finding little visible impurity,",
      "exact_native_cache_key": "f1893d5f426f6d9e315f16fb171d7584f463a4aa.pkl",
      "cache_input_text_sha256": "e0af61ae074e1ac77f8970508493ffc55827434ce5caa5ae1271e66cf057169d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "he hesitated,",
      "exact_native_cache_key": "5eb70e56616353a5d9de1bbdf96be225efa6f6d9.pkl",
      "cache_input_text_sha256": "564623de7ec4c9bb8836c67c642afc8ed926959e21a2d47a722403694230097c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S4",
      "piece": 3,
      "source_slice": "then consulted the death register and questioned bereaved families.",
      "exact_native_cache_key": "9ba9b22ceb810b220905f19faa29c23b7e0c7042.pkl",
      "cache_input_text_sha256": "f745bbb8be1ac3d578b57aa4d9adb3044465e336b13b4f6e5417eaa5e8d0d11e",
      "cache_input_is_phonemes": true,
      "cache_preexisted": false
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "At his urging,",
      "exact_native_cache_key": "d732e978ed1e6d66cc4cbe9d4155a1164cae4c8e.pkl",
      "cache_input_text_sha256": "7a700eddce577f953b86755949f8a14c2afe546e88a8ce3d1c32e86c1c3bedfc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "parish officials removed the handle,",
      "exact_native_cache_key": "65a392bab807fe8280603bde06bd02a103cf122e.pkl",
      "cache_input_text_sha256": "9d80db264c13f9243d9117d87956ef6226c2eb839a76bea5e28e4831dc7c619e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "but daily fatal attacks had already plunged from a peak of 143 to 12.",
      "exact_native_cache_key": "06e9f3c7d5ee4ad1ff1f1521f2befc16e641503a.pkl",
      "cache_input_text_sha256": "34ee3af65f954c0098f4beb7c200dad91b801394a4dadf603f9d4c7108d0a114",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "In 1855 Edmund Parkes,",
      "exact_native_cache_key": "b804c1eff85888c5bc2ace1a7e683e2f214bc4c0.pkl",
      "cache_input_text_sha256": "665e726a6978aedebe3c1c55d3beadad5bdc795f99d9f0f74373f35bb40400bd",
      "cache_input_is_phonemes": true,
      "cache_preexisted": false
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "a professor of clinical medicine,",
      "exact_native_cache_key": "b7421052a00e3b427ab88e42c3386291683a8efc.pkl",
      "cache_input_text_sha256": "b4bb4aea913c75c5fd477618012df0b9167f9321deb88f12134083c373b3e0d4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S8",
      "piece": 3,
      "source_slice": "interpreted the cluster on that map as a poison drifting through the air.",
      "exact_native_cache_key": "0441fb398029ee9bbcf355e5f15c0d5d73b8ddb2.pkl",
      "cache_input_text_sha256": "b9094cec55b0e80b3aaa4e3d54c66d077ccd9cbd7cc0a091b0b50c3eac562e64",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Yet a map could chart where people died,",
      "exact_native_cache_key": "0f1ecf9e4b54f487c6368b0e2d56ae0fbfc385ef.pkl",
      "cache_input_text_sha256": "dfa568206ed8196bea1a1c86d028ca29d911e5d4a4be5f258df2eedf7155372e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "not what they drank.",
      "exact_native_cache_key": "8f0a2a534d0ab3af4cbd9f2276e4a41ff3c62514.pkl",
      "cache_input_text_sha256": "5e962025ede44a64f9bf3d97e4fa0a1d1236dd6bfb9a4795163e60e711c94a4a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "The crucial evidence,",
      "exact_native_cache_key": "3ad2d47976c20a79ddda83f2b637846b1b4ba2ab.pkl",
      "cache_input_text_sha256": "7a70ca1290020bb74ecb019525bff45aaf3a1407bf7a6951e994f5396a309baa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "gathered in 1854,",
      "exact_native_cache_key": "87f54aa8cd87ff05234e42062418da4bb8cc3e04.pkl",
      "cache_input_text_sha256": "6169eb2077cbca2cbd52604273c8d10004ca6d1bc89ce653cc5d32bb254937cb",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S10",
      "piece": 3,
      "source_slice": "lay in exceptions.",
      "exact_native_cache_key": "842b8488153fac543161d9f3ec642b10051c0632.pkl",
      "cache_input_text_sha256": "c08d156a7189d9a0e50c8a0e427e95177f56ed56af7a25f106d88408e5b40d7f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S11",
      "piece": 1,
      "source_slice": "Amid the deaths in the surrounding streets,",
      "exact_native_cache_key": "ecfbeffaa28e20a307051e8a9a6b393e5536e966.pkl",
      "cache_input_text_sha256": "9c2689dc7d6f2a49fc1d2a938b156d3fe4d87f84f0c3a7ab801146a4bdcfb22f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S11",
      "piece": 2,
      "source_slice": "a workhouse with its own well lost a mere five of 535 inmates.",
      "exact_native_cache_key": "619a577ec704972d61fbce676eb17a837dd7ee74.pkl",
      "cache_input_text_sha256": "54d9e26e99c8c292948c61cc325c1ed6960aae8d94bfc3ab566bb8a533dc6a68",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "More than 70 nearby brewery workers,",
      "exact_native_cache_key": "d8b78c7e19d7ee6d547a3a58a1bf3343d120af5f.pkl",
      "cache_input_text_sha256": "2f9efd152222312c1dff16f7fd5451968630ec00cd74d7d13fd235dda9e3fae3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "with a beer allowance and their own well,",
      "exact_native_cache_key": "9493f35a495f79481e3d952b7e2e4336748e3732.pkl",
      "cache_input_text_sha256": "f53990f88777ed4bd9241aaba2a1b3dddcbab5d2ac43ff97c44ab87acbff5acd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S12",
      "piece": 3,
      "source_slice": "escaped severe cholera.",
      "exact_native_cache_key": "84c25d0d054e9512f332eecc4a8af8b8b1727d4f.pkl",
      "cache_input_text_sha256": "f9cfdb0e40a43ba694e1af5d0bd4360c7877fe442b4c149b01c996ec5d9e05b0",
      "cache_input_is_phonemes": true,
      "cache_preexisted": false
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Conversely,",
      "exact_native_cache_key": "f384ebaedb5238d310d2e2c01f83f3a99a79edbb.pkl",
      "cache_input_text_sha256": "5ec2602ed7af81c94233b13c3d5a579fb66ce23eeac2c38aec54cd0cc26d03b1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "a Hampstead widow who had not set foot in Soho for months had the pump's water carted to her daily.",
      "exact_native_cache_key": "b833e358693a9e1829f282da96a461e9e4008386.pkl",
      "cache_input_text_sha256": "b262a3a60ba8462d2945a7a1dba15ad54eebdeeaa656d0f82b93e993bd79e80f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "She died,",
      "exact_native_cache_key": "5e46cb840076b27e1d41cce936537ffe04deabfd.pkl",
      "cache_input_text_sha256": "cc993975a6ded3fef54803e94601db90fbef38a65c5275cc0b68c97986e4dd4d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "as did a visiting niece who drank it.",
      "exact_native_cache_key": "00a56dbeb3246d766d1f046724dedf4ed9e5d8ef.pkl",
      "cache_input_text_sha256": "1352534b7165a93190dcabfd3c0bfb10044cea992fa2cd294e6ffbfb29343f8d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "In 1855 a government inquiry declined to condemn the pump,",
      "exact_native_cache_key": "1fca3a78b6db1cee99b11de7b3724030188020fd.pkl",
      "cache_input_text_sha256": "1bfa57cfe415a86ba5b47a91fdb291d113a4b8b03063e805264e3f2bce1f15f8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "contending its water had at most absorbed airborne poison.",
      "exact_native_cache_key": "b23be5ac2178798b886dc07d28eb9e42d8565ff4.pkl",
      "cache_input_text_sha256": "ca0ea630176ebffbd4bb7d0ea7869df55a185b87010f9ddc7d2593d182172400",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "Meanwhile,",
      "exact_native_cache_key": "f54199d32a89cb853bfef2c12e9c3fbbe6dded48.pkl",
      "cache_input_text_sha256": "01d0eef70abc55d087bd6273044b2ecd5e2a33944d7d6fe72de53284a7acaecf",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "the sceptical curate Henry Whitehead set out to refute Snow but found that those who drank from the pump were far more likely to succumb to the disease than others,",
      "exact_native_cache_key": "22d4b70ea071fcf02b8be5f07d88714a8ac3c7ad.pkl",
      "cache_input_text_sha256": "e08fee84f39bfe4ba48cec656f179c8487dd0756f7cb1dfdbc83aea9d72f6b09",
      "cache_input_is_phonemes": true,
      "cache_preexisted": false
    },
    {
      "sentence": "S17",
      "piece": 3,
      "source_slice": "vindicating him.",
      "exact_native_cache_key": "d461c557b0744ab3eb59ea690c5ad29bf90c5f14.pkl",
      "cache_input_text_sha256": "0f1c841df344fe6c4df9684b61e4df823175642164940e872e9b459c098fe1b9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": false
    }
  ],
