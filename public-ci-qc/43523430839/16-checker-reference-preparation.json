      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "bringing abundance.",
      "exact_native_cache_key": "754eea5abf69455705f5b1c805d88527752d58fa.pkl",
      "cache_input_text_sha256": "de704b1779641c7a8318efe4a44e04828fdbe62b85ced0e57f4b1f61e9cc233f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Ammonia stocked Germany's arsenal with nitrates for munitions despite a British blockade,",
      "exact_native_cache_key": "20bd414273096a73bab50fc1ab4c8a0b6415a0d3.pkl",
      "cache_input_text_sha256": "deb256cceeefef8502cac66e2843acf041aa742d5a39b665317166c438ce3a29",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "and Captain Haber marshalled chemical warfare.",
      "exact_native_cache_key": "711b07b7a079c943a5fa1c0acba73742bdd64838.pkl",
      "cache_input_text_sha256": "6860f301d2409ffee8ff5600b03723fb44c010e91fe976fb649ee8fa3dcc8bc9",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "On 22 April 1915 at Ypres,",
