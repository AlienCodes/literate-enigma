      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "BASF envoys gathered round a squat machine on a bench in Fritz Haber's Karlsruhe laboratory.",
      "exact_native_cache_key": "85b44f6d0418dba35754dc6375424241c0fe8ea4.pkl",
      "cache_input_text_sha256": "0356f8e5f5c3e7bfd674ddc9b7651d8c16f203d5cce9d988cff2de4b5613ef08",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 1,
      "source_slice": "Behind its gleaming,",
      "exact_native_cache_key": "b4a4da16d5b1c2694920da03a632befa7c5be6a4.pkl",
      "cache_input_text_sha256": "11ec634103317cf0f2b04f586e5ff67dacf93214cb8704dd52490dba2ac4c764",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 2,
      "source_slice": "bolted valves,",
      "exact_native_cache_key": "3424d518a99c7b4d7e27f0951ef6f38a43e41db3.pkl",
      "cache_input_text_sha256": "5819376b04f7c5b35650c861ff44fe2ee29477d1ee77407f977b2a58710979ef",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 3,
      "source_slice": "nitrogen and hydrogen met at crushing pressure and furnace heat,",
      "exact_native_cache_key": "2e759bc0c158715efcf8b9e8fface5e68ba083c1.pkl",
      "cache_input_text_sha256": "94c0b0b51a0ab4b78facbbd7d627b0a9c767c1f54c43c862d4a7e37e3a858b4c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S2",
      "piece": 4,
      "source_slice": "and transparent beads of ammonia began to drip slowly.",
      "exact_native_cache_key": "b47970fd9f867b35c4be6f8a2100af14e06ea3c3.pkl",
      "cache_input_text_sha256": "6a2cb24146ba75b5e1e14e3777cfeb3b70d2e502fa1ec014743635b57fd57481",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 1,
      "source_slice": "BASF's Carl Bosch scaled the method up,",
      "exact_native_cache_key": "3503cb804f07c55af20275ee10a1e71d5e339bf8.pkl",
      "cache_input_text_sha256": "0b58118aff73988f9c0bf7a41cce7c1a3cd54b9ae5d68b495e5ab499c672b308",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S4",
      "piece": 2,
      "source_slice": "and from 1913 a gigantic plant at Oppau mass-produced ammonia.",
      "exact_native_cache_key": "0d51b02f427a5f57656a4f667a2bc53104f6e1d0.pkl",
      "cache_input_text_sha256": "17c46600caa5380dad375fb67ae480c94b3234dfb741ce1c56b13a29936d4169",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "Hailed for making bread from air,",
      "exact_native_cache_key": "7474912bf0ee522feb38f8469bf503349e738f33.pkl",
      "cache_input_text_sha256": "6d49c66ead18d5a12782effb7af33bd9784b78ca33ba0872d894bb40b7cffc42",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "Haber won the coveted 1918 Nobel Prize.",
      "exact_native_cache_key": "6a381fcdbc250ab8e89ca381c8ee4f6ca6ba60bb.pkl",
      "cache_input_text_sha256": "ebe1725ad87bb1399a99fe483283681c540132fe4fe34e523b090c231caf6ad0",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "Ploughed into stony soils as fertiliser,",
      "exact_native_cache_key": "abfbd003bc74d74bd24f186fd3419de1ecb7f2ec.pkl",
      "cache_input_text_sha256": "dd1d7ec08cd84c050251182bdb8306791fcc5a9515b430f9ee9ae5111bbddcc1",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "ammonia wards off famine as no manure heap could,",
      "exact_native_cache_key": "d40f8b434ddbbae00ecd6376a83e6da1d043e911.pkl",
