      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S7",
      "piece": 3,
      "source_slice": "is fussy about location.",
      "exact_native_cache_key": "88716e02e84dac152068f7c38b2890cbc4f483ec.pkl",
      "cache_input_text_sha256": "922ec964b1854194a1abb78eb0a21c5c8350af88003c10c4eba6e93b384ca8f4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "David Hughes and colleagues found the bites mostly on the north-west side of plants,",
      "exact_native_cache_key": "d58374ce578bba1bbec0eb23d49b41e186513df3.pkl",
      "cache_input_text_sha256": "60266d64fed6555372cce5d57133174999c8fb29b02014ffdaa2fcc6e478a9b5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "where the air is humid and the temperature suits the fungus.",
      "exact_native_cache_key": "f0121550f578e6aadbbdac274af1c29f44789dee.pkl",
      "cache_input_text_sha256": "9cd28cc57ddd2135c90156b393add3af18d0c3dcd14ec3acb45a0be9ccf205b9",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "When researchers moved infected ants higher,",
      "exact_native_cache_key": "5e20538dcf2da5fcaddff3528cf485676e797d9d.pkl",
      "cache_input_text_sha256": "11856a5afdd36a1bafe5678ed8ec15087316a37c2d60cde4b8cd0adfc5dbf42c",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "the fungus grew abnormally.",
      "exact_native_cache_key": "0853368ead9df4ed9aebac44b3499e8294d543de.pkl",
