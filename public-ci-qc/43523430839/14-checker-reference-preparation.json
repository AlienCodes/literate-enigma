      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 1,
      "source_slice": "Placed on the ground,",
      "exact_native_cache_key": "f0867b6994d4ad38cec6be9e461bcf6efe104cb0.pkl",
      "cache_input_text_sha256": "9ab073e1b0e99a7f91337b23089a048ce8e170097e92149139dc68bf0f65c82e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "the bodies disappeared.",
      "exact_native_cache_key": "6411c9b07f3677dccc30bb1716143245fb65deda.pkl",
      "cache_input_text_sha256": "80f62707a06dcba39a406a6c2334143f8b79f33b38030734f6ab8b855e1b3577",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "Fungal cells had formed an intertwined lattice around muscle fibres in the legs and jaw,",
      "exact_native_cache_key": "cbd924871a12135c3d89177e13002e6ca6cad497.pkl",
      "cache_input_text_sha256": "5d4bdfe5bc0a283520601b8aee604e73ad5ee8f5fe7e552cf8d12cf76bfea7f5",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "a picture that evokes the strings of a puppet.",
      "exact_native_cache_key": "bb2dd52b8e513fa1a2eef5d2ed3e7931865e87d1.pkl",
      "cache_input_text_sha256": "0caf66bb6a9bac2a5db5007208e8018119f348adbfc889a18542325a7d70d8e7",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "A Planet Earth episode,",
      "exact_native_cache_key": "e70ff9b349225fd3ff5f0a57de84ab594e0bed14.pkl",
