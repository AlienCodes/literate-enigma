      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "In 1984 Barry Marshall,",
        "exact_native_cache_key": "6e6af6e07d80392889a95b947aaf9351e51e0149.pkl",
        "cache_input_text_sha256": "6c38f38a9b48133cb38d6693e18d71b8cb3f338c69f9503893a92f0e5734fe17",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "a 32-year-old doctor at Fremantle Hospital,",
        "exact_native_cache_key": "3a438cbf3933bef2180cc0bed0e83da2cd82766e.pkl",
