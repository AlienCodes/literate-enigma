      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Thereafter,",
      "exact_native_cache_key": "be72200a558052ce03edff95fcfd2dc4ed063aec.pkl",
      "cache_input_text_sha256": "c829e6d3ec4da1af8340b113f47ff7f0b9affddd69474df752504e841e371c91",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 2,
      "source_slice": "from August to October,",
      "exact_native_cache_key": "45bf20c2c1d2853dd4b0bd497a58860a91d71161.pkl",
      "cache_input_text_sha256": "17cd27f08df19806a657588546dd4ba3566f9739c932844882b87675d39efe06",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 3,
      "source_slice": "it was administered to 21 malaria patients in Hainan,",
      "exact_native_cache_key": "d9d30c5dac328b39103a301528b268482ccead05.pkl",
      "cache_input_text_sha256": "40d82722cfe6e68f4d1cc2b5ca2be003262fd9719c5d6ac61431eb10a728a4c4",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 4,
      "source_slice": "and on 8 November her team obtained pure crystals of the substance later named artemisinin.",
      "exact_native_cache_key": "ae7b3a5e1d50d054cf71d635ff70647d3fdde0c4.pkl",
      "cache_input_text_sha256": "c48468b6c1099a4b3cafd8ac42d34f7a9461e8c345759b2f5d64afb4e4d37920",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "In September 2011 Tu was named a Lasker Award recipient;",
      "exact_native_cache_key": "87f9b070cbf42e40c45d95c08983ff0cfe35b3c9.pkl",
      "cache_input_text_sha256": "26dab4fd370ef34bdae42d4cd374a0520978527c1c8f03c0c2bf98224d900937",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
