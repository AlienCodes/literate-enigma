      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Only a few dozen children entered the SAT analysis,",
      "exact_native_cache_key": "bd387f4ab67d85d0395e61e90868b98f8d9d9ac5.pkl",
      "cache_input_text_sha256": "06dfe2710af81281cca29ac995610155159f77db4c3a3be39b13bf85375fc070",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "predominantly the sons and daughters of Stanford faculty and postgraduate students.",
      "exact_native_cache_key": "42789389190f62f97848230b7c111abbb6d2a1c4.pkl",
      "cache_input_text_sha256": "51dc378bed859b66cd54b5a1e13579361a0c26a4f961c25777e661bfa4b51b7a",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "Such a homogeneous,",
      "exact_native_cache_key": "8a1058986685b8ebd35d188331ad145b13b47ebf.pkl",
