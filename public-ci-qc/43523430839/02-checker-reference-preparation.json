      "cache_input_text_sha256": "9e3d1a5cd2943895f66e42d6539f40f50cc74bb1aebf4c81b9dcd2fa5aad7b58",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "A 1990 study in Developmental Psychology found that,",
