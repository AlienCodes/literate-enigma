      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "as adolescents,",
      "exact_native_cache_key": "9ff86267b89f43a4e4b54943ff02b84c57dd3603.pkl",
      "cache_input_text_sha256": "e34a5d8af9840b2e334625d487f9a1fe1f5945753e73aa87c5734c6e1d423f17",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "longer waiters tended to attain higher scores on the SAT,",
