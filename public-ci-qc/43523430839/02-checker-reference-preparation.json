      "cache_input_text_sha256": "0607d1a49e69e8cce37ba8dd35eb4a3bda49a96df5d0be2bc4e0c5f5eb4f0a51",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "A trivial snack became an emblem of virtue,",
      "exact_native_cache_key": "3ab90cdcef7243108a0ea5861e6c80793c97d9b8.pkl",
      "cache_input_text_sha256": "a6b07a816b9d8b1a621345f61bc846063fcb153916276d03b8d8c1ae0aedf04d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "and restraint at four was glorified as a predictor of destiny.",
