      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S13",
      "piece": 1,
      "source_slice": "Adjusting for family background and early cognitive ability shrank it by about two thirds,",
      "exact_native_cache_key": "11a5f1089779ca005fe4f72697cde48a47d62c60.pkl",
