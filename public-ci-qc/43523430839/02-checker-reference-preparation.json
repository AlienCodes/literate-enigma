      "cache_input_text_sha256": "eb584f1c0d00725da33974d8ed885d157061c9e459f6846b32ffe1d4a920fba8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "Impulsive children often surrender instantly;",
      "exact_native_cache_key": "0098e3a9bebc086471ec1da78bb56a39cbe0b104.pkl",
      "cache_input_text_sha256": "d874a329967db1a086f97d0b41d93e0791fd453f5039a75696bdd772fb49965a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
