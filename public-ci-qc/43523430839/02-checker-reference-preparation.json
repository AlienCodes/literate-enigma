      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S10",
      "piece": 2,
      "source_slice": "the same idea,",
      "exact_native_cache_key": "cabed578d3b06a5dc95cfbaa871c7659011ea6c9.pkl",
      "cache_input_text_sha256": "af721baef6f621ad045064c52bb1886f546aaaf863f6c158da9ef195c95397f4",
