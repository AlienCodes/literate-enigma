    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "On 6 January 1995,",
        "exact_native_cache_key": "d01d4461eb4d88c42fb459860b047f07f0dbda74.pkl",
        "cache_input_text_sha256": "7a79b07e62964c54971f8324a6f1bad080280444badcee43cb33510b8491b2ac",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "McArthur Wheeler and an accomplice raided two Pittsburgh-area banks at gunpoint in broad daylight,",
        "exact_native_cache_key": "c0a52dbf88167f59a90d5ab9f9cf7724411d9db9.pkl",
        "cache_input_text_sha256": "ea55bf87d9b90fb052fdda49b9e5a1b0a2643c6ae946457da4df901a02577113",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "without disguise.",
        "exact_native_cache_key": "93f900af103170895ae748c100a71e1448845e49.pkl",
        "cache_input_text_sha256": "fe71db32ebe9b5c4e62d3356ee743a71f37c81e5b77765f48db81bf6ab15695c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "Their only camouflage was lemon juice,",
        "exact_native_cache_key": "664520ba926ec2751d72c0e0ce4754ba4621f37f.pkl",
        "cache_input_text_sha256": "b99ae1850d9673f056e8bdd7dc458e21a4606a1154dc01f77477b1d9a3008703",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "rubbed on in the earnest conviction that it would render them invisible to cameras.",
        "exact_native_cache_key": "6be24e0a25647beed2488007faa1782cb14d8dcd.pkl",
        "cache_input_text_sha256": "d37fa343424bdc88ab11184adb921e5b48e07a49b8b37e3011eb12998a813129",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "Lemon juice is a time-honoured invisible ink,",
        "exact_native_cache_key": "1166be37a4040afe4ad9bc401324538bec614f20.pkl",
        "cache_input_text_sha256": "05df911ff18755ae02e337f0e9ce080836e2ff1067b99f8ffad961261284e3a3",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "and Wheeler made an inventive leap from paper to skin.",
        "exact_native_cache_key": "542c1b65f8e6e4ce7efe8d4c4340587d0edd1126.pkl",
        "cache_input_text_sha256": "3972713a3a423b8875319321809d7d6e05cb404d70ae4ad25625a0fba668f3c6",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "His Polaroid self-portrait came out devoid of its subject,",
        "exact_native_cache_key": "2c4e3c28b05a888e81da1ce1ba5f7957d7ae9146.pkl",
        "cache_input_text_sha256": "468297176e20943386251a960a70493387bae1f4dc4502079812e984f1b805a0",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "a result he took as conclusive.",
        "exact_native_cache_key": "ea2876685e62afc987a8cdf9058ca09f321cb3f4.pkl",
        "cache_input_text_sha256": "e71b03b26fae2e6dc7032c1c366de6a83d33179370ac2231f0505e1cd113e612",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 1,
        "source_slice": "On 19 April the eleven o'clock news showed viewers the damning images,",
        "exact_native_cache_key": "559dea1c6ea4745a069c313545f825ad7075b7b7.pkl",
        "cache_input_text_sha256": "c596ea6c305260db33ddd4f4c7aa55bec083a7632eda15fd53dc80420ae11e16",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S7",
        "piece": 2,
        "source_slice": "and Wheeler was arrested shortly after midnight.",
        "exact_native_cache_key": "1279a7a47947734fcddd155b6845e78c49c71161.pkl",
        "cache_input_text_sha256": "fbc92585bb273b7fbf246093dbd89ae7e1a7bc353ce6beaadd7a868cbb57aa15",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "Confronted with the tapes,",
        "exact_native_cache_key": "b9df3b490d8ef45a6249c1fc0f5a0e179a253d3e.pkl",
        "cache_input_text_sha256": "eb8f58a5ec6d2874939cc4ec6ed2f5ddea45d417f293a8001af55cf702ec0a9b",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "he protested in sheer disbelief that he had worn the juice.",
        "exact_native_cache_key": "8c4fd519d5f027cec7e4861dc1f420d9886db27a.pkl",
        "cache_input_text_sha256": "1cd67ffc505ad1b2d43bff6474e8614778105d61094d546bd4a152ff56887393",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "Reading about the case,",
        "exact_native_cache_key": "2d3880d6de8b8306b5be60eb93d27f30227a23a5.pkl",
        "cache_input_text_sha256": "a21aae4012b73a6f45d3677d65bb022e86528cbc29ba9e72fc90ad266ed64006",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "the Cornell psychologist David Dunning pondered a disquieting proposition.",
        "exact_native_cache_key": "cf36db19d7a2077961b8164183967928b3f30f33.pkl",
        "cache_input_text_sha256": "d59d328c539df34be498867c98757a5b8d57ee09463ac8cc0c0292a32a333afd",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "Perhaps incompetence can cloak itself,",
        "exact_native_cache_key": "ebd00ffb1ef8a17498c370218200fec29c34600d.pkl",
        "cache_input_text_sha256": "acb8eb176eb0ef61d5c57d1ff24861a59dca0433111afb875b634e33f0acd443",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "robbing people of the discernment to notice their deficiencies.",
        "exact_native_cache_key": "713a2ab69f9a5a8f5ceb06ef71ba9d8c0d962bb8.pkl",
        "cache_input_text_sha256": "3afb689152335841a3ee1720adc1f275b13e177352ec06129f03707c609028d9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "For a 1999 paper,",
        "exact_native_cache_key": "51b85fe9e7f3aff08b5d6ba26277e61f8792ed03.pkl",
        "cache_input_text_sha256": "bdf786218ca8d7b7d307f113485339d6bd60ebb51acf0a72fb24316448295478",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "Dunning and his student Justin Kruger quizzed Cornell undergraduates on humour,",
        "exact_native_cache_key": "16adae78bf7e34330272b200e21739d798d3097f.pkl",
        "cache_input_text_sha256": "1a98658a6ee6c5e701bd756becf603635d8d6b595f24e97669b6a585e1c83d6f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 3,
        "source_slice": "grammar,",
        "exact_native_cache_key": "8c6655a7952b8daf4f5fc4307d5bc4ab08d5412d.pkl",
        "cache_input_text_sha256": "33105ffff08b04e0e7431d1c41571a68161535cb5d6c8900e29574e3edc7145a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S11",
        "piece": 4,
        "source_slice": "and logical reasoning.",
        "exact_native_cache_key": "41d91a2367c9c656bfcf3b3a224e110ca058fdce.pkl",
        "cache_input_text_sha256": "ebed2fad8b47b6bdb6e84d82bbff3fddf81e5efe5f7dfe9f064cea320d006721",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 1,
        "source_slice": "The bottom quarter of scorers averaged the 12th percentile but generously placed themselves near the 62nd,",
        "exact_native_cache_key": "bb8d5452d3945c58faa0102297ed09760e00d387.pkl",
        "cache_input_text_sha256": "414fbb2ed9b7a7206ea606aa626333d48c30591760611d85b762acafcfa63a02",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S12",
        "piece": 2,
        "source_slice": "whereas high achievers showed undue modesty.",
        "exact_native_cache_key": "8f6d98ce374a5b5bb1ab578d68768148a1449bdf.pkl",
        "cache_input_text_sha256": "2b502cad7770f73b4107e2b186d499d4334e0bb310583e1848aa80f6f013630a",
        "cache_input_is_phonemes": true,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "The unskilled,",
        "exact_native_cache_key": "1a876002ba7089127b55000cf590b8e4df49ebb9.pkl",
        "cache_input_text_sha256": "1b0c27ca724634e916e7e5ebe4df8463481d213105f5d61d0d8a72259ac79504",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "the authors argued,",
        "exact_native_cache_key": "d5b2a3bb15a58567697e5339f6035d7290fd7879.pkl",
        "cache_input_text_sha256": "f754eb9b2ce6b1f9a88a3e5c8b5c14242bdeecd840e9d6128f2100569cab4d05",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 3,
        "source_slice": "bear a dual burden,",
        "exact_native_cache_key": "4da8143ad204fae13289f1714ecfa6204ba683f6.pkl",
        "cache_input_text_sha256": "b4be93a75e56f73bb835e517f1a2fc6d6b974751cb535b99df80bbfc17768db4",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S13",
        "piece": 4,
        "source_slice": "since appraisal calls for the same skills as execution.",
        "exact_native_cache_key": "de2e492427af32ef0abade78467e41337a6bc932.pkl",
        "cache_input_text_sha256": "06a74ff01b0a19990c6e16844607c68397bc8c919bfc59119aec998b4ff13b12",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 1,
        "source_slice": "Detractors traced part of the Dunning-Kruger disparity to regression to the mean,",
        "exact_native_cache_key": "ee27050ef1138a0ff80b9ccfac770b9d5043bc74.pkl",
        "cache_input_text_sha256": "45968fd3f5a0ceeacfee3b6ebdcde87b9c8fa6a4a9a4e21d3fa4f3b6831c1206",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S14",
        "piece": 2,
        "source_slice": "a statistical mirage the paper partially acknowledged.",
        "exact_native_cache_key": "1f798ef8543023e80d31332c2c3dd03e19821a7d.pkl",
        "cache_input_text_sha256": "5e1eca95c8c4d7c0d52a64c2abe025a597415731e57b9589f34b7aadf58879fc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 1,
        "source_slice": "In fairness,",
        "exact_native_cache_key": "62ff2d08fb833e0a03b2fded5067c765d1f4a655.pkl",
        "cache_input_text_sha256": "ab76d044143d708bc8d958841952e26f19c855fabd05254e13e147bfdde5bc67",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S17",
        "piece": 2,
        "source_slice": "Wheeler had tested his method empirically before staking his liberty on it.",
        "exact_native_cache_key": "1f765280a0dfdb2ddf139b87233774a3f3c1656d.pkl",
        "cache_input_text_sha256": "ce2235f80a6802d03a2a5f036de2464e58949b1f20dfb27edbe5bae65a83090c",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      }
    ],
