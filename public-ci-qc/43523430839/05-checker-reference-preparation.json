  "reference_calls": [
    {
      "sentence": "S1",
      "piece": 1,
      "source_slice": "In November 1983 a 15-year-old girl was murdered in the Leicestershire village of Narborough,",
      "exact_native_cache_key": "eff3936f964761a149a77a1e1f79b4b27a386157.pkl",
      "cache_input_text_sha256": "8fd538634e17cccdac8fedee0ffbf9d337ba3bec3e19ca0744d8b71a0e25b361",
      "cache_input_is_phonemes": true,
      "cache_preexisted": true
    },
    {
      "sentence": "S1",
      "piece": 2,
      "source_slice": "and the homicide went unsolved.",
      "exact_native_cache_key": "7c849a3a7391e4c576df3384ec6fd44bc2488893.pkl",
      "cache_input_text_sha256": "40e7b80aaf27eaf8951f2e9bd8b68a455b99ddc77833bea565e9e981fc3da17f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 1,
      "source_slice": "A 17-year-old local youth confessed to the second killing,",
      "exact_native_cache_key": "515c005a02d83f135ebf92eb26c853d4abc79592.pkl",
      "cache_input_text_sha256": "ff79a07de15e2106810b34274e1d7d20465d1873cea34e4a87777902ab29c026",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S3",
      "piece": 2,
      "source_slice": "and to detectives the perplexing investigation was seemingly resolved.",
      "exact_native_cache_key": "ce46a7df9207daaf27fc209345eb440844405aa9.pkl",
      "cache_input_text_sha256": "f3f4e1f75616eb14ac83b35954a36305a7dd3bf15597e7a822d0cf56b969944e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 1,
      "source_slice": "On 10 September 1984 Alec Jeffreys,",
      "exact_native_cache_key": "bd594990c13f82d568ad9d30006ddac83d6cfcc0.pkl",
      "cache_input_text_sha256": "2c52c429fd352f56257cde4a277eb56939d7d03d981c268b4c119dec667782b3",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 2,
      "source_slice": "a geneticist at the University of Leicester,",
      "exact_native_cache_key": "db1daeefe220b998ac26a3a8ec5b68ac271914c6.pkl",
      "cache_input_text_sha256": "284fddd282d706cc1352b4e390b05ccf3dca4a196fad573b200fa8baacba7052",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S5",
      "piece": 3,
      "source_slice": "discerned on an X-ray film molecular markers whose layout varied considerably from person to person.",
      "exact_native_cache_key": "23ab62d2c18add2c9af48f7ff1ec3e8581c170d1.pkl",
      "cache_input_text_sha256": "883ebd0ed640fbca8dd364aad7237766a377d28f3b4cc50ac0edfd18c4570ebc",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 1,
      "source_slice": "He called them DNA fingerprints,",
      "exact_native_cache_key": "c02d73e4836646a0150a65238a0b8bf5c28c2501.pkl",
      "cache_input_text_sha256": "b36f420fd8f47aae03e9ea2ceae42c3a0866779a9a4fdbfd6fe103c721fe609a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 2,
      "source_slice": "since,",
      "exact_native_cache_key": "d9f7d8f71e67be0dd89a4a80e28a8429ce94e55a.pkl",
      "cache_input_text_sha256": "f5c10395c3d29cfbfc939abe6246e4228bee9167884da48540112a75d2272c48",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 3,
      "source_slice": "like fingerprints,",
      "exact_native_cache_key": "a8e65551a3b7d8f8e4a05088ac45df2d17edc5d3.pkl",
      "cache_input_text_sha256": "5c7f4dc5f800d644afe2c37db6e41ad8d70ee149bce66244cd7437707e7c770e",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S6",
      "piece": 4,
      "source_slice": "they differentiated individuals.",
      "exact_native_cache_key": "ced50def6419d2dda436a168ef47c3079458b0fb.pkl",
      "cache_input_text_sha256": "8daa47bd3da80ade42cfc20bc832330d4b435d626b47bcbcbec5925fb6589116",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 1,
      "source_slice": "Police enlisted Jeffreys,",
      "exact_native_cache_key": "589800a5645a8feffb132cdf225248c2de643d7e.pkl",
      "cache_input_text_sha256": "7d9c929cad5826b26603de9d4d1e4e30c1164974e28553fce8dde637fbf131f2",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S8",
      "piece": 2,
      "source_slice": "and his genetic tests overturned the erroneous confession.",
      "exact_native_cache_key": "c21aed4c505c22809203ca5af549dd885e496656.pkl",
      "cache_input_text_sha256": "836ca5b5a8beae13e8e0c8326b6c3273c378445a983dee406c8f791c24b5af6a",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 1,
      "source_slice": "The youth was not the perpetrator,",
      "exact_native_cache_key": "25389006ae7342187ee3987cefefc08aebc15a9c.pkl",
      "cache_input_text_sha256": "4127915b1e36841537d4910f7c4dd4d61891ae83a939739acb133d7e0313c56b",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S9",
      "piece": 2,
      "source_slice": "and the same attacker had killed both girls.",
      "exact_native_cache_key": "87c1bcef7ecffe4b3b5fd78901cb57ffe9cc1fb1.pkl",
      "cache_input_text_sha256": "0dfb5846c5ff6aeff6f46f3b729ac34f85f3676ae274c94c54beb3e9b62c4845",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 1,
      "source_slice": "In January 1987 police commenced the world's first large-scale DNA screening,",
      "exact_native_cache_key": "58b47a379021ab5b9874ac09796c9d1ff09b8e84.pkl",
      "cache_input_text_sha256": "fd5f07bfb3ae4e0de95e52f67063cd35f6bf1a64254fbd860545a52258ad08bd",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S12",
      "piece": 2,
      "source_slice": "asking more than 5,000 men in three villages for blood or saliva.",
      "exact_native_cache_key": "bf73103e2e5c8b7ec571d76b3a2dea388634c2b3.pkl",
      "cache_input_text_sha256": "a87783334723d13e589832e5580f88f19d1c8840b65c5deae4290cc055f373a8",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 1,
      "source_slice": "The elusive killer,",
      "exact_native_cache_key": "6d317f168f87dd81f72e33c8bfd16de03821d2fd.pkl",
      "cache_input_text_sha256": "f1eab2e6ec7b93b2646605fa5bc07f7f3d05e783690d7a17694d726f6f2e2032",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 2,
      "source_slice": "a local baker,",
      "exact_native_cache_key": "c414d9125192df27e773c641f89eafdd46f9e5f1.pkl",
      "cache_input_text_sha256": "dda94d9730eccea749b010f85fb068e31aeba3c5ae9848a855d27bf420655068",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 3,
      "source_slice": "had induced a co-worker to give a sample in his name,",
      "exact_native_cache_key": "bae0fbced602e57f1652f74ca3afa0052f6b0ddc.pkl",
      "cache_input_text_sha256": "e8ffd4991ee01ca1ec0c45554416dbb15c35ce42721ea200678abf49f1d3ddad",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S14",
      "piece": 4,
      "source_slice": "evading suspicion.",
      "exact_native_cache_key": "3007e31db675f2067c3432ac7f0de1dddc87ac0a.pkl",
      "cache_input_text_sha256": "6edac9b1a2a28215d30b18198a7b6e2dc7f2ca0002c78d1c1bb0cac501864515",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 1,
      "source_slice": "Colin Pitchfork was detained on 19 September 1987,",
      "exact_native_cache_key": "b59ff195d2b6b2b6d2e7e79e3f212463cc14b3e3.pkl",
      "cache_input_text_sha256": "704c9a10af0569ec5ff12a99d01369a67d6c35c41014e009b8ef3957bdf0c37d",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S16",
      "piece": 2,
      "source_slice": "and his DNA profile matched.",
      "exact_native_cache_key": "c99982015434efefcff306c3f833821cbe9226e7.pkl",
      "cache_input_text_sha256": "c9bf1f842889c928d91aa1403b75b11ffd241e18f9b2bf752243404677a99b30",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 1,
      "source_slice": "In January 1988 he pleaded guilty and was jailed for life,",
      "exact_native_cache_key": "94b78964e6dc3101475f5bfaaa6bdd422e17bd4e.pkl",
      "cache_input_text_sha256": "1d7810f8c22b880a0e550a3381b99c1b97eaa4756f92418f168a3abb00eedfaa",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S17",
      "piece": 2,
      "source_slice": "the first person convicted of murder on the basis of DNA evidence.",
      "exact_native_cache_key": "e8944af95620b55d2ff736be74d8a98fb2929562.pkl",
      "cache_input_text_sha256": "78b50d6b7aa8c17131d86bc13214bf04c1dbd7fbde2a7b7270440e5a04e390de",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 1,
      "source_slice": "A tip-off,",
      "exact_native_cache_key": "0c9e7bc163339848961657f11fc4a7901f0a3dab.pkl",
      "cache_input_text_sha256": "a10d2323dd10e557b443cacdc0a750f663d0f5d261b8ab2976dd124c0530bc95",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 2,
      "source_slice": "not the screening,",
      "exact_native_cache_key": "88c1cb95b0c12d539aee8fb3ffb19738d490f9c7.pkl",
      "cache_input_text_sha256": "c33cb40ff46b901984f19653c562f23e378666ce162205571bff11db09c9fa6f",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    },
    {
      "sentence": "S18",
      "piece": 3,
      "source_slice": "had unmasked him.",
      "exact_native_cache_key": "18750828c5ddcbf7c6da3d4b0954c42875b27340.pkl",
      "cache_input_text_sha256": "86ae16e0b88f9ec094f55941735ab615ade55c7d882d998f7f025619e84734c4",
      "cache_input_is_phonemes": false,
      "cache_preexisted": true
    }
  ],
