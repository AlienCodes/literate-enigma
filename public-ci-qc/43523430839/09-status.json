    "reference_calls": [
      {
        "sentence": "S1",
        "piece": 1,
        "source_slice": "Around Campion,",
        "exact_native_cache_key": "58a8947da6d2a5c515d316d5333865f013ee2172.pkl",
        "cache_input_text_sha256": "918b43698f3754d76865b9048b9fadadd30c9144e3b5585bc63eeed2d7ac51b2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S1",
        "piece": 2,
        "source_slice": "Western Australia,",
        "exact_native_cache_key": "4294476cdce30db5c48b77565d5bb14985550154.pkl",
        "cache_input_text_sha256": "a42fbee5563f7811963243657a3a017c39e58f571d6243e3c11952187ab936bc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S1",
        "piece": 3,
        "source_slice": "most farmers were First World War veterans,",
        "exact_native_cache_key": "7b30fe4e112bc065f61abfe1ad0f11ece0f15239.pkl",
        "cache_input_text_sha256": "c70f4a712923d2ff56f1fea4e17190d7e219f83d600443f91dde27024703569f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S1",
        "piece": 4,
        "source_slice": "settlers placed by a government scheme on marginal parcels of farmland.",
        "exact_native_cache_key": "563f323c52c9546be87c9e77eeb398b545052b0b.pkl",
        "cache_input_text_sha256": "0ed890700ef3d8a6b96d3493e95a14bc1b6a8335389c753d860d5307dc35ed26",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S2",
        "piece": 1,
        "source_slice": "They were inexperienced growers,",
        "exact_native_cache_key": "00edec357f9ef24ab75c8d6fdb778a14222ed3a6.pkl",
        "cache_input_text_sha256": "87839155bf74f8061605cc1074ef64642c1b8527ec34c59b2389b321fa179f74",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S2",
        "piece": 2,
        "source_slice": "and a quarter had already quit.",
        "exact_native_cache_key": "b8203f523aa770f48d6f2917b752e1fbaeab4abc.pkl",
        "cache_input_text_sha256": "fca895c9f5a2051b52dd92c3d32f6d73f55acc9d4692cdc0bbe66f4ecb1a035f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S3",
        "piece": 1,
        "source_slice": "In 1932,",
        "exact_native_cache_key": "1270bbe26b0d715ada6f8872608f8fdfd8698ca6.pkl",
        "cache_input_text_sha256": "b33cb67574e516fa16d1d1ec8a2ff3d2b24efb57c91e30c0848097a4f91cfb35",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "after drought,",
        "exact_native_cache_key": "36715fefd7f811c69a7fb340f770fc39a0844fdd.pkl",
        "cache_input_text_sha256": "4231cc19f99e11382a7e325900dd203e44e6ad56f9fa87cdb1d880f04f353f29",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S3",
        "piece": 3,
        "source_slice": "roughly 20,000 emus swarmed in from arid country in flocks and trampled the wheat crops.",
        "exact_native_cache_key": "a1e851969519a77166a4752ba11c7f34fa4e0621.pkl",
        "cache_input_text_sha256": "59b6bc7bafed33061e4dae5ef0c603fbe204134e25f58d5a395dc4eddc9643fa",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "In desperation,",
        "exact_native_cache_key": "161f7761dd763f9cf5c36a4162db6f72e7e23f81.pkl",
        "cache_input_text_sha256": "42bd868904c200e3921d8e788f1aeb3e7f0bdbb19cb76870f54f46bfec7a49fc",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "a delegation of ex-soldiers aired their grievances and asked the Defence Minister for machine-guns.",
        "exact_native_cache_key": "ae3c617806ee86d369ab6597e565a33d706851e3.pkl",
        "cache_input_text_sha256": "3554c074f58602a3601f63c094122a413269da082183e97c5ff8d72750ac3dec",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 1,
        "source_slice": "He agreed,",
        "exact_native_cache_key": "86804dcc26b170ec8b541f5960bb3c44ed9ad8a3.pkl",
        "cache_input_text_sha256": "084770d1d7f5049ce3fb68ee322aff77931f6e9f07db3f9c7c35708c89587646",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 2,
        "source_slice": "sending not a battalion but a detachment:",
        "exact_native_cache_key": "2a5eaef7eda2e02dcec5604026085838c0688be1.pkl",
        "cache_input_text_sha256": "9cccf0f880f4e856d2cd0c005757716cb96775fb07f7ce29ba2d0bcfcca86a58",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 3,
        "source_slice": "Major Meredith,",
        "exact_native_cache_key": "c48d69f4b87720ee91c9bc87cb3b136bab8132b0.pkl",
        "cache_input_text_sha256": "2c691fa2c4b139cf18a51105c954dc02bfb0dac6693a0656a439826b144514aa",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 4,
        "source_slice": "an artillery officer,",
        "exact_native_cache_key": "208849f9aaae3c406402525a7a1f62faf45603a4.pkl",
        "cache_input_text_sha256": "c6b07f99acdd81c3576bc19f94baf41953d1bac17c1c3987e57256d84f2afc54",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 5,
        "source_slice": "with two soldiers,",
        "exact_native_cache_key": "bd299fcdbfba83d1d68daa277d82ab38c9c29392.pkl",
        "cache_input_text_sha256": "528f7d31288c29b058a1bcb91ece9b9b27d4abe820cd00a0cb1856750e1f9921",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 6,
        "source_slice": "two Lewis guns,",
        "exact_native_cache_key": "31e218568112cbb488082ac39068bae21782e895.pkl",
        "cache_input_text_sha256": "80173f23f4984acf8e86678735437c2f00f5eeeeacd817c7707cd76983194c0a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S6",
        "piece": 7,
        "source_slice": "and 10,000 rounds of ammunition.",
        "exact_native_cache_key": "4a6d45ffe96f8987f8b81eb4bb08bf77945f2f06.pkl",
        "cache_input_text_sha256": "dc5e3f6fa1a9af96d0f93a2116001b9fe35d526cdfe5365675d4aa6f2344e98e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 1,
        "source_slice": "At a dam,",
        "exact_native_cache_key": "b1d81bfe81d9912a1e9e39b7aeaa8470edd5e0cc.pkl",
        "cache_input_text_sha256": "17bec06eec1835ad66c32d8cf436e742e204b36f240bc06c666bc96492cfdb30",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 2,
        "source_slice": "about a thousand birds approached an ambush,",
        "exact_native_cache_key": "a2d471d1be230f8d01bb475772919e5dc97f3587.pkl",
        "cache_input_text_sha256": "78fdf8078ad41083ce6e22d8c470c9a1f71bfad4c748863e241c1b90223c3bab",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S8",
        "piece": 3,
        "source_slice": "but a gun jammed after a dozen fell.",
        "exact_native_cache_key": "95d2e1df0083d423e58afed3304c4a90483776de.pkl",
        "cache_input_text_sha256": "d9330879004b193e87452065bfb7f0b6b807add16a49e648f5773cdef7342c7a",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S9",
        "piece": 1,
        "source_slice": "The flocks broke formation into small,",
        "exact_native_cache_key": "c5d24e660ec4b013093d988f4fc80eb839739834.pkl",
        "cache_input_text_sha256": "51ac2a7a69a2e7fa851e8cfb8003c9862ba210ee1f3f3b03f43eb4013750ec5e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S9",
        "piece": 2,
        "source_slice": "agile groups,",
        "exact_native_cache_key": "591a24a3b8869c02b11e5618d6d50195ba747d3e.pkl",
        "cache_input_text_sha256": "ee947ceb75309d62c8ef9a3840eff895773007d018ff53c0b2128d4f1628142f",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S9",
        "piece": 3,
        "source_slice": "frustrating each tactical plan,",
        "exact_native_cache_key": "9befc91e26ac32830f5fd5bba22ee1ceb4ca2f82.pkl",
        "cache_input_text_sha256": "5cea58c485ae3838adafb1ec5e31436a49c41de0e15b7e4f5f352a3de2741adf",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S9",
        "piece": 4,
        "source_slice": "and a truck-mounted gun proved futile.",
        "exact_native_cache_key": "ee848ce809d17122d4cc0e844bb4137f48f1b758.pkl",
        "cache_input_text_sha256": "0646a1ca5e1142c4cad2ebbbde08838d65f4dfefd1ace35bbd4464348e4f2423",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S10",
        "piece": 1,
        "source_slice": "Six days of wasteful firing spent 2,500 rounds on perhaps 50 to 200 birds,",
        "exact_native_cache_key": "1df3be551f4bd8ff0614191052720ba4c9c450e2.pkl",
        "cache_input_text_sha256": "c3ce7ab09a7e0370ec4b2360d526ea2a30fcce8793a846328a7e44339e8e091d",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S10",
        "piece": 2,
        "source_slice": "a ludicrous return.",
        "exact_native_cache_key": "62be8ec7a8237e0f07bea7791615c4a05c5f0186.pkl",
        "cache_input_text_sha256": "12f61e3cb76ae929b706acc3729ac99e79ca25a6b378b726c6c216507082b3b7",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 1,
        "source_slice": "After parliamentary questions and press ridicule,",
        "exact_native_cache_key": "29c8e622df8100cc565a0547a0dfbb105a0cda20.pkl",
        "cache_input_text_sha256": "d88bef9c4e183b8f42334664ed7a8a8b4de386458333bc9dd597c57cd46869b1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 2,
        "source_slice": "an embarrassing withdrawal came on 8 November,",
        "exact_native_cache_key": "21eff357f32305ee94d6cdf4ac02e3cd4693072f.pkl",
        "cache_input_text_sha256": "cd7ee52c4dd22adc293599bb2e4be21f40eee1bf907be766a76a54e64a21e1c5",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      },
      {
        "sentence": "S11",
        "piece": 3,
        "source_slice": "though shooting restarted within days.",
        "exact_native_cache_key": "4ba11d9b11ef90cfd1149ac87efdc54cb605f24a.pkl",
        "cache_input_text_sha256": "c6e24fadda858e3d0e322401799f1088476f8d912d76f1b10f8c77a4b955d510",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S13",
        "piece": 1,
        "source_slice": "His memo's inventory counted 986 kills from 9,860 rounds,",
        "exact_native_cache_key": "3f4a54e2f278ddcd2621d7c66ac8d3b4a2e342c5.pkl",
        "cache_input_text_sha256": "138c6ecc5358b68c8c9a45ddd102e4661d3ab9579047a2e0bfb1e1602fc30914",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S13",
        "piece": 2,
        "source_slice": "a ratio of ten bullets to one bird.",
        "exact_native_cache_key": "08129e9bd18ab46fed95ea3b03f304c0619bf9c8.pkl",
        "cache_input_text_sha256": "617d7611a29621ebe6aa1c8dfe159003a483007faf8b44f2d1d39422236bf6f2",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S16",
        "piece": 1,
        "source_slice": "Later pleas for reinforcements were refused,",
        "exact_native_cache_key": "36c0130fd5584bb18621ede3b2802ddb8ad6bfeb.pkl",
        "cache_input_text_sha256": "b137a272176832d31771d6b39584825659651b580e572c4cb696dbee168ffe69",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S16",
        "piece": 2,
        "source_slice": "and intervention gave way to a bounty sanctioned by the government.",
        "exact_native_cache_key": "8ca049f9af6d2e7b7f5db3f9a12480b2d0ddf230.pkl",
        "cache_input_text_sha256": "496ae9da3fe63fe9df5245ab61ab12717474234705f78f51ca645a349e826708",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S18",
        "piece": 1,
        "source_slice": "Farmers claimed over 57,000 payments in six months of 1934,",
        "exact_native_cache_key": "d33eb84c37c6cc5beb17a4a6c4cfc25b3f03a3bc.pkl",
        "cache_input_text_sha256": "b1a280afa794a829064b387af4386a67bb7ae9237eab14f27ea5fe3dd7d227b1",
        "cache_input_is_phonemes": false,
        "cache_preexisted": false
      },
      {
        "sentence": "S18",
        "piece": 2,
        "source_slice": "more than fifty-seven times Meredith's 986 kills.",
        "exact_native_cache_key": "fd2bfef3996fe417d4083202806dbc3c2e4c2973.pkl",
        "cache_input_text_sha256": "f628fa157aa704141717f0cb648765ae2e454eca4adf0c07e45c351d5480ace8",
        "cache_input_is_phonemes": true,
        "cache_preexisted": false
      }
    ],
