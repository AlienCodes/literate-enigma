        "cache_preexisted": true
      },
      {
        "sentence": "S3",
        "piece": 2,
        "source_slice": "since glaciers sometimes yield frozen remains.",
        "exact_native_cache_key": "f376f8866164fa15d61598827e92e36eb97a301e.pkl",
        "cache_input_text_sha256": "33bfd2c15107b12e2e447186143c17204d118174457983c30d6543061118ebd9",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 1,
        "source_slice": "Taking it for a recent death,",
        "exact_native_cache_key": "aa40d023d6688ba3d839868999cacba12d13a3f5.pkl",
        "cache_input_text_sha256": "a9c9e101dc340aa09697f4218729a36c70ce346105d7b4079d88be3ee0b6df27",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S4",
        "piece": 2,
        "source_slice": "rescuers used a jackhammer that ripped flesh from his left hip.",
        "exact_native_cache_key": "1c1c4d6b8f89aa60349424bc8b16bac2966d678d.pkl",
        "cache_input_text_sha256": "b6efc2715a0deac0cba7d7d5ecb9be75380617bd8680982f19b9e6b453759c51",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 1,
        "source_slice": "His possessions told another story:",
        "exact_native_cache_key": "dfa41fb978929e71a064b064b4cc351ec06e145d.pkl",
        "cache_input_text_sha256": "bbd87498a7d7deccbcf0333f42a9abfcc88fbdd115ffb898bee15883d56c99ee",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
      },
      {
        "sentence": "S5",
        "piece": 2,
        "source_slice": "leather and grass clothing,",
        "exact_native_cache_key": "38e9e387f8b6c9a06c3a8212cc1751a889dc473a.pkl",
        "cache_input_text_sha256": "08db4cf7d09083aa70271f2fbf61d959cbb146d32eed381aaf2b4483e6bbe26e",
        "cache_input_is_phonemes": false,
        "cache_preexisted": true
