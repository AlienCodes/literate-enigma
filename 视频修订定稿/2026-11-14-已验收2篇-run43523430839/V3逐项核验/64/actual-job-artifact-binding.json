      "reference_calls": [
        {
          "sentence": "S1",
          "piece": 1,
          "source_slice": "In January 2018,",
          "exact_native_cache_key": "cb63ac3e1230843b92f02ed1fe0ac284256bbdc5.pkl",
          "cache_input_text_sha256": "62ae5f3a00fd742f263ff1fc234278ea4d9f4bc5590880a22d7783fa91586fbc",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S1",
          "piece": 2,
          "source_slice": "Cape Town issued a stark alert:",
          "exact_native_cache_key": "a501361ac0aead4bdf0777c36e502b5ffd91e4cc.pkl",
          "cache_input_text_sha256": "f67b35b567de18e6d1d01c515e2747c36247a8079d0ffb4fd7d10050a47502f4",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S1",
          "piece": 3,
          "source_slice": "Day Zero could arrive in April.",
          "exact_native_cache_key": "cbf941fc6c4fbed44ebe112af1d48d68d47898f4.pkl",
          "cache_input_text_sha256": "9c2197ba9c1e1f69b1d88f787a9186abaa51b1fd3fe6438b973943d15ae296ce",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S2",
          "piece": 1,
          "source_slice": "The term denoted a grim threshold,",
          "exact_native_cache_key": "c66ccc3539aea262876afbf9d43351777b15b90e.pkl",
          "cache_input_text_sha256": "bdf74fb75f5f6e5c0c258928807c6dca05c4690c7b8d3cd84dbbeac05395f405",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S2",
          "piece": 2,
          "source_slice": "reached when water in the city's reservoirs,",
          "exact_native_cache_key": "f220008cef1e32e318c89628c490a5738c2d5fd7.pkl",
          "cache_input_text_sha256": "7b8f6437bf7657b3b7b783b06a916a6e87d4fa5360784674b28a71d89866d8f1",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S2",
          "piece": 3,
          "source_slice": "as a percentage of capacity,",
          "exact_native_cache_key": "44016e2eddbb6740faa47266f565e1874e62f17c.pkl",
          "cache_input_text_sha256": "54881038d8b2415c5e4c8c08b7c658a0c2bd77dabf709e9a0e0e771abca0b855",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S2",
          "piece": 4,
          "source_slice": "fell to 13.5 per cent.",
          "exact_native_cache_key": "4cbe679ef0124776e897fc09072b886871ff5109.pkl",
          "cache_input_text_sha256": "94d568f1592962c54dbc50e75c6072d43827f98049ba677f37a34b80e3914335",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S3",
          "piece": 1,
          "source_slice": "Most taps would then be shut,",
          "exact_native_cache_key": "4c100031853ebd4510921186b47d179a333abfff.pkl",
          "cache_input_text_sha256": "6a87ceffaf900045557834dfaafb3d8e7239f66009c13dd215f23dd03101520f",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S3",
          "piece": 2,
          "source_slice": "and residents would queue at about 200 designated collection points.",
          "exact_native_cache_key": "bc125fd80091b75092df72c949787a913fbb74fd.pkl",
          "cache_input_text_sha256": "5394fab91d9ff94b7f32cfe36861ea144b54f8ed7c44d6fd2e2f071d3ecc17b5",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S5",
          "piece": 1,
          "source_slice": "Three consecutive years of meagre rainfall,",
          "exact_native_cache_key": "50822bffa107c04316081b4f9f294c102f3131ec.pkl",
          "cache_input_text_sha256": "d7d3d4448944287294eb2473a8baad17c7070bf8ffee182d8c9d1891cb22d834",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S5",
          "piece": 2,
          "source_slice": "from 2015 to 2017,",
          "exact_native_cache_key": "08233a34c177b48c3cd7f4c5b6bd4967559b6fb4.pkl",
          "cache_input_text_sha256": "8a10a9937159b7c31ffc841d0ec6c1a96ba4981f0465f68dc0328fdc79df8daf",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S5",
          "piece": 3,
          "source_slice": "had diminished the reservoirs serving a metropolitan area of about four million people.",
          "exact_native_cache_key": "066a04e2889abb12261681a5f022ee5d12786db3.pkl",
          "cache_input_text_sha256": "88ca12af8a7d150168e08999e3aecf924914d904073d4c43355f93362c728dda",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S9",
          "piece": 1,
          "source_slice": "From 1 February 2018,",
          "exact_native_cache_key": "7db275aeef1cfc107eaa19c11f1307d5371a5a3d.pkl",
          "cache_input_text_sha256": "82273b210940b9604cd9822cbf46b98edd6d13d52c779d1adec34132a5b178cf",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S9",
          "piece": 2,
          "source_slice": "each person was allotted 50 litres a day.",
          "exact_native_cache_key": "d0fc7a20b05391dedc48fcc5aa417b4462aa9c37.pkl",
          "cache_input_text_sha256": "fe3cf6528d90eeb739269e936213d153568776293a4f7b65ee20e25df2a140e0",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S10",
          "piece": 1,
          "source_slice": "Officials disclosed dam levels and household consumption;",
          "exact_native_cache_key": "1160688b63b52570fc6b9401e73e8fef870dfd1c.pkl",
          "cache_input_text_sha256": "810d5241b7b533ac2d2ab35eeaf66f60c6e9e0f4c1a3d7de9bd73e9f3fa179fe",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S10",
          "piece": 2,
          "source_slice": "the published tallies made thrift visible and let neighbours benchmark their use.",
          "exact_native_cache_key": "2309b20a7a32c79f692cd11cbc330232509595d2.pkl",
          "cache_input_text_sha256": "815a01456ab2eb8ce0c8a0fae72af84dbe90ef03610613489d81cbc25c3d18b3",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S11",
          "piece": 1,
          "source_slice": "Daily use was more than halved,",
          "exact_native_cache_key": "f19c3123b8b202f962efba68ca8dd1ec02f959a6.pkl",
          "cache_input_text_sha256": "04013a37c8e762935b1c418f5b56ab520af08e65922ff57d0d407dc10827b535",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S11",
          "piece": 2,
          "source_slice": "from about 1.2 billion litres in 2015 to about 500 million by early 2018.",
          "exact_native_cache_key": "8b833cef2c009b6288df4fe5ffbb7c4bcdaab754.pkl",
          "cache_input_text_sha256": "592843a073bbb2781de2367be9692bbd3054204b6c4da59f1229740f94802373",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S13",
          "piece": 1,
          "source_slice": "In February 2018,",
          "exact_native_cache_key": "9678f10524d638dd895fa9515a828ec018099b3f.pkl",
          "cache_input_text_sha256": "e9636bd49c8181aae73abbcce6b011e6dd2d3c79d9d040169b14bf7d55de8b57",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S13",
          "piece": 2,
          "source_slice": "upstream farmers released water from their irrigation dams;",
          "exact_native_cache_key": "1dcb2870de59640d688c0e49a990c9b3ffa9d32e.pkl",
          "cache_input_text_sha256": "81a6408698aa576068bfc428f90e52005e0f489df4fdaace0f0c2a954e2fe0a0",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S13",
          "piece": 3,
          "source_slice": "with farms drawing less,",
          "exact_native_cache_key": "c58c8c9948e4356606edf6d3e8c1d1ef349c73a4.pkl",
          "cache_input_text_sha256": "bc9492664602c673af472e036f91f8fe14201deaa0c91a9e262ce7abf0d9461b",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S13",
          "piece": 4,
          "source_slice": "Day Zero was postponed to July.",
          "exact_native_cache_key": "cd4d0302d680d45b3fc1b212684373286c979eb1.pkl",
          "cache_input_text_sha256": "7435661aa2ed844aa16c050d7cdb88279ea429c4da7f5f048b608f9f89339feb",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S14",
          "piece": 1,
          "source_slice": "In March 2018,",
          "exact_native_cache_key": "364240104fd0a2ed6a8183c486157adb1d386f9e.pkl",
          "cache_input_text_sha256": "e3fb7ba42a7f023361940374c0b84a52dd6e02f449e35d2627ed8973ea8bc022",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S14",
          "piece": 2,
          "source_slice": "officials judged Day Zero unlikely that year.",
          "exact_native_cache_key": "74f164be2606e259837ffc4988a44daf47d8fcdc.pkl",
          "cache_input_text_sha256": "aff69bd55366bb33628c75f7796b346ec17a1ffabcb7f2a709fd8a296a3db980",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S15",
          "piece": 1,
          "source_slice": "Winter rains subsequently replenished the reservoirs,",
          "exact_native_cache_key": "aac44dec558e8b2ea2c69213ff078ed439d2f581.pkl",
          "cache_input_text_sha256": "1467615c28f17a79b681581133d8d8a896c433cb9d844125a6ea7fe57a510e60",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S15",
          "piece": 2,
          "source_slice": "which were about half full by July.",
          "exact_native_cache_key": "db07a513db1c18883eb018474a7c32e0373723cc.pkl",
          "cache_input_text_sha256": "518daef62fea2adf79e222c82b27e24db940e51f63e199e514f240ea34c04127",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S17",
          "piece": 1,
          "source_slice": "The burden,",
          "exact_native_cache_key": "e8350bb4aca4661dbc8658f8d997d42ea17e22e1.pkl",
          "cache_input_text_sha256": "277b8072fd0fe04c889a50e60ede37db19a8b78d279bb0c80a1954b73e8bb386",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S17",
          "piece": 2,
          "source_slice": "critics argued,",
          "exact_native_cache_key": "18e66b55cd94d9dd1b62bcf58a218236850d7153.pkl",
          "cache_input_text_sha256": "fe0425f25295c9a33d18f867e029f92ca41cd2aeaf370e8a9bd594647e36430b",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S17",
          "piece": 3,
          "source_slice": "fell unevenly.",
          "exact_native_cache_key": "5a6790664aa54f4d7cf53e998d751c62ed3a0ee2.pkl",
          "cache_input_text_sha256": "77d2896ef53f412cd477c559882c7cfb0a825cd31bbe07fceb21d5ca26983843",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S18",
          "piece": 1,
          "source_slice": "Townships,",
          "exact_native_cache_key": "5d5d94dd949250f12fd4301e6b7c6c8e86f6febc.pkl",
          "cache_input_text_sha256": "ba008de250c1bebff4c9cf6b79fe0b5055540d78106629d397303d971b8db216",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S18",
          "piece": 2,
          "source_slice": "poor areas segregated by race under apartheid,",
          "exact_native_cache_key": "487280ac97044a28cda66e72a3a1dd34ecef4dbe.pkl",
          "cache_input_text_sha256": "7b7c39febef9176f3976c192093ec62910abdf2582a40d20d65d8aa2ce6feaa8",
          "cache_input_is_phonemes": true,
          "cache_preexisted": true
        },
        {
          "sentence": "S18",
          "piece": 3,
          "source_slice": "had long made do with scant water,",
          "exact_native_cache_key": "db99a719f8afa154816833e16838812f1231695a.pkl",
          "cache_input_text_sha256": "a59d651dabfc7184bd869e4bf45f4e76dec9f72df9177f8a92fab3efd272534b",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S18",
          "piece": 4,
          "source_slice": "yet steeper tariffs squeezed them hardest.",
          "exact_native_cache_key": "06bd475d3ff58193e71a469986083dc8cab70435.pkl",
          "cache_input_text_sha256": "666086f1e7784b0ca24469649d3cb66ff91cec080955e8c50ed2ee5ad8d874f3",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S20",
          "piece": 1,
          "source_slice": "Households,",
          "exact_native_cache_key": "61c9110202f49517e8fe22f4b11a1aa788920f89.pkl",
          "cache_input_text_sha256": "998e5f1a694eadb9305d437676b45e40dfb82ba889c88285143d1bfc774ff0df",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S20",
          "piece": 2,
          "source_slice": "farmers,",
          "exact_native_cache_key": "da9c33801d5647d6184a8d51c44d340cf884ab1a.pkl",
          "cache_input_text_sha256": "2f7f916185a9333f4a78db4d7e841804505aa60c7d7c94f3c6a14f9bd3b0d2f5",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S20",
          "piece": 3,
          "source_slice": "and rain kept the collection points idle,",
          "exact_native_cache_key": "6993e52cc8c200b3831a5b2b8baf99c520e45a14.pkl",
          "cache_input_text_sha256": "7c86b9ca04eb80477948a324cedc1239eb1acc1968bad3fb63ec42b85d4fbf22",
          "cache_input_is_phonemes": false,
          "cache_preexisted": true
        },
        {
          "sentence": "S20",
          "piece": 4,
          "source_slice": "but the sacrifice weighed heaviest on those with the least to give.",
          "exact_native_cache_key": "3c759850568551e9b33332917cd68621a7ae8481.pkl",
          "cache_input_text_sha256": "99afbe40895950c45d216964f19b83366907d8cb9a9a65814525a9cfe0f060ad",
