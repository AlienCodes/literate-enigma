63c85eca60af4ef521f1d36f765575a568d6f3", "checker_program_sha256": "6a735daa5aeaa8c0f00d1c5836438878c5d726cc0a8acbad3e6e241d1d12aa94", "reference_calls": [{"sentence": "S1", "piece": 1, "source_slice": "On the morning of 7 November 1940,", "exact_native_cache_key": "48728aba4a57df54f509f08668f60fc3f4f076c6.pkl", "cache_input_text_sha256": "3f97abde9e3a1e2ea7f8be61244fc47eee295d060f40723675b169750efc3fc7", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S1", "piece": 2, "source_slice": "a sustained wind of about 40 miles an hour set the Tacoma Narrows Bridge twisting.", "exact_native_cache_key": "3ddcc1349e1c24ec137ba8e16580a11e09a5be1e.pkl", "cache_input_text_sha256": "c4162f07d6f2fc25a0a69bc95b71792598e6ceab336910506096c7373f1cefac", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S5", "piece": 1, "source_slice": "The bridge had opened in July 1940 as the third-longest suspension span in the world at the time,", "exact_native_cache_key": "1a8ee21132e21436bbb26b199c58b1ee2e7f9af0.pkl", "cache_input_text_sha256": "e51212448b3d91e1c933ee306236dc7f800f8a26ee47f544defd0946768d6b8d", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S5", "piece": 2, "source_slice": "its roadway hung from steel cables.", "exact_native_cache_key": "ef6f4486b9239996c5e4f2482e7b8b75e0fcc75b.pkl", "cache_input_text_sha256": "902a0675c50738f0268dfb45d63c8607f963306001c02429101742c2c96bbce2", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S6", "piece": 1, "source_slice": "Girders only eight feet deep stiffened the deck,", "exact_native_cache_key": "5a323318009fc7943d586ccdb54ad6baa8cd24b4.pkl", "cache_input_text_sha256": "bac52c97a29f046ebd3aae599f2c2478f65b7e1abb26e2af60c22178ae54fdfa", "cache_input_is_phonemes": true, "cache_preexisted": true}, {"sentence": "S6", "piece": 2, "source_slice": "making it slender,", "exact_native_cache_key": "59de4b75ce76980f21912ade2b7370e05cc9d2bc.pkl", "cache_input_text_sha256": "738dba7c2347ba3119c74df1aa342c8a8c8b2fd3b9d2c86d5753a655c6050a70", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S6", "piece": 3, "source_slice": "elegant,", "exact_native_cache_key": "2470de8e1c0f0a09c3d488db463f8fea86c5fddf.pkl", "cache_input_text_sha256": "cdcdf35f3c9489bc41e2ec9a454032f16445e5f8f523e6b413cb228cd06401ae", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S6", "piece": 4, "source_slice": "and economical,", "exact_native_cache_key": "5fb955b53b4a5e2ea548ec527429625c63962a98.pkl", "cache_input_text_sha256": "f90607b99213f30f2b3627d840fe7e970d8b706bbffff6b4e5942e1c2c882d65", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S6", "piece": 5, "source_slice": "but far from rigid.", "exact_native_cache_key": "cc41c440261f16729ef0d27a98ecdc0968a62499.pkl", "cache_input_text_sha256": "b960c34f6108a551546d6464e6600b2f4c9c88590ce820c66d09b4b34c7b50c8", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S7", "piece": 1, "source_slice": "Even faint breezes made it heave,", "exact_native_cache_key": "cc6ac7c7082440ac6126706e861570f8e7246f13.pkl", "cache_input_text_sha256": "2dcc9a7c9fee28a8ff2dc986e288373ed797c294201c7b828ec8916d6be8bceb", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S7", "piece": 2, "source_slice": "earning the nickname Galloping Gertie.", "exact_native_cache_key": "29e50fb80943340e3f09976be0b0bc1c02689680.pkl", "cache_input_text_sha256": "528cb74557a57a3005fe852a4c4873997d5b518cddc8ad0737624fa60944dc24", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S8", "piece": 1, "source_slice": "Textbooks have long invoked resonance:", "exact_native_cache_key": "68bc622298830b8c0b4ea2aca1f1d6944b42b7ee.pkl", "cache_input_text_sha256": "d40c39454c2cf35b6d46aabd2074136d84134fccd0f00fc93138a460fddfb1d7", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S8", "piece": 2, "source_slice": "a periodic push that matches an object's natural frequency can amplify its motion,", "exact_native_cache_key": "e31a41093d1077254617036145b70f9854b86fcb.pkl", "cache_input_text_sha256": "a277670db075edc813b37ac8b54a792f14b08abd13c15940e5c0a63329801ccc", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S8", "piece": 3, "source_slice": "as when well-timed shoves propel a child on a swing.", "exact_native_cache_key": "913012b2cbec0f537b04b6e8a2b7761a44384073.pkl", "cache_input_text_sha256": "baf4208315b570caa1f56e67b3a9774ef88ba676756c4d2f57fe0eec67990f6c", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S10", "piece": 1, "source_slice": "That morning's wind did not pulse in time with the bridge;", "exact_native_cache_key": "d282e6bd39635b29de3eb6bf577d315bd2d29585.pkl", "cache_input_text_sha256": "59baea46914299a3248d328db47994c630eecc2b49f6e723436ab2597d6a316b", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S10", "piece": 2, "source_slice": "it blew fairly steadily.", "exact_native_cache_key": "5fb2ac747e9381afd8e03acdbb1c684d789581c1.pkl", "cache_input_text_sha256": "6bdf29c3c4a694168f65bb4dbaeaff3cd65f675e261057cc93d00db82170808b", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S12", "piece": 1, "source_slice": "Each twist altered the passing airflow,", "exact_native_cache_key": "a1680e6c6aebb5a0d3cbf6a3bc8b5fb23dee1038.pkl", "cache_input_text_sha256": "29a9b82dd747e72578491759f8e9df271463d71b1088fa163d2f6d5e3e539fa5", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S12", "piece": 2, "source_slice": "which reinforced the next twist:", "exact_native_cache_key": "4e5caea95d2078e8fc8dede65b25e8299cd28385.pkl", "cache_input_text_sha256": "936cc730090463afcaf8311e450dcc92365c7873be4629d70948bffff49c71e8", "cache_input_is_phonemes": true, "cache_preexisted": true}, {"sentence": "S12", "piece": 3, "source_slice": "a feedback loop that kept tapping the wind for energy.", "exact_native_cache_key": "502797b479897eaf9206396939bc333e88ff280e.pkl", "cache_input_text_sha256": "256edf61229618105c1bbab6ea3d45cd64ff9b742615cd6ada390855013e997d", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S14", "piece": 1, "source_slice": "Later analysis called the mechanism flutter;", "exact_native_cache_key": "c915687ab04c309750c27141fb23ae284858e432.pkl", "cache_input_text_sha256": "ca89dca1a4056bc95ca83b3fa2263ed25b95da5d42dbbb4bd99fc3cc576b2304", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S14", "piece": 2, "source_slice": "in February 1991 two engineers asserted in a physics journal that textbooks had erred.", "exact_native_cache_key": "b164b7d9ed132aacff1d2ddff8d4a84b886c4b14.pkl", "cache_input_text_sha256": "87fe624a960311a58f084626de47038d7a748d77fbe3aa546f7dbc90602af74a", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S15", "piece": 1, "source_slice": "The panel urged wind-tunnel tests,", "exact_native_cache_key": "ad61986be54d51e8368b4b0ce75f1ddba8b6f720.pkl", "cache_input_text_sha256": "ef51340e831b539b7bb67fc35b0500760126287b10a0a86a2bc6e9273499576b", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S15", "piece": 2, "source_slice": "and trials on scaled-down replicas gradually became customary for suspension bridges.", "exact_native_cache_key": "e2c340ba595baf63210a4cfd1f2d00e0a6d9f23a.pkl", "cache_input_text_sha256": "06fee925cae092eb092f90f9f0e1b9c30f8a0ef9067d6aa8ef9ee4be92de1b9f", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S17", "piece": 1, "source_slice": "Gertie's fall may still instruct engineers,", "exact_native_cache_key": "b02c9232b50c48dd70a77f6345466b0a712aca1c.pkl", "cache_input_text_sha256": "4f7bd5f6a7d462a9ea7cc7f78d72016fac3801b7a7827ab11caaf465d5a6e43f", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S17", "piece": 2, "source_slice": "if read accurately:", "exact_native_cache_key": "5360dbf2bec4e54c6f6cd1c5d7e70ed04d7531bf.pkl", "cache_input_text_sha256": "f6810ac729137ab7f2c8f1972511ce3b092d00d2cc29dfbde3484ee12fa2784c", "cache_input_is_phonemes": true, "cache_preexisted": true}, {"sentence": "S17", "piece": 3, "source_slice": "the wind never kept time with the bridge,", "exact_native_cache_key": "a2dec314a443e4517a1d77eb95ae6a29852fcc38.pkl", "cache_input_text_sha256": "6f2259c027b6926a9b51374497e37a19571102b0007426ebd50dc94145b25baa", "cache_input_is_phonemes": false, "cache_preexisted": true}, {"sentence": "S17", "piece": 4, "source_slice": "the bridge's own motion turned a sustained wind destructive.", "exact_native_cache_key": "a4ab662022fdbd6c3ec32fa53fd69157530165c4.pkl", "cache_input_text_sha256": "b80485c6f181d3fbe22f1d87bd727fb155ccdc82c90e8f830cdaf0f845103303", "cache_input_is_phonemes": false, "cache_preexisted": true}], "unique_reference_key_count": 27, "missing_reference_key_count": 0, "observed_missing_keys_covered": [], "new_private_cache_names": [], "native_single_thread_marker_verified": true, "single_thread_sessions": [{"intra_op_num_threads": 1, "inter_op_num_threads": 1}, {"intra_op_num_threads": 1, "inter_op_num_threads": 1}], "models_sha256": {"kokoro-v1.0.onnx": "7d5df8ecf7d4b1878015a32686053fd0eebe2bc377234608764cc0ef3636a6c5", "kokoro-v1.0-timed.onnx": "beb0d1848dee9a49da392cc3df26958d46cfa35d321edf434f52949153f0df3a", "voices-v1.0.bin": "bca610b8308e8d99f32e6fe4197e7ec01679264efed0cac9140fe9c29f1fbf7d"}, "fixed_voice_sha256": "1f97658bb5a4280cc3f6c01dc644dff471bf57c970fc8b99f3049d6991c4f6c8", "existing_private_cache_count": 11514, "existing_private_cache_inventory_sha256_before": "e4b084f2d448943fb382896809b837cfcfd461cb519ced97a135479c8636aa5f", "existing_private_cache_inventory_sha256_after": "e4b084f2d448943fb382896809b837cfcfd461cb519ced97a135479c8636aa5f", "existing_private_cache_bytes_unchanged": true, "public