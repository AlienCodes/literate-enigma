{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/视频/工具/token进行中.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/视频/工具/钩子/闸门.py\" 收工 || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/视频/工具/开工提醒.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/视频/工具/钩子/闸门.py\" 子代理 || true"
          }
        ]
      },
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/视频/工具/钩子/闸门.py\" 发文件 || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/视频/工具/钩子/闸门.py\" 命令 || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/视频/工具/钩子/闸门.py\" 改文件 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/视频/工具/钩子/闸门.py\" 发文件后 || true"
          }
        ]
      },
      {
        "matcher": "mcp__claude-code-remote__send_later",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/视频/工具/钩子/闸门.py\" 已约唤醒 || true"
          }
        ]
      }
    ]
  }
}